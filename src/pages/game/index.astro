---
import "@fontsource/dela-gothic-one/latin-400.css";
import Layout from "../../layouts/Layout.astro";
import {
  MENU_ICON,
  SCORE_ICON,
  UI_ICON,
  sizedIcon,
} from "../../lib/game/icons";
---

<Layout
  title="Game"
  description="An in-site survival game, earned by making real progress on the curriculum."
>
  <div
    data-game-root
    class="relative mx-auto flex w-full max-w-5xl flex-col items-center gap-4"
  >
    <div class="flex w-full items-center justify-between">
      <h1 class="text-xl font-semibold">Game</h1>
      <button
        type="button"
        data-fullscreen-toggle
        title="Fullscreen"
        aria-label="Toggle fullscreen"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      ></button>
    </div>

    <div data-lobby class="flex w-full flex-col gap-5">
      <section class="title-screen">
        <div class="ts-scan" aria-hidden="true"></div>
        <div class="ts-top">
          <div class="ts-credits">
            <span>CREDITS <b data-lobby-tokens>00</b></span>
            <span data-daily-chip class="ts-free"></span>
          </div>
          <div class="ts-tools">
            <button
              type="button"
              data-open-panel="lab"
              title="Balance lab"
              aria-label="Balance lab"
              class="ts-tool"
              set:html={sizedIcon(UI_ICON.lab, "h-4 w-4")}
            />
            <button
              type="button"
              data-mute-toggle
              title="Sound"
              aria-label="Toggle sound"
              class="ts-tool"
            >
            </button>
            <button
              type="button"
              data-motion-toggle
              title="Visual effects"
              aria-label="Toggle visual effects"
              class="ts-tool"
            >
            </button>
          </div>
        </div>
        <div class="ts-body">
          <div class="ts-left">
            <h2 class="ts-title">SURVIVE<br />THE RUN</h2>
            <nav class="ts-menu" aria-label="Game menu">
              <button type="button" data-start-button class="ts-start">
                <span class="ts-ico ts-ico-sky" set:html={MENU_ICON.start} />
                <span class="ts-label ts-label-start"
                  ><span data-icon-play class="hidden"></span><span
                    data-start-label>Start run</span
                  ></span
                >
                <span data-start-tag class="ts-tag ts-green">free</span>
              </button>
              <button
                type="button"
                data-mode-toggle
                class="ts-mode"
                aria-pressed="false"
              >
                <svg
                  viewBox="0 0 32 16"
                  width="30"
                  height="15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.2"
                  stroke-linecap="round"
                  aria-hidden="true"
                  ><path
                    d="M16 8c-3-6-11-6-11 0s8 6 11 0c3-6 11-6 11 0s-8 6-11 0Z"
                  ></path></svg
                >
                <span data-mode-label>Endless: off</span>
                <span class="ts-mode-hint" data-mode-hint
                  >no timer, bosses keep coming</span
                >
              </button>
              <div class="ts-arms-wrap">
                <span class="ts-arms-cap" data-start-weapon-name
                  >Start with: Bolt</span
                >
                <div
                  class="ts-arms"
                  data-start-weapons
                  role="radiogroup"
                  aria-label="Starting weapon"
                >
                </div>
              </div>
              <div class="ts-grid">
                <button type="button" data-open-panel="duel" class="ts-tile">
                  <span
                    class="ts-ico ts-ico-lg ts-ico-rose"
                    set:html={MENU_ICON.duel}
                  />
                  <span class="ts-label">Duel</span>
                </button>
                <button
                  type="button"
                  data-open-panel="upgrades"
                  class="ts-tile"
                >
                  <span
                    class="ts-ico ts-ico-lg ts-ico-lime"
                    set:html={MENU_ICON.upgrades}
                  />
                  <span class="ts-label">Upgrades</span>
                  <span data-tag-upgrades class="ts-tag ts-gold"></span>
                </button>
                <button type="button" data-open-panel="chests" class="ts-tile">
                  <span
                    class="ts-ico ts-ico-lg ts-ico-gold"
                    set:html={MENU_ICON.chests}
                  />
                  <span class="ts-label">Chests</span>
                  <span data-tag-chests class="ts-tag ts-gold"></span>
                </button>
                <button type="button" data-open-panel="relics" class="ts-tile">
                  <span
                    class="ts-ico ts-ico-lg ts-ico-violet"
                    set:html={MENU_ICON.relics}
                  />
                  <span class="ts-label">Relics</span>
                  <span data-tag-relics class="ts-tag ts-lilac"></span>
                </button>
              </div>
            </nav>
            <p
              data-lobby-zero-message
              class="hidden text-sm font-bold text-amber-300"
            >
              No runs left —
              <a href="/roadmap" class="underline">finish a unit</a> to earn one,
              or come back tomorrow for the free daily run.
            </p>
            <div class="ts-chips">
              <div class="ts-chip" title="Best run">
                <span class="ts-chip-ico" set:html={SCORE_ICON.trophy} />
                <span class="ts-chip-text"
                  ><small>Best</small><b data-lobby-best>--</b></span
                >
              </div>
              <div class="ts-chip" title="Run length">
                <span class="ts-chip-ico" set:html={SCORE_ICON.clock} />
                <span class="ts-chip-text"
                  ><small>Length</small><b data-lobby-duration>60s</b></span
                >
              </div>
              <div class="ts-chip ts-chip-gold" title="Coins">
                <span class="ts-chip-ico" set:html={SCORE_ICON.coin} />
                <span class="ts-chip-text"
                  ><small>Coins</small><b data-lobby-coins-score>0</b></span
                >
              </div>
            </div>
          </div>
          <div class="ts-stage">
            <canvas data-hero-stage aria-hidden="true" class="ts-canvas"
            ></canvas>
            <a
              data-stage-chest
              href="#chests-panel"
              class="ts-chest hidden"
              aria-label="Open your chest"
            >
              <span data-stage-chest-art class="ts-chest-art"></span>
              <span data-stage-chest-count class="ts-chest-count">1</span>
            </a>
            <p data-stage-bubble class="ts-bubble"></p>
          </div>
        </div>
      </section>

      <dialog
        data-panel="upgrades"
        class="panel-dialog"
        style="max-width: 720px"
      >
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-lime"
              set:html={MENU_ICON.upgrades}
            />
            <h2 class="panel-title">Upgrades</h2>
            <span class="panel-extra"
              ><span class="panel-chip" title="Coins"
                ><span data-icon-lobby-coins></span><span
                  class="tabular-nums"
                  data-lobby-coins>0</span
                ></span
              ></span
            >
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <div
              data-shop-rows
              class="grid w-full grid-cols-2 gap-3 sm:grid-cols-3"
            >
            </div>
            <div class="panel-divider">
              <span set:html={sizedIcon(UI_ICON.lock, "h-5 w-5")} />
            </div>
            <div data-shop-unlock-rows class="flex w-full flex-col gap-2"></div>
          </div>
        </div>
      </dialog>

      <dialog data-panel="duel" class="panel-dialog" style="max-width: 500px">
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-rose"
              set:html={MENU_ICON.duel}
            />
            <h2 class="panel-title">Duel</h2>
            <span class="panel-extra"
              ><span data-duel-record class="panel-chip tabular-nums"
                >0 – 0</span
              ></span
            >
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <canvas
              data-duel-art
              aria-hidden="true"
              class="h-28 w-full rounded-xl border-2 border-slate-900 bg-rose-200"
            ></canvas>
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2" title="Your weapon">
                <span
                  class="shrink-0"
                  set:html={sizedIcon(MENU_ICON.duel, "h-7 w-7")}
                />
                <div data-pick-weapon class="flex flex-wrap gap-1.5"></div>
              </div>
              <div class="flex items-center gap-2" title="Rival weapon">
                <span
                  class="shrink-0"
                  set:html={sizedIcon(UI_ICON.kills, "h-7 w-7")}
                />
                <div data-pick-rival class="flex flex-wrap gap-1.5"></div>
              </div>
              <div class="flex items-center gap-2" title="Weapon level">
                <span
                  class="shrink-0"
                  set:html={sizedIcon(UI_ICON.level, "h-7 w-7")}
                />
                <div data-pick-level class="flex flex-wrap gap-1.5"></div>
              </div>
              <div class="flex items-center gap-2" title="Rival skill">
                <span
                  class="shrink-0"
                  set:html={sizedIcon(UI_ICON.threat, "h-7 w-7")}
                />
                <div data-pick-diff class="flex flex-wrap gap-1.5"></div>
              </div>
            </div>

            <div class="hidden">
              <div class="grid grid-cols-2 gap-2">
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Your weapon
                  <select
                    data-duel-weapon
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                    ><option value="bolt">Bolt</option><option
                      value="homingDart">Homing Dart</option
                    ><option value="chainLightning">Chain Lightning</option
                    ><option value="meteorRain">Meteor Rain</option><option
                      value="gravityWell">Gravity Well</option
                    ><option value="flameTrail">Flame Trail</option><option
                      value="sentryTotem">Sentry Totem</option
                    ><option value="novaPulse">Nova Pulse</option><option
                      value="orbitShield">Orbit Shield</option
                    ><option value="bladeArc">Blade Arc</option></select
                  >
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Level
                  <select
                    data-duel-level
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="1">1</option><option value="2">2</option
                    ><option value="3" selected>3</option><option value="4"
                      >4</option
                    ><option value="5">5</option><option value="6"
                      >6 (evolved)</option
                    >
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Rival weapon
                  <select
                    data-duel-rival
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="different" selected
                      >Different (random)</option
                    ><option value="mirror">Mirror</option><option value="bolt"
                      >Bolt</option
                    ><option value="homingDart">Homing Dart</option><option
                      value="chainLightning">Chain Lightning</option
                    ><option value="meteorRain">Meteor Rain</option><option
                      value="gravityWell">Gravity Well</option
                    ><option value="flameTrail">Flame Trail</option><option
                      value="sentryTotem">Sentry Totem</option
                    ><option value="novaPulse">Nova Pulse</option><option
                      value="orbitShield">Orbit Shield</option
                    ><option value="bladeArc">Blade Arc</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Rival skill
                  <select
                    data-duel-difficulty
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="easy">Easy</option><option
                      value="normal"
                      selected>Normal</option
                    ><option value="hard">Hard</option>
                  </select>
                </label>
              </div>
            </div>
            <button
              type="button"
              data-duel-start
              class="flex h-12 w-full items-center justify-center rounded-xl border-2 border-slate-900 bg-rose-400 text-base font-black tracking-wide uppercase shadow-[0_4px_0_#020617] transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-[0_1px_0_#020617]"
              ><span set:html={sizedIcon(MENU_ICON.duel, "h-7 w-7")} /><span
                class="sr-only">Start duel</span
              ></button
            >
          </div>
        </div>
      </dialog>

      <dialog data-panel="weapon" class="panel-dialog" style="max-width: 520px">
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-sky"
              set:html={MENU_ICON.start}
            />
            <h2 class="panel-title">Choose your weapon</h2>
            <span class="panel-extra"></span>
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <div data-weapon-grid class="wp-grid"></div>
            <p data-weapon-desc class="wp-desc"></p>
            <button type="button" data-weapon-go class="wp-go">Start</button>
          </div>
        </div>
      </dialog>

      <dialog data-panel="chests" class="panel-dialog" style="max-width: 480px">
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-gold"
              set:html={MENU_ICON.chests}
            />
            <h2 class="panel-title">Chests</h2>
            <span class="panel-extra"></span>
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <div data-chest-rows class="flex flex-col gap-3"></div>
          </div>
        </div>
      </dialog>

      <dialog data-panel="relics" class="panel-dialog" style="max-width: 540px">
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-violet"
              set:html={MENU_ICON.relics}
            />
            <h2 class="panel-title">Relics</h2>
            <span class="panel-extra"
              ><span data-relic-count class="panel-chip tabular-nums"
              ></span></span
            >
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <div data-relic-grid class="grid grid-cols-5 gap-2.5"></div>
            <p
              data-relic-detail
              class="min-h-8 text-sm font-semibold text-[#c9c2ff]"
            >
            </p>
          </div>
        </div>
      </dialog>

      <dialog data-panel="lab" class="panel-dialog" style="max-width: 540px">
        <div class="panel-stack">
          <header class="panel-head">
            <span
              class="ts-ico ts-ico-md ts-ico-sky"
              set:html={sizedIcon(UI_ICON.lab, "h-6 w-6")}
            />
            <h2 class="panel-title">Lab</h2>
            <span class="panel-extra"></span>
            <button
              type="button"
              data-panel-close
              aria-label="Close"
              class="panel-close"
              ><span set:html={sizedIcon(UI_ICON.close, "h-5 w-5")} /></button
            >
          </header>
          <div class="panel-body">
            <div class="light-scope flex flex-col gap-3">
              <p class="text-xs text-slate-500 dark:text-slate-400">
                One weapon, nothing can hurt you. Enemies stop at the distance
                you pick, so you see which weapons still kill and what they ask
                of you. The drain stands in for incoming damage to judge
                recovery.
              </p>
              <div class="grid grid-cols-2 gap-2">
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Weapon
                  <select
                    data-training-weapon
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="bolt">Bolt</option>
                    <option value="homingDart">Homing Dart</option>
                    <option value="chainLightning">Chain Lightning</option>
                    <option value="meteorRain">Meteor Rain</option>
                    <option value="gravityWell">Gravity Well</option><option
                      value="flameTrail">Flame Trail</option
                    ><option value="sentryTotem">Sentry Totem</option>
                    <option value="novaPulse">Nova Pulse</option>
                    <option value="orbitShield">Orbit Shield</option>
                    <option value="bladeArc">Blade Arc</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Level
                  <select
                    data-training-level
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6 (evolved)</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Enemies keep away
                  <select
                    data-training-standoff
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="0">0 px (touching)</option>
                    <option value="40">40 px</option>
                    <option value="80" selected>80 px</option>
                    <option value="120">120 px</option>
                    <option value="160">160 px</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >HP drain
                  <select
                    data-training-drain
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="0" selected>None</option>
                    <option value="10">10 HP/s</option>
                    <option value="20">20 HP/s</option>
                    <option value="30">30 HP/s</option>
                  </select>
                </label>
              </div>
              <button
                type="button"
                data-training-start
                class="flex h-11 w-full items-center justify-center rounded-xl border-2 border-slate-300 bg-white text-sm font-extrabold shadow-[0_3px_0_#cbd5e1] transition hover:border-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_3px_0_#334155] dark:hover:border-slate-300"
              >
                Start training — no run needed
              </button>
            </div>
          </div>
        </div>
      </dialog>
    </div>

    <div
      data-play-area
      class="mx-auto hidden w-full max-w-none flex-col items-center gap-3"
    >
      <div
        class="relative mx-auto"
        style="width: min(100%, calc((100svh - var(--chrome, 15rem)) * var(--aspect, 0.84)), 1180px); container-type: inline-size;"
      >
        <div
          data-hud
          class="mb-2 flex flex-col gap-1 rounded-xl border-2 border-slate-900 bg-white/90 px-2.5 py-1.5 text-slate-800"
        >
          <div class="flex items-center gap-3">
            <div class="flex min-w-0 flex-1 items-center gap-2">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-rose-300"
                data-icon-hp></span>
              <div
                class="h-4 flex-1 overflow-hidden rounded-full border-2 border-slate-900 bg-white/70"
              >
                <div
                  data-hud-hp-bar
                  class="h-full rounded-full bg-rose-400 transition-[width] duration-200"
                  style="width: 100%"
                >
                </div>
              </div>
              <span
                data-hud-hp
                class="shrink-0 text-xs font-bold tabular-nums text-slate-600"
                >--/--</span
              >
            </div>
            <span class="flex shrink-0 items-center gap-1.5 text-sm">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-sky-300"
                data-icon-timer></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-timer
                >--</span
              >
            </span>
            <button
              type="button"
              data-special-button
              aria-label="Special move"
              class="relative hidden h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-lg border-2 border-slate-900 bg-cyan-300 text-slate-900 shadow-[0_2px_0_#020617]"
            >
              <span data-special-icon class="relative z-[1]"></span>
              <span
                data-special-fill
                class="absolute inset-x-0 top-0 bg-slate-900/45"
                style="height: 100%"></span>
            </button>
            <button
              type="button"
              data-pause-button
              aria-label="Pause"
              title="Pause (Esc)"
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border-2 border-slate-900 bg-amber-300 [@media(pointer:coarse)]:h-10 [@media(pointer:coarse)]:w-10 text-slate-900 shadow-[0_2px_0_#020617] transition active:translate-y-0.5 active:shadow-none"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="currentColor"
                aria-hidden="true"
                ><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect
                  x="14"
                  y="5"
                  width="4"
                  height="14"
                  rx="1"></rect></svg
              >
            </button>
          </div>
          <div class="flex items-center justify-between gap-1 text-xs">
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-yellow-300"
                data-icon-level></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-level
                >1</span
              >
            </span>
            <span class="flex items-center gap-1.5">
              <span
