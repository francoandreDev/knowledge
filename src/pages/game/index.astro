  <style>
    .title-screen {
      --ts-ink: #0d0a24;
      --ts-bg: #17123a;
      --ts-line: #3a2f7a;
      position: relative;
      overflow: hidden;
      width: 100%;
      background: var(--ts-bg);
      color: #fff;
      border: 3px solid var(--ts-ink);
      border-radius: 28px;
      box-shadow: 8px 8px 0 var(--ts-ink);
      padding: 20px 24px 28px;
    }
    .ts-scan {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.16) 0 1px,
        transparent 1px 4px
      );
    }
    .ts-top,
    .ts-body {
      position: relative;
    }
    .ts-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 22px;
    }
    .ts-credits {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      background: var(--ts-ink);
      border: 3px solid #5a4ca8;
      border-radius: 12px;
      padding: 6px 16px;
      font-family: "Dela Gothic One", sans-serif;
      font-size: 17px;
      letter-spacing: 0.04em;
      color: #ffd447;
    }
    .ts-free {
      color: #43e0a0;
      animation: ts-blink 1.1s steps(1) infinite;
    }
    .ts-free.is-used {
      color: #8e83d9;
      animation: none;
    }
    .ts-tools {
      display: flex;
      gap: 8px;
    }
    .ts-tool {
      display: flex;
      height: 40px;
      width: 40px;
      align-items: center;
      justify-content: center;
      border: 2px solid #5a4ca8;
      border-radius: 12px;
      background: var(--ts-ink);
      color: #c9c2ff;
    }
    .ts-tool:hover {
      border-color: #ffd447;
      color: #fff;
    }
    .ts-body {
      display: grid;
      gap: 32px;
    }
    @media (min-width: 900px) {
      .ts-body {
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: 40px;
      }
    }
    .ts-left {
      display: flex;
      flex-direction: column;
      gap: 26px;
      min-width: 0;
      container-type: inline-size;
    }
    .ts-title {
      margin: 0;
      font-family: "Dela Gothic One", sans-serif;
      font-weight: 400;
      font-size: clamp(34px, 15.5cqw, 84px);
      line-height: 0.92;
      text-shadow: 5px 5px 0 #ff5d5d;
    }
    .ts-menu {
      display: flex;
      flex-direction: column;
      border-top: 2px dashed var(--ts-line);
    }
    .ts-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 14px;
      align-items: center;
      gap: 8px;
      min-height: 60px;
      padding: 6px 4px 6px 0;
      border: 0;
      border-bottom: 2px dashed var(--ts-line);
      background: transparent;
      color: #c9c2ff;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
    }
    .ts-row:hover,
    .ts-row:focus-visible {
      color: #fff;
      outline: none;
    }
    .ts-row:focus-visible {
      box-shadow: inset 0 0 0 3px #ffd447;
    }
    .ts-label {
      font-family: "Dela Gothic One", sans-serif;
      font-size: 26px;
      line-height: 1;
    }
    .ts-label-start {
      font-size: clamp(26px, 9cqw, 38px);
      white-space: nowrap;
      color: #ffd447;
    }
    .ts-start:disabled {
      cursor: not-allowed;
      opacity: 0.45;
    }
    .ts-tag {
      border: 2px solid var(--ts-ink);
      border-radius: 999px;
      padding: 3px 12px;
      font-size: 13px;
      font-weight: 800;
      color: var(--ts-ink);
      white-space: nowrap;
    }
    .ts-green {
      background: #43e0a0;
    }
    .ts-pink {
      background: #ff9bb0;
    }
    .ts-gold {
      background: #ffd447;
    }
    .ts-lilac {
      background: #c9c2ff;
    }
    .ts-ico {
      display: flex;
      height: 56px;
      width: 56px;
      align-items: center;
      justify-content: center;
      border: 3px solid var(--ts-ink);
      border-radius: 16px;
      box-shadow: 0 4px 0 var(--ts-ink);
      transition: transform 0.12s;
    }
    .ts-ico :global(svg) {
      width: 34px;
      height: 34px;
    }
    .ts-row:hover .ts-ico,
    .ts-row:focus-visible .ts-ico {
      transform: translateY(-3px) rotate(-4deg);
    }
    .ts-start .ts-ico {
      height: 68px;
      width: 68px;
    }
    .ts-start .ts-ico :global(svg) {
      width: 42px;
      height: 42px;
    }
    .ts-ico-sky {
      background: #5cc8ff;
    }
    .ts-ico-rose {
      background: #ff9bb0;
    }
    .ts-ico-lime {
      background: #b6f06a;
    }
    .ts-ico-gold {
      background: #ffd447;
    }
    .ts-ico-violet {
      background: #c9c2ff;
    }
    .panel-dialog {
      width: calc(100% - 24px);
      max-height: none;
      margin: auto;
      padding: 12px;
      overflow: visible;
      border: 0;
      background: transparent;
      color: #fff;
    }
    .panel-dialog::backdrop {
