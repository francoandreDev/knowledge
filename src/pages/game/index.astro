      // Populate the static (never-change) icon slots once — the HUD/lobby/
      // results markup carries empty <span data-icon-*> placeholders so the
      // .astro template doesn't need to embed raw SVG strings inline.
      function setIcon(selector: string, svg: string, size = "h-4 w-4") {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.innerHTML = sizedIcon(svg, size);
      }
      setIcon("[data-icon-tokens]", UI_ICON.tokens);
      setIcon("[data-icon-duration]", UI_ICON.timer);
      setIcon("[data-icon-best]", UI_ICON.trophy);
      setIcon("[data-icon-lobby-coins]", UI_ICON.coins);
      setIcon("[data-icon-play]", UI_ICON.play, "h-4 w-4");
      setIcon("[data-icon-hp]", UI_ICON.hp, "h-4 w-4");
      setIcon("[data-icon-timer]", UI_ICON.timer, "h-3.5 w-3.5");
      setIcon("[data-icon-level]", UI_ICON.level, "h-3.5 w-3.5");
      setIcon("[data-icon-kills]", UI_ICON.kills, "h-3.5 w-3.5");
      setIcon("[data-icon-gems]", UI_ICON.gems, "h-3.5 w-3.5");
      setIcon("[data-icon-coins]", UI_ICON.coins, "h-3.5 w-3.5");
      setIcon("[data-icon-threat]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-threat-toast]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-boss-toast]", UI_ICON.warning, "h-3.5 w-3.5");
      setIcon("[data-icon-synergy-toast]", UI_ICON.synergy, "h-3.5 w-3.5");
      setIcon("[data-icon-results-time]", UI_ICON.timer, "h-4 w-4");
      setIcon("[data-icon-results-kills]", UI_ICON.kills, "h-4 w-4");
      setIcon("[data-icon-results-level]", UI_ICON.level, "h-4 w-4");
      setIcon("[data-icon-results-coins]", UI_ICON.coins, "h-4 w-4");
      setIcon("[data-icon-record]", UI_ICON.trophy, "h-4 w-4");
      setIcon("[data-icon-back]", UI_ICON.back, "h-4 w-4");

      const WEAPON_LABEL: Record<string, string> = {
        bolt: "Bolt",
        homingDart: "Homing Dart",
        chainLightning: "Chain Lightning",
        novaPulse: "Nova Pulse",
        orbitShield: "Orbit Shield",
        bladeArc: "Blade Arc",
      };

      // Per-weapon totals and rates — kills and damage are what a weapon
      // earns, the enemy distance you picked is what it cost you.
      function trainingTable(
        weapons: { id: string; level: number; kills: number; damage: number }[],
        elapsedS: number,
      ): string {
        const minutes = Math.max(elapsedS, 1) / 60;
        const cell = "px-2 py-1 text-right tabular-nums";
        const rows = weapons
          .map(
            (w) => `<tr>
              <td class="px-2 py-1 text-left font-bold">${WEAPON_LABEL[w.id] ?? w.id} <span class="text-slate-500">L${w.level}</span></td>
              <td class="${cell}">${w.kills}</td>
              <td class="${cell}">${(w.kills / minutes).toFixed(1)}</td>
              <td class="${cell}">${w.damage}</td>
              <td class="${cell}">${(w.damage / Math.max(elapsedS, 1)).toFixed(1)}</td>
            </tr>`,
          )
          .join("");
        return `<table class="w-full text-xs">
          <thead class="text-slate-500"><tr>
            <th class="px-2 py-1 text-left font-medium">Weapon</th>
            <th class="px-2 py-1 text-right font-medium">Kills</th>
            <th class="px-2 py-1 text-right font-medium">Kills/min</th>
            <th class="px-2 py-1 text-right font-medium">Damage</th>
            <th class="px-2 py-1 text-right font-medium">Dmg/s</th>
          </tr></thead><tbody>${rows}</tbody></table>`;
      }

      // --- Duel (1v1) ---------------------------------------------------
      const duelArea = document.querySelector<HTMLElement>("[data-duel-area]")!;
      const duelCanvas =
        document.querySelector<HTMLCanvasElement>("[data-duel-canvas]")!;
      const duelResultsEl = document.querySelector<HTMLElement>(
        "[data-duel-results]",
      )!;
      let activeDuel: ReturnType<typeof startDuel> | null = null;
      const DUEL_RECORD_KEY = "duel:record";
      function readDuelRecord(): { w: number; l: number } {
        try {
          const raw = JSON.parse(localStorage.getItem(DUEL_RECORD_KEY) ?? "{}");
          return { w: Number(raw.w) || 0, l: Number(raw.l) || 0 };
        } catch {
          return { w: 0, l: 0 };
        }
      }
      function renderDuelRecord() {
        const r = readDuelRecord();
        const el = document.querySelector<HTMLElement>("[data-duel-record]");
        if (el) el.textContent = `${r.w} – ${r.l}`;
      }
      function stopDuel() {
        activeDuel?.stop();
        activeDuel = null;
        duelResultsEl.classList.add("hidden");
        duelResultsEl.classList.remove("flex");
        duelArea.classList.add("hidden");
        duelArea.classList.remove("flex");
      }
      function startDuelMatch() {
        unlockAudio();
        const pick = (q: string) =>
          document.querySelector<HTMLSelectElement>(q)!.value;
        const weaponId = pick("[data-duel-weapon]") as WeaponId;
        const rivalPick = pick("[data-duel-rival]");
        const others = DUEL_WEAPONS.filter((w) => w !== weaponId);
        const rivalWeaponId = (
          rivalPick === "mirror"
            ? weaponId
            : rivalPick === "different"
              ? others[Math.floor(Math.random() * others.length)]
              : rivalPick
        ) as WeaponId;
        const level = Number(pick("[data-duel-level]"));
        const difficulty = pick("[data-duel-difficulty]") as Difficulty;
        activeGame?.stop();
        activeGame = null;
        lobby!.classList.add("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        duelResultsEl.classList.add("hidden");
        duelResultsEl.classList.remove("flex");
        duelArea.classList.remove("hidden");
        duelArea.classList.add("flex");
        duelCanvas.parentElement!.style.setProperty(
          "--chrome",
          document.fullscreenElement ? "4.5rem" : "9rem",
        );
        activeDuel?.stop();
        activeDuel = startDuel(
          duelCanvas,
          {
            weaponId,
            level,
            rivalWeaponId,
            difficulty,
            renderScale: 2,
            reduceMotion: isReducedMotion(),
          },
          {
            onMatchEnd(summary) {
              const rec = readDuelRecord();
              if (summary.won) rec.w += 1;
              else rec.l += 1;
              try {
                localStorage.setItem(DUEL_RECORD_KEY, JSON.stringify(rec));
              } catch {
                /* storage can be unavailable; the record is a convenience */
              }
              const head = duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-headline]",
              )!;
              head.textContent = summary.won ? "Victory!" : "Defeated";
              head.className = head.className.replace(
                /bg-\S+/,
                summary.won ? "bg-yellow-300" : "bg-rose-300",
              );
              duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-rounds]",
              )!.innerHTML = summary.rounds
                .map((r, i) => {
                  const tone =
                    r.winner === 0
                      ? "bg-sky-300"
                      : r.winner === 1
                        ? "bg-rose-300"
                        : "bg-slate-300";
                  const what =
                    r.winner === 0 ? "Won" : r.winner === 1 ? "Lost" : "Draw";
                  return `<span class="rounded-lg border-2 border-slate-900 ${tone} px-[0.7em] py-[0.2em] text-[0.8em] font-black text-slate-900">R${i + 1} · ${what} · ${r.timeS}s</span>`;
                })
                .join("");
              duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-stats]",
              )!.textContent =
                `${WEAPON_NAME[weaponId]} L${level} vs ${WEAPON_NAME[rivalWeaponId]} · you dealt ${summary.damageDealt} damage and took ${summary.hitsTaken} hits`;
              duelResultsEl.classList.remove("hidden");
              duelResultsEl.classList.add("flex");
              renderDuelRecord();
            },
          },
        );
      }

      let shownLevel = 1;
      // Screen change cover: a sticker-coloured panel sweeps across, the
      // change happens behind it, then it sweeps off. Skipped with reduced
      // motion; a second click while one is running is ignored.
      let wiping = false;
      function wipeTo(change: () => void) {
        const wipeEl = document.querySelector<HTMLElement>("[data-wipe]");
        const panel = wipeEl?.firstElementChild as HTMLElement | undefined;
        if (!wipeEl || !panel || isReducedMotion()) {
          change();
          return;
        }
        if (wiping) return;
        wiping = true;
        wipeEl.classList.remove("hidden");
        panel.classList.remove("wipe-reveal");
        panel.classList.add("wipe-cover");
        setTimeout(() => {
          change();
          panel.classList.remove("wipe-cover");
          panel.classList.add("wipe-reveal");
          setTimeout(() => {
            wipeEl.classList.add("hidden");
            panel.classList.remove("wipe-reveal");
            wiping = false;
          }, 420);
        }, 340);
      }

      function showLobby() {
        stopDuel();
        trainingPanel!.classList.add("hidden");
        trainingPanel!.classList.remove("flex");
        lobby!.classList.remove("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        renderLobby();
      }

      // The lobby's hero backdrop: the player holds the right side while
      // enemies drift in and pop. Pure decoration; skipped when the lobby is
      // hidden, drawn once (still) with reduced motion.
      function startHeroStage(stage: HTMLCanvasElement) {
        const ctx = stage.getContext("2d");
        if (!ctx) return;
        const KINDS = [
          ["zombie", "#4ade80"],
          ["bat", "#f472b6"],
          ["skeleton", "#e2e8f0"],
          ["ghost", "#a5f3fc"],
          ["ogre", "#f97316"],
          ["slime", "#84cc16"],
          ["imp", "#f43f5e"],
          ["bomber", "#fbbf24"],
          ["knight", "#94a3b8"],
        ] as const;
        const foes: {
          kind: (typeof KINDS)[number][0];
          color: string;
          x: number;
          y: number;
          r: number;
        }[] = [];
        const particles: Particle[] = [];
        let w = 0;
        let h = 0;
        let last = performance.now();
        let spawnIn = 0;
        function resize() {
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          w = stage.clientWidth;
          h = stage.clientHeight;
          stage.width = Math.max(1, Math.round(w * dpr));
          stage.height = Math.max(1, Math.round(h * dpr));
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function spawn() {
          const [kind, color] = KINDS[Math.floor(Math.random() * KINDS.length)];
          foes.push({
            kind,
            color,
            x: Math.random() < 0.5 ? -30 : w + 30,
            y: h * (0.3 + Math.random() * 0.5),
            r: kind === "ogre" || kind === "knight" ? 22 : 15,
          });
        }
        function frame(now: number) {
          const dt = Math.min(64, now - last);
          last = now;
          if (stage.offsetParent !== null && w > 0) {
            draw(now, dt);
          }
          if (!isReducedMotion()) requestAnimationFrame(frame);
        }
        function draw(now: number, dt: number) {
          const px = w * 0.5;
          const heroR = Math.max(24, Math.min(56, h * 0.085));
          const py = h * 0.64;
          ctx!.clearRect(0, 0, w, h);
          // The ground the fight happens on.
          const groundY = h * 0.78;
          ctx!.fillStyle = "#1b1445";
          ctx!.fillRect(0, groundY, w, h - groundY);
          ctx!.strokeStyle = "#5a4ca8";
          ctx!.lineWidth = 3;
          ctx!.setLineDash([18, 12]);
          ctx!.beginPath();
          ctx!.moveTo(0, groundY);
          ctx!.lineTo(w, groundY);
          ctx!.stroke();
          ctx!.setLineDash([]);
          if (!isReducedMotion()) {
            spawnIn -= dt;
            if (spawnIn <= 0) {
              spawn();
              spawnIn = 700 + Math.random() * 600;
            }
          }
          for (let i = foes.length - 1; i >= 0; i--) {
            const f = foes[i];
            const dx = px - f.x;
            const dy = py - f.y;
            const d = Math.hypot(dx, dy) || 1;
            f.x += (dx / d) * 0.05 * dt;
            f.y += (dy / d) * 0.05 * dt;
            if (d < heroR * 2.4) {
              burst(particles, f.x, f.y, f.color, 9, 170);
              ringPop(particles, f.x, f.y, f.color, f.r * 2.6);
              foes.splice(i, 1);
            }
          }
          for (const f of foes)
            drawEnemy(ctx!, f.kind, f.x, f.y, f.r, f.color, {});
          drawGem(ctx!, w * 0.62, h * 0.8, 6, "#a78bfa");
          drawGem(ctx!, w * 0.9, h * 0.25, 6, "#a78bfa");
          const bob = isReducedMotion() ? 0 : Math.sin(now / 320) * 3;
          const a = now / 700;
          for (let k = 0; k < 2; k++) {
            const ang = a + k * Math.PI;
            const orbitR = heroR * 2.1;
            drawOrbiter(
              ctx!,
              px + Math.cos(ang) * orbitR,
              py + bob + Math.sin(ang) * orbitR,
              heroR * 0.36,
              ang,
            );
          }
          drawPlayer(ctx!, px, py + bob, heroR, "#38bdf8", Math.PI);
          stepParticles(particles, dt);
          drawParticles(ctx!, particles);
        }
        resize();
        window.addEventListener("resize", resize);
        if (isReducedMotion()) {
          for (let i = 0; i < 4; i++) spawn();
          for (const f of foes) f.x = w * (0.35 + Math.random() * 0.3);
        }
        requestAnimationFrame(frame);
      }

      function renderLobby() {
        const tokens = getTokenCount();
        const daily = dailyFreeAvailable();
        const duration = computeRunDurationS();
        const best = getBestTimeS();
        const balance = getCoinBalance();
        lobbyTokensEl!.textContent = String(tokens).padStart(2, "0");
        lobbyDurationEl!.textContent = `${duration} s`;
        lobbyBestEl!.textContent = best > 0 ? formatTime(best) : "--";
        lobbyCoinsEl!.textContent = String(balance);
        const coinsScore = document.querySelector<HTMLElement>(
          "[data-lobby-coins-score]",
        );
        if (coinsScore) coinsScore.textContent = String(balance);
        lobbyZeroMessage!.classList.toggle("hidden", tokens >= 1 || daily);
        startButton!.disabled = tokens < 1 && !daily;
        renderDailyChip(daily);
        renderMenuTags(tokens, daily, balance);
        renderShop();
        renderChests();
        renderRelics();
      }

      // The menu rows say what is waiting behind them.
      function renderMenuTags(tokens: number, daily: boolean, balance: number) {
        const setTag = (sel: string, text: string, on: boolean) => {
          const el = document.querySelector<HTMLElement>(sel);
          if (!el) return;
          el.textContent = text;
          el.style.opacity = on ? "1" : "0.55";
        };
        setTag(
          "[data-start-tag]",
          daily ? "free today" : tokens > 0 ? "uses a credit" : "no credits",
          daily || tokens > 0,
        );
        const buyable = UPGRADES.filter((u) => {
          const cost = upgradeCost(u.id);
          return cost !== null && balance >= cost;
        }).length;
        setTag(
          "[data-tag-upgrades]",
          buyable > 0 ? `${buyable} you can buy` : "nothing to buy yet",
          buyable > 0,
        );
        const chests = getChestCount("wooden") + getChestCount("golden");
        setTag(
          "[data-tag-chests]",
          chests > 0 ? `${chests} waiting` : "win a run for one",
          chests > 0,
        );
        setTag(
          "[data-tag-relics]",
          `${Object.keys(getRelicLevels()).length} of ${RELICS.length}`,
          true,
        );
        const stageChest =
          document.querySelector<HTMLElement>("[data-stage-chest]");
        if (stageChest) {
          stageChest.classList.toggle("hidden", chests < 1);
          stageChest.textContent =
            getChestCount("golden") > 0
              ? "Open your golden chest"
              : "Open your chest";
        }
        const bubble = document.querySelector<HTMLElement>(
          "[data-stage-bubble]",
        );
        if (bubble) {
          bubble.textContent = daily
            ? "Today's free run is ready. Finish a unit to make every run 30 s longer."
            : tokens > 0
              ? "Finish a unit to earn another credit and 30 s on every run."
              : "Out of credits. Finish a unit to earn one, or come back tomorrow.";
        }
      }

      // The free run renews at local midnight; the chip says which state it is in.
      function renderDailyChip(daily: boolean) {
        const chip = document.querySelector<HTMLElement>("[data-daily-chip]");
        if (!chip) return;
        chip.classList.toggle("is-used", !daily);
        chip.textContent = daily
          ? "+ 1 FREE"
          : `FREE RUN IN ${formatCountdown(msUntilReset()).toUpperCase()}`;
      }

      const RARITY_STYLE: Record<Rarity, { bg: string; label: string }> = {
        common: { bg: "bg-sky-200", label: "Common" },
        rare: { bg: "bg-violet-300", label: "Rare" },
        epic: { bg: "bg-fuchsia-300", label: "Epic" },
        legendary: { bg: "bg-amber-300", label: "Legendary" },
      };

      function renderChests() {
        const wrap = document.querySelector<HTMLElement>("[data-chest-rows]");
        if (!wrap) return;
        wrap.innerHTML = "";
        for (const tier of ["wooden", "golden"] as ChestTier[]) {
          const n = getChestCount(tier);
          const row = document.createElement("div");
          row.className = `flex items-center justify-between gap-2 rounded-xl border-2 border-slate-900 px-3 py-2 ${tier === "golden" ? "bg-amber-300" : "bg-orange-200"}`;
          const label = document.createElement("span");
          label.className = "flex items-center gap-2 text-sm font-extrabold";
          label.innerHTML = `${sizedIcon(UI_ICON.chest, "h-6 w-6")}<span>${tier === "golden" ? "Golden" : "Wooden"} chest</span><span class="rounded-full border-2 border-slate-900 bg-white px-2 text-xs tabular-nums">×${n}</span>`;
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = "Open";
          btn.disabled = n < 1;
          btn.className =
            "rounded-full border-2 border-slate-900 bg-white px-3 py-1 text-xs font-black shadow-[0_2px_0_#020617] active:translate-y-0.5 active:shadow-none disabled:cursor-not-allowed disabled:opacity-40";
          btn.addEventListener("click", () => showChestOpening(tier));
          row.append(label, btn);
          wrap.append(row);
        }
      }

      function renderRelics() {
        const grid = document.querySelector<HTMLElement>("[data-relic-grid]");
        const detail = document.querySelector<HTMLElement>(
          "[data-relic-detail]",
        );
        const count = document.querySelector<HTMLElement>("[data-relic-count]");
        if (!grid) return;
        const levels = getRelicLevels();
        const owned = Object.keys(levels).length;
        if (count) count.textContent = `${owned}/${RELICS.length}`;
        grid.innerHTML = "";
        for (const r of RELICS) {
          const level = levels[r.id] ?? 0;
          const cell = document.createElement("button");
          cell.type = "button";
          cell.className = level
            ? `relative flex aspect-square items-center justify-center rounded-xl border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] ${RARITY_STYLE[r.rarity].bg}`
            : "relative flex aspect-square items-center justify-center rounded-xl border-2 border-dashed border-slate-300 text-slate-300 dark:border-slate-700 dark:text-slate-700";
          cell.innerHTML = `${sizedIcon(RELIC_ICON[r.id] ?? "", "h-5 w-5")}${level ? `<span class="absolute -right-1 -bottom-1 rounded-full border-2 border-slate-900 bg-white px-1 text-[9px] leading-tight font-black tabular-nums">${level}</span>` : ""}`;
          cell.setAttribute(
            "aria-label",
            level ? `${r.name}, level ${level}` : "Not found yet",
          );
          cell.addEventListener("click", () => {
            if (!detail) return;
            detail.textContent = level
              ? `${r.name} · ${RARITY_STYLE[r.rarity].label} · Lv ${level}/${RELIC_MAX_LEVEL} — ${r.blurb}`
              : `${RARITY_STYLE[r.rarity].label} relic — not found yet. Open chests to find it.`;
          });
          grid.append(cell);
        }
      }

      // The chest: it shakes shut, then flips open onto what was inside.
      function showChestOpening(tier: ChestTier) {
        const modal = document.querySelector<HTMLElement>("[data-chest-modal]");
        const art = document.querySelector<HTMLElement>("[data-chest-art]");
        const reveal = document.querySelector<HTMLElement>(
          "[data-chest-reveal]",
        );
        const title = document.querySelector<HTMLElement>("[data-chest-title]");
        if (!modal || !art || !reveal || !title) return;
        const loot = openChest(tier);
        if (!loot) return;
        title.textContent = `${tier === "golden" ? "Golden" : "Wooden"} chest`;
        art.innerHTML = sizedIcon(UI_ICON.chest, "h-16 w-16");
        reveal.innerHTML = "";
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        const instant = isReducedMotion();
        if (!instant) {
          art.classList.remove("animate-shake");
          void art.offsetWidth;
          art.classList.add("animate-shake");
        }
        const show = () => {
          title.textContent = "Chest opened!";
          const coinsLine = document.createElement("div");
          coinsLine.className =
            "animate-fade-slide-in flex items-center justify-center gap-2 rounded-xl border-2 border-slate-900 bg-yellow-200 px-3 py-2 text-sm font-extrabold";
          coinsLine.innerHTML = `${sizedIcon(UI_ICON.coins, "h-5 w-5")}+${loot.coins} coins`;
          reveal.append(coinsLine);
          loot.finds.forEach((f, i) => {
            const def = relicById(f.relicId)!;
            const card = document.createElement("div");
            card.className = `animate-fade-slide-in flex items-center gap-3 rounded-xl border-2 border-slate-900 px-3 py-2 text-left ${RARITY_STYLE[def.rarity].bg}`;
            card.style.animationDelay = `${(i + 1) * (instant ? 0 : 220)}ms`;
            const badge = f.converted
              ? "MAXED → coins"
              : f.isNew
                ? "NEW!"
                : `Lv ${f.level}/${RELIC_MAX_LEVEL}`;
            card.innerHTML = `<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border-2 border-slate-900 bg-white">${sizedIcon(RELIC_ICON[def.id] ?? "", "h-6 w-6")}</span><span class="flex flex-col"><span class="text-sm font-black">${def.name} <span class="ml-1 rounded-full border-2 border-slate-900 bg-white px-1.5 text-[10px]">${badge}</span></span><span class="text-xs font-semibold">${RARITY_STYLE[def.rarity].label} · ${def.blurb}</span></span>`;
            reveal.append(card);
          });
          renderLobby();
        };
        if (instant) show();
        else setTimeout(show, 650);
      }

      document
        .querySelector<HTMLElement>("[data-chest-close]")
        ?.addEventListener("click", () => {
          const modal =
            document.querySelector<HTMLElement>("[data-chest-modal]");
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
        });

      function renderShop() {
        const balance = getCoinBalance();
        shopRowsEl!.innerHTML = "";
        for (const def of UPGRADES) {
          const level = getUpgradeLevel(def.id);
          const cost = upgradeCost(def.id);
          const affordable = cost !== null && balance >= cost;
          const row = document.createElement("div");
          // Colour only shows up on a row you can actually act on — maxed
          // or unaffordable rows fall back to flat neutral, same rule as
          // the buy button below, so "tinted" reliably means "actionable".
          const maxed = cost === null;
          row.className = maxed
            ? "animate-fade-slide-in flex flex-col gap-2 rounded-xl border-2 border-amber-300 bg-amber-50/70 p-3 text-sm dark:border-amber-800/60 dark:bg-amber-500/5"
            : affordable
              ? "animate-fade-slide-in flex flex-col gap-2 rounded-xl border-2 border-sky-400 bg-sky-50/70 p-3 text-sm transition dark:border-sky-700 dark:bg-sky-500/10"
              : "animate-fade-slide-in flex flex-col gap-2 rounded-xl border-2 border-slate-200 p-3 text-sm transition dark:border-slate-800";
          const iconBadge = document.createElement("span");
          iconBadge.className = `flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${badgeClass(def.id)}`;
          iconBadge.innerHTML = sizedIcon(
            UPGRADE_ICON[def.id] ?? "",
            "h-4 w-4",
          );
          const head = document.createElement("div");
          head.className = "flex items-center gap-2.5";
          const pips = Array.from(
            { length: def.maxLevel },
            (_, i) =>
              `<span class="h-2 flex-1 rounded-full ${i < level ? (maxed ? "bg-amber-400" : "bg-sky-500") : "bg-slate-200 dark:bg-slate-700"}"></span>`,
          ).join("");
          const info = document.createElement("div");
          info.className = "min-w-0 flex-1 leading-tight";
          info.innerHTML = `
            <span class="block font-bold">${def.label}</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">${def.effectLabel}</span>
          `;
          const tag = document.createElement("span");
          tag.className = maxed
            ? "shrink-0 rounded-full border-2 border-amber-700 bg-amber-300 px-2 text-[10px] leading-5 font-black text-amber-950"
            : "shrink-0 text-xs font-bold tabular-nums text-slate-500 dark:text-slate-400";
          tag.textContent = maxed ? "MAX" : `${level}/${def.maxLevel}`;
          head.append(iconBadge, info, tag);
          const bar = document.createElement("div");
          bar.className = "flex gap-1";
          bar.innerHTML = pips;
          row.append(head, bar);
          if (!maxed) {
            const buyButton = document.createElement("button");
            buyButton.type = "button";
            buyButton.className = affordable
              ? "w-full rounded-lg border-2 border-amber-800 bg-amber-400 px-3 py-1.5 text-sm font-extrabold text-slate-900 shadow-[0_3px_0_#92400e] transition hover:brightness-110 active:translate-y-0.5 active:shadow-none"
              : "w-full rounded-lg border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = `Buy · ${cost}`;
            buyButton.disabled = !affordable;
            buyButton.addEventListener("click", () => {
              if (purchaseUpgrade(def.id)) {
                log.log("shop:purchase", { id: def.id });
                renderLobby();
              }
            });
            row.append(buyButton);
          }
          shopRowsEl!.appendChild(row);
        }
        renderUnlocks();
      }

      // Phase 15: one-time unlock rows (Chain Lightning, Necromancy) —
      // structurally similar to the leveled UPGRADES rows above, but no
      // progress bar (nothing to level, it's owned or not) and the button
      // reads "Owned" (disabled) once purchased instead of "MAX".
      const UNLOCK_ICON: Record<string, string> = {
        chainLightning: WEAPON_ICON.chainLightning,
        necromancy: UI_ICON.necromancy,
      };
      function renderUnlocks() {
        const balance = getCoinBalance();
        shopUnlockRowsEl!.innerHTML = "";
        for (const def of UNLOCKS) {
          const owned = isUnlocked(def.id);
          const affordable = !owned && balance >= def.cost;
          const row = document.createElement("div");
          row.className = affordable
            ? "animate-fade-slide-in flex items-center gap-3 rounded-lg border border-fuchsia-200 bg-fuchsia-50/60 px-2.5 py-2 text-sm transition dark:border-fuchsia-900 dark:bg-fuchsia-500/5"
            : "animate-fade-slide-in flex items-center gap-3 rounded-lg border border-slate-200 px-2.5 py-2 text-sm transition dark:border-slate-800";
          const iconBadge = document.createElement("span");
          iconBadge.className = owned
            ? `flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${badgeClass(undefined, "bg-fuchsia-300")}`
            : "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300 bg-slate-100 text-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500";
          iconBadge.innerHTML = sizedIcon(
            owned ? (UNLOCK_ICON[def.id] ?? "") : UI_ICON.lock,
            "h-4 w-4",
          );
          const info = document.createElement("div");
          info.className = "min-w-0 flex-1";
          info.innerHTML = `
            <div class="flex items-center justify-between gap-2">
              <span class="font-medium">${def.label}</span>
              <span class="shrink-0 text-xs ${owned ? "text-fuchsia-600 dark:text-fuchsia-400" : "text-slate-500 dark:text-slate-400"}">${owned ? "Owned" : "Locked"}</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${def.effectLabel}</p>
          `;
          const buyButton = document.createElement("button");
          buyButton.type = "button";
          if (owned) {
            buyButton.className =
              "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = "Owned";
            buyButton.disabled = true;
          } else {
            buyButton.className = affordable
              ? "shrink-0 rounded-xl border-2 border-amber-800 bg-amber-400 px-3 py-1.5 text-sm font-extrabold text-slate-900 shadow-[0_3px_0_#92400e] transition hover:brightness-110"
              : "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = `Buy · ${def.cost}`;
            buyButton.disabled = !affordable;
            buyButton.addEventListener("click", () => {
              if (purchaseUnlock(def.id)) {
                log.log("shop:unlock", { id: def.id });
                renderLobby();
              }
            });
          }
          row.append(iconBadge, info, buyButton);
          shopUnlockRowsEl!.appendChild(row);
        }
      }

      // A toggle button holding a non-default state (muted, reduced motion)
      // fills with the accent instead of only swapping its icon glyph —
      // otherwise "engaged" only shows up in the tooltip. Shop/fullscreen
      // don't call this: they open something rather than hold a state.
      function setToggleEngaged(button: HTMLButtonElement, engaged: boolean) {
        button.classList.toggle("border-slate-300", !engaged);
        button.classList.toggle("dark:border-slate-700", !engaged);
        button.classList.toggle("border-[var(--accent)]", engaged);
        button.style.background = engaged ? "var(--accent-soft-bg)" : "";
        button.style.color = engaged ? "var(--accent-text)" : "";
      }

      function renderMute() {
        const muted = isMuted();
        muteToggle!.innerHTML = sizedIcon(
          muted ? UI_ICON.soundOff : UI_ICON.soundOn,
          "h-4 w-4",
        );
        muteToggle!.title = muted ? "Sound off" : "Sound on";
        setToggleEngaged(muteToggle!, muted);
      }

      function renderMotion() {
        const reduced = isReducedMotion();
        motionToggle!.innerHTML = sizedIcon(
          reduced ? UI_ICON.motionOff : UI_ICON.motionOn,
          "h-4 w-4",
        );
        motionToggle!.title = reduced
          ? "Visual effects off"
          : "Visual effects on";
        setToggleEngaged(motionToggle!, reduced);
      }

      function renderFullscreen() {
        const isFs = document.fullscreenElement === gameRoot;
        fullscreenToggle!.innerHTML = sizedIcon(
          isFs ? UI_ICON.minimize : UI_ICON.maximize,
          "h-4 w-4",
        );
        fullscreenToggle!.title = isFs ? "Exit fullscreen" : "Fullscreen";
        canvas!.parentElement!.style.setProperty(
          "--chrome",
          isFs ? "4.5rem" : "9rem",
        );
        document
          .querySelector<HTMLElement>("[data-duel-canvas]")
          ?.parentElement?.style.setProperty(
            "--chrome",
            isFs ? "4.5rem" : "9rem",
          );
        gameRoot!.classList.toggle("max-w-none", isFs);
        gameRoot!.classList.toggle("h-screen", isFs);
        gameRoot!.classList.toggle("justify-center", isFs);
        gameRoot!.classList.toggle("bg-white", isFs);
        gameRoot!.classList.toggle("dark:bg-slate-950", isFs);
        gameRoot!.classList.toggle("p-4", isFs);
      }

      // Phase 13: brief "difficulty rising" banner, fired once per threat
      // tier crossed (engine.ts's onThreatTierUp). Re-triggerable per the
      // project's remove/reflow/re-add pattern for repeat one-shot CSS
      // animations (see CLAUDE.md's "Micro-interactions and animation").
      let threatToastTimeout: number | undefined;
      function showThreatToast(tier: number) {
        threatToastTextEl!.textContent = `Threat rising — tier ${tier}`;
        threatToastEl!.classList.remove("hidden");
        threatToastEl!.classList.add("flex");
        threatToastEl!.classList.remove("animate-fade-slide-in");
        void threatToastEl!.offsetWidth;
        threatToastEl!.classList.add("animate-fade-slide-in");
        const threatToastBar = threatToastEl!.querySelector<HTMLElement>(
          "[data-threat-toast-bar]",
        );
        threatToastBar?.classList.remove("animate-toast-timer");
        void threatToastBar?.offsetWidth;
        threatToastBar?.classList.add("animate-toast-timer");
        if (threatToastTimeout) window.clearTimeout(threatToastTimeout);
        threatToastTimeout = window.setTimeout(() => {
          threatToastEl!.classList.add("hidden");
          threatToastEl!.classList.remove("flex");
        }, 2200);
      }

      // Phase 14: boss telegraph banner, fired once via engine.ts's
      // onBossIncoming — same re-triggerable animation pattern as the
      // threat toast above.
      let bossToastTimeout: number | undefined;
      // Run rating: a third of the run per star, so even a short run earns one.
      function starsFor(survivedS: number, durationS: number) {
        const f = survivedS / Math.max(1, durationS);
        return f >= 0.98 ? 3 : f >= 0.66 ? 2 : f >= 0.33 ? 1 : 0;
      }
      function renderStars(earned: number) {
        const el = document.querySelector<HTMLElement>("[data-results-stars]")!;
        el.innerHTML = "";
        if (earned < 0) return;
        for (let i = 0; i < 3; i++) {
          const on = i < earned;
          const size = i === 1 ? 44 : 34;
          const star = document.createElement("span");
          star.className = "animate-fade-slide-in";
          star.style.animationDelay = `${i * 200}ms`;
          star.style.animationFillMode = "backwards";
          star.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${on ? "#fde047" : "#e2e8f0"}" stroke="#0f172a" stroke-width="2" stroke-linejoin="round"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>`;
          el.appendChild(star);
        }
      }
      // Stats tick up to their value; the final write is guaranteed even if
      // the tab throttles timers.
      function countUp(el: HTMLElement, to: number) {
        const steps = 14;
        let i = 0;
        el.textContent = "0";
        const timer = window.setInterval(() => {
          i += 1;
          el.textContent = String(Math.round((to * i) / steps));
          if (i >= steps) window.clearInterval(timer);
        }, 45);
        window.setTimeout(
          () => (el.textContent = String(to)),
          45 * steps + 100,
        );
      }

      function showBossToast() {
        bossToastEl!.classList.remove("hidden");
        bossToastEl!.classList.add("flex");
        bossToastEl!.classList.remove("animate-fade-slide-in");
        void bossToastEl!.offsetWidth;
        bossToastEl!.classList.add("animate-fade-slide-in");
        const bossToastBar = bossToastEl!.querySelector<HTMLElement>(
          "[data-boss-toast-bar]",
        );
        bossToastBar?.classList.remove("animate-toast-timer");
        void bossToastBar?.offsetWidth;
        bossToastBar?.classList.add("animate-toast-timer");
        if (bossToastTimeout) window.clearTimeout(bossToastTimeout);
        bossToastTimeout = window.setTimeout(() => {
          bossToastEl!.classList.add("hidden");
          bossToastEl!.classList.remove("flex");
        }, 3200);
      }

      // Phase 16: synergy discovery banner, fired once per named synergy via
      // engine.ts's onSynergyTriggered — same re-triggerable animation
      // pattern as the threat/boss toasts above.
      let synergyToastTimeout: number | undefined;
      function showSynergyToast(name: string) {
        synergyToastTextEl!.textContent = `Synergy — ${name}!`;
        synergyToastEl!.classList.remove("hidden");
        synergyToastEl!.classList.add("flex");
        synergyToastEl!.classList.remove("animate-fade-slide-in");
        void synergyToastEl!.offsetWidth;
        synergyToastEl!.classList.add("animate-fade-slide-in");
        const synergyToastBar = synergyToastEl!.querySelector<HTMLElement>(
          "[data-synergy-toast-bar]",
        );
        synergyToastBar?.classList.remove("animate-toast-timer");
        void synergyToastBar?.offsetWidth;
        synergyToastBar?.classList.add("animate-toast-timer");
        if (synergyToastTimeout) window.clearTimeout(synergyToastTimeout);
        synergyToastTimeout = window.setTimeout(() => {
          synergyToastEl!.classList.add("hidden");
          synergyToastEl!.classList.remove("flex");
        }, 2600);
      }

      // Phase 14: low-HP pulsing vignette — only animates when reduceMotion
      // is off, matching the canvas glow/idle-bob gating elsewhere.
      function setLowHp(active: boolean) {
        lowHpVignetteEl!.classList.toggle("hidden", !active);
        lowHpVignetteEl!.classList.toggle(
          "animate-pulse-warn",
          active && !isReducedMotion(),
        );
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";
      backToLobbyButton.dataset.wired = "true";
      muteToggle.dataset.wired = "true";
      motionToggle.dataset.wired = "true";
      fullscreenToggle.dataset.wired = "true";

      renderMute();
      muteToggle.addEventListener("click", () => {
        toggleMuted();
        renderMute();
      });

      renderMotion();
      motionToggle.addEventListener("click", () => {
        toggleReducedMotion();
        renderMotion();
      });

      const heroStage =
        document.querySelector<HTMLCanvasElement>("[data-hero-stage]");
      if (heroStage) startHeroStage(heroStage);

      renderFullscreen();
      fullscreenToggle.addEventListener("click", () => {
        if (document.fullscreenElement) {
          document.exitFullscreen?.();
        } else {
          gameRoot!.requestFullscreen?.();
        }
      });
      document.addEventListener("fullscreenchange", renderFullscreen);

      let activeGame: ReturnType<typeof startGame> | null = null;

      let activeTraining: TrainingOptions | null = null;
      let lastTrainingHtml = "";

      const launch = (training: TrainingOptions | null) => {
        unlockAudio();
        activeTraining = training;
        // Today's free run goes first, so earned tokens keep for later.
        if (!training && !consumeDailyFree() && !consumeToken()) {
          log.warn("start clicked with 0 tokens — should have been disabled");
          renderLobby();
          return;
        }
        log.log("start button clicked", { training });
        trainingPanel!.classList.toggle("hidden", !training);
        trainingPanel!.classList.toggle("flex", !!training);
        resultsTraining!.classList.add("hidden");
        resultsStats!.classList.remove("hidden");
        if (training) {
          trainingMeta!.textContent = `Enemies keep ${training.standoffPx} px away · drain ${training.drainPerS} HP/s · a full recovery build regenerates ${maxRecoveryHps()} HP/s`;
        }
        levelUpOverlay!.classList.add("hidden");
        levelUpOverlay!.classList.remove("flex");
        threatToastEl!.classList.add("hidden");
        threatToastEl!.classList.remove("flex");
        bossToastEl!.classList.add("hidden");
        bossToastEl!.classList.remove("flex");
        synergyToastEl!.classList.add("hidden");
        synergyToastEl!.classList.remove("flex");
        setLowHp(false);
        lobby!.classList.add("hidden");
        playArea!.classList.remove("hidden");
        playArea!.classList.add("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");

        const durationS = training ? 120 : computeRunDurationS();
        const upgradeEffects = getUpgradeEffects();
        const powerIndex = computePowerIndex();
        // Phase 15: shop unlocks that expand this run's available content —
        // see engine.ts's GameOptions.unlockedWeaponIds/abilityUnlocked.
        const unlockedWeaponIds: WeaponId[] = isUnlocked("chainLightning")
          ? ["chainLightning"]
          : [];
        const abilityUnlocked = isUnlocked("necromancy");
        // Phase 16C: "Vampiric Might" needs the shop's raw Might level, not
        // just its aggregated damage-multiplier effect.
        const mightLevel = getUpgradeLevel("might");
        // The field is as wide as the window allows (the world keeps its 500 px
        // height), so a wide screen shows more map instead of black bars. The
        // lab keeps the classic 420 px so its numbers stay comparable.
        const chromePx = document.fullscreenElement ? 72 : 144;
        const aspect = training
          ? 0.84
          : Math.min(
              1.5,
              Math.max(
                0.84,
                playArea!.clientWidth /
                  Math.max(300, window.innerHeight - chromePx),
              ),
            );
        const worldW = Math.round(500 * aspect);
        canvas!.width = worldW * 2;
        canvas!.height = 1000;
        canvas!.style.aspectRatio = `${worldW} / 500`;
        canvas!.parentElement!.style.setProperty(
          "--aspect",
          String(worldW / 500),
        );
        activeGame?.stop();
        shownLevel = 1;
        activeGame = startGame(
          canvas,
          {
            onHudUpdate(state) {
              hpEl.textContent = `${Math.round(state.hp)}/${Math.round(state.maxHp)}`;
              hpBarEl.style.width = `${Math.max(0, Math.min(100, (state.hp / state.maxHp) * 100))}%`;
              timerEl.textContent = `${state.timeRemaining.toFixed(1)}s`;
              timerEl.classList.toggle(
                "animate-timer-urgent",
                state.timeRemaining <= 30 && state.timeRemaining > 0,
              );
              killsEl.textContent = String(state.kills);
              gemsEl.textContent = String(state.gems);
              coinsEl.textContent = String(state.coins);
              if (state.level > shownLevel) {
                shownLevel = state.level;
                for (const el of [xpBarEl.parentElement!, levelEl]) {
                  el.classList.remove("animate-xp-pop");
                  void el.offsetWidth;
                  el.classList.add("animate-xp-pop");
                }
              }
              levelEl.textContent = String(state.level);
              threatEl.textContent = String(state.threatTier);
              setLowHp(state.lowHp);
              xpBarEl.style.width = `${Math.max(0, Math.min(100, (state.xp / state.xpToNext) * 100))}%`;
              weaponsEl.innerHTML = state.weapons
                .map(
                  (w) => `
                <span class="inline-flex items-center gap-1 rounded-full border-2 border-slate-900 bg-sky-300 px-1.5 py-0.5 text-xs font-bold text-slate-900 shadow-[0_2px_0_#020617]">
                  <span>${sizedIcon(WEAPON_ICON[w.id] ?? "", "h-3 w-3")}</span>
                  <span>L${w.level}</span>
                  <span class="inline-flex items-center gap-0.5 opacity-70">${sizedIcon(UI_ICON.kills, "h-3 w-3")}${w.kills}</span>
                </span>`,
                )
                .join("");
              if (activeTraining) {
                lastTrainingHtml = trainingTable(state.weapons, state.elapsedS);
                trainingRows.innerHTML = lastTrainingHtml;
                trainingMeta.textContent = `Enemies keep ${activeTraining.standoffPx} px away · drain ${activeTraining.drainPerS} HP/s · regen ${state.regenPerS.toFixed(1)} HP/s (a full build reaches ${maxRecoveryHps()})`;
              }
            },
            onThreatTierUp(tier) {
              log.log("onThreatTierUp callback", { tier });
              showThreatToast(tier);
            },
            onBossIncoming() {
              log.log("onBossIncoming callback");
              showBossToast();
            },
            onSynergyTriggered(name) {
              log.log("onSynergyTriggered callback", { name });
              showSynergyToast(name);
            },
            onGameOver(summary) {
              log.log("onGameOver callback", summary);
              const isRecord = activeTraining
                ? false
                : recordRunResult(summary.survivedS);
              if (!activeTraining) addCoins(summary.coinsEarned);
              if (activeTraining) {
                resultsTraining.innerHTML = lastTrainingHtml;
                resultsTraining.classList.remove("hidden");
                resultsStats.classList.add("hidden");
              }
              setLowHp(false);
              resultsHeadline.textContent = activeTraining
                ? "Training finished"
                : `Survived ${formatTime(summary.survivedS)}`;
              resultsCause.textContent = summary.cause;
              resultsTime.textContent = formatTime(summary.survivedS);
              countUp(resultsKills, summary.kills);
              countUp(resultsLevel, summary.level);
              countUp(resultsCoins, summary.coinsEarned);
              renderStars(
                activeTraining ? -1 : starsFor(summary.survivedS, durationS),
              );
              resultsRecord.classList.toggle("hidden", !isRecord);
              // Surviving the whole run wins a chest — golden if the boss fell.
              const chestBox = document.querySelector<HTMLElement>(
                "[data-results-chest]",
              );
              if (chestBox) {
                const earned = !activeTraining && summary.won;
                chestBox.classList.toggle("hidden", !earned);
                chestBox.classList.toggle("flex", earned);
                if (earned) {
                  const tier: ChestTier = summary.bossDefeated
                    ? "golden"
                    : "wooden";
                  grantChest(tier);
                  chestBox.querySelector<HTMLElement>(
                    "[data-results-chest-icon]",
                  )!.innerHTML = sizedIcon(UI_ICON.chest, "h-7 w-7");
                  chestBox.querySelector<HTMLElement>(
                    "[data-results-chest-text]",
                  )!.textContent =
                    tier === "golden"
                      ? "Golden chest — you beat the boss!"
                      : "Wooden chest earned";
                  const openBtn = chestBox.querySelector<HTMLButtonElement>(
                    "[data-results-chest-open]",
                  )!;
                  openBtn.onclick = () => {
                    showChestOpening(tier);
                    chestBox.classList.add("hidden");
                    chestBox.classList.remove("flex");
                  };
                }
              }
              playArea!.classList.add("hidden");
              playArea!.classList.remove("flex");
              results!.classList.remove("hidden");
              results!.classList.add("flex");
            },
            onLevelUp(cards, choose) {
              log.log("onLevelUp callback", cards);
              levelUpCardsEl.innerHTML = "";
              let chosen = false;
              for (const card of cards) {
                const btn = document.createElement("button");
                btn.type = "button";
                // Accent by card kind — evolution cards (Lv6) get their
                // own gold treatment regardless of kind, since reaching
                // one is the rarer/bigger moment of the three.
                const kind = card.isEvolution
                  ? {
                      bg: "bg-amber-200",
                      tag: "EVOLUTION",
                      tagBg: "bg-amber-400",
                    }
                  : card.kind === "newWeapon"
                    ? {
                        bg: "bg-emerald-200",
                        tag: "NEW WEAPON",
                        tagBg: "bg-emerald-400",
                      }
                    : card.kind === "stat"
                      ? {
                          bg: "bg-violet-200",
                          tag: "BOOST",
                          tagBg: "bg-violet-400",
                        }
                      : card.kind === "ability"
                        ? {
                            bg: "bg-fuchsia-200",
                            tag: "ABILITY",
                            tagBg: "bg-fuchsia-400",
                          }
                        : {
                            bg: "bg-sky-200",
                            tag: "UPGRADE",
                            tagBg: "bg-sky-400",
                          };
                const iconBg = card.isEvolution
                  ? badgeClass(undefined, "bg-amber-300")
                  : card.kind === "newWeapon"
                    ? badgeClass(undefined, "bg-emerald-300")
                    : card.kind === "stat"
                      ? badgeClass(card.statId, "bg-violet-300")
                      : card.kind === "ability"
                        ? badgeClass(undefined, "bg-fuchsia-300")
                        : badgeClass(undefined, "bg-sky-300");
                const icon =
                  card.kind === "stat"
                    ? (STAT_ICON[card.statId ?? ""] ?? "")
                    : card.kind === "ability"
                      ? UI_ICON.necromancy
                      : (WEAPON_ICON[card.weaponId ?? "bolt"] ?? "");
                const i = levelUpCardsEl.children.length;
                btn.className = `animate-fade-slide-in w-full rounded-xl border-2 border-slate-900 ${kind.bg} px-[0.9em] py-[0.7em] text-left text-[1em] text-slate-900 shadow-[0_4px_0_#020617] transition-transform hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-[0_1px_0_#020617] ${card.isEvolution ? "ring-4 ring-amber-300/60" : ""}`;
                btn.style.animationDelay = `${i * 90}ms`;
                btn.style.animationFillMode = "backwards";
                btn.innerHTML = `
                  <span class="flex items-center gap-[0.8em]">
                    <span class="flex h-[2.8em] w-[2.8em] shrink-0 items-center justify-center rounded-xl ${iconBg}">
                      ${sizedIcon(icon, "h-[1.4em] w-[1.4em]")}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center gap-1.5">
                        <span class="font-extrabold">${card.title}</span>
                        <span class="rounded-full border-2 border-slate-900 ${kind.tagBg} px-1.5 text-[0.6em] leading-[1.6] font-black tracking-wide">${kind.tag}</span>
                        ${
                          card.isEvolution
                            ? `<span>${sizedIcon(EVOLUTION_ICON, "h-3.5 w-3.5")}</span>`
                            : ""
                        }
                      </span>
                      <span class="block text-[0.8em] font-medium text-slate-700">${card.description}</span>
                    </span>
                  </span>
                `;
                btn.addEventListener("click", () => {
                  if (chosen) return;
                  chosen = true;
                  log.log("levelup card chosen", card.id);
                  levelUpOverlay!.classList.add("hidden");
                  levelUpOverlay!.classList.remove("flex");
                  choose(card.id);
                });
                levelUpCardsEl.appendChild(btn);
              }
              levelUpOverlay!.classList.remove("hidden");
              levelUpOverlay!.classList.add("flex");
            },
          },
          {
            durationS,
            renderScale: 2,
            upgradeEffects,
            powerIndex,
            reduceMotion: isReducedMotion(),
            unlockedWeaponIds,
            abilityUnlocked,
            mightLevel,
            training: training ?? undefined,
          },
        );
      };

      startButton.addEventListener("click", () => wipeTo(() => launch(null)));
      trainingStart.addEventListener("click", () => {
        wipeTo(() =>
          launch({
            weaponId: trainingSelect("weapon")!
              .value as TrainingOptions["weaponId"],
            weaponLevel: Number(trainingSelect("level")!.value),
            standoffPx: Number(trainingSelect("standoff")!.value),
            drainPerS: Number(trainingSelect("drain")!.value),
          }),
        );
      });
      trainingStop.addEventListener("click", () => {
        wipeTo(() => {
          activeGame?.stop();
          activeGame = null;
          showLobby();
        });
      });

      document
        .querySelector("[data-duel-start]")!
        .addEventListener("click", () => wipeTo(startDuelMatch));
      document
        .querySelector("[data-duel-again]")!
        .addEventListener("click", () => wipeTo(startDuelMatch));
      for (const q of ["[data-duel-quit]", "[data-duel-leave]"]) {
        document
          .querySelector(q)!
          .addEventListener("click", () => wipeTo(showLobby));
      }
      renderDuelRecord();
      backToLobbyButton.addEventListener("click", () => {
        wipeTo(() => {
          activeGame?.stop();
          activeGame = null;
          showLobby();
        });
      });

      showLobby();
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
