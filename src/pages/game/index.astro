---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Game"
  description="Phase 1-2 prototype of the in-site study-reward game."
>
  <div class="mx-auto flex max-w-lg flex-col items-center gap-4">
    <h1 class="text-xl font-semibold">Game (Phase 1-2 prototype)</h1>
    <p class="text-center text-sm text-slate-600 dark:text-slate-400">
      WASD / arrow keys to move. Auto-fires at the nearest enemy. Full enemy
      roster + a boss near the end. Fixed 90-second test run — not yet gated by
      tokens (see <code>docs/GAME-PROGRESS.md</code>).
    </p>

    <div
      class="sticky top-14 z-[5] flex w-full items-center justify-between rounded-lg border border-slate-200 bg-white/95 px-3 py-2 text-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95"
    >
      <span data-hud-hp>HP: --/--</span>
      <span data-hud-timer>Time: --</span>
      <span data-hud-kills>Kills: 0</span>
      <span data-hud-gems>Gems: 0</span>
    </div>

    <canvas
      data-game-canvas
      width="420"
      height="500"
      style="aspect-ratio: 420 / 500;"
      class="h-[min(58vh,500px)] w-auto rounded-lg border border-slate-300 bg-slate-900 dark:border-slate-700"
    ></canvas>

    <div
      data-game-over
      class="hidden w-full rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 text-center text-sm dark:border-emerald-800 dark:bg-emerald-950"
    >
    </div>

    <button
      type="button"
      data-start-button
      class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
    >
      Start run
    </button>
  </div>

  <script>
    import { startGame } from "../../lib/game/engine";
    import { createLogger } from "../../lib/game/logger";

    const log = createLogger("page");

    function init() {
      const canvas =
        document.querySelector<HTMLCanvasElement>("[data-game-canvas]");
      const startButton = document.querySelector<HTMLButtonElement>(
        "[data-start-button]",
      );
      const hpEl = document.querySelector<HTMLElement>("[data-hud-hp]");
      const timerEl = document.querySelector<HTMLElement>("[data-hud-timer]");
      const killsEl = document.querySelector<HTMLElement>("[data-hud-kills]");
      const gemsEl = document.querySelector<HTMLElement>("[data-hud-gems]");
      const gameOverEl =
        document.querySelector<HTMLElement>("[data-game-over]");
      if (
        !canvas ||
        !startButton ||
        !hpEl ||
        !timerEl ||
        !killsEl ||
        !gemsEl ||
        !gameOverEl
      ) {
        log.error("missing expected DOM nodes, aborting init");
        return;
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";

      let activeGame: ReturnType<typeof startGame> | null = null;

      startButton.addEventListener("click", () => {
        log.log("start button clicked");
        gameOverEl.classList.add("hidden");
        startButton.disabled = true;
        activeGame?.stop();
        activeGame = startGame(canvas, {
          onHudUpdate(state) {
            hpEl.textContent = `HP: ${Math.round(state.hp)}/${state.maxHp}`;
            timerEl.textContent = `Time: ${state.timeRemaining.toFixed(1)}s`;
            killsEl.textContent = `Kills: ${state.kills}`;
            gemsEl.textContent = `Gems: ${state.gems}`;
          },
          onGameOver(summary) {
            log.log("onGameOver callback", summary);
            startButton.disabled = false;
            gameOverEl.classList.remove("hidden");
            gameOverEl.textContent = `Run ended — survived ${summary.survivedS.toFixed(
              1,
            )}s, ${summary.kills} kills.`;
          },
        });
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
