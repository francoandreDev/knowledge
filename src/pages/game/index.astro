---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Game"
  description="An in-site survival game, earned by making real progress on the curriculum."
>
  <div
    data-game-root
    class="relative mx-auto flex w-full max-w-3xl flex-col items-center gap-4"
  >
    <div class="flex w-full items-center justify-between">
      <h1 class="text-xl font-semibold">Game</h1>
      <button
        type="button"
        data-fullscreen-toggle
        title="Fullscreen"
        aria-label="Toggle fullscreen"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      ></button>
    </div>

    <div data-lobby class="flex w-full flex-col gap-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-500 dark:text-slate-400">
          WASD or drag to move — weapons auto-fire.
        </p>
        <div class="flex items-center gap-2">
          <button
            type="button"
            data-mute-toggle
            title="Sound"
            aria-label="Toggle sound"
            class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-slate-300 shadow-[0_3px_0_#cbd5e1] transition hover:border-slate-900 dark:border-slate-700 dark:shadow-[0_3px_0_#334155] dark:hover:border-slate-300"
          >
          </button>
          <button
            type="button"
            data-motion-toggle
            title="Visual effects"
            aria-label="Toggle visual effects"
            class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-slate-300 shadow-[0_3px_0_#cbd5e1] transition hover:border-slate-900 dark:border-slate-700 dark:shadow-[0_3px_0_#334155] dark:hover:border-slate-300"
          >
          </button>
        </div>
      </div>

      <div class="grid items-start gap-4 md:grid-cols-[5fr_7fr]">
        <div class="flex flex-col gap-4">
          <div
            class="flex flex-col gap-4 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
          >
            <span
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
              >Run tokens</span
            >
            <div
              data-token-tiles
              title="Runs available — earned by marking curriculum units done"
              class="flex flex-wrap gap-2.5"
            >
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              <span class="font-bold tabular-nums" data-lobby-tokens>0</span> runs
              ready. One run lasts{" "}
              <span class="font-bold tabular-nums" data-lobby-duration>60s</span
              >.
            </p>
            <p
              data-lobby-zero-message
              class="hidden text-sm font-semibold text-amber-700 dark:text-amber-400"
            >
              No runs left —
              <a href="/roadmap" class="underline">finish a unit</a> to earn one.
            </p>
            <button
              type="button"
              data-start-button
              class="flex h-16 w-full items-center justify-center gap-3 rounded-2xl border-2 border-[#082f49] bg-[#0369a1] text-xl font-extrabold text-white shadow-[0_6px_0_#082f49] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:brightness-100"
            >
              <span data-icon-play></span>
              <span>Start run</span>
            </button>
          </div>

          <div
            class="flex flex-col gap-2 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
          >
            <span
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
              >Best survival</span
            >
            <span
              class="text-4xl leading-none font-extrabold tabular-nums"
              data-lobby-best>--</span
            >
            <div
              class="h-3 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"
            >
              <div
                data-best-bar
                class="h-full rounded-full bg-emerald-600 transition-[width] duration-300"
                style="width: 0%"
              >
              </div>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400"
              >Against this run's length. Finish units to extend it.</span
            >
          </div>
        </div>

        <div
          class="flex flex-col gap-3 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
        >
          <div class="flex items-center justify-between gap-2">
            <span
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
              >Upgrades</span
            >
            <span
              title="Coins earned in-game — spend them here"
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-sm font-extrabold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300"
            >
              <span data-icon-lobby-coins></span>
              <span class="tabular-nums" data-lobby-coins>0</span>
              <span class="text-xs font-bold">coins</span>
            </span>
          </div>
          <div data-shop-rows class="flex w-full flex-col gap-2"></div>
          <div class="h-0.5 bg-slate-200 dark:bg-slate-800"></div>
          <p
            class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
          >
            Unlocks
          </p>
          <div data-shop-unlock-rows class="flex w-full flex-col gap-2"></div>
        </div>
      </div>
    </div>

    <div
      data-play-area
      class="mx-auto hidden w-full max-w-lg flex-col items-center gap-3"
    >
      <div
        class="sticky top-14 z-[5] flex w-full flex-col gap-2 rounded-2xl border-2 border-slate-300 bg-white/95 px-3 py-2.5 shadow-[0_4px_0_#cbd5e1] backdrop-blur dark:border-slate-700 dark:bg-slate-900/95 dark:shadow-[0_4px_0_#334155]"
      >
        <div class="flex items-center gap-3">
          <div class="flex min-w-0 flex-1 items-center gap-2">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-rose-300"
              data-icon-hp></span>
            <div
              class="h-4 flex-1 overflow-hidden rounded-full border-2 border-slate-900 bg-slate-200 dark:bg-slate-700"
            >
              <div
                data-hud-hp-bar
                class="h-full rounded-full bg-rose-400 transition-[width] duration-200"
                style="width: 100%"
              >
              </div>
            </div>
            <span
              data-hud-hp
              class="shrink-0 text-xs font-bold tabular-nums text-slate-600 dark:text-slate-300"
              >--/--</span
            >
          </div>
          <span class="flex shrink-0 items-center gap-1.5 text-sm">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-sky-300"
              data-icon-timer></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-timer>--</span
            >
          </span>
        </div>
        <div class="flex items-center justify-between gap-1 text-xs">
          <span class="flex items-center gap-1.5">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-yellow-300"
              data-icon-level></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-level>1</span
            >
          </span>
          <span class="flex items-center gap-1.5">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-slate-300"
              data-icon-kills></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-kills>0</span
            >
          </span>
          <span class="flex items-center gap-1.5">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-violet-300"
              data-icon-gems></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-gems>0</span
            >
          </span>
          <span class="flex items-center gap-1.5">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-amber-300"
              data-icon-coins></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-coins>0</span
            >
          </span>
          <span class="flex items-center gap-1.5">
            <span
              class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-orange-300"
              data-icon-threat></span>
            <span
              class="font-bold tabular-nums text-slate-800 dark:text-slate-100"
              data-hud-threat>1</span
            >
          </span>
        </div>
        <div
          class="h-3 w-full overflow-hidden rounded-full border-2 border-slate-900 bg-slate-200 dark:bg-slate-700"
        >
          <div
            data-hud-xp-bar
            class="h-full rounded-full bg-violet-400 transition-[width] duration-200"
            style="width: 0%"
          >
          </div>
        </div>
        <div data-hud-weapons class="flex flex-wrap items-center gap-1.5"></div>
      </div>

      <div class="relative mx-auto w-fit max-w-full">
        <canvas
          data-game-canvas
          width="420"
          height="500"
          style="aspect-ratio: 420 / 500;"
          class="h-[min(58vh,500px)] w-auto rounded-2xl border-2 border-slate-900 bg-slate-900 shadow-[0_5px_0_#cbd5e1] dark:border-slate-600 dark:shadow-[0_5px_0_#334155]"
        ></canvas>

        <div
          data-threat-toast
          class="animate-fade-slide-in pointer-events-none absolute top-2 left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-full border-2 border-slate-900 bg-orange-300 shadow-[0_3px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-threat-toast></span>
            <span data-threat-toast-text>Threat rising</span>
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-threat-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 2200ms"></span>
          </span>
        </div>

        <div
          data-boss-toast
          class="animate-fade-slide-in pointer-events-none absolute top-2 left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-full border-2 border-slate-900 bg-red-300 shadow-[0_3px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-boss-toast></span>
            <span>Boss incoming</span>
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-boss-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 3200ms"></span>
          </span>
        </div>

        <div
          data-synergy-toast
          class="animate-fade-slide-in pointer-events-none absolute top-2 left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-full border-2 border-slate-900 bg-fuchsia-300 shadow-[0_3px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-synergy-toast></span>
            <span data-synergy-toast-text>Synergy!</span>
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-synergy-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 2600ms"></span>
          </span>
        </div>

        <div
          data-lowhp-vignette
          class="pointer-events-none absolute inset-0 hidden rounded-2xl"
          style="box-shadow: inset 0 0 40px 10px rgba(244, 63, 94, 0.9);"
        >
        </div>

        <div
          data-levelup-overlay
          class="absolute inset-0 hidden flex-col items-center justify-center gap-3 rounded-lg bg-slate-950/90 p-4"
        >
          <p class="text-sm font-medium text-white">Choose an upgrade</p>
          <div data-levelup-cards class="flex w-full flex-col gap-2"></div>
        </div>
      </div>
    </div>

    <div
      data-results
      class="mx-auto hidden w-full max-w-lg flex-col items-center gap-3 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-6 text-center dark:border-emerald-800 dark:bg-emerald-950"
    >
      <p class="text-lg font-semibold" data-results-headline>Run ended</p>
      <p
        class="text-xs text-emerald-700 dark:text-emerald-400"
        data-results-cause
      >
      </p>
      <div
        class="grid w-full grid-cols-2 gap-2 text-sm sm:grid-cols-4"
        data-results-stats
      >
        <div
          class="flex items-center gap-2.5 rounded-xl bg-sky-500/10 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-600 dark:text-sky-400"
            data-icon-results-time></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-time
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-sky-700/80 uppercase dark:text-sky-400/80"
              >survived</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl bg-slate-500/10 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-500/20 text-slate-600 dark:text-slate-300"
            data-icon-results-kills></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-kills
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-slate-600/80 uppercase dark:text-slate-400/80"
              >kills</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl bg-yellow-500/10 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-yellow-500/20 text-yellow-600 dark:text-yellow-400"
            data-icon-results-level></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-level
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-yellow-700/80 uppercase dark:text-yellow-400/80"
              >level</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl bg-amber-500/10 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400"
            data-icon-results-coins></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-coins
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-amber-700/80 uppercase dark:text-amber-400/80"
              >coins</span
            >
          </span>
        </div>
      </div>
      <p
        data-results-record
        class="hidden inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 dark:text-emerald-400"
      >
        <span data-icon-record></span>
        <span>New best time!</span>
      </p>
      <button
        type="button"
        data-back-to-lobby-button
        class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      >
        <span data-icon-back></span>
        <span>Lobby</span>
      </button>
    </div>
  </div>

  <script>
    import { startGame } from "../../lib/game/engine";
    import { createLogger } from "../../lib/game/logger";
    import {
      getTokenCount,
      getBestTimeS,
      computeRunDurationS,
      consumeToken,
      recordRunResult,
    } from "../../lib/game/tokens";
    import {
      UPGRADES,
      UNLOCKS,
      getCoinBalance,
      addCoins,
      getUpgradeLevel,
      upgradeCost,
      purchaseUpgrade,
      computePowerIndex,
      getUpgradeEffects,
      isUnlocked,
      purchaseUnlock,
    } from "../../lib/game/shop";
    import { unlockAudio, isMuted, toggleMuted } from "../../lib/game/audio";
    import {
      isReducedMotion,
      toggleReducedMotion,
    } from "../../lib/game/settings";
    import {
      WEAPON_ICON,
      STAT_ICON,
      UPGRADE_ICON,
      EVOLUTION_ICON,
      UI_ICON,
      badgeClass,
      sizedIcon,
    } from "../../lib/game/icons";
    import type { WeaponId } from "../../lib/game/engine";

    const log = createLogger("page");

    function formatTime(s: number): string {
      return `${s.toFixed(1)}s`;
    }

    function init() {
      const gameRoot = document.querySelector<HTMLElement>("[data-game-root]");
      const fullscreenToggle = document.querySelector<HTMLButtonElement>(
        "[data-fullscreen-toggle]",
      );
      const lobby = document.querySelector<HTMLElement>("[data-lobby]");
      const playArea = document.querySelector<HTMLElement>("[data-play-area]");
      const results = document.querySelector<HTMLElement>("[data-results]");
      const canvas =
        document.querySelector<HTMLCanvasElement>("[data-game-canvas]");
      const startButton = document.querySelector<HTMLButtonElement>(
        "[data-start-button]",
      );
      const backToLobbyButton = document.querySelector<HTMLButtonElement>(
        "[data-back-to-lobby-button]",
      );
      const lobbyTokensEl = document.querySelector<HTMLElement>(
        "[data-lobby-tokens]",
      );
      const lobbyDurationEl = document.querySelector<HTMLElement>(
        "[data-lobby-duration]",
      );
      const lobbyBestEl =
        document.querySelector<HTMLElement>("[data-lobby-best]");
      const lobbyZeroMessage = document.querySelector<HTMLElement>(
        "[data-lobby-zero-message]",
      );
      const lobbyCoinsEl =
        document.querySelector<HTMLElement>("[data-lobby-coins]");
      const muteToggle =
        document.querySelector<HTMLButtonElement>("[data-mute-toggle]");
      const motionToggle = document.querySelector<HTMLButtonElement>(
        "[data-motion-toggle]",
      );
      const shopRowsEl =
        document.querySelector<HTMLElement>("[data-shop-rows]");
      const shopUnlockRowsEl = document.querySelector<HTMLElement>(
        "[data-shop-unlock-rows]",
      );
      const resultsHeadline = document.querySelector<HTMLElement>(
        "[data-results-headline]",
      );
      const resultsTime = document.querySelector<HTMLElement>(
        "[data-results-time]",
      );
      const resultsKills = document.querySelector<HTMLElement>(
        "[data-results-kills]",
      );
      const resultsLevel = document.querySelector<HTMLElement>(
        "[data-results-level]",
      );
      const resultsCoins = document.querySelector<HTMLElement>(
        "[data-results-coins]",
      );
      const resultsRecord = document.querySelector<HTMLElement>(
        "[data-results-record]",
      );
      const resultsCause = document.querySelector<HTMLElement>(
        "[data-results-cause]",
      );
      const hpEl = document.querySelector<HTMLElement>("[data-hud-hp]");
      const hpBarEl = document.querySelector<HTMLElement>("[data-hud-hp-bar]");
      const timerEl = document.querySelector<HTMLElement>("[data-hud-timer]");
      const killsEl = document.querySelector<HTMLElement>("[data-hud-kills]");
      const gemsEl = document.querySelector<HTMLElement>("[data-hud-gems]");
      const coinsEl = document.querySelector<HTMLElement>("[data-hud-coins]");
      const levelEl = document.querySelector<HTMLElement>("[data-hud-level]");
      const xpBarEl = document.querySelector<HTMLElement>("[data-hud-xp-bar]");
      const weaponsEl =
        document.querySelector<HTMLElement>("[data-hud-weapons]");
      const threatEl = document.querySelector<HTMLElement>("[data-hud-threat]");
      const threatToastEl = document.querySelector<HTMLElement>(
        "[data-threat-toast]",
      );
      const threatToastTextEl = document.querySelector<HTMLElement>(
        "[data-threat-toast-text]",
      );
      const bossToastEl =
        document.querySelector<HTMLElement>("[data-boss-toast]");
      const synergyToastEl = document.querySelector<HTMLElement>(
        "[data-synergy-toast]",
      );
      const synergyToastTextEl = document.querySelector<HTMLElement>(
        "[data-synergy-toast-text]",
      );
      const lowHpVignetteEl = document.querySelector<HTMLElement>(
        "[data-lowhp-vignette]",
      );
      const levelUpOverlay = document.querySelector<HTMLElement>(
        "[data-levelup-overlay]",
      );
      const levelUpCardsEl = document.querySelector<HTMLElement>(
        "[data-levelup-cards]",
      );
      if (
        !gameRoot ||
        !fullscreenToggle ||
        !lobby ||
        !playArea ||
        !results ||
        !canvas ||
        !startButton ||
        !backToLobbyButton ||
        !lobbyTokensEl ||
        !lobbyDurationEl ||
        !lobbyBestEl ||
        !lobbyZeroMessage ||
        !lobbyCoinsEl ||
        !muteToggle ||
        !motionToggle ||
        !shopRowsEl ||
        !shopUnlockRowsEl ||
        !resultsHeadline ||
        !resultsTime ||
        !resultsKills ||
        !resultsLevel ||
        !resultsCoins ||
        !resultsRecord ||
        !resultsCause ||
        !hpEl ||
        !hpBarEl ||
        !timerEl ||
        !killsEl ||
        !gemsEl ||
        !coinsEl ||
        !levelEl ||
        !xpBarEl ||
        !weaponsEl ||
        !threatEl ||
        !threatToastEl ||
        !threatToastTextEl ||
        !bossToastEl ||
        !synergyToastEl ||
        !synergyToastTextEl ||
        !lowHpVignetteEl ||
        !levelUpOverlay ||
        !levelUpCardsEl
      ) {
        log.error("missing expected DOM nodes, aborting init");
        return;
      }

      // Populate the static (never-change) icon slots once — the HUD/lobby/
      // results markup carries empty <span data-icon-*> placeholders so the
      // .astro template doesn't need to embed raw SVG strings inline.
      function setIcon(selector: string, svg: string, size = "h-4 w-4") {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.innerHTML = sizedIcon(svg, size);
      }
      setIcon("[data-icon-tokens]", UI_ICON.tokens);
      setIcon("[data-icon-duration]", UI_ICON.timer);
      setIcon("[data-icon-best]", UI_ICON.trophy);
      setIcon("[data-icon-lobby-coins]", UI_ICON.coins);
      setIcon("[data-icon-play]", UI_ICON.play, "h-4 w-4");
      setIcon("[data-icon-hp]", UI_ICON.hp, "h-4 w-4");
      setIcon("[data-icon-timer]", UI_ICON.timer, "h-3.5 w-3.5");
      setIcon("[data-icon-level]", UI_ICON.level, "h-3.5 w-3.5");
      setIcon("[data-icon-kills]", UI_ICON.kills, "h-3.5 w-3.5");
      setIcon("[data-icon-gems]", UI_ICON.gems, "h-3.5 w-3.5");
      setIcon("[data-icon-coins]", UI_ICON.coins, "h-3.5 w-3.5");
      setIcon("[data-icon-threat]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-threat-toast]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-boss-toast]", UI_ICON.warning, "h-3.5 w-3.5");
      setIcon("[data-icon-synergy-toast]", UI_ICON.synergy, "h-3.5 w-3.5");
      setIcon("[data-icon-results-time]", UI_ICON.timer, "h-4 w-4");
      setIcon("[data-icon-results-kills]", UI_ICON.kills, "h-4 w-4");
      setIcon("[data-icon-results-level]", UI_ICON.level, "h-4 w-4");
      setIcon("[data-icon-results-coins]", UI_ICON.coins, "h-4 w-4");
      setIcon("[data-icon-record]", UI_ICON.trophy, "h-4 w-4");
      setIcon("[data-icon-back]", UI_ICON.back, "h-4 w-4");

      function showLobby() {
        lobby!.classList.remove("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        renderLobby();
      }

      function renderLobby() {
        const tokens = getTokenCount();
        const duration = computeRunDurationS();
        const best = getBestTimeS();
        lobbyTokensEl!.textContent = String(tokens);
        lobbyDurationEl!.textContent = `${duration}s`;
        lobbyBestEl!.textContent = best > 0 ? formatTime(best) : "--";
        lobbyCoinsEl!.textContent = String(getCoinBalance());
        renderTokenTiles(tokens);
        const bestBar = document.querySelector<HTMLElement>("[data-best-bar]");
        if (bestBar) {
          bestBar.style.width = `${Math.min(100, Math.round((best / duration) * 100))}%`;
        }
        lobbyZeroMessage!.classList.toggle("hidden", tokens >= 1);
        startButton!.disabled = tokens < 1;
        renderShop();
      }

      // One amber tile per run token (capped), then an empty dashed slot so
      // "earn another" is visible even with a full hand.
      function renderTokenTiles(tokens: number) {
        const wrap = document.querySelector<HTMLElement>("[data-token-tiles]");
        if (!wrap) return;
        const shown = Math.min(tokens, 5);
        let html = "";
        for (let i = 0; i < shown; i++) {
          html +=
            '<span class="h-12 w-12 rounded-xl border-2 border-amber-800 bg-amber-400 shadow-[0_3px_0_#92400e]"></span>';
        }
        if (tokens > shown) {
          html += `<span class="flex h-12 items-center text-sm font-extrabold text-amber-700 dark:text-amber-400">+${tokens - shown}</span>`;
        }
        if (tokens < 5) {
          html +=
            '<span class="h-12 w-12 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700"></span>';
        }
        wrap.innerHTML = html;
      }

      function renderShop() {
        const balance = getCoinBalance();
        shopRowsEl!.innerHTML = "";
        for (const def of UPGRADES) {
          const level = getUpgradeLevel(def.id);
          const cost = upgradeCost(def.id);
          const affordable = cost !== null && balance >= cost;
          const row = document.createElement("div");
          // Colour only shows up on a row you can actually act on — maxed
          // or unaffordable rows fall back to flat neutral, same rule as
          // the buy button below, so "tinted" reliably means "actionable".
          row.className = affordable
            ? "animate-fade-slide-in flex items-center gap-3 rounded-xl border-2 border-sky-300 bg-sky-50/60 px-3 py-2 text-sm transition dark:border-sky-800 dark:bg-sky-500/5"
            : "animate-fade-slide-in flex items-center gap-3 rounded-xl border-2 border-slate-200 px-3 py-2 text-sm transition dark:border-slate-800";
          const iconBadge = document.createElement("span");
          iconBadge.className = `flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${badgeClass(def.id)}`;
          iconBadge.innerHTML = sizedIcon(
            UPGRADE_ICON[def.id] ?? "",
            "h-4 w-4",
          );
          const info = document.createElement("div");
          info.className = "min-w-0 flex-1";
          info.innerHTML = `
            <div class="flex items-center justify-between gap-2">
              <span class="font-medium">${def.label}</span>
              <span class="shrink-0 text-xs tabular-nums text-slate-500 dark:text-slate-400">${level}/${def.maxLevel}</span>
            </div>
            <div class="mt-1.5 flex gap-1">${Array.from(
              { length: def.maxLevel },
              (_, i) =>
                `<span class="h-2 flex-1 rounded-full ${i < level ? "bg-sky-600 dark:bg-sky-400" : "bg-slate-200 dark:bg-slate-700"}"></span>`,
            ).join("")}</div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${def.effectLabel}</p>
          `;
          const buyButton = document.createElement("button");
          buyButton.type = "button";
          if (cost === null) {
            buyButton.className =
              "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = "MAX";
            buyButton.disabled = true;
          } else {
            buyButton.className = affordable
              ? "shrink-0 rounded-xl border-2 border-amber-800 bg-amber-400 px-3 py-1.5 text-sm font-extrabold text-slate-900 shadow-[0_3px_0_#92400e] transition hover:brightness-110"
              : "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = `Buy · ${cost}`;
            buyButton.disabled = !affordable;
            buyButton.addEventListener("click", () => {
              if (purchaseUpgrade(def.id)) {
                log.log("shop:purchase", { id: def.id });
                renderLobby();
              }
            });
          }
          row.append(iconBadge, info, buyButton);
          shopRowsEl!.appendChild(row);
        }
        renderUnlocks();
      }

      // Phase 15: one-time unlock rows (Chain Lightning, Necromancy) —
      // structurally similar to the leveled UPGRADES rows above, but no
      // progress bar (nothing to level, it's owned or not) and the button
      // reads "Owned" (disabled) once purchased instead of "MAX".
      const UNLOCK_ICON: Record<string, string> = {
        chainLightning: WEAPON_ICON.chainLightning,
        necromancy: UI_ICON.necromancy,
      };
      function renderUnlocks() {
        const balance = getCoinBalance();
        shopUnlockRowsEl!.innerHTML = "";
        for (const def of UNLOCKS) {
          const owned = isUnlocked(def.id);
          const affordable = !owned && balance >= def.cost;
          const row = document.createElement("div");
          row.className = affordable
            ? "animate-fade-slide-in flex items-center gap-3 rounded-lg border border-fuchsia-200 bg-fuchsia-50/60 px-2.5 py-2 text-sm transition dark:border-fuchsia-900 dark:bg-fuchsia-500/5"
            : "animate-fade-slide-in flex items-center gap-3 rounded-lg border border-slate-200 px-2.5 py-2 text-sm transition dark:border-slate-800";
          const iconBadge = document.createElement("span");
          iconBadge.className = owned
            ? `flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${badgeClass(undefined, "bg-fuchsia-300")}`
            : "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border-2 border-slate-300 bg-slate-100 text-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500";
          iconBadge.innerHTML = sizedIcon(
            owned ? (UNLOCK_ICON[def.id] ?? "") : UI_ICON.lock,
            "h-4 w-4",
          );
          const info = document.createElement("div");
          info.className = "min-w-0 flex-1";
          info.innerHTML = `
            <div class="flex items-center justify-between gap-2">
              <span class="font-medium">${def.label}</span>
              <span class="shrink-0 text-xs ${owned ? "text-fuchsia-600 dark:text-fuchsia-400" : "text-slate-500 dark:text-slate-400"}">${owned ? "Owned" : "Locked"}</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${def.effectLabel}</p>
          `;
          const buyButton = document.createElement("button");
          buyButton.type = "button";
          if (owned) {
            buyButton.className =
              "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = "Owned";
            buyButton.disabled = true;
          } else {
            buyButton.className = affordable
              ? "shrink-0 rounded-xl border-2 border-amber-800 bg-amber-400 px-3 py-1.5 text-sm font-extrabold text-slate-900 shadow-[0_3px_0_#92400e] transition hover:brightness-110"
              : "shrink-0 rounded-xl border-2 border-slate-300 px-3 py-1.5 text-sm font-bold text-slate-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-400";
            buyButton.textContent = `Buy · ${def.cost}`;
            buyButton.disabled = !affordable;
            buyButton.addEventListener("click", () => {
              if (purchaseUnlock(def.id)) {
                log.log("shop:unlock", { id: def.id });
                renderLobby();
              }
            });
          }
          row.append(iconBadge, info, buyButton);
          shopUnlockRowsEl!.appendChild(row);
        }
      }

      // A toggle button holding a non-default state (muted, reduced motion)
      // fills with the accent instead of only swapping its icon glyph —
      // otherwise "engaged" only shows up in the tooltip. Shop/fullscreen
      // don't call this: they open something rather than hold a state.
      function setToggleEngaged(button: HTMLButtonElement, engaged: boolean) {
        button.classList.toggle("border-slate-300", !engaged);
        button.classList.toggle("dark:border-slate-700", !engaged);
        button.classList.toggle("border-[var(--accent)]", engaged);
        button.style.background = engaged ? "var(--accent-soft-bg)" : "";
        button.style.color = engaged ? "var(--accent-text)" : "";
      }

      function renderMute() {
        const muted = isMuted();
        muteToggle!.innerHTML = sizedIcon(
          muted ? UI_ICON.soundOff : UI_ICON.soundOn,
          "h-4 w-4",
        );
        muteToggle!.title = muted ? "Sound off" : "Sound on";
        setToggleEngaged(muteToggle!, muted);
      }

      function renderMotion() {
        const reduced = isReducedMotion();
        motionToggle!.innerHTML = sizedIcon(
          reduced ? UI_ICON.motionOff : UI_ICON.motionOn,
          "h-4 w-4",
        );
        motionToggle!.title = reduced
          ? "Visual effects off"
          : "Visual effects on";
        setToggleEngaged(motionToggle!, reduced);
      }

      function renderFullscreen() {
        const isFs = document.fullscreenElement === gameRoot;
        fullscreenToggle!.innerHTML = sizedIcon(
          isFs ? UI_ICON.minimize : UI_ICON.maximize,
          "h-4 w-4",
        );
        fullscreenToggle!.title = isFs ? "Exit fullscreen" : "Fullscreen";
        gameRoot!.classList.toggle("max-w-none", isFs);
        gameRoot!.classList.toggle("h-screen", isFs);
        gameRoot!.classList.toggle("justify-center", isFs);
        gameRoot!.classList.toggle("bg-white", isFs);
        gameRoot!.classList.toggle("dark:bg-slate-950", isFs);
        gameRoot!.classList.toggle("p-4", isFs);
      }

      // Phase 13: brief "difficulty rising" banner, fired once per threat
      // tier crossed (engine.ts's onThreatTierUp). Re-triggerable per the
      // project's remove/reflow/re-add pattern for repeat one-shot CSS
      // animations (see CLAUDE.md's "Micro-interactions and animation").
      let threatToastTimeout: number | undefined;
      function showThreatToast(tier: number) {
        threatToastTextEl!.textContent = `Threat rising — tier ${tier}`;
        threatToastEl!.classList.remove("hidden");
        threatToastEl!.classList.add("flex");
        threatToastEl!.classList.remove("animate-fade-slide-in");
        void threatToastEl!.offsetWidth;
        threatToastEl!.classList.add("animate-fade-slide-in");
        const threatToastBar = threatToastEl!.querySelector<HTMLElement>(
          "[data-threat-toast-bar]",
        );
        threatToastBar?.classList.remove("animate-toast-timer");
        void threatToastBar?.offsetWidth;
        threatToastBar?.classList.add("animate-toast-timer");
        if (threatToastTimeout) window.clearTimeout(threatToastTimeout);
        threatToastTimeout = window.setTimeout(() => {
          threatToastEl!.classList.add("hidden");
          threatToastEl!.classList.remove("flex");
        }, 2200);
      }

      // Phase 14: boss telegraph banner, fired once via engine.ts's
      // onBossIncoming — same re-triggerable animation pattern as the
      // threat toast above.
      let bossToastTimeout: number | undefined;
      function showBossToast() {
        bossToastEl!.classList.remove("hidden");
        bossToastEl!.classList.add("flex");
        bossToastEl!.classList.remove("animate-fade-slide-in");
        void bossToastEl!.offsetWidth;
        bossToastEl!.classList.add("animate-fade-slide-in");
        const bossToastBar = bossToastEl!.querySelector<HTMLElement>(
          "[data-boss-toast-bar]",
        );
        bossToastBar?.classList.remove("animate-toast-timer");
        void bossToastBar?.offsetWidth;
        bossToastBar?.classList.add("animate-toast-timer");
        if (bossToastTimeout) window.clearTimeout(bossToastTimeout);
        bossToastTimeout = window.setTimeout(() => {
          bossToastEl!.classList.add("hidden");
          bossToastEl!.classList.remove("flex");
        }, 3200);
      }

      // Phase 16: synergy discovery banner, fired once per named synergy via
      // engine.ts's onSynergyTriggered — same re-triggerable animation
      // pattern as the threat/boss toasts above.
      let synergyToastTimeout: number | undefined;
      function showSynergyToast(name: string) {
        synergyToastTextEl!.textContent = `Synergy — ${name}!`;
        synergyToastEl!.classList.remove("hidden");
        synergyToastEl!.classList.add("flex");
        synergyToastEl!.classList.remove("animate-fade-slide-in");
        void synergyToastEl!.offsetWidth;
        synergyToastEl!.classList.add("animate-fade-slide-in");
        const synergyToastBar = synergyToastEl!.querySelector<HTMLElement>(
          "[data-synergy-toast-bar]",
        );
        synergyToastBar?.classList.remove("animate-toast-timer");
        void synergyToastBar?.offsetWidth;
        synergyToastBar?.classList.add("animate-toast-timer");
        if (synergyToastTimeout) window.clearTimeout(synergyToastTimeout);
        synergyToastTimeout = window.setTimeout(() => {
          synergyToastEl!.classList.add("hidden");
          synergyToastEl!.classList.remove("flex");
        }, 2600);
      }

      // Phase 14: low-HP pulsing vignette — only animates when reduceMotion
      // is off, matching the canvas glow/idle-bob gating elsewhere.
      function setLowHp(active: boolean) {
        lowHpVignetteEl!.classList.toggle("hidden", !active);
        lowHpVignetteEl!.classList.toggle(
          "animate-pulse-warn",
          active && !isReducedMotion(),
        );
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";
      backToLobbyButton.dataset.wired = "true";
      muteToggle.dataset.wired = "true";
      motionToggle.dataset.wired = "true";
      fullscreenToggle.dataset.wired = "true";

      renderMute();
      muteToggle.addEventListener("click", () => {
        toggleMuted();
        renderMute();
      });

      renderMotion();
      motionToggle.addEventListener("click", () => {
        toggleReducedMotion();
        renderMotion();
      });

      renderFullscreen();
      fullscreenToggle.addEventListener("click", () => {
        if (document.fullscreenElement) {
          document.exitFullscreen?.();
        } else {
          gameRoot!.requestFullscreen?.();
        }
      });
      document.addEventListener("fullscreenchange", renderFullscreen);

      let activeGame: ReturnType<typeof startGame> | null = null;

      startButton.addEventListener("click", () => {
        unlockAudio();
        if (!consumeToken()) {
          log.warn("start clicked with 0 tokens — should have been disabled");
          renderLobby();
          return;
        }
        log.log("start button clicked");
        levelUpOverlay!.classList.add("hidden");
        levelUpOverlay!.classList.remove("flex");
        threatToastEl!.classList.add("hidden");
        threatToastEl!.classList.remove("flex");
        bossToastEl!.classList.add("hidden");
        bossToastEl!.classList.remove("flex");
        synergyToastEl!.classList.add("hidden");
        synergyToastEl!.classList.remove("flex");
        setLowHp(false);
        lobby!.classList.add("hidden");
        playArea!.classList.remove("hidden");
        playArea!.classList.add("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");

        const durationS = computeRunDurationS();
        const upgradeEffects = getUpgradeEffects();
        const powerIndex = computePowerIndex();
        // Phase 15: shop unlocks that expand this run's available content —
        // see engine.ts's GameOptions.unlockedWeaponIds/abilityUnlocked.
        const unlockedWeaponIds: WeaponId[] = isUnlocked("chainLightning")
          ? ["chainLightning"]
          : [];
        const abilityUnlocked = isUnlocked("necromancy");
        // Phase 16C: "Vampiric Might" needs the shop's raw Might level, not
        // just its aggregated damage-multiplier effect.
        const mightLevel = getUpgradeLevel("might");
        activeGame?.stop();
        activeGame = startGame(
          canvas,
          {
            onHudUpdate(state) {
              hpEl.textContent = `${Math.round(state.hp)}/${Math.round(state.maxHp)}`;
              hpBarEl.style.width = `${Math.max(0, Math.min(100, (state.hp / state.maxHp) * 100))}%`;
              timerEl.textContent = `${state.timeRemaining.toFixed(1)}s`;
              killsEl.textContent = String(state.kills);
              gemsEl.textContent = String(state.gems);
              coinsEl.textContent = String(state.coins);
              levelEl.textContent = String(state.level);
              threatEl.textContent = String(state.threatTier);
              setLowHp(state.lowHp);
              xpBarEl.style.width = `${Math.max(0, Math.min(100, (state.xp / state.xpToNext) * 100))}%`;
              weaponsEl.innerHTML = state.weapons
                .map(
                  (w) => `
                <span class="inline-flex items-center gap-1 rounded-full border-2 border-slate-900 bg-sky-300 px-1.5 py-0.5 text-xs font-bold text-slate-900 shadow-[0_2px_0_#020617]">
                  <span>${sizedIcon(WEAPON_ICON[w.id] ?? "", "h-3 w-3")}</span>
                  <span>L${w.level}</span>
                </span>`,
                )
                .join("");
            },
            onThreatTierUp(tier) {
              log.log("onThreatTierUp callback", { tier });
              showThreatToast(tier);
            },
            onBossIncoming() {
              log.log("onBossIncoming callback");
              showBossToast();
            },
            onSynergyTriggered(name) {
              log.log("onSynergyTriggered callback", { name });
              showSynergyToast(name);
            },
            onGameOver(summary) {
              log.log("onGameOver callback", summary);
              const isRecord = recordRunResult(summary.survivedS);
              addCoins(summary.coinsEarned);
              setLowHp(false);
              resultsHeadline.textContent = `Survived ${formatTime(summary.survivedS)}`;
              resultsCause.textContent = summary.cause;
              resultsTime.textContent = formatTime(summary.survivedS);
              resultsKills.textContent = String(summary.kills);
              resultsLevel.textContent = String(summary.level);
              resultsCoins.textContent = String(summary.coinsEarned);
              resultsRecord.classList.toggle("hidden", !isRecord);
              playArea!.classList.add("hidden");
              playArea!.classList.remove("flex");
              results!.classList.remove("hidden");
              results!.classList.add("flex");
            },
            onLevelUp(cards, choose) {
              log.log("onLevelUp callback", cards);
              levelUpCardsEl.innerHTML = "";
              let chosen = false;
              for (const card of cards) {
                const btn = document.createElement("button");
                btn.type = "button";
                // Accent by card kind — evolution cards (Lv6) get their
                // own gold treatment regardless of kind, since reaching
                // one is the rarer/bigger moment of the three.
                const accent = card.isEvolution
                  ? "border-amber-400/70 bg-amber-950/30 hover:border-amber-300"
                  : card.kind === "newWeapon"
                    ? "border-emerald-600/60 bg-emerald-950/20 hover:border-emerald-400"
                    : card.kind === "stat"
                      ? "border-violet-600/60 bg-slate-900/80 hover:border-violet-400"
                      : card.kind === "ability"
                        ? "border-fuchsia-600/60 bg-fuchsia-950/20 hover:border-fuchsia-400"
                        : "border-sky-600/60 bg-slate-900/80 hover:border-sky-400";
                const iconBg = card.isEvolution
                  ? badgeClass(undefined, "bg-amber-300")
                  : card.kind === "newWeapon"
                    ? badgeClass(undefined, "bg-emerald-300")
                    : card.kind === "stat"
                      ? badgeClass(card.statId, "bg-violet-300")
                      : card.kind === "ability"
                        ? badgeClass(undefined, "bg-fuchsia-300")
                        : badgeClass(undefined, "bg-sky-300");
                const icon =
                  card.kind === "stat"
                    ? (STAT_ICON[card.statId ?? ""] ?? "")
                    : card.kind === "ability"
                      ? UI_ICON.necromancy
                      : (WEAPON_ICON[card.weaponId ?? "bolt"] ?? "");
                btn.className = `animate-fade-slide-in w-full rounded-lg border ${accent} px-3 py-2 text-left text-sm text-white`;
                btn.innerHTML = `
                  <span class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${iconBg}">
                      ${sizedIcon(icon, "h-5 w-5")}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center gap-1.5">
                        <span class="font-medium">${card.title}</span>
                        ${
                          card.kind === "newWeapon"
                            ? '<span class="rounded-full bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-300">NEW</span>'
                            : ""
                        }
                        ${
                          card.isEvolution
                            ? `<span class="text-amber-300">${sizedIcon(EVOLUTION_ICON, "h-3.5 w-3.5")}</span>`
                            : ""
                        }
                      </span>
                      <span class="block text-xs text-slate-400">${card.description}</span>
                    </span>
                  </span>
                `;
                btn.addEventListener("click", () => {
                  if (chosen) return;
                  chosen = true;
                  log.log("levelup card chosen", card.id);
                  levelUpOverlay!.classList.add("hidden");
                  levelUpOverlay!.classList.remove("flex");
                  choose(card.id);
                });
                levelUpCardsEl.appendChild(btn);
              }
              levelUpOverlay!.classList.remove("hidden");
              levelUpOverlay!.classList.add("flex");
            },
          },
          {
            durationS,
            upgradeEffects,
            powerIndex,
            reduceMotion: isReducedMotion(),
            unlockedWeaponIds,
            abilityUnlocked,
            mightLevel,
          },
        );
      });

      backToLobbyButton.addEventListener("click", () => {
        activeGame?.stop();
        activeGame = null;
        showLobby();
      });

      showLobby();
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
