---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Game"
  description="An in-site survival game, earned by making real progress on the curriculum."
>
  <div class="mx-auto flex max-w-lg flex-col items-center gap-4">
    <h1 class="text-xl font-semibold">Game</h1>

    <div
      data-lobby
      class="flex w-full flex-col items-center gap-4 rounded-lg border border-slate-200 bg-white/60 px-4 py-6 text-center dark:border-slate-800 dark:bg-slate-900/40"
    >
      <p class="text-sm text-slate-600 dark:text-slate-400">
        WASD / arrow keys to move (or drag anywhere on the play area on touch),
        weapons auto-fire. Playing costs a token — earn one every time you mark
        a curriculum level done (see <code>docs/GAME-DESIGN.md</code>). Runs get
        longer the more units you've fully completed.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-6">
        <div>
          <div class="text-2xl font-semibold" data-lobby-tokens>0</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">tokens</div>
        </div>
        <div>
          <div class="text-2xl font-semibold" data-lobby-duration>60s</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">
            run length
          </div>
        </div>
        <div>
          <div class="text-2xl font-semibold" data-lobby-best>--</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">
            best time
          </div>
        </div>
        <div>
          <div class="text-2xl font-semibold" data-lobby-coins>0</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">coins</div>
        </div>
      </div>

      <p
        data-lobby-zero-message
        class="hidden text-sm text-amber-600 dark:text-amber-400"
      >
        No tokens yet —
        <a href="/roadmap" class="underline">mark a curriculum level done</a>
        to earn one.
      </p>

      <div class="flex items-center gap-3">
        <button
          type="button"
          data-start-button
          class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:hover:border-slate-500"
        >
          Start run (1 token)
        </button>
        <button
          type="button"
          data-shop-toggle
          class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
        >
          Shop
        </button>
        <button
          type="button"
          data-mute-toggle
          class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
        >
          Sound: On
        </button>
        <button
          type="button"
          data-motion-toggle
          class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
        >
          Motion: On
        </button>
      </div>

      <div data-shop-panel class="hidden w-full flex-col gap-2 text-left">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Permanent upgrades, bought with coins earned from runs. Cost rises
          each level.
        </p>
        <div data-shop-rows class="flex w-full flex-col gap-2"></div>
      </div>
    </div>

    <div data-play-area class="hidden w-full flex-col items-center gap-4">
      <div
        class="sticky top-14 z-[5] flex w-full flex-col gap-1 rounded-lg border border-slate-200 bg-white/95 px-3 py-2 text-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95"
      >
        <div class="flex items-center justify-between">
          <span data-hud-hp>HP: --/--</span>
          <span data-hud-level>Lv 1 (XP 0/20)</span>
          <span data-hud-timer>Time: --</span>
        </div>
        <div class="flex items-center justify-between">
          <span data-hud-kills>Kills: 0</span>
          <span data-hud-gems>Gems: 0</span>
          <span data-hud-coins>Coins: 0</span>
        </div>
        <div
          data-hud-weapons
          class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400"
        >
          Weapons: —
        </div>
      </div>

      <div class="relative w-full">
        <canvas
          data-game-canvas
          width="420"
          height="500"
          style="aspect-ratio: 420 / 500;"
          class="h-[min(58vh,500px)] w-auto rounded-lg border border-slate-300 bg-slate-900 dark:border-slate-700"
        ></canvas>

        <div
          data-levelup-overlay
          class="absolute inset-0 hidden flex-col items-center justify-center gap-3 rounded-lg bg-slate-950/90 p-4"
        >
          <p class="text-sm font-medium text-white">Choose an upgrade</p>
          <div data-levelup-cards class="flex w-full flex-col gap-2"></div>
        </div>
      </div>
    </div>

    <div
      data-results
      class="hidden w-full flex-col items-center gap-3 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-6 text-center dark:border-emerald-800 dark:bg-emerald-950"
    >
      <p class="text-lg font-semibold" data-results-headline>Run ended</p>
      <div class="grid w-full grid-cols-4 gap-2 text-sm" data-results-stats>
        <div>
          <div class="font-semibold" data-results-time>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">survived</div>
        </div>
        <div>
          <div class="font-semibold" data-results-kills>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">kills</div>
        </div>
        <div>
          <div class="font-semibold" data-results-level>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">
            level reached
          </div>
        </div>
        <div>
          <div class="font-semibold" data-results-coins>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">
            coins earned
          </div>
        </div>
      </div>
      <p
        data-results-record
        class="hidden text-sm font-medium text-emerald-700 dark:text-emerald-400"
      >
        New best time!
      </p>
      <button
        type="button"
        data-back-to-lobby-button
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      >
        Back to lobby
      </button>
    </div>
  </div>

  <script>
    import { startGame } from "../../lib/game/engine";
    import { createLogger } from "../../lib/game/logger";
    import {
      getTokenCount,
      getBestTimeS,
      computeRunDurationS,
      consumeToken,
      recordRunResult,
    } from "../../lib/game/tokens";
    import {
      UPGRADES,
      getCoinBalance,
      addCoins,
      getUpgradeLevel,
      upgradeCost,
      purchaseUpgrade,
      computePowerIndex,
      getUpgradeEffects,
    } from "../../lib/game/shop";
    import { unlockAudio, isMuted, toggleMuted } from "../../lib/game/audio";
    import {
      isReducedMotion,
      toggleReducedMotion,
    } from "../../lib/game/settings";
    import {
      WEAPON_ICON,
      STAT_ICON,
      UPGRADE_ICON,
      EVOLUTION_ICON,
      sizedIcon,
    } from "../../lib/game/icons";

    const log = createLogger("page");

    function formatTime(s: number): string {
      return `${s.toFixed(1)}s`;
    }

    function init() {
      const lobby = document.querySelector<HTMLElement>("[data-lobby]");
      const playArea = document.querySelector<HTMLElement>("[data-play-area]");
      const results = document.querySelector<HTMLElement>("[data-results]");
      const canvas =
        document.querySelector<HTMLCanvasElement>("[data-game-canvas]");
      const startButton = document.querySelector<HTMLButtonElement>(
        "[data-start-button]",
      );
      const backToLobbyButton = document.querySelector<HTMLButtonElement>(
        "[data-back-to-lobby-button]",
      );
      const lobbyTokensEl = document.querySelector<HTMLElement>(
        "[data-lobby-tokens]",
      );
      const lobbyDurationEl = document.querySelector<HTMLElement>(
        "[data-lobby-duration]",
      );
      const lobbyBestEl =
        document.querySelector<HTMLElement>("[data-lobby-best]");
      const lobbyZeroMessage = document.querySelector<HTMLElement>(
        "[data-lobby-zero-message]",
      );
      const lobbyCoinsEl =
        document.querySelector<HTMLElement>("[data-lobby-coins]");
      const shopToggle =
        document.querySelector<HTMLButtonElement>("[data-shop-toggle]");
      const muteToggle =
        document.querySelector<HTMLButtonElement>("[data-mute-toggle]");
      const motionToggle = document.querySelector<HTMLButtonElement>(
        "[data-motion-toggle]",
      );
      const shopPanel =
        document.querySelector<HTMLElement>("[data-shop-panel]");
      const shopRowsEl =
        document.querySelector<HTMLElement>("[data-shop-rows]");
      const resultsHeadline = document.querySelector<HTMLElement>(
        "[data-results-headline]",
      );
      const resultsTime = document.querySelector<HTMLElement>(
        "[data-results-time]",
      );
      const resultsKills = document.querySelector<HTMLElement>(
        "[data-results-kills]",
      );
      const resultsLevel = document.querySelector<HTMLElement>(
        "[data-results-level]",
      );
      const resultsCoins = document.querySelector<HTMLElement>(
        "[data-results-coins]",
      );
      const resultsRecord = document.querySelector<HTMLElement>(
        "[data-results-record]",
      );
      const hpEl = document.querySelector<HTMLElement>("[data-hud-hp]");
      const timerEl = document.querySelector<HTMLElement>("[data-hud-timer]");
      const killsEl = document.querySelector<HTMLElement>("[data-hud-kills]");
      const gemsEl = document.querySelector<HTMLElement>("[data-hud-gems]");
      const coinsEl = document.querySelector<HTMLElement>("[data-hud-coins]");
      const levelEl = document.querySelector<HTMLElement>("[data-hud-level]");
      const weaponsEl =
        document.querySelector<HTMLElement>("[data-hud-weapons]");
      const levelUpOverlay = document.querySelector<HTMLElement>(
        "[data-levelup-overlay]",
      );
      const levelUpCardsEl = document.querySelector<HTMLElement>(
        "[data-levelup-cards]",
      );
      if (
        !lobby ||
        !playArea ||
        !results ||
        !canvas ||
        !startButton ||
        !backToLobbyButton ||
        !lobbyTokensEl ||
        !lobbyDurationEl ||
        !lobbyBestEl ||
        !lobbyZeroMessage ||
        !lobbyCoinsEl ||
        !shopToggle ||
        !muteToggle ||
        !motionToggle ||
        !shopPanel ||
        !shopRowsEl ||
        !resultsHeadline ||
        !resultsTime ||
        !resultsKills ||
        !resultsLevel ||
        !resultsCoins ||
        !resultsRecord ||
        !hpEl ||
        !timerEl ||
        !killsEl ||
        !gemsEl ||
        !coinsEl ||
        !levelEl ||
        !weaponsEl ||
        !levelUpOverlay ||
        !levelUpCardsEl
      ) {
        log.error("missing expected DOM nodes, aborting init");
        return;
      }

      function showLobby() {
        lobby!.classList.remove("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        renderLobby();
      }

      function renderLobby() {
        const tokens = getTokenCount();
        const duration = computeRunDurationS();
        const best = getBestTimeS();
        lobbyTokensEl!.textContent = String(tokens);
        lobbyDurationEl!.textContent = `${duration}s`;
        lobbyBestEl!.textContent = best > 0 ? formatTime(best) : "--";
        lobbyCoinsEl!.textContent = String(getCoinBalance());
        lobbyZeroMessage!.classList.toggle("hidden", tokens >= 1);
        startButton!.disabled = tokens < 1;
        renderShop();
      }

      function renderShop() {
        const balance = getCoinBalance();
        shopRowsEl!.innerHTML = "";
        for (const def of UPGRADES) {
          const level = getUpgradeLevel(def.id);
          const cost = upgradeCost(def.id);
          const pct = Math.round((level / def.maxLevel) * 100);
          const row = document.createElement("div");
          row.className =
            "animate-fade-slide-in flex items-center gap-3 rounded border border-slate-200 px-2 py-1.5 text-sm dark:border-slate-800";
          const iconBadge = document.createElement("span");
          iconBadge.className =
            "flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-600 dark:bg-sky-500/10 dark:text-sky-400";
          iconBadge.innerHTML = sizedIcon(
            UPGRADE_ICON[def.id] ?? "",
            "h-4 w-4",
          );
          const info = document.createElement("div");
          info.className = "min-w-0 flex-1";
          info.innerHTML = `
            <div class="flex items-center justify-between gap-2">
              <span class="font-medium">${def.label}</span>
              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">${level}/${def.maxLevel}</span>
            </div>
            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
              <div class="animate-fill-bar h-full rounded-full bg-sky-500" style="--target-width: ${pct}%"></div>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${def.effectLabel}</p>
          `;
          const buyButton = document.createElement("button");
          buyButton.type = "button";
          buyButton.className =
            "shrink-0 rounded-full border border-slate-300 px-3 py-1 text-xs font-medium hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:hover:border-slate-500";
          if (cost === null) {
            buyButton.textContent = "MAX";
            buyButton.disabled = true;
          } else {
            buyButton.textContent = `Buy (${cost})`;
            buyButton.disabled = balance < cost;
            buyButton.addEventListener("click", () => {
              if (purchaseUpgrade(def.id)) {
                log.log("shop:purchase", { id: def.id });
                renderLobby();
              }
            });
          }
          row.append(iconBadge, info, buyButton);
          shopRowsEl!.appendChild(row);
        }
      }

      function renderMute() {
        muteToggle!.textContent = isMuted() ? "Sound: Off" : "Sound: On";
      }

      function renderMotion() {
        motionToggle!.textContent = isReducedMotion()
          ? "Motion: Off"
          : "Motion: On";
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";
      backToLobbyButton.dataset.wired = "true";
      shopToggle.dataset.wired = "true";
      muteToggle.dataset.wired = "true";
      motionToggle.dataset.wired = "true";

      renderMute();
      muteToggle.addEventListener("click", () => {
        toggleMuted();
        renderMute();
      });

      renderMotion();
      motionToggle.addEventListener("click", () => {
        toggleReducedMotion();
        renderMotion();
      });

      shopToggle.addEventListener("click", () => {
        const isHidden = shopPanel!.classList.contains("hidden");
        shopPanel!.classList.toggle("hidden", !isHidden);
        shopPanel!.classList.toggle("flex", isHidden);
        if (isHidden) renderShop();
      });

      let activeGame: ReturnType<typeof startGame> | null = null;

      startButton.addEventListener("click", () => {
        unlockAudio();
        if (!consumeToken()) {
          log.warn("start clicked with 0 tokens — should have been disabled");
          renderLobby();
          return;
        }
        log.log("start button clicked");
        levelUpOverlay!.classList.add("hidden");
        levelUpOverlay!.classList.remove("flex");
        lobby!.classList.add("hidden");
        playArea!.classList.remove("hidden");
        playArea!.classList.add("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");

        const durationS = computeRunDurationS();
        const upgradeEffects = getUpgradeEffects();
        const powerIndex = computePowerIndex();
        activeGame?.stop();
        activeGame = startGame(
          canvas,
          {
            onHudUpdate(state) {
              hpEl.textContent = `HP: ${Math.round(state.hp)}/${Math.round(state.maxHp)}`;
              timerEl.textContent = `Time: ${state.timeRemaining.toFixed(1)}s`;
              killsEl.textContent = `Kills: ${state.kills}`;
              gemsEl.textContent = `Gems: ${state.gems}`;
              coinsEl.textContent = `Coins: ${state.coins}`;
              levelEl.textContent = `Lv ${state.level} (XP ${Math.round(
                state.xp,
              )}/${state.xpToNext})`;
              weaponsEl.innerHTML =
                `<span>Weapons:</span>` +
                state.weapons
                  .map(
                    (w) => `
                <span class="inline-flex items-center gap-1 rounded-full border border-slate-300 bg-slate-100 px-1.5 py-0.5 dark:border-slate-700 dark:bg-slate-800">
                  <span class="text-sky-600 dark:text-sky-400">${sizedIcon(
                    WEAPON_ICON[w.id] ?? "",
                    "h-3 w-3",
                  )}</span>
                  <span>L${w.level}</span>
                </span>`,
                  )
                  .join("");
            },
            onGameOver(summary) {
              log.log("onGameOver callback", summary);
              const isRecord = recordRunResult(summary.survivedS);
              addCoins(summary.coinsEarned);
              resultsHeadline.textContent = `Run ended — survived ${formatTime(
                summary.survivedS,
              )} / ${durationS}s`;
              resultsTime.textContent = formatTime(summary.survivedS);
              resultsKills.textContent = String(summary.kills);
              resultsLevel.textContent = String(summary.level);
              resultsCoins.textContent = String(summary.coinsEarned);
              resultsRecord.classList.toggle("hidden", !isRecord);
              playArea!.classList.add("hidden");
              playArea!.classList.remove("flex");
              results!.classList.remove("hidden");
              results!.classList.add("flex");
            },
            onLevelUp(cards, choose) {
              log.log("onLevelUp callback", cards);
              levelUpCardsEl.innerHTML = "";
              let chosen = false;
              for (const card of cards) {
                const btn = document.createElement("button");
                btn.type = "button";
                // Accent by card kind — evolution cards (Lv6) get their
                // own gold treatment regardless of kind, since reaching
                // one is the rarer/bigger moment of the three.
                const accent = card.isEvolution
                  ? "border-amber-400/70 bg-amber-950/30 hover:border-amber-300"
                  : card.kind === "newWeapon"
                    ? "border-emerald-600/60 bg-emerald-950/20 hover:border-emerald-400"
                    : card.kind === "stat"
                      ? "border-violet-600/60 bg-slate-900/80 hover:border-violet-400"
                      : "border-sky-600/60 bg-slate-900/80 hover:border-sky-400";
                const iconBg = card.isEvolution
                  ? "bg-amber-500/20 text-amber-300"
                  : card.kind === "newWeapon"
                    ? "bg-emerald-500/20 text-emerald-300"
                    : card.kind === "stat"
                      ? "bg-violet-500/20 text-violet-300"
                      : "bg-sky-500/20 text-sky-300";
                const icon =
                  card.kind === "stat"
                    ? (STAT_ICON[card.statId ?? ""] ?? "")
                    : (WEAPON_ICON[card.weaponId ?? "bolt"] ?? "");
                btn.className = `animate-fade-slide-in w-full rounded-lg border ${accent} px-3 py-2 text-left text-sm text-white`;
                btn.innerHTML = `
                  <span class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${iconBg}">
                      ${sizedIcon(icon, "h-5 w-5")}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center gap-1.5">
                        <span class="font-medium">${card.title}</span>
                        ${
                          card.kind === "newWeapon"
                            ? '<span class="rounded-full bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-300">NEW</span>'
                            : ""
                        }
                        ${
                          card.isEvolution
                            ? `<span class="text-amber-300">${sizedIcon(EVOLUTION_ICON, "h-3.5 w-3.5")}</span>`
                            : ""
                        }
                      </span>
                      <span class="block text-xs text-slate-400">${card.description}</span>
                    </span>
                  </span>
                `;
                btn.addEventListener("click", () => {
                  if (chosen) return;
                  chosen = true;
                  log.log("levelup card chosen", card.id);
                  levelUpOverlay!.classList.add("hidden");
                  levelUpOverlay!.classList.remove("flex");
                  choose(card.id);
                });
                levelUpCardsEl.appendChild(btn);
              }
              levelUpOverlay!.classList.remove("hidden");
              levelUpOverlay!.classList.add("flex");
            },
          },
          {
            durationS,
            upgradeEffects,
            powerIndex,
            reduceMotion: isReducedMotion(),
          },
        );
      });

      backToLobbyButton.addEventListener("click", () => {
        activeGame?.stop();
        activeGame = null;
        showLobby();
      });

      showLobby();
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
