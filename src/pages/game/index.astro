---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Game"
  description="An in-site survival game, earned by making real progress on the curriculum."
>
  <div
    data-game-root
    class="relative mx-auto flex w-full max-w-5xl flex-col items-center gap-4"
  >
    <div class="flex w-full items-center justify-between">
      <h1 class="text-xl font-semibold">Game</h1>
      <button
        type="button"
        data-fullscreen-toggle
        title="Fullscreen"
        aria-label="Toggle fullscreen"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      ></button>
    </div>

    <div data-lobby class="flex w-full flex-col gap-5">
      <section
        class="relative overflow-hidden rounded-3xl border-2 border-slate-900 bg-slate-900 text-white shadow-[0_6px_0_#020617]"
      >
        <canvas
          data-hero-stage
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
        <div
          class="relative z-10 flex flex-col gap-4 p-6 sm:p-8 md:max-w-[58%]"
        >
          <div class="flex items-center justify-between gap-2">
            <span
              class="-rotate-2 rounded-md border-2 border-slate-950 bg-yellow-300 px-2 py-0.5 text-[11px] font-black tracking-widest text-slate-900 uppercase shadow-[0_2px_0_#020617]"
              >Survival mode</span
            >
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-mute-toggle
                title="Sound"
                aria-label="Toggle sound"
                class="flex h-9 w-9 items-center justify-center rounded-xl border-2 border-slate-600 bg-slate-800 text-slate-200 shadow-[0_3px_0_#020617] transition hover:border-slate-300"
              >
              </button>
              <button
                type="button"
                data-motion-toggle
                title="Visual effects"
                aria-label="Toggle visual effects"
                class="flex h-9 w-9 items-center justify-center rounded-xl border-2 border-slate-600 bg-slate-800 text-slate-200 shadow-[0_3px_0_#020617] transition hover:border-slate-300"
              >
              </button>
            </div>
          </div>
          <h2
            class="text-4xl leading-[0.95] font-black tracking-tight sm:text-5xl"
          >
            Survive<br /><span class="text-sky-300">the run</span>
          </h2>
          <p class="max-w-xs text-sm text-slate-300">
            WASD or drag to move — weapons auto-fire. Level up, pick a build,
            outlast the boss.
          </p>
          <button
            type="button"
            data-start-button
            class="group flex h-16 w-full max-w-sm items-center justify-center gap-3 rounded-2xl border-2 border-[#082f49] bg-sky-400 text-xl font-black tracking-wide text-slate-900 uppercase shadow-[0_6px_0_#082f49] transition hover:-translate-y-0.5 hover:brightness-105 active:translate-y-1 active:shadow-[0_2px_0_#082f49] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0 disabled:hover:brightness-100"
          >
            <span data-icon-play></span>
            <span>Start run</span>
          </button>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <div
              data-token-tiles
              title="Runs available — earned by marking curriculum units done"
              class="flex flex-wrap items-center gap-1.5"
            >
            </div>
            <p class="text-sm text-slate-300">
              <span
                class="font-extrabold text-white tabular-nums"
                data-lobby-tokens>0</span
              > runs ready · <span
                class="font-extrabold text-white tabular-nums"
                data-lobby-duration>60s</span
              > each
            </p>
          </div>
          <p
            data-lobby-zero-message
            class="hidden text-sm font-bold text-amber-300"
          >
            No runs left —
            <a href="/roadmap" class="underline">finish a unit</a> to earn one.
          </p>
        </div>
      </section>

      <div class="grid items-start gap-5 lg:grid-cols-[7fr_5fr]">
        <div
          class="flex flex-col gap-3 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
        >
          <div class="flex items-center justify-between gap-2">
            <span
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
              >Upgrades</span
            >
            <span
              title="Coins earned in-game — spend them here"
              class="inline-flex items-center gap-1.5 rounded-full border-2 border-amber-800/40 bg-amber-100 px-3 py-1 text-sm font-extrabold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300"
            >
              <span data-icon-lobby-coins></span>
              <span class="tabular-nums" data-lobby-coins>0</span>
              <span class="text-xs font-bold">coins</span>
            </span>
          </div>
          <div
            data-shop-rows
            class="grid w-full grid-cols-1 gap-2 min-[420px]:grid-cols-2"
          >
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <div
            class="flex flex-col gap-2 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
          >
            <span
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
              >Best survival</span
            >
            <span
              class="text-4xl leading-none font-black tabular-nums"
              data-lobby-best>--</span
            >
            <div
              class="h-3.5 w-full overflow-hidden rounded-full border-2 border-slate-900 bg-slate-200 dark:bg-slate-700"
            >
              <div
                data-best-bar
                class="h-full bg-emerald-500 transition-[width] duration-300"
                style="width: 0%"
              >
              </div>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400"
              >Against this run's length. Finish units to extend it.</span
            >
          </div>

          <div
            class="flex flex-col gap-3 rounded-2xl border-2 border-slate-300 bg-white p-5 shadow-[0_5px_0_#cbd5e1] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_5px_0_#334155]"
          >
            <p
              class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
            >
              Unlocks
            </p>
            <div data-shop-unlock-rows class="flex w-full flex-col gap-2"></div>
          </div>

          <details
            class="group rounded-2xl border-2 border-dashed border-slate-300 bg-white p-4 dark:border-slate-700 dark:bg-slate-900"
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
            >
              Balance lab
              <span class="text-[10px] font-bold normal-case group-open:hidden"
                >show</span
              >
            </summary>
            <div class="mt-3 flex flex-col gap-3">
              <p class="text-xs text-slate-500 dark:text-slate-400">
                One weapon, nothing can hurt you. Enemies stop at the distance
                you pick, so you see which weapons still kill and what they ask
                of you. The drain stands in for incoming damage to judge
                recovery.
              </p>
              <div class="grid grid-cols-2 gap-2">
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Weapon
                  <select
                    data-training-weapon
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="bolt">Bolt</option>
                    <option value="homingDart">Homing Dart</option>
                    <option value="chainLightning">Chain Lightning</option>
                    <option value="novaPulse">Nova Pulse</option>
                    <option value="orbitShield">Orbit Shield</option>
                    <option value="bladeArc">Blade Arc</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Level
                  <select
                    data-training-level
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6 (evolved)</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >Enemies keep away
                  <select
                    data-training-standoff
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="0">0 px (touching)</option>
                    <option value="40">40 px</option>
                    <option value="80" selected>80 px</option>
                    <option value="120">120 px</option>
                    <option value="160">160 px</option>
                  </select>
                </label>
                <label
                  class="flex flex-col gap-1 text-xs font-bold text-slate-500 dark:text-slate-400"
                  >HP drain
                  <select
                    data-training-drain
                    class="w-full rounded-lg border-2 border-slate-300 bg-white px-2 py-1.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-950"
                  >
                    <option value="0" selected>None</option>
                    <option value="10">10 HP/s</option>
                    <option value="20">20 HP/s</option>
                    <option value="30">30 HP/s</option>
                  </select>
                </label>
              </div>
              <button
                type="button"
                data-training-start
                class="flex h-11 w-full items-center justify-center rounded-xl border-2 border-slate-300 bg-white text-sm font-extrabold shadow-[0_3px_0_#cbd5e1] transition hover:border-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_3px_0_#334155] dark:hover:border-slate-300"
              >
                Start training — no run needed
              </button>
            </div>
          </details>
        </div>
      </div>
    </div>

    <div
      data-play-area
      class="mx-auto hidden w-full max-w-none flex-col items-center gap-3"
    >
      <div
        class="relative mx-auto"
        style="width: min(100%, calc((100svh - var(--chrome, 9rem)) * var(--aspect, 0.84)), 1180px); container-type: inline-size;"
      >
        <div
          data-hud
          class="pointer-events-none absolute inset-x-2 top-2 z-[5] flex flex-col gap-1.5 rounded-xl border-2 border-slate-900/70 bg-white/60 px-2.5 py-2 text-slate-800 backdrop-blur-sm"
        >
          <div class="flex items-center gap-3">
            <div class="flex min-w-0 flex-1 items-center gap-2">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-rose-300"
                data-icon-hp></span>
              <div
                class="h-4 flex-1 overflow-hidden rounded-full border-2 border-slate-900 bg-white/70"
              >
                <div
                  data-hud-hp-bar
                  class="h-full rounded-full bg-rose-400 transition-[width] duration-200"
                  style="width: 100%"
                >
                </div>
              </div>
              <span
                data-hud-hp
                class="shrink-0 text-xs font-bold tabular-nums text-slate-600"
                >--/--</span
              >
            </div>
            <span class="flex shrink-0 items-center gap-1.5 text-sm">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-sky-300"
                data-icon-timer></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-timer
                >--</span
              >
            </span>
          </div>
          <div class="flex items-center justify-between gap-1 text-xs">
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-yellow-300"
                data-icon-level></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-level
                >1</span
              >
            </span>
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-slate-300"
                data-icon-kills></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-kills
                >0</span
              >
            </span>
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-violet-300"
                data-icon-gems></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-gems
                >0</span
              >
            </span>
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-amber-300"
                data-icon-coins></span>
              <span class="font-bold tabular-nums text-slate-800" data-hud-coins
                >0</span
              >
            </span>
            <span class="flex items-center gap-1.5">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-900 text-slate-900 shadow-[0_2px_0_#020617] bg-orange-300"
                data-icon-threat></span>
              <span
                class="font-bold tabular-nums text-slate-800"
                data-hud-threat>1</span
              >
            </span>
          </div>
          <div
            class="h-3 w-full overflow-hidden rounded-full border-2 border-slate-900 bg-white/70"
          >
            <div
              data-hud-xp-bar
              class="h-full rounded-full bg-violet-400 transition-[width] duration-200"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <canvas
          data-game-canvas
          width="840"
          height="1000"
          style="aspect-ratio: 420 / 500;"
          class="block h-auto w-full rounded-2xl border-2 border-slate-900 bg-slate-900 shadow-[0_5px_0_#cbd5e1] dark:border-slate-600 dark:shadow-[0_5px_0_#334155]"
        ></canvas>
        <div class="pointer-events-none absolute inset-x-2 bottom-2 z-[5]">
          <div data-hud-weapons class="flex flex-wrap items-center gap-1.5">
          </div>
        </div>

        <div
          data-threat-toast
          class="animate-fade-slide-in pointer-events-none absolute top-[6.5rem] left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-full border-2 border-slate-900 bg-orange-300 shadow-[0_3px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-threat-toast></span>
            <span data-threat-toast-text>Threat rising</span>
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-threat-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 2200ms"></span>
          </span>
        </div>

        <div
          data-boss-toast
          class="animate-fade-slide-in pointer-events-none absolute top-[10rem] left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-xl border-2 border-slate-900 bg-red-300 shadow-[0_4px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-boss-toast></span>
            <span class="text-sm font-black tracking-wide uppercase"
              >Boss incoming</span
            >
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-boss-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 3200ms"></span>
          </span>
        </div>

        <div
          data-synergy-toast
          class="animate-fade-slide-in pointer-events-none absolute top-[6.5rem] left-1/2 z-10 hidden -translate-x-1/2 flex-col overflow-hidden rounded-full border-2 border-slate-900 bg-fuchsia-300 shadow-[0_3px_0_#020617]"
        >
          <span
            class="flex items-center gap-1.5 px-3 pt-1 pb-1 text-xs font-bold text-slate-900"
          >
            <span
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-900/10"
              data-icon-synergy-toast></span>
            <span data-synergy-toast-text>Synergy!</span>
          </span>
          <span class="h-[3px] w-full bg-slate-900/15">
            <span
              data-synergy-toast-bar
              class="animate-toast-timer block h-full bg-slate-900"
              style="animation-duration: 2600ms"></span>
          </span>
        </div>

        <div
          data-lowhp-vignette
          class="pointer-events-none absolute inset-0 hidden rounded-2xl"
          style="box-shadow: inset 0 0 40px 10px rgba(244, 63, 94, 0.9);"
        >
        </div>

        <div
          data-levelup-overlay
          class="absolute inset-0 z-20 hidden flex-col items-center justify-center gap-3 overflow-y-auto rounded-lg bg-slate-950/90 p-4"
        >
          <p
            class="animate-pop -rotate-2 rounded-lg border-2 border-slate-900 bg-yellow-300 px-4 py-1 text-base font-black tracking-wide text-slate-900 uppercase shadow-[0_4px_0_#020617]"
          >
            Level up!
          </p>
          <p class="text-xs font-bold tracking-widest text-slate-300 uppercase">
            Pick one
          </p>
          <div
            data-levelup-cards
            class="flex w-full flex-col gap-[0.6em]"
            style="font-size: clamp(14px, 3.1cqw, 24px)"
          >
          </div>
        </div>
      </div>

      <div
        data-training-panel
        class="hidden w-full flex-col gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-white p-3 dark:border-slate-700 dark:bg-slate-900"
      >
        <div class="flex items-center justify-between gap-2">
          <span
            class="text-xs font-extrabold tracking-widest text-slate-500 uppercase dark:text-slate-400"
            >Balance lab</span
          >
          <button
            type="button"
            data-training-stop
            class="rounded-full border-2 border-slate-300 px-3 py-0.5 text-xs font-bold hover:border-slate-900 dark:border-slate-700 dark:hover:border-slate-300"
            >Stop</button
          >
        </div>
        <p
          data-training-meta
          class="text-xs text-slate-500 dark:text-slate-400"
        >
        </p>
        <div data-training-rows></div>
      </div>
    </div>

    <div
      data-results
      class="mx-auto hidden w-full max-w-lg flex-col items-center gap-3 rounded-2xl border-2 border-slate-900 bg-emerald-100 px-4 py-6 text-center text-slate-900 shadow-[0_5px_0_#020617]"
    >
      <div class="flex items-end gap-1.5" data-results-stars></div>
      <p class="text-2xl font-black tracking-tight" data-results-headline>
        Run ended
      </p>
      <p class="text-xs font-semibold text-slate-700" data-results-cause></p>
      <div
        class="grid w-full grid-cols-2 gap-2 text-sm sm:grid-cols-4"
        data-results-stats
      >
        <div
          class="flex items-center gap-2.5 rounded-xl border-2 border-slate-900 bg-sky-100 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-600 dark:text-sky-400"
            data-icon-results-time></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-time
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-sky-700/80 uppercase dark:text-sky-400/80"
              >survived</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl border-2 border-slate-900 bg-slate-100 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-500/20 text-slate-600 dark:text-slate-300"
            data-icon-results-kills></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-kills
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-slate-600/80 uppercase dark:text-slate-400/80"
              >kills</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl border-2 border-slate-900 bg-yellow-100 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-yellow-500/20 text-yellow-600 dark:text-yellow-400"
            data-icon-results-level></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-level
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-yellow-700/80 uppercase dark:text-yellow-400/80"
              >level</span
            >
          </span>
        </div>
        <div
          class="flex items-center gap-2.5 rounded-xl border-2 border-slate-900 bg-amber-100 px-3 py-2"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400"
            data-icon-results-coins></span>
          <span class="leading-tight">
            <span class="block font-semibold tabular-nums" data-results-coins
              >--</span
            >
            <span
              class="block text-[9px] font-medium tracking-wide text-amber-700/80 uppercase dark:text-amber-400/80"
              >coins</span
            >
          </span>
        </div>
      </div>
      <div data-results-training class="hidden w-full"></div>
      <p
        data-results-record
        class="animate-pop hidden inline-flex items-center gap-1.5 rounded-full border-2 border-slate-900 bg-yellow-300 px-3 py-0.5 text-sm font-extrabold text-slate-900"
      >
        <span data-icon-record></span>
        <span>New best time!</span>
      </p>
      <button
        type="button"
        data-back-to-lobby-button
