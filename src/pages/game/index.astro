---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Game"
  description="An in-site survival game, earned by making real progress on the curriculum."
>
  <div class="mx-auto flex max-w-lg flex-col items-center gap-4">
    <h1 class="text-xl font-semibold">Game</h1>

    <div
      data-lobby
      class="flex w-full flex-col items-center gap-4 rounded-lg border border-slate-200 bg-white/60 px-4 py-6 text-center dark:border-slate-800 dark:bg-slate-900/40"
    >
      <p class="text-sm text-slate-600 dark:text-slate-400">
        WASD / arrow keys to move, weapons auto-fire. Playing costs a token —
        earn one every time you mark a curriculum level done (see <code
          >docs/GAME-DESIGN.md</code
        >). Runs get longer the more units you've fully completed.
      </p>

      <div class="flex items-center justify-center gap-6">
        <div>
          <div class="text-2xl font-semibold" data-lobby-tokens>0</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">tokens</div>
        </div>
        <div>
          <div class="text-2xl font-semibold" data-lobby-duration>60s</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">
            run length
          </div>
        </div>
        <div>
          <div class="text-2xl font-semibold" data-lobby-best>--</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">
            best time
          </div>
        </div>
      </div>

      <p
        data-lobby-zero-message
        class="hidden text-sm text-amber-600 dark:text-amber-400"
      >
        No tokens yet —
        <a href="/roadmap" class="underline">mark a curriculum level done</a>
        to earn one.
      </p>

      <button
        type="button"
        data-start-button
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:hover:border-slate-500"
      >
        Start run (1 token)
      </button>
    </div>

    <div data-play-area class="hidden w-full flex-col items-center gap-4">
      <div
        class="sticky top-14 z-[5] flex w-full flex-col gap-1 rounded-lg border border-slate-200 bg-white/95 px-3 py-2 text-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95"
      >
        <div class="flex items-center justify-between">
          <span data-hud-hp>HP: --/--</span>
          <span data-hud-level>Lv 1 (XP 0/20)</span>
          <span data-hud-timer>Time: --</span>
        </div>
        <div class="flex items-center justify-between">
          <span data-hud-kills>Kills: 0</span>
          <span data-hud-gems>Gems: 0</span>
        </div>
        <div
          data-hud-weapons
          class="truncate text-xs text-slate-500 dark:text-slate-400"
        >
          Weapons: —
        </div>
      </div>

      <div class="relative w-full">
        <canvas
          data-game-canvas
          width="420"
          height="500"
          style="aspect-ratio: 420 / 500;"
          class="h-[min(58vh,500px)] w-auto rounded-lg border border-slate-300 bg-slate-900 dark:border-slate-700"
        ></canvas>

        <div
          data-levelup-overlay
          class="absolute inset-0 hidden flex-col items-center justify-center gap-3 rounded-lg bg-slate-950/90 p-4"
        >
          <p class="text-sm font-medium text-white">Choose an upgrade</p>
          <div data-levelup-cards class="flex w-full flex-col gap-2"></div>
        </div>
      </div>
    </div>

    <div
      data-results
      class="hidden w-full flex-col items-center gap-3 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-6 text-center dark:border-emerald-800 dark:bg-emerald-950"
    >
      <p class="text-lg font-semibold" data-results-headline>Run ended</p>
      <div class="grid w-full grid-cols-3 gap-2 text-sm" data-results-stats>
        <div>
          <div class="font-semibold" data-results-time>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">survived</div>
        </div>
        <div>
          <div class="font-semibold" data-results-kills>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">kills</div>
        </div>
        <div>
          <div class="font-semibold" data-results-level>--</div>
          <div class="text-xs text-slate-600 dark:text-slate-400">
            level reached
          </div>
        </div>
      </div>
      <p
        data-results-record
        class="hidden text-sm font-medium text-emerald-700 dark:text-emerald-400"
      >
        New best time!
      </p>
      <p class="text-xs text-slate-600 dark:text-slate-400">
        Coins & the permanent shop arrive in a future update.
      </p>
      <button
        type="button"
        data-back-to-lobby-button
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500"
      >
        Back to lobby
      </button>
    </div>
  </div>

  <script>
    import { startGame } from "../../lib/game/engine";
    import { createLogger } from "../../lib/game/logger";
    import {
      getTokenCount,
      getBestTimeS,
      computeRunDurationS,
      consumeToken,
      recordRunResult,
    } from "../../lib/game/tokens";

    const log = createLogger("page");

    function formatTime(s: number): string {
      return `${s.toFixed(1)}s`;
    }

    function init() {
      const lobby = document.querySelector<HTMLElement>("[data-lobby]");
      const playArea = document.querySelector<HTMLElement>("[data-play-area]");
      const results = document.querySelector<HTMLElement>("[data-results]");
      const canvas =
        document.querySelector<HTMLCanvasElement>("[data-game-canvas]");
      const startButton = document.querySelector<HTMLButtonElement>(
        "[data-start-button]",
      );
      const backToLobbyButton = document.querySelector<HTMLButtonElement>(
        "[data-back-to-lobby-button]",
      );
      const lobbyTokensEl = document.querySelector<HTMLElement>(
        "[data-lobby-tokens]",
      );
      const lobbyDurationEl = document.querySelector<HTMLElement>(
        "[data-lobby-duration]",
      );
      const lobbyBestEl =
        document.querySelector<HTMLElement>("[data-lobby-best]");
      const lobbyZeroMessage = document.querySelector<HTMLElement>(
        "[data-lobby-zero-message]",
      );
      const resultsHeadline = document.querySelector<HTMLElement>(
        "[data-results-headline]",
      );
      const resultsTime = document.querySelector<HTMLElement>(
        "[data-results-time]",
      );
      const resultsKills = document.querySelector<HTMLElement>(
        "[data-results-kills]",
      );
      const resultsLevel = document.querySelector<HTMLElement>(
        "[data-results-level]",
      );
      const resultsRecord = document.querySelector<HTMLElement>(
        "[data-results-record]",
      );
      const hpEl = document.querySelector<HTMLElement>("[data-hud-hp]");
      const timerEl = document.querySelector<HTMLElement>("[data-hud-timer]");
      const killsEl = document.querySelector<HTMLElement>("[data-hud-kills]");
      const gemsEl = document.querySelector<HTMLElement>("[data-hud-gems]");
      const levelEl = document.querySelector<HTMLElement>("[data-hud-level]");
      const weaponsEl =
        document.querySelector<HTMLElement>("[data-hud-weapons]");
      const levelUpOverlay = document.querySelector<HTMLElement>(
        "[data-levelup-overlay]",
      );
      const levelUpCardsEl = document.querySelector<HTMLElement>(
        "[data-levelup-cards]",
      );
      if (
        !lobby ||
        !playArea ||
        !results ||
        !canvas ||
        !startButton ||
        !backToLobbyButton ||
        !lobbyTokensEl ||
        !lobbyDurationEl ||
        !lobbyBestEl ||
        !lobbyZeroMessage ||
        !resultsHeadline ||
        !resultsTime ||
        !resultsKills ||
        !resultsLevel ||
        !resultsRecord ||
        !hpEl ||
        !timerEl ||
        !killsEl ||
        !gemsEl ||
        !levelEl ||
        !weaponsEl ||
        !levelUpOverlay ||
        !levelUpCardsEl
      ) {
        log.error("missing expected DOM nodes, aborting init");
        return;
      }

      function showLobby() {
        lobby!.classList.remove("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        renderLobby();
      }

      function renderLobby() {
        const tokens = getTokenCount();
        const duration = computeRunDurationS();
        const best = getBestTimeS();
        lobbyTokensEl!.textContent = String(tokens);
        lobbyDurationEl!.textContent = `${duration}s`;
        lobbyBestEl!.textContent = best > 0 ? formatTime(best) : "--";
        lobbyZeroMessage!.classList.toggle("hidden", tokens >= 1);
        startButton!.disabled = tokens < 1;
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";
      backToLobbyButton.dataset.wired = "true";

      let activeGame: ReturnType<typeof startGame> | null = null;

      startButton.addEventListener("click", () => {
        if (!consumeToken()) {
          log.warn("start clicked with 0 tokens — should have been disabled");
          renderLobby();
          return;
        }
        log.log("start button clicked");
        levelUpOverlay!.classList.add("hidden");
        levelUpOverlay!.classList.remove("flex");
        lobby!.classList.add("hidden");
        playArea!.classList.remove("hidden");
        playArea!.classList.add("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");

        const durationS = computeRunDurationS();
        activeGame?.stop();
        activeGame = startGame(
          canvas,
          {
            onHudUpdate(state) {
              hpEl.textContent = `HP: ${Math.round(state.hp)}/${Math.round(state.maxHp)}`;
              timerEl.textContent = `Time: ${state.timeRemaining.toFixed(1)}s`;
              killsEl.textContent = `Kills: ${state.kills}`;
              gemsEl.textContent = `Gems: ${state.gems}`;
              levelEl.textContent = `Lv ${state.level} (XP ${Math.round(
                state.xp,
              )}/${state.xpToNext})`;
              weaponsEl.textContent = `Weapons: ${state.weapons
                .map((w) => `${w.id} L${w.level}`)
                .join(", ")}`;
            },
            onGameOver(summary) {
              log.log("onGameOver callback", summary);
              const isRecord = recordRunResult(summary.survivedS);
              resultsHeadline.textContent = `Run ended — survived ${formatTime(
                summary.survivedS,
              )} / ${durationS}s`;
              resultsTime.textContent = formatTime(summary.survivedS);
              resultsKills.textContent = String(summary.kills);
              resultsLevel.textContent = String(summary.level);
              resultsRecord.classList.toggle("hidden", !isRecord);
              playArea!.classList.add("hidden");
              playArea!.classList.remove("flex");
              results!.classList.remove("hidden");
              results!.classList.add("flex");
            },
            onLevelUp(cards, choose) {
              log.log("onLevelUp callback", cards);
              levelUpCardsEl.innerHTML = "";
              let chosen = false;
              for (const card of cards) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className =
                  "w-full rounded-lg border border-slate-600 bg-slate-900/80 px-3 py-2 text-left text-sm text-white hover:border-slate-400";
                btn.innerHTML = `<span class="block font-medium">${card.title}</span><span class="block text-xs text-slate-400">${card.description}</span>`;
                btn.addEventListener("click", () => {
                  if (chosen) return;
                  chosen = true;
                  log.log("levelup card chosen", card.id);
                  levelUpOverlay!.classList.add("hidden");
                  levelUpOverlay!.classList.remove("flex");
                  choose(card.id);
                });
                levelUpCardsEl.appendChild(btn);
              }
              levelUpOverlay!.classList.remove("hidden");
              levelUpOverlay!.classList.add("flex");
            },
          },
          { durationS },
        );
      });

      backToLobbyButton.addEventListener("click", () => {
        activeGame?.stop();
        activeGame = null;
        showLobby();
      });

      showLobby();
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
