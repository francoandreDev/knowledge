  <script>
    import { startGame, type TrainingOptions } from "../../lib/game/engine";
    import { maxRecoveryHps } from "../../lib/game/balance";
    import { createLogger } from "../../lib/game/logger";
    import { startDuel, WEAPON_NAME } from "../../lib/game/duelView";
