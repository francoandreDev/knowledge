        "[data-levelup-cards]",
      );
      if (
        !gameRoot ||
        !fullscreenToggle ||
        !lobby ||
        !playArea ||
        !results ||
        !canvas ||
        !startButton ||
        !backToLobbyButton ||
        !lobbyTokensEl ||
        !lobbyDurationEl ||
        !lobbyBestEl ||
        !lobbyZeroMessage ||
        !lobbyCoinsEl ||
        !muteToggle ||
        !motionToggle ||
        !shopRowsEl ||
        !shopUnlockRowsEl ||
        !resultsHeadline ||
        !resultsTime ||
        !resultsKills ||
        !resultsLevel ||
        !resultsCoins ||
        !resultsRecord ||
        !resultsCause ||
        !hpEl ||
        !hpBarEl ||
        !timerEl ||
        !killsEl ||
        !gemsEl ||
        !coinsEl ||
        !levelEl ||
        !xpBarEl ||
        !weaponsEl ||
        !trainingPanel ||
        !trainingMeta ||
        !trainingRows ||
        !trainingStop ||
        !trainingStart ||
        !resultsTraining ||
        !resultsStats ||
        !threatEl ||
        !threatToastEl ||
        !threatToastTextEl ||
        !bossToastEl ||
        !synergyToastEl ||
        !synergyToastTextEl ||
        !lowHpVignetteEl ||
        !levelUpOverlay ||
        !levelUpCardsEl
      ) {
        log.error("missing expected DOM nodes, aborting init");
        return;
      }

      // Populate the static (never-change) icon slots once — the HUD/lobby/
      // results markup carries empty <span data-icon-*> placeholders so the
      // .astro template doesn't need to embed raw SVG strings inline.
      function setIcon(selector: string, svg: string, size = "h-4 w-4") {
        const el = document.querySelector<HTMLElement>(selector);
        if (el) el.innerHTML = sizedIcon(svg, size);
      }
      setIcon("[data-icon-tokens]", UI_ICON.tokens);
      setIcon("[data-icon-duration]", UI_ICON.timer);
      setIcon("[data-icon-best]", UI_ICON.trophy);
      setIcon("[data-icon-lobby-coins]", UI_ICON.coins);
      setIcon("[data-icon-play]", UI_ICON.play, "h-4 w-4");
      setIcon("[data-icon-hp]", UI_ICON.hp, "h-4 w-4");
      setIcon("[data-icon-timer]", UI_ICON.timer, "h-3.5 w-3.5");
      setIcon("[data-icon-level]", UI_ICON.level, "h-3.5 w-3.5");
      setIcon("[data-icon-kills]", UI_ICON.kills, "h-3.5 w-3.5");
      setIcon("[data-icon-gems]", UI_ICON.gems, "h-3.5 w-3.5");
      setIcon("[data-icon-coins]", UI_ICON.coins, "h-3.5 w-3.5");
      setIcon("[data-icon-threat]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-threat-toast]", UI_ICON.threat, "h-3.5 w-3.5");
      setIcon("[data-icon-boss-toast]", UI_ICON.warning, "h-3.5 w-3.5");
      setIcon("[data-icon-synergy-toast]", UI_ICON.synergy, "h-3.5 w-3.5");
      setIcon("[data-icon-results-time]", UI_ICON.timer, "h-4 w-4");
      setIcon("[data-icon-results-kills]", UI_ICON.kills, "h-4 w-4");
      setIcon("[data-icon-results-level]", UI_ICON.level, "h-4 w-4");
      setIcon("[data-icon-results-coins]", UI_ICON.coins, "h-4 w-4");
      setIcon("[data-icon-record]", UI_ICON.trophy, "h-4 w-4");
      setIcon("[data-icon-back]", UI_ICON.back, "h-4 w-4");

      const WEAPON_LABEL: Record<string, string> = {
        bolt: "Bolt",
        homingDart: "Homing Dart",
        chainLightning: "Chain Lightning",
        meteorRain: "Meteor Rain",
        gravityWell: "Gravity Well",
        flameTrail: "Flame Trail",
        sentryTotem: "Sentry Totem",
        novaPulse: "Nova Pulse",
        orbitShield: "Orbit Shield",
        bladeArc: "Blade Arc",
      };

      // Per-weapon totals and rates — kills and damage are what a weapon
      // earns, the enemy distance you picked is what it cost you.
      function trainingTable(
        weapons: { id: string; level: number; kills: number; damage: number }[],
        elapsedS: number,
      ): string {
        const minutes = Math.max(elapsedS, 1) / 60;
        const cell = "px-2 py-1 text-right tabular-nums";
        const rows = weapons
          .map(
            (w) => `<tr>
              <td class="px-2 py-1 text-left font-bold">${WEAPON_LABEL[w.id] ?? w.id} <span class="text-slate-500">L${w.level}</span></td>
              <td class="${cell}">${w.kills}</td>
              <td class="${cell}">${(w.kills / minutes).toFixed(1)}</td>
              <td class="${cell}">${w.damage}</td>
              <td class="${cell}">${(w.damage / Math.max(elapsedS, 1)).toFixed(1)}</td>
            </tr>`,
          )
          .join("");
        return `<table class="w-full text-xs">
          <thead class="text-slate-500"><tr>
            <th class="px-2 py-1 text-left font-medium">Weapon</th>
            <th class="px-2 py-1 text-right font-medium">Kills</th>
            <th class="px-2 py-1 text-right font-medium">Kills/min</th>
            <th class="px-2 py-1 text-right font-medium">Damage</th>
            <th class="px-2 py-1 text-right font-medium">Dmg/s</th>
          </tr></thead><tbody>${rows}</tbody></table>`;
      }

      // --- Duel (1v1) ---------------------------------------------------
      const duelArea = document.querySelector<HTMLElement>("[data-duel-area]")!;
      const duelCanvas =
        document.querySelector<HTMLCanvasElement>("[data-duel-canvas]")!;
      const duelResultsEl = document.querySelector<HTMLElement>(
        "[data-duel-results]",
      )!;
      let activeDuel: ReturnType<typeof startDuel> | null = null;
      const DUEL_RECORD_KEY = "duel:record";
      function readDuelRecord(): { w: number; l: number } {
        try {
          const raw = JSON.parse(localStorage.getItem(DUEL_RECORD_KEY) ?? "{}");
          return { w: Number(raw.w) || 0, l: Number(raw.l) || 0 };
        } catch {
          return { w: 0, l: 0 };
        }
      }
      function renderDuelRecord() {
        const r = readDuelRecord();
        const el = document.querySelector<HTMLElement>("[data-duel-record]");
        if (el) el.textContent = `${r.w} – ${r.l}`;
      }
      function stopDuel() {
        activeDuel?.stop();
        activeDuel = null;
        duelResultsEl.classList.add("hidden");
        duelResultsEl.classList.remove("flex");
        duelArea.classList.add("hidden");
        duelArea.classList.remove("flex");
      }
      function startDuelMatch() {
        closePanels();
        unlockAudio();
        const pick = (q: string) =>
          document.querySelector<HTMLSelectElement>(q)!.value;
        const weaponId = pick("[data-duel-weapon]") as WeaponId;
        const rivalPick = pick("[data-duel-rival]");
        const others = DUEL_WEAPONS.filter((w) => w !== weaponId);
        const rivalWeaponId = (
          rivalPick === "mirror"
            ? weaponId
            : rivalPick === "different"
              ? others[Math.floor(Math.random() * others.length)]
              : rivalPick
        ) as WeaponId;
        const level = Number(pick("[data-duel-level]"));
        const difficulty = pick("[data-duel-difficulty]") as Difficulty;
        activeGame?.stop();
        activeGame = null;
        lobby!.classList.add("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        duelResultsEl.classList.add("hidden");
        duelResultsEl.classList.remove("flex");
        duelArea.classList.remove("hidden");
        duelArea.classList.add("flex");
        duelCanvas.parentElement!.style.setProperty(
          "--chrome",
          document.fullscreenElement ? "4.5rem" : "9rem",
        );
        activeDuel?.stop();
        activeDuel = startDuel(
          duelCanvas,
          {
            weaponId,
            level,
            rivalWeaponId,
            difficulty,
            renderScale: 2,
            reduceMotion: isReducedMotion(),
          },
          {
            onMatchEnd(summary) {
              const rec = readDuelRecord();
              if (summary.won) rec.w += 1;
              else rec.l += 1;
              try {
                localStorage.setItem(DUEL_RECORD_KEY, JSON.stringify(rec));
              } catch {
                /* storage can be unavailable; the record is a convenience */
              }
              const head = duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-headline]",
              )!;
              head.textContent = summary.won ? "Victory!" : "Defeated";
              head.className = head.className.replace(
                /bg-\S+/,
                summary.won ? "bg-yellow-300" : "bg-rose-300",
              );
              duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-rounds]",
              )!.innerHTML = summary.rounds
                .map((r, i) => {
                  const tone =
                    r.winner === 0
                      ? "bg-sky-300"
                      : r.winner === 1
                        ? "bg-rose-300"
                        : "bg-slate-300";
                  const what =
                    r.winner === 0 ? "Won" : r.winner === 1 ? "Lost" : "Draw";
                  return `<span class="rounded-lg border-2 border-slate-900 ${tone} px-[0.7em] py-[0.2em] text-[0.8em] font-black text-slate-900">R${i + 1} · ${what} · ${r.timeS}s</span>`;
                })
                .join("");
              duelResultsEl.querySelector<HTMLElement>(
                "[data-duel-stats]",
              )!.textContent =
                `${WEAPON_NAME[weaponId]} L${level} vs ${WEAPON_NAME[rivalWeaponId]} · you dealt ${summary.damageDealt} damage and took ${summary.hitsTaken} hits`;
              duelResultsEl.classList.remove("hidden");
              duelResultsEl.classList.add("flex");
              renderDuelRecord();
            },
          },
        );
      }

      let shownLevel = 1;
      // Screen change cover: a sticker-coloured panel sweeps across, the
      // change happens behind it, then it sweeps off. Skipped with reduced
      // motion; a second click while one is running is ignored.
      let wiping = false;
      function wipeTo(change: () => void) {
        const wipeEl = document.querySelector<HTMLElement>("[data-wipe]");
        const panel = wipeEl?.firstElementChild as HTMLElement | undefined;
        if (!wipeEl || !panel || isReducedMotion()) {
          change();
          return;
        }
        if (wiping) return;
        wiping = true;
        wipeEl.classList.remove("hidden");
        panel.classList.remove("wipe-reveal");
        panel.classList.add("wipe-cover");
        setTimeout(() => {
          change();
          panel.classList.remove("wipe-cover");
          panel.classList.add("wipe-reveal");
          setTimeout(() => {
            wipeEl.classList.add("hidden");
            panel.classList.remove("wipe-reveal");
            wiping = false;
          }, 420);
        }, 340);
      }

      function showLobby() {
        stopDuel();
        clearPause();
        trainingPanel!.classList.add("hidden");
        trainingPanel!.classList.remove("flex");
        lobby!.classList.remove("hidden");
        playArea!.classList.add("hidden");
        playArea!.classList.remove("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");
        renderLobby();
      }

      // The lobby's hero backdrop: the player holds the right side while
      // enemies drift in and pop. Pure decoration; skipped when the lobby is
      // hidden, drawn once (still) with reduced motion.
      function startHeroStage(stage: HTMLCanvasElement) {
        const ctx = stage.getContext("2d");
        if (!ctx) return;
        const KINDS = [
          ["zombie", "#4ade80"],
          ["bat", "#f472b6"],
          ["skeleton", "#e2e8f0"],
          ["ghost", "#a5f3fc"],
          ["ogre", "#f97316"],
          ["slime", "#84cc16"],
          ["imp", "#f43f5e"],
          ["bomber", "#fbbf24"],
          ["knight", "#94a3b8"],
          ["boar", "#b45309"],
          ["shaman", "#16a34a"],
          ["wasp", "#facc15"],
          ["phantom", "#8b5cf6"],
          ["spitter", "#65a30d"],
          ["cultist", "#be123c"],
          ["golem", "#a8a29e"],
        ] as const;
        const foes: {
          kind: (typeof KINDS)[number][0];
          color: string;
          x: number;
          y: number;
          r: number;
        }[] = [];
        const particles: Particle[] = [];
        let w = 0;
        let h = 0;
        let last = performance.now();
        let spawnIn = 0;
        function resize() {
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          w = stage.clientWidth;
          h = stage.clientHeight;
          stage.width = Math.max(1, Math.round(w * dpr));
          stage.height = Math.max(1, Math.round(h * dpr));
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function spawn() {
          const [kind, color] = KINDS[Math.floor(Math.random() * KINDS.length)];
          foes.push({
            kind,
            color,
            x: Math.random() < 0.5 ? -30 : w + 30,
            y: h * (0.3 + Math.random() * 0.5),
            r:
              kind === "ogre" || kind === "knight" || kind === "boar"
                ? 22
                : kind === "wasp"
                  ? 9
                  : 15,
          });
        }
        function frame(now: number) {
          const dt = Math.min(64, now - last);
          last = now;
          if (stage.offsetParent !== null && w > 0) {
            draw(now, dt);
          }
          if (!isReducedMotion()) requestAnimationFrame(frame);
        }
        function draw(now: number, dt: number) {
          const px = w * 0.5;
          const heroR = Math.max(24, Math.min(56, h * 0.085));
          const py = h * 0.64;
          ctx!.clearRect(0, 0, w, h);
          // The ground the fight happens on.
          const groundY = h * 0.78;
          ctx!.fillStyle = "#1b1445";
          ctx!.fillRect(0, groundY, w, h - groundY);
          ctx!.strokeStyle = "#5a4ca8";
          ctx!.lineWidth = 3;
          ctx!.setLineDash([18, 12]);
          ctx!.beginPath();
          ctx!.moveTo(0, groundY);
          ctx!.lineTo(w, groundY);
          ctx!.stroke();
          ctx!.setLineDash([]);
          if (!isReducedMotion()) {
            spawnIn -= dt;
            if (spawnIn <= 0) {
              spawn();
              spawnIn = 700 + Math.random() * 600;
            }
          }
          for (let i = foes.length - 1; i >= 0; i--) {
            const f = foes[i];
            const dx = px - f.x;
            const dy = py - f.y;
            const d = Math.hypot(dx, dy) || 1;
            f.x += (dx / d) * 0.05 * dt;
            f.y += (dy / d) * 0.05 * dt;
            if (d < heroR * 2.4) {
              burst(particles, f.x, f.y, f.color, 9, 170);
              burst(particles, f.x, f.y - f.r, "#ffd447", 4, 230);
              ringPop(particles, f.x, f.y, f.color, f.r * 2.6);
              foes.splice(i, 1);
            }
          }
          for (const f of foes)
            drawEnemy(ctx!, f.kind, f.x, f.y, f.r, f.color, {});
          drawGem(ctx!, w * 0.62, h * 0.8, 6, "#a78bfa");
          drawGem(ctx!, w * 0.9, h * 0.25, 6, "#a78bfa");
          const bob = isReducedMotion() ? 0 : Math.sin(now / 320) * 3;
          const a = now / 700;
          for (let k = 0; k < 2; k++) {
            const ang = a + k * Math.PI;
            const orbitR = heroR * 2.1;
            drawOrbiter(
              ctx!,
              px + Math.cos(ang) * orbitR,
              py + bob + Math.sin(ang) * orbitR,
              heroR * 0.36,
              ang,
            );
          }
          drawPlayer(ctx!, px, py + bob, heroR, "#38bdf8", Math.PI);
          stepParticles(particles, dt);
          drawParticles(ctx!, particles);
        }
        resize();
        window.addEventListener("resize", resize);
        if (isReducedMotion()) {
          for (let i = 0; i < 4; i++) spawn();
          for (const f of foes) f.x = w * (0.35 + Math.random() * 0.3);
        }
        requestAnimationFrame(frame);
      }

      // The level-up screen's "what you have" strip: weapons with level pips,
      // boosts with their stacks. Hovering a card rings the chip it changes.
      function renderBuildPanel(build: LevelUpBuild) {
        const el = document.querySelector<HTMLElement>("[data-levelup-build]");
        if (!el) return;
        const chip = (
          id: string,
          bg: string,
          icon: string,
          label: string,
          title: string,
        ) =>
          `<span data-build-chip="${id}" title="${title}" class="flex items-center gap-1 rounded-lg border-2 border-slate-900 ${bg} px-1.5 py-0.5 text-slate-900">${sizedIcon(icon, "h-[1.1em] w-[1.1em]")}<span class="text-[0.8em] font-black">${label}</span></span>`;
        const weapons = build.weapons
          .map((w) => {
            const label =
              w.level < w.maxLevel
                ? `${w.level}`
                : w.level === w.maxLevel
                  ? "★"
                  : `★+${w.level - w.maxLevel}`;
            const name = w.level >= w.maxLevel ? w.evolvedName : w.name;
            return chip(
              w.id,
              "bg-emerald-200",
              WEAPON_ICON[w.id as keyof typeof WEAPON_ICON] ?? "",
              label,
              `${name}: level ${w.level}`,
            );
          })
          .join("");
        const stats = build.stats
          .map((st) =>
            chip(
              st.id,
              "bg-violet-200",
              STAT_ICON[st.id] ?? "",
              `×${st.stacks}`,
              `${st.label} ×${st.stacks}: ${st.effect} each`,
            ),
          )
          .join("");
        const special = build.special
          ? chip(
              build.special,
              "bg-cyan-200",
              SPECIAL_ICON[build.special],
              "",
              `${SPECIALS[build.special].name}: ${SPECIALS[build.special].blurb}`,
            )
          : "";
        el.innerHTML = `
          <span class="flex flex-wrap items-center gap-1.5">
            <span class="flex items-center gap-1 text-[0.7em] font-black tracking-widest text-slate-300 uppercase" title="Your opening weapon sets the style">${sizedIcon(STYLE_ICON[build.style], "h-[1.1em] w-[1.1em]")}${STYLE_NAMES[build.style]} · lv ${build.level}</span>
            ${weapons}${stats}${special}
          </span>
        `;
      }

      // One loop animates every card's scene while the overlay is open.
      let cardDemoRaf = 0;
      function runCardDemos(
        demos: { canvas: HTMLCanvasElement; spec: DemoSpec }[],
      ) {
        cancelAnimationFrame(cardDemoRaf);
        const ctxs = demos.map((d) => {
          const ctx = d.canvas.getContext("2d")!;
          ctx.setTransform(2, 0, 0, 2, 0, 0);
          return ctx;
        });
        const paint = (now: number) => {
          demos.forEach((d, i) => drawCardDemo(ctxs[i], now, d.spec));
        };
        if (isReducedMotion()) {
          paint(1400);
          return;
        }
        const frame = (now: number) => {
          if (levelUpOverlay!.classList.contains("hidden")) return;
          paint(now);
          cardDemoRaf = requestAnimationFrame(frame);
        };
        cardDemoRaf = requestAnimationFrame(frame);
      }

      document
        .querySelector<HTMLElement>("[data-mode-toggle]")
        ?.addEventListener("click", () => {
          endlessOn = !endlessOn;
          setEndlessMode(endlessOn);
          renderLobby();
        });

      function getUnlockedWeaponIds(): WeaponId[] {
        const ids: WeaponId[] = [];
        for (const id of [
          "chainLightning",
          "meteorRain",
          "gravityWell",
          "flameTrail",
          "sentryTotem",
        ] as const) {
          if (isUnlocked(id)) ids.push(id);
        }
        return ids;
      }

      // The weapon a run opens with: one of the base five or anything bought.
      function renderStartWeapon() {
        const host = document.querySelector<HTMLElement>(
          "[data-start-weapons]",
        );
        if (!host) return;
        const options = [...BASE_START_WEAPONS, ...getUnlockedWeaponIds()];
        if (!options.includes(startWeapon)) startWeapon = "bolt";
        host.innerHTML = options
          .map(
            (id) =>
              `<button type="button" role="radio" class="ts-arm" data-arm="${id}" aria-checked="${id === startWeapon}" title="${WEAPON_LABEL[id] ?? id}: ${WEAPON_FLAVOR[id]}" aria-label="${WEAPON_LABEL[id] ?? id}">${WEAPON_ICON[id] ?? ""}</button>`,
          )
          .join("");
        const cap = document.querySelector<HTMLElement>(
          "[data-start-weapon-name]",
        );
        if (cap)
          cap.textContent = `Start with: ${WEAPON_LABEL[startWeapon] ?? startWeapon}`;
      }
      document
        .querySelector<HTMLElement>("[data-start-weapons]")
        ?.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-arm]",
          );
          if (!btn) return;
          startWeapon = btn.dataset.arm as WeaponId;
          try {
            localStorage.setItem(START_WEAPON_KEY, startWeapon);
          } catch {
            /* a private window just forgets the pick */
          }
          renderStartWeapon();
        });

      // Pressing Start opens this: big tiles, locked weapons shown dimmed.
      const weaponDialog = document.querySelector<HTMLDialogElement>(
        '[data-panel="weapon"]',
      );
      const ALL_START_WEAPONS: WeaponId[] = [
        ...BASE_START_WEAPONS,
        "chainLightning",
        "meteorRain",
        "gravityWell",
        "flameTrail",
        "sentryTotem",
      ];
      function renderWeaponPicker() {
        const grid =
          weaponDialog?.querySelector<HTMLElement>("[data-weapon-grid]");
        const desc =
          weaponDialog?.querySelector<HTMLElement>("[data-weapon-desc]");
        if (!grid || !desc) return;
        const owned = [...BASE_START_WEAPONS, ...getUnlockedWeaponIds()];
        if (!owned.includes(startWeapon)) startWeapon = "bolt";
        grid.innerHTML = ALL_START_WEAPONS.map((id) => {
          const locked = !owned.includes(id);
          const style = WEAPON_STYLE[id];
          return `<button type="button" class="wp-tile" data-pick-weapon="${id}" aria-pressed="${id === startWeapon}" ${locked ? 'disabled title="Unlock it in Upgrades"' : ""}>${WEAPON_ICON[id] ?? ""}<span>${WEAPON_LABEL[id] ?? id}</span><span class="wp-tag">${STYLE_ICON[style]}${locked ? "Locked" : STYLE_NAMES[style]}</span></button>`;
        }).join("");
        const style = WEAPON_STYLE[startWeapon];
        desc.textContent = `${WEAPON_FLAVOR[startWeapon]} ${STYLE_NAMES[style]} style: its weapons hit 10% harder and matching boosts come up more often.`;
      }
      function openWeaponPicker() {
        if (!weaponDialog) return wipeTo(() => launch(null));
        renderWeaponPicker();
        weaponDialog.showModal();
        weaponDialog.querySelector<HTMLElement>("[data-weapon-go]")?.focus();
      }
      weaponDialog
        ?.querySelector("[data-weapon-grid]")
        ?.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-pick-weapon]",
          );
          if (!btn || btn.disabled) return;
          startWeapon = btn.dataset.pickWeapon as WeaponId;
          try {
            localStorage.setItem(START_WEAPON_KEY, startWeapon);
          } catch {
            /* a private window just forgets the pick */
          }
          renderWeaponPicker();
          renderStartWeapon();
        });
      weaponDialog
        ?.querySelector("[data-weapon-go]")
        ?.addEventListener("click", () => {
          weaponDialog.close();
          wipeTo(() => launch(null));
        });

      function renderLobby() {
        renderStartWeapon();
        const tokens = getTokenCount();
        const daily = dailyFreeAvailable();
        const duration = computeRunDurationS();
        const best = getBestTimeS();
        const balance = getCoinBalance();
        lobbyTokensEl!.textContent = String(tokens).padStart(2, "0");
        const bestEndless = getBestEndlessS();
        lobbyDurationEl!.textContent = endlessOn ? "∞" : `${duration} s`;
        const shownBest = endlessOn ? bestEndless : best;
        lobbyBestEl!.textContent = shownBest > 0 ? formatTime(shownBest) : "--";
        document
          .querySelector<HTMLElement>("[data-start-label]")!
          .replaceChildren(endlessOn ? "Start endless" : "Start run");
        const modeToggle =
          document.querySelector<HTMLElement>("[data-mode-toggle]");
        if (modeToggle) {
          modeToggle.setAttribute("aria-pressed", String(endlessOn));
          modeToggle.querySelector("[data-mode-label]")!.textContent = endlessOn
            ? "Endless: on"
            : "Endless: off";
          modeToggle.querySelector("[data-mode-hint]")!.textContent = endlessOn
            ? bestEndless > 0
              ? `best ${formatTime(bestEndless)}`
              : "until you fall"
            : "no timer, bosses keep coming";
        }
        lobbyCoinsEl!.textContent = String(balance);
        const coinsScore = document.querySelector<HTMLElement>(
          "[data-lobby-coins-score]",
        );
        if (coinsScore) coinsScore.textContent = String(balance);
        lobbyZeroMessage!.classList.toggle("hidden", tokens >= 1 || daily);
        startButton!.disabled = tokens < 1 && !daily;
        renderDailyChip(daily);
        renderMenuTags(tokens, daily, balance);
        renderShop();
        renderChests();
        renderRelics();
      }

      // The menu rows say what is waiting behind them.
      function renderMenuTags(tokens: number, daily: boolean, balance: number) {
        // A badge is a number or nothing: the rows are pictures first.
        const setTag = (sel: string, text: string) => {
          const el = document.querySelector<HTMLElement>(sel);
          if (!el) return;
          el.textContent = text;
          el.classList.toggle("hidden", text === "");
        };
        setTag(
          "[data-start-tag]",
          daily ? "free today" : tokens > 0 ? `${tokens} left` : "0 left",
        );
        const buyable = UPGRADES.filter((u) => {
          const cost = upgradeCost(u.id);
          return cost !== null && balance >= cost;
        }).length;
        setTag("[data-tag-upgrades]", buyable > 0 ? String(buyable) : "");
        const alertTile = (panel: string, on: boolean) =>
          document
            .querySelector<HTMLElement>(`[data-open-panel="${panel}"].ts-tile`)
            ?.classList.toggle("ts-alert", on);
        alertTile("upgrades", buyable > 0);
        const wooden = getChestCount("wooden");
        const golden = getChestCount("golden");
        const chests = wooden + golden;
        setTag("[data-tag-chests]", chests > 0 ? String(chests) : "");
        alertTile("chests", chests > 0);
        setTag(
          "[data-tag-relics]",
          `${Object.keys(getRelicLevels()).length}/${RELICS.length}`,
        );
        const stageChest =
          document.querySelector<HTMLElement>("[data-stage-chest]");
        if (stageChest) {
          stageChest.classList.toggle("hidden", chests < 1);
          const tier = golden > 0 ? "golden" : "wooden";
          const art = stageChest.querySelector<HTMLElement>(
            "[data-stage-chest-art]",
          );
          if (art && chests > 0) art.innerHTML = chestArt(tier);
          const count = stageChest.querySelector<HTMLElement>(
            "[data-stage-chest-count]",
          );
          if (count) {
            count.textContent = String(chests);
            count.classList.toggle("hidden", chests < 2);
          }
        }
        const bubble = document.querySelector<HTMLElement>(
          "[data-stage-bubble]",
        );
        if (bubble) {
          const text = daily
            ? "Free run ready!"
            : tokens > 0
              ? ""
              : "Out of credits";
          bubble.textContent = text;
          bubble.classList.toggle("hidden", text === "");
        }
      }

      // The free run renews at local midnight; the chip says which state it is in.
      function renderDailyChip(daily: boolean) {
        const chip = document.querySelector<HTMLElement>("[data-daily-chip]");
        if (!chip) return;
        chip.classList.toggle("is-used", !daily);
        chip.textContent = daily
          ? "+ 1 FREE"
          : `FREE RUN IN ${formatCountdown(msUntilReset()).toUpperCase()}`;
      }

      const RARITY_STYLE: Record<Rarity, { bg: string; label: string }> = {
        common: { bg: "bg-sky-200", label: "Common" },
        rare: { bg: "bg-violet-300", label: "Rare" },
        epic: { bg: "bg-fuchsia-300", label: "Epic" },
        legendary: { bg: "bg-amber-300", label: "Legendary" },
      };

      function renderChests() {
        const wrap = document.querySelector<HTMLElement>("[data-chest-rows]");
        if (!wrap) return;
        wrap.innerHTML = "";
        for (const tier of ["wooden", "golden"] as ChestTier[]) {
          const n = getChestCount(tier);
          const row = document.createElement("div");
          row.className = `flex items-center justify-between gap-2 rounded-2xl border-[3px] border-[#0d0a24] px-3 py-2.5 text-slate-900 shadow-[0_4px_0_#0d0a24] ${tier === "golden" ? "bg-amber-300" : "bg-orange-200"}`;
          const label = document.createElement("span");
          label.className = "flex items-center gap-2 text-sm font-extrabold";
          label.innerHTML = `${chestArt(tier, { className: "h-10 w-12" })}<span>${tier === "golden" ? "Golden" : "Wooden"} chest</span><span class="rounded-full border-2 border-slate-900 bg-white px-2 text-xs tabular-nums">×${n}</span>`;
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = "Open";
          btn.disabled = n < 1;
          btn.className =
            "rounded-full border-2 border-slate-900 bg-white px-4 py-1.5 text-sm font-black text-slate-900 shadow-[0_2px_0_#020617] active:translate-y-0.5 active:shadow-none disabled:cursor-not-allowed disabled:opacity-40";
          btn.addEventListener("click", () => showChestOpening(tier));
          row.append(label, btn);
          wrap.append(row);
        }
        // With nothing to open, show how to earn one: survive a whole run.
        if (getChestCount("wooden") + getChestCount("golden") === 0) {
          const hint = document.createElement("div");
          hint.className =
            "flex items-center justify-center gap-3 rounded-2xl border-[3px] border-dashed border-[#5a4ca8] px-3 py-3 text-[#c9c2ff]";
          hint.title = "Survive a whole run to win a chest";
          hint.setAttribute("role", "note");
          hint.innerHTML = `${sizedIcon(UI_ICON.timer, "h-7 w-7")}<span class="text-xl font-black">→</span>${sizedIcon(UI_ICON.trophy, "h-7 w-7")}<span class="text-xl font-black">→</span>${chestArt("wooden", { className: "h-9 w-11" })}<span class="sr-only">Survive a whole run to win a chest</span>`;
          wrap.append(hint);
        }
      }

      function renderRelics() {
        const grid = document.querySelector<HTMLElement>("[data-relic-grid]");
        const detail = document.querySelector<HTMLElement>(
          "[data-relic-detail]",
        );
        const count = document.querySelector<HTMLElement>("[data-relic-count]");
        if (!grid) return;
        const levels = getRelicLevels();
        const owned = Object.keys(levels).length;
        if (count) count.textContent = `${owned}/${RELICS.length}`;
        grid.innerHTML = "";
        for (const r of RELICS) {
          const level = levels[r.id] ?? 0;
          const cell = document.createElement("button");
          cell.type = "button";
          cell.className = level
            ? `relative flex aspect-square items-center justify-center rounded-xl border-[3px] border-[#0d0a24] text-slate-900 shadow-[0_3px_0_#0d0a24] ${RARITY_STYLE[r.rarity].bg}`
            : "relative flex aspect-square items-center justify-center rounded-xl border-2 border-dashed border-[#5a4ca8] text-[#5a4ca8]";
          cell.innerHTML = `${sizedIcon(RELIC_ICON[r.id] ?? "", "h-5 w-5")}${level ? `<span class="absolute -right-1 -bottom-1 rounded-full border-2 border-slate-900 bg-white px-1 text-[9px] leading-tight font-black tabular-nums">${level}</span>` : ""}`;
          cell.setAttribute(
            "aria-label",
            level ? `${r.name}, level ${level}` : "Not found yet",
          );
          cell.addEventListener("click", () => {
            if (!detail) return;
            detail.textContent = level
              ? `${r.name} · ${RARITY_STYLE[r.rarity].label} · Lv ${level}/${RELIC_MAX_LEVEL} — ${r.blurb}`
              : `${RARITY_STYLE[r.rarity].label} relic — not found yet. Open chests to find it.`;
          });
          grid.append(cell);
        }
      }

      // The chest: it shakes shut, then flips open onto what was inside.
      function showChestOpening(tier: ChestTier) {
        const modal = document.querySelector<HTMLElement>("[data-chest-modal]");
        const art = document.querySelector<HTMLElement>("[data-chest-art]");
        const reveal = document.querySelector<HTMLElement>(
          "[data-chest-reveal]",
        );
        const title = document.querySelector<HTMLElement>("[data-chest-title]");
        if (!modal || !art || !reveal || !title) return;
        const loot = openChest(tier);
        if (!loot) return;
        title.textContent = `${tier === "golden" ? "Golden" : "Wooden"} chest`;
        art.innerHTML = chestArt(tier, { className: "h-full w-full" });
        reveal.innerHTML = "";
        if (!(modal as HTMLDialogElement).open) {
          (modal as HTMLDialogElement).showModal();
        }
        const instant = isReducedMotion();
        if (!instant) {
          art.classList.remove("animate-shake");
          void art.offsetWidth;
          art.classList.add("animate-shake");
        }
        const show = () => {
          title.textContent = "Chest opened!";
          art.innerHTML = chestArt(tier, {
            open: true,
            className: "h-full w-full",
          });
          const coinsLine = document.createElement("div");
          coinsLine.className =
            "animate-fade-slide-in flex items-center justify-center gap-2 rounded-xl border-2 border-slate-900 bg-yellow-200 px-3 py-2 text-sm font-extrabold";
          coinsLine.innerHTML = `${sizedIcon(UI_ICON.coins, "h-5 w-5")}+${loot.coins} coins`;
          reveal.append(coinsLine);
          loot.finds.forEach((f, i) => {
            const def = relicById(f.relicId)!;
            const card = document.createElement("div");
            card.className = `animate-fade-slide-in flex items-center gap-3 rounded-xl border-2 border-slate-900 px-3 py-2 text-left ${RARITY_STYLE[def.rarity].bg}`;
            card.style.animationDelay = `${(i + 1) * (instant ? 0 : 220)}ms`;
            const badge = f.converted
              ? "MAXED → coins"
              : f.isNew
                ? "NEW!"
                : `Lv ${f.level}/${RELIC_MAX_LEVEL}`;
            card.innerHTML = `<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border-2 border-slate-900 bg-white">${sizedIcon(RELIC_ICON[def.id] ?? "", "h-6 w-6")}</span><span class="flex flex-col"><span class="text-sm font-black">${def.name} <span class="ml-1 rounded-full border-2 border-slate-900 bg-white px-1.5 text-[10px]">${badge}</span></span><span class="text-xs font-semibold">${RARITY_STYLE[def.rarity].label} · ${def.blurb}</span></span>`;
            reveal.append(card);
          });
          renderLobby();
        };
        if (instant) show();
        else setTimeout(show, 650);
      }

      document
        .querySelector<HTMLElement>("[data-stage-chest]")
        ?.addEventListener("click", (event) => {
          event.preventDefault();
          showChestOpening(getChestCount("golden") > 0 ? "golden" : "wooden");
        });

      document
        .querySelector<HTMLElement>("[data-chest-close]")
        ?.addEventListener("click", () => {
          document
            .querySelector<HTMLDialogElement>("[data-chest-modal]")
            ?.close();
        });

      function renderShop() {
        const balance = getCoinBalance();
        shopRowsEl!.innerHTML = "";
        for (const def of UPGRADES) {
          const level = getUpgradeLevel(def.id);
          const cost = upgradeCost(def.id);
          const maxed = false; // upgrades have no top level
          const price0 = cost ?? 0;
          const affordable = balance >= price0;
          // The whole tile is the buy button: picture, level pips, price.
          const tileBtn = document.createElement("button");
          tileBtn.type = "button";
          tileBtn.disabled = !affordable;
          tileBtn.title = def.effectLabel;
          tileBtn.setAttribute(
            "aria-label",
            maxed
              ? `${def.label}, maxed. ${def.effectLabel}`
              : `${def.label}, level ${level}. ${def.effectLabel}. ${affordable ? `Buy for ${cost} coins` : `Costs ${cost} coins`}`,
          );
          tileBtn.className = `animate-fade-slide-in flex flex-col items-center gap-2 rounded-2xl border-[3px] border-[#0d0a24] p-3 text-center text-slate-900 shadow-[0_4px_0_#0d0a24] transition ${
            maxed
              ? "bg-[#ffe9a3]"
              : affordable
                ? "bg-white hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none"
                : "cursor-not-allowed bg-[#d9d3f5] opacity-70"
          }`;
          // Five pips fill up, then start over: each lap is a "rank".
          const lap = Math.floor(level / 5);
          const filled = level % 5;
          const pips = Array.from(
            { length: 5 },
            (_, i) =>
              `<span class="h-2 flex-1 rounded-full border border-slate-900/40 ${i < filled ? (lap > 0 ? "bg-amber-400" : "bg-sky-500") : lap > 0 ? "bg-amber-200" : "bg-slate-200 dark:bg-slate-700"}"></span>`,
          ).join("");
          const price = maxed
            ? `<span class="inline-flex items-center gap-1 rounded-full border-2 border-amber-700 bg-amber-300 px-2.5 py-0.5 text-xs font-black text-amber-950">MAX</span>`
            : `<span class="inline-flex items-center gap-1 rounded-full border-2 px-2.5 py-0.5 text-sm font-black tabular-nums ${affordable ? "border-amber-800 bg-amber-300 text-amber-950" : "border-slate-300 text-slate-500 dark:border-slate-700"}">${sizedIcon(UI_ICON.coins, "h-3.5 w-3.5")}${cost}</span>`;
          tileBtn.innerHTML = `
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl ${badgeClass(def.id)}">${sizedIcon(UPGRADE_ICON[def.id] ?? "", "h-7 w-7")}</span>
            <span class="text-xs font-extrabold leading-tight">${def.label} <span class="rounded-full border-2 border-slate-900 bg-white px-1.5 text-[10px] tabular-nums">Lv ${level}</span></span>
            <span class="flex w-full gap-1">${pips}</span>
            ${price}
          `;
          tileBtn.addEventListener("click", () => {
            if (purchaseUpgrade(def.id)) {
              log.log("shop:purchase", { id: def.id });
              renderLobby();
            }
          });
          shopRowsEl!.appendChild(tileBtn);
        }
        renderUnlocks();
      }

      // Phase 15: one-time unlock rows (Chain Lightning, Necromancy) —
      // structurally similar to the leveled UPGRADES rows above, but no
      // progress bar (nothing to level, it's owned or not) and the button
      // reads "Owned" (disabled) once purchased instead of "MAX".
      const UNLOCK_ICON: Record<string, string> = {
        chainLightning: WEAPON_ICON.chainLightning,
        meteorRain: WEAPON_ICON.meteorRain,
        gravityWell: WEAPON_ICON.gravityWell,
        flameTrail: WEAPON_ICON.flameTrail,
        sentryTotem: WEAPON_ICON.sentryTotem,
        necromancy: UI_ICON.necromancy,
      };
      function renderUnlocks() {
        const balance = getCoinBalance();
        shopUnlockRowsEl!.innerHTML = "";
        for (const def of UNLOCKS) {
          const owned = isUnlocked(def.id);
          const affordable = !owned && balance >= def.cost;
          const row = document.createElement("button");
          row.type = "button";
          row.disabled = owned || !affordable;
          row.title = def.effectLabel;
          row.setAttribute(
            "aria-label",
            `${def.label}. ${def.effectLabel}. ${owned ? "Owned" : `Costs ${def.cost} coins`}`,
          );
          row.className = `animate-fade-slide-in flex items-center gap-3 rounded-2xl border-[3px] border-[#0d0a24] p-2.5 text-left text-slate-900 shadow-[0_4px_0_#0d0a24] transition ${
            owned
              ? "bg-[#f5d0fe]"
              : affordable
                ? "bg-white hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none"
                : "cursor-not-allowed bg-[#d9d3f5] opacity-70"
          }`;
          const icon = owned
            ? `<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl ${badgeClass(undefined, "bg-fuchsia-300")}">${sizedIcon(UNLOCK_ICON[def.id] ?? "", "h-6 w-6")}</span>`
            : `<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border-2 border-slate-300 bg-slate-100 text-slate-400 dark:border-slate-700 dark:bg-slate-800">${sizedIcon(UI_ICON.lock, "h-5 w-5")}</span>`;
          const tag = owned
            ? `<span class="rounded-full border-2 border-fuchsia-500 bg-fuchsia-200 px-2.5 py-0.5 text-xs font-black text-fuchsia-900">OWNED</span>`
            : `<span class="inline-flex items-center gap-1 rounded-full border-2 px-2.5 py-0.5 text-sm font-black tabular-nums ${affordable ? "border-amber-800 bg-amber-300 text-amber-950" : "border-slate-300 text-slate-500 dark:border-slate-700"}">${sizedIcon(UI_ICON.coins, "h-3.5 w-3.5")}${def.cost}</span>`;
          row.innerHTML = `${icon}<span class="min-w-0 flex-1 text-sm font-extrabold leading-tight">${def.label}</span>${tag}`;
          row.addEventListener("click", () => {
            if (purchaseUnlock(def.id)) {
              log.log("shop:unlock", { id: def.id });
              renderLobby();
            }
          });
          shopUnlockRowsEl!.appendChild(row);
        }
      }

      // A toggle button holding a non-default state (muted, reduced motion)
      // fills with the accent instead of only swapping its icon glyph —
      // otherwise "engaged" only shows up in the tooltip. Shop/fullscreen
      // don't call this: they open something rather than hold a state.
      function setToggleEngaged(button: HTMLButtonElement, engaged: boolean) {
        button.classList.toggle("border-slate-300", !engaged);
        button.classList.toggle("dark:border-slate-700", !engaged);
        button.classList.toggle("border-[var(--accent)]", engaged);
        button.style.background = engaged ? "var(--accent-soft-bg)" : "";
        button.style.color = engaged ? "var(--accent-text)" : "";
      }

      function renderMute() {
        const muted = isMuted();
        muteToggle!.innerHTML = sizedIcon(
          muted ? UI_ICON.soundOff : UI_ICON.soundOn,
          "h-4 w-4",
        );
        muteToggle!.title = muted ? "Sound off" : "Sound on";
        setToggleEngaged(muteToggle!, muted);
      }

      function renderMotion() {
        const reduced = isReducedMotion();
        motionToggle!.innerHTML = sizedIcon(
          reduced ? UI_ICON.motionOff : UI_ICON.motionOn,
          "h-4 w-4",
        );
        motionToggle!.title = reduced
          ? "Visual effects off"
          : "Visual effects on";
        setToggleEngaged(motionToggle!, reduced);
      }

      function renderFullscreen() {
        const isFs = document.fullscreenElement === gameRoot;
        fullscreenToggle!.innerHTML = sizedIcon(
          isFs ? UI_ICON.minimize : UI_ICON.maximize,
          "h-4 w-4",
        );
        fullscreenToggle!.title = isFs ? "Exit fullscreen" : "Fullscreen";
        canvas!.parentElement!.style.setProperty(
          "--chrome",
          isFs ? "10.5rem" : "15rem",
        );
        document
          .querySelector<HTMLElement>("[data-duel-canvas]")
          ?.parentElement?.style.setProperty(
            "--chrome",
            isFs ? "4.5rem" : "9rem",
          );
        gameRoot!.classList.toggle("max-w-none", isFs);
        gameRoot!.classList.toggle("h-screen", isFs);
        gameRoot!.classList.toggle("justify-center", isFs);
        gameRoot!.classList.toggle("bg-white", isFs);
        gameRoot!.classList.toggle("dark:bg-slate-950", isFs);
        gameRoot!.classList.toggle("p-4", isFs);
      }

      // Phase 13: brief "difficulty rising" banner, fired once per threat
      // tier crossed (engine.ts's onThreatTierUp). Re-triggerable per the
      // project's remove/reflow/re-add pattern for repeat one-shot CSS
      // animations (see CLAUDE.md's "Micro-interactions and animation").
      let threatToastTimeout: number | undefined;
      function showThreatToast(tier: number) {
        threatToastTextEl!.textContent = `Threat rising — tier ${tier}`;
        threatToastEl!.classList.remove("hidden");
        threatToastEl!.classList.add("flex");
        threatToastEl!.classList.remove("animate-fade-slide-in");
        void threatToastEl!.offsetWidth;
        threatToastEl!.classList.add("animate-fade-slide-in");
        const threatToastBar = threatToastEl!.querySelector<HTMLElement>(
          "[data-threat-toast-bar]",
        );
        threatToastBar?.classList.remove("animate-toast-timer");
        void threatToastBar?.offsetWidth;
        threatToastBar?.classList.add("animate-toast-timer");
        if (threatToastTimeout) window.clearTimeout(threatToastTimeout);
        threatToastTimeout = window.setTimeout(() => {
          threatToastEl!.classList.add("hidden");
          threatToastEl!.classList.remove("flex");
        }, 2200);
      }

      // Phase 14: boss telegraph banner, fired once via engine.ts's
      // onBossIncoming — same re-triggerable animation pattern as the
      // threat toast above.
      let bossToastTimeout: number | undefined;
      // Run rating: a third of the run per star, so even a short run earns one.
      function starsFor(survivedS: number, durationS: number) {
        const f = survivedS / Math.max(1, durationS);
        return f >= 0.98 ? 3 : f >= 0.66 ? 2 : f >= 0.33 ? 1 : 0;
      }
      function renderStars(earned: number) {
        const el = document.querySelector<HTMLElement>("[data-results-stars]")!;
        el.innerHTML = "";
        if (earned < 0) return;
        for (let i = 0; i < 3; i++) {
          const on = i < earned;
          const size = i === 1 ? 44 : 34;
          const star = document.createElement("span");
          star.className = "animate-fade-slide-in";
          star.style.animationDelay = `${i * 200}ms`;
          star.style.animationFillMode = "backwards";
          star.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${on ? "#fde047" : "#e2e8f0"}" stroke="#0f172a" stroke-width="2" stroke-linejoin="round"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>`;
          el.appendChild(star);
        }
      }
      // Stats tick up to their value; the final write is guaranteed even if
      // the tab throttles timers.
      function countUp(el: HTMLElement, to: number) {
        const steps = 14;
        let i = 0;
        el.textContent = "0";
        const timer = window.setInterval(() => {
          i += 1;
          el.textContent = String(Math.round((to * i) / steps));
          if (i >= steps) window.clearInterval(timer);
        }, 45);
        window.setTimeout(
          () => (el.textContent = String(to)),
          45 * steps + 100,
        );
      }

      function showBossToast() {
        bossToastEl!.classList.remove("hidden");
        bossToastEl!.classList.add("flex");
        bossToastEl!.classList.remove("animate-fade-slide-in");
        void bossToastEl!.offsetWidth;
        bossToastEl!.classList.add("animate-fade-slide-in");
        const bossToastBar = bossToastEl!.querySelector<HTMLElement>(
          "[data-boss-toast-bar]",
        );
        bossToastBar?.classList.remove("animate-toast-timer");
        void bossToastBar?.offsetWidth;
        bossToastBar?.classList.add("animate-toast-timer");
        if (bossToastTimeout) window.clearTimeout(bossToastTimeout);
        bossToastTimeout = window.setTimeout(() => {
          bossToastEl!.classList.add("hidden");
          bossToastEl!.classList.remove("flex");
        }, 3200);
      }

      // Phase 16: synergy discovery banner, fired once per named synergy via
      // engine.ts's onSynergyTriggered — same re-triggerable animation
      // pattern as the threat/boss toasts above.
      let synergyToastTimeout: number | undefined;
      function showSynergyToast(name: string) {
        synergyToastTextEl!.textContent = `Synergy — ${name}!`;
        synergyToastEl!.classList.remove("hidden");
        synergyToastEl!.classList.add("flex");
        synergyToastEl!.classList.remove("animate-fade-slide-in");
        void synergyToastEl!.offsetWidth;
        synergyToastEl!.classList.add("animate-fade-slide-in");
        const synergyToastBar = synergyToastEl!.querySelector<HTMLElement>(
          "[data-synergy-toast-bar]",
        );
        synergyToastBar?.classList.remove("animate-toast-timer");
        void synergyToastBar?.offsetWidth;
        synergyToastBar?.classList.add("animate-toast-timer");
        if (synergyToastTimeout) window.clearTimeout(synergyToastTimeout);
        synergyToastTimeout = window.setTimeout(() => {
          synergyToastEl!.classList.add("hidden");
          synergyToastEl!.classList.remove("flex");
        }, 2600);
      }

      // Phase 14: low-HP pulsing vignette — only animates when reduceMotion
      // is off, matching the canvas glow/idle-bob gating elsewhere.
      function setLowHp(active: boolean) {
        lowHpVignetteEl!.classList.toggle("hidden", !active);
        lowHpVignetteEl!.classList.toggle(
          "animate-pulse-warn",
          active && !isReducedMotion(),
        );
      }

      if (startButton.dataset.wired === "true") return;
      startButton.dataset.wired = "true";
      backToLobbyButton.dataset.wired = "true";
      muteToggle.dataset.wired = "true";
      motionToggle.dataset.wired = "true";
      fullscreenToggle.dataset.wired = "true";

      renderMute();
      muteToggle.addEventListener("click", () => {
        toggleMuted();
        renderMute();
      });

      renderMotion();
      motionToggle.addEventListener("click", () => {
        toggleReducedMotion();
        renderMotion();
      });

      const heroStage =
        document.querySelector<HTMLCanvasElement>("[data-hero-stage]");
      if (heroStage) startHeroStage(heroStage);

      renderFullscreen();
      fullscreenToggle.addEventListener("click", () => {
        if (document.fullscreenElement) {
          document.exitFullscreen?.();
        } else {
          gameRoot!.requestFullscreen?.();
        }
      });
      document.addEventListener("fullscreenchange", renderFullscreen);

      let activeGame: ReturnType<typeof startGame> | null = null;

      const coarse =
        matchMedia("(pointer: coarse)").matches || "ontouchstart" in window;
      const specialFab =
        document.querySelector<HTMLElement>("[data-special-fab]");
      const touchHint =
        document.querySelector<HTMLElement>("[data-touch-hint]");
      // The floating buttons sit over the canvas's bottom corner; the HUD and
      // the weapon strip live outside it, so measure the canvas itself.
      function placeTouchUi() {
        if (!canvas) return;
        const bottom = canvas.offsetTop + canvas.offsetHeight;
        if (specialFab) specialFab.style.top = `${bottom - 64 - 14}px`;
        if (touchHint) touchHint.style.top = `${bottom - 64 - 14}px`;
      }
      window.addEventListener("resize", placeTouchUi);
      document.addEventListener("fullscreenchange", () =>
        setTimeout(placeTouchUi, 100),
      );
      specialFab?.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        activeGame?.useSpecial();
      });
      function showTouchHint() {
        if (!coarse || !touchHint) return;
        placeTouchUi();
        touchHint.classList.remove("hidden");
        touchHint.classList.add("flex");
        const hide = () => {
          touchHint.classList.add("hidden");
          touchHint.classList.remove("flex");
        };
        setTimeout(hide, 4500);
        canvas?.addEventListener("pointerdown", hide, { once: true });
      }

      let paused = false;
      const pauseOverlay = document.querySelector<HTMLElement>(
        "[data-pause-overlay]",
      );
      const pauseButton = document.querySelector<HTMLButtonElement>(
        "[data-pause-button]",
      );
      function setPaused(on: boolean) {
        if (!activeGame || on === paused) return;
        // The level-up and results screens already hold the run still.
        if (on && !levelUpOverlay!.classList.contains("hidden")) return;
        if (on && !results!.classList.contains("hidden")) return;
        paused = on;
        if (on) activeGame.pause();
        else activeGame.resume();
        pauseOverlay?.classList.toggle("hidden", !on);
        pauseOverlay?.classList.toggle("flex", on);
        pauseButton?.setAttribute("aria-pressed", String(on));
      }
      function clearPause() {
        paused = false;
        pauseOverlay?.classList.add("hidden");
        pauseOverlay?.classList.remove("flex");
      }
      pauseButton?.addEventListener("click", () => setPaused(!paused));
      document
        .querySelector("[data-special-button]")
        ?.addEventListener("click", () => activeGame?.useSpecial());
      document
        .querySelector("[data-pause-resume]")
        ?.addEventListener("click", () => setPaused(false));
      document
        .querySelector("[data-pause-quit]")
        ?.addEventListener("click", () => {
          setPaused(false);
          wipeTo(() => {
            activeGame?.stop();
            activeGame = null;
            showLobby();
          });
        });
      document.addEventListener("keydown", (e) => {
        if (playArea!.classList.contains("hidden")) return;
        if (e.key === " ") e.preventDefault(); // Space is the special move
        if (e.key === "Escape" || e.key === "p" || e.key === "P")
          setPaused(!paused);
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) setPaused(true);
      });

      let activeTraining: TrainingOptions | null = null;
      let lastTrainingHtml = "";

      const launch = (training: TrainingOptions | null) => {
        closePanels();
        unlockAudio();
        activeTraining = training;
        // Today's free run goes first, so earned tokens keep for later.
        if (!training && !consumeDailyFree() && !consumeToken()) {
          log.warn("start clicked with 0 tokens — should have been disabled");
          renderLobby();
          return;
        }
        log.log("start button clicked", { training });
        trainingPanel!.classList.toggle("hidden", !training);
        trainingPanel!.classList.toggle("flex", !!training);
        resultsTraining!.classList.add("hidden");
        resultsStats!.classList.remove("hidden");
        if (training) {
          trainingMeta!.textContent = `Enemies keep ${training.standoffPx} px away · drain ${training.drainPerS} HP/s · a full recovery build regenerates ${maxRecoveryHps()} HP/s`;
        }
        levelUpOverlay!.classList.add("hidden");
        levelUpOverlay!.classList.remove("flex");
        threatToastEl!.classList.add("hidden");
        threatToastEl!.classList.remove("flex");
        bossToastEl!.classList.add("hidden");
        bossToastEl!.classList.remove("flex");
        synergyToastEl!.classList.add("hidden");
        synergyToastEl!.classList.remove("flex");
        setLowHp(false);
        lobby!.classList.add("hidden");
        playArea!.classList.remove("hidden");
        playArea!.classList.add("flex");
        results!.classList.add("hidden");
        results!.classList.remove("flex");

        const endless = !training && endlessOn;
        const durationS = training ? 120 : computeRunDurationS();
        const upgradeEffects = getUpgradeEffects();
        const powerIndex = computePowerIndex();
        // Phase 15: shop unlocks that expand this run's available content —
        // see engine.ts's GameOptions.unlockedWeaponIds/abilityUnlocked.
        const unlockedWeaponIds: WeaponId[] = getUnlockedWeaponIds();
        const abilityUnlocked = isUnlocked("necromancy");
        // Phase 16C: "Vampiric Might" needs the shop's raw Might level, not
        // just its aggregated damage-multiplier effect.
        const mightLevel = getUpgradeLevel("might");
        // The field is as wide as the window allows (the world keeps its 500 px
        // height), so a wide screen shows more map instead of black bars. The
        // lab keeps the classic 420 px so its numbers stay comparable.
        const chromePx = document.fullscreenElement ? 168 : 240;
        const aspect = training
          ? 0.84
          : Math.min(
              1.5,
              Math.max(
                0.84,
                playArea!.clientWidth /
                  Math.max(300, window.innerHeight - chromePx),
              ),
            );
        const worldW = Math.round(500 * aspect);
        canvas!.width = worldW * 2;
        canvas!.height = 1000;
        canvas!.style.aspectRatio = `${worldW} / 500`;
        canvas!.parentElement!.style.setProperty(
          "--aspect",
          String(worldW / 500),
        );
        activeGame?.stop();
        clearPause();
        showTouchHint();
        shownLevel = 1;
        activeGame = startGame(
          canvas,
          {
            onHudUpdate(state) {
              hpEl.textContent = `${Math.round(state.hp)}/${Math.round(state.maxHp)}`;
              hpBarEl.style.width = `${Math.max(0, Math.min(100, (state.hp / state.maxHp) * 100))}%`;
              if (Number.isFinite(state.timeRemaining)) {
                timerEl.textContent = `${state.timeRemaining.toFixed(1)}s`;
              } else {
                timerEl.textContent = `∞ ${formatTime(state.elapsedS)}`;
              }
              timerEl.classList.toggle(
                "animate-timer-urgent",
                state.timeRemaining <= 30 && state.timeRemaining > 0,
              );
              killsEl.textContent = String(state.kills);
              gemsEl.textContent = String(state.gems);
              coinsEl.textContent = String(state.coins);
              if (state.level > shownLevel) {
                shownLevel = state.level;
                for (const el of [xpBarEl.parentElement!, levelEl]) {
                  el.classList.remove("animate-xp-pop");
                  void el.offsetWidth;
                  el.classList.add("animate-xp-pop");
                }
              }
              levelEl.textContent = String(state.level);
              threatEl.textContent = String(state.threatTier);
              setLowHp(state.lowHp);
              const spBtn = document.querySelector<HTMLElement>(
                "[data-special-button]",
              );
              if (spBtn) {
                if (state.special) {
                  spBtn.classList.remove("hidden");
                  spBtn.classList.add("flex");
                  if (spBtn.dataset.id !== state.special.id) {
                    spBtn.dataset.id = state.special.id;
                    const def = SPECIALS[state.special.id];
                    spBtn.title = `${def.name} (Space / E): ${def.blurb}`;
                    spBtn.querySelector("[data-special-icon]")!.innerHTML =
                      sizedIcon(SPECIAL_ICON[state.special.id], "h-4 w-4");
                  }
                  spBtn.querySelector<HTMLElement>(
                    "[data-special-fill]",
                  )!.style.height = `${(1 - state.special.charge) * 100}%`;
                  spBtn.classList.toggle("ring-2", state.special.charge >= 1);
                  spBtn.classList.toggle(
                    "ring-yellow-300",
                    state.special.charge >= 1,
                  );
                } else {
                  spBtn.classList.add("hidden");
                  spBtn.classList.remove("flex");
                  delete spBtn.dataset.id;
                }
              }
              if (specialFab) {
                const on = coarse && !!state.special;
                specialFab.classList.toggle("hidden", !on);
                specialFab.classList.toggle("flex", on);
                if (on && state.special) {
                  if (specialFab.dataset.id !== state.special.id) {
                    specialFab.dataset.id = state.special.id;
                    specialFab.querySelector("[data-fab-icon]")!.innerHTML =
                      sizedIcon(SPECIAL_ICON[state.special.id], "h-7 w-7");
                    placeTouchUi();
                  }
                  specialFab.querySelector<HTMLElement>(
                    "[data-fab-fill]",
                  )!.style.height = `${(1 - state.special.charge) * 100}%`;
                  specialFab.classList.toggle(
                    "ring-4",
                    state.special.charge >= 1,
                  );
                  specialFab.classList.toggle(
                    "ring-yellow-300",
                    state.special.charge >= 1,
                  );
                } else delete specialFab.dataset.id;
              }
              xpBarEl.style.width = `${Math.max(0, Math.min(100, (state.xp / state.xpToNext) * 100))}%`;
              weaponsEl.innerHTML = state.weapons
                .map((w) => {
                  const evolved = w.level >= 6;
                  const name = evolved
                    ? EVOLVED_NAMES[w.id as WeaponId]
                    : (WEAPON_LABEL[w.id] ?? w.id);
                  const lv = !evolved
                    ? `Lv ${w.level}`
                    : w.level === 6
                      ? "Evolved"
                      : `Evolved +${w.level - 6}`;
                  return `
                <span title="${name}: ${lv}, ${w.kills} kills" class="inline-flex items-center gap-1.5 rounded-lg border-2 border-slate-900 ${evolved ? "bg-amber-200" : "bg-sky-200"} px-2 py-1 text-slate-900 shadow-[0_2px_0_#020617]">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-slate-900 text-white">${sizedIcon(WEAPON_ICON[w.id] ?? "", "h-4 w-4")}</span>
                  <span class="flex flex-col leading-tight"><span class="text-xs font-extrabold">${name}</span><span class="text-[0.68rem] font-semibold text-slate-700">${lv} · ${w.kills} kills</span></span>
                </span>`;
                })
                .join("");
              if (activeTraining) {
                lastTrainingHtml = trainingTable(state.weapons, state.elapsedS);
                trainingRows.innerHTML = lastTrainingHtml;
                trainingMeta.textContent = `Enemies keep ${activeTraining.standoffPx} px away · drain ${activeTraining.drainPerS} HP/s · regen ${state.regenPerS.toFixed(1)} HP/s (a full build reaches ${maxRecoveryHps()})`;
              }
            },
            onThreatTierUp(tier) {
              log.log("onThreatTierUp callback", { tier });
              showThreatToast(tier);
            },
            onBossIncoming() {
              log.log("onBossIncoming callback");
              showBossToast();
            },
            onSynergyTriggered(name) {
              log.log("onSynergyTriggered callback", { name });
              showSynergyToast(name);
            },
            onGameOver(summary) {
              log.log("onGameOver callback", summary);
              const isRecord = activeTraining
                ? false
                : endless
                  ? recordEndlessResult(summary.survivedS)
                  : recordRunResult(summary.survivedS);
              if (!activeTraining) addCoins(summary.coinsEarned);
              if (activeTraining) {
                resultsTraining.innerHTML = lastTrainingHtml;
                resultsTraining.classList.remove("hidden");
                resultsStats.classList.add("hidden");
              }
              setLowHp(false);
              resultsHeadline.textContent = activeTraining
                ? "Training finished"
                : `Survived ${formatTime(summary.survivedS)}`;
              resultsCause.textContent = summary.cause;
              resultsTime.textContent = formatTime(summary.survivedS);
              countUp(resultsKills, summary.kills);
              countUp(resultsLevel, summary.level);
              countUp(resultsCoins, summary.coinsEarned);
              renderStars(
                activeTraining || endless
                  ? -1
                  : starsFor(summary.survivedS, durationS),
              );
              resultsRecord.classList.toggle("hidden", !isRecord);
              // Surviving the whole run wins a chest — golden if the boss fell.
              const chestBox = document.querySelector<HTMLElement>(
                "[data-results-chest]",
              );
              if (chestBox) {
                const earned = !activeTraining && summary.won;
                chestBox.classList.toggle("hidden", !earned);
                chestBox.classList.toggle("flex", earned);
                if (earned) {
                  const tier: ChestTier = summary.bossDefeated
                    ? "golden"
                    : "wooden";
                  grantChest(tier);
                  chestBox.querySelector<HTMLElement>(
                    "[data-results-chest-icon]",
                  )!.innerHTML = chestArt(tier, {
                    className: "h-9 w-11",
                  });
                  chestBox.querySelector<HTMLElement>(
                    "[data-results-chest-text]",
                  )!.textContent =
                    tier === "golden"
                      ? "Golden chest — you beat the boss!"
                      : "Wooden chest earned";
                  const openBtn = chestBox.querySelector<HTMLButtonElement>(
                    "[data-results-chest-open]",
                  )!;
                  openBtn.onclick = () => {
                    showChestOpening(tier);
                    chestBox.classList.add("hidden");
                    chestBox.classList.remove("flex");
                  };
                }
              }
              playArea!.classList.add("hidden");
              playArea!.classList.remove("flex");
              results!.classList.remove("hidden");
              results!.classList.add("flex");
            },
            onLevelUp(cards, choose, build) {
              log.log("onLevelUp callback", cards);
              levelUpCardsEl.innerHTML = "";
              renderBuildPanel(build);
              const detailEl = document.querySelector<HTMLElement>(
                "[data-levelup-detail]",
              )!;
              const tiles: HTMLButtonElement[] = [];
              let chosen = false;
              let sel = -1;

              const look = (card: LevelUpCard) => {
                const special = card.kind === "ability" && card.specialId;
                const kind = card.isEvolution
                  ? {
                      bg: "bg-amber-200",
                      tag: "EVOLUTION",
                      tagBg: "bg-amber-400",
                    }
                  : card.kind === "newWeapon"
                    ? {
                        bg: "bg-emerald-200",
                        tag: "NEW WEAPON",
                        tagBg: "bg-emerald-400",
                      }
                    : card.kind === "stat"
                      ? {
                          bg: "bg-violet-200",
                          tag: "BOOST",
                          tagBg: "bg-violet-400",
                        }
                      : special
                        ? {
                            bg: "bg-cyan-200",
                            tag: "SPECIAL MOVE",
                            tagBg: "bg-cyan-400",
                          }
                        : card.kind === "ability"
                          ? {
                              bg: "bg-fuchsia-200",
                              tag: "ABILITY",
                              tagBg: "bg-fuchsia-400",
                            }
                          : {
                              bg: "bg-sky-200",
                              tag: "UPGRADE",
                              tagBg: "bg-sky-400",
                            };
                const icon =
                  card.kind === "stat"
                    ? (STAT_ICON[card.statId ?? ""] ?? "")
                    : special
                      ? SPECIAL_ICON[card.specialId!]
                      : card.kind === "ability"
                        ? UI_ICON.necromancy
                        : (WEAPON_ICON[card.weaponId ?? "bolt"] ?? "");
                const from = card.fromLevel ?? 0;
                const badge =
                  card.kind === "stat"
                    ? `×${card.stacks ?? 0} → ${(card.stacks ?? 0) + 1}`
                    : card.kind === "newWeapon"
                      ? "NEW"
                      : card.kind === "weaponUpgrade"
                        ? card.isEvolution
                          ? "EVOLVE"
                          : `${from} → ${from + 1}`
                        : special
                          ? "SPECIAL"
                          : "BOSS";
                return { kind, icon, badge };
              };

              const renderDetail = (card: LevelUpCard) => {
                const { kind, icon, badge } = look(card);
                const spec: DemoSpec = {
                  kind: card.kind,
                  weaponId: card.weaponId,
                  statId: card.statId,
                  specialId: card.specialId,
                };
                const pipsTotal =
                  card.kind === "stat"
                    ? (card.maxStacks ?? 0)
                    : card.kind === "ability"
                      ? 0
                      : 6;
                const pipsOwned =
                  card.kind === "stat"
                    ? (card.stacks ?? 0)
                    : (card.fromLevel ?? 0);
                const pips = Array.from({ length: pipsTotal }, (_, k) =>
                  k < pipsOwned
                    ? `<span class="h-2 w-2 rounded-full border border-slate-900 bg-slate-800"></span>`
                    : k === pipsOwned
                      ? `<span class="animate-pulse h-2 w-2 rounded-full border border-slate-900 bg-yellow-300 ring-2 ring-yellow-400"></span>`
                      : `<span class="h-2 w-2 rounded-full border border-slate-500 bg-transparent"></span>`,
                ).join("");
                const styleName = STYLE_NAMES[build.style];
                const fitLine =
                  card.fit === "match"
                    ? `<span class="text-emerald-700">✓ Fits your ${styleName} style${card.weaponId ? " · +10% damage" : ""}</span>`
                    : card.fit === "off"
                      ? `<span class="text-rose-700">✕ Off-style for a ${styleName} run: rarer, no bonus</span>`
                      : `<span class="text-slate-500">Works with any style</span>`;
                detailEl.innerHTML = `
                  <span class="flex items-center gap-[0.8em]">
                    <span class="relative shrink-0">
                      <canvas data-card-demo class="block rounded-lg border-2 border-slate-900" style="width:11em;height:${(11 * DEMO_H) / DEMO_W}em" aria-hidden="true"></canvas>
                      <span class="absolute -top-2 -left-2 flex h-[2em] w-[2em] items-center justify-center rounded-lg border-2 border-slate-900 ${kind.tagBg} shadow-[0_2px_0_#020617]">${sizedIcon(icon, "h-[1.1em] w-[1.1em]")}</span>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex flex-wrap items-center gap-1.5">
                        <span class="font-extrabold">${card.title}</span>
                        <span class="rounded-full border-2 border-slate-900 ${kind.tagBg} px-1.5 text-[0.6em] leading-[1.6] font-black tracking-wide">${kind.tag}</span>
                        ${card.isEvolution ? `<span>${sizedIcon(EVOLUTION_ICON, "h-3.5 w-3.5")}</span>` : ""}
                      </span>
                      <span class="block text-[0.8em] font-medium text-slate-700">${card.description}</span>
                      <span class="mt-0.5 block text-[0.72em] font-bold text-slate-900/80 italic">${idealCase(spec)}</span>
                      <span class="mt-1 flex items-center gap-1">${pips}<span class="ml-1 text-[0.68em] font-black tracking-wide text-slate-700 uppercase">${badge}</span></span>
                      <span class="mt-0.5 flex items-center gap-1 text-[0.72em] font-bold">${fitLine}</span>
                    </span>
                  </span>
                  <button type="button" data-pick class="mt-2 w-full rounded-xl border-2 border-slate-900 bg-yellow-300 py-[0.35em] text-[1em] font-black tracking-wide uppercase shadow-[0_4px_0_#020617] active:translate-y-0.5 active:shadow-none">Take it</button>
                `;
                const demoCanvas =
                  detailEl.querySelector<HTMLCanvasElement>(
                    "[data-card-demo]",
                  )!;
                demoCanvas.width = DEMO_W * 2;
                demoCanvas.height = DEMO_H * 2;
                detailEl
                  .querySelector<HTMLElement>("[data-pick]")!
                  .addEventListener("click", () => pick(sel));
                runCardDemos([{ canvas: demoCanvas, spec }]);
              };

              const highlight = (id: string | undefined) => {
                document
                  .querySelectorAll<HTMLElement>(
                    "[data-levelup-build] [data-build-chip]",
                  )
                  .forEach((chip) =>
                    chip.classList.toggle(
                      "ring-4",
                      !!id && chip.dataset.buildChip === id,
                    ),
                  );
              };

              const select = (i: number) => {
                if (i === sel) return;
                sel = i;
                tiles.forEach((t, k) => {
                  t.setAttribute("aria-selected", String(k === i));
                  t.classList.toggle("ring-4", k === i);
                  t.classList.toggle("ring-yellow-300", k === i);
                  t.classList.toggle("-translate-y-1", k === i);
                });
                renderDetail(cards[i]);
                highlight(cards[i].weaponId ?? cards[i].statId);
              };

              const onKey = (e: KeyboardEvent) => {
                const n = cards.length;
                const k = e.key;
                if (
                  k === "ArrowRight" ||
                  k === "ArrowDown" ||
                  k === "d" ||
                  k === "D"
                )
                  select((sel + 1) % n);
                else if (
                  k === "ArrowLeft" ||
                  k === "ArrowUp" ||
                  k === "a" ||
                  k === "A"
                )
                  select((sel - 1 + n) % n);
                else if (/^[1-9]$/.test(k) && Number(k) <= n)
                  select(Number(k) - 1);
                else if (k === "Enter" || k === " ") pick(sel);
                else return;
                e.preventDefault();
              };

              const pick = (i: number) => {
                if (chosen || i < 0) return;
                chosen = true;
                document.removeEventListener("keydown", onKey);
                log.log("levelup card chosen", cards[i].id);
                highlight(undefined);
                levelUpOverlay!.classList.add("hidden");
                levelUpOverlay!.classList.remove("flex");
                choose(cards[i].id);
              };

              cards.forEach((card, i) => {
                const { kind, icon, badge } = look(card);
                const tile = document.createElement("button");
                tile.type = "button";
                tile.setAttribute("role", "option");
                tile.setAttribute(
                  "aria-label",
                  `${card.title}. ${card.description}`,
                );
                tile.className = `animate-fade-slide-in relative flex aspect-square flex-col items-center justify-center gap-1 rounded-2xl border-2 border-slate-900 ${kind.bg} p-1 text-slate-900 shadow-[0_4px_0_#020617] transition-transform ${card.isEvolution ? "ring-2 ring-amber-300" : ""}`;
                tile.style.animationDelay = `${i * 70}ms`;
                tile.style.animationFillMode = "backwards";
                const fitMark =
                  card.fit === "match"
                    ? `<span class="absolute -top-1.5 -right-1.5 flex h-[1.5em] w-[1.5em] items-center justify-center rounded-full border-2 border-slate-900 bg-emerald-300 text-[0.7em] font-black" title="Fits your style">✓</span>`
                    : card.fit === "off"
                      ? `<span class="absolute -top-1.5 -right-1.5 flex h-[1.5em] w-[1.5em] items-center justify-center rounded-full border-2 border-slate-900 bg-rose-300 text-[0.7em] font-black" title="Off-style">✕</span>`
                      : "";
                const styleMark = card.style
                  ? `<span class="absolute bottom-1 left-1 opacity-60">${sizedIcon(STYLE_ICON[card.style], "h-[0.9em] w-[0.9em]")}</span>`
                  : "";
                tile.innerHTML = `
                  <span class="flex h-[2.8em] w-[2.8em] items-center justify-center">${sizedIcon(icon, "h-full w-full")}</span>
                  <span class="rounded-full border-2 border-slate-900 ${kind.tagBg} px-1.5 text-[0.62em] leading-[1.6] font-black whitespace-nowrap">${badge}</span>
                  ${fitMark}${styleMark}
                `;
                tile.addEventListener("pointerenter", (ev) => {
                  if (ev.pointerType === "mouse") select(i);
                });
                tile.addEventListener("focus", () => select(i));
                tile.addEventListener("click", () => {
                  if (i === sel) pick(i);
                  else select(i);
                });
                tiles.push(tile);
                levelUpCardsEl.appendChild(tile);
              });
              document.addEventListener("keydown", onKey);
              levelUpOverlay!.classList.remove("hidden");
              levelUpOverlay!.classList.add("flex");
              select(0);
            },
          },
          {
            durationS,
            endless,
            renderScale: 2,
            upgradeEffects,
            powerIndex,
            reduceMotion: isReducedMotion(),
            unlockedWeaponIds,
            startingWeapon: training
              ? undefined
              : { id: startWeapon, level: 1 },
            abilityUnlocked,
            mightLevel,
            training: training ?? undefined,
          },
        );
      };

      startButton.addEventListener("click", () => openWeaponPicker());
      trainingStart.addEventListener("click", () => {
        wipeTo(() =>
          launch({
            weaponId: trainingSelect("weapon")!
              .value as TrainingOptions["weaponId"],
            weaponLevel: Number(trainingSelect("level")!.value),
            standoffPx: Number(trainingSelect("standoff")!.value),
            drainPerS: Number(trainingSelect("drain")!.value),
          }),
        );
      });
      trainingStop.addEventListener("click", () => {
        wipeTo(() => {
          activeGame?.stop();
          activeGame = null;
          showLobby();
        });
      });

      // The duel setup is pictures: pick a weapon, a rival, a level and a skill
      // by icon. The selects stay underneath (hidden) as the source of truth.
      function mountDuelUi() {
        const pick = (q: string) =>
          document.querySelector<HTMLSelectElement>(q)!;
        const weaponSel = pick("[data-duel-weapon]");
        const rivalSel = pick("[data-duel-rival]");
        const levelSel = pick("[data-duel-level]");
        const diffSel = pick("[data-duel-difficulty]");
        const art =
          document.querySelector<HTMLCanvasElement>("[data-duel-art]");
        const svg = (inner: string) =>
          `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">${inner}</svg>`;
        const DICE = svg(
          '<rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/>',
        );
        const MIRROR = svg(
          '<path d="M12 3v18" stroke-dasharray="2 3"/><path d="M9 7 4 12l5 5Z"/><path d="m15 7 5 5-5 5Z" fill="currentColor"/>',
        );
        const bars = (n: number) =>
          svg(
            [0, 1, 2]
              .map(
                (i) =>
                  `<rect x="${4 + i * 6}" y="${14 - i * 4}" width="4" height="${6 + i * 4}" rx="1" fill="${i < n ? "currentColor" : "none"}"/>`,
              )
              .join(""),
          );
        const pickers: {
          select: HTMLSelectElement;
          box: string;
          face: (value: string) => string;
        }[] = [
          {
            select: weaponSel,
            box: "[data-pick-weapon]",
            face: (v) => sizedIcon(WEAPON_ICON[v as WeaponId] ?? "", "h-6 w-6"),
          },
          {
            select: rivalSel,
            box: "[data-pick-rival]",
            face: (v) =>
              v === "different"
                ? DICE
                : v === "mirror"
                  ? MIRROR
                  : sizedIcon(WEAPON_ICON[v as WeaponId] ?? "", "h-6 w-6"),
          },
          {
            select: levelSel,
            box: "[data-pick-level]",
            face: (v) => `<span class="text-sm font-black">${v}</span>`,
          },
          {
            select: diffSel,
            box: "[data-pick-diff]",
            face: (v) => bars(v === "easy" ? 1 : v === "normal" ? 2 : 3),
          },
        ];

        function drawArt() {
          if (!art) return;
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          const w = art.clientWidth;
          const h = art.clientHeight;
          if (!w || !h) return;
          art.width = Math.round(w * dpr);
          art.height = Math.round(h * dpr);
          const c = art.getContext("2d")!;
          c.setTransform(dpr, 0, 0, dpr, 0, 0);
          c.clearRect(0, 0, w, h);
          c.fillStyle = "rgba(76,5,25,0.14)";
          c.fillRect(0, h * 0.82, w, h * 0.18);
          drawPlayer(c, w * 0.26, h * 0.6, 16, "#38bdf8", 0);
          drawEnemy(c, "imp", w * 0.74, h * 0.6, 13, "#f43f5e", {});
          const mine = weaponSel.value as WeaponId;
          drawWeaponGlyph(c, mine, w * 0.26, h * 0.16, 15, 0);
          const rv = rivalSel.value;
          const theirs =
            rv === "mirror"
              ? mine
              : rv === "different"
                ? null
                : (rv as WeaponId);
          if (theirs)
            drawWeaponGlyph(c, theirs, w * 0.74, h * 0.16, 15, Math.PI);
          c.textAlign = "center";
          c.textBaseline = "middle";
          c.fillStyle = "#4c0519";
          if (!theirs) {
            c.font = '20px "Dela Gothic One", sans-serif';
            c.fillText("?", w * 0.74, h * 0.16);
          }
          c.font = '26px "Dela Gothic One", sans-serif';
          c.fillText("VS", w / 2, h * 0.55);
        }

        function render() {
          for (const pk of pickers) {
            const box = document.querySelector<HTMLElement>(pk.box);
            if (!box) continue;
            box.innerHTML = "";
            for (const opt of Array.from(pk.select.options)) {
              const on = opt.value === pk.select.value;
              const btn = document.createElement("button");
              btn.type = "button";
              btn.title = opt.textContent ?? "";
              btn.setAttribute("aria-label", opt.textContent ?? opt.value);
              btn.setAttribute("aria-pressed", String(on));
              btn.className = `flex h-10 w-10 items-center justify-center rounded-xl border-[3px] transition ${
                on
                  ? "border-[#0d0a24] bg-[#ffd447] text-[#0d0a24] shadow-[0_3px_0_#0d0a24]"
                  : "border-[#5a4ca8] bg-[#2f2670] text-[#c9c2ff] hover:border-[#ffd447]"
              }`;
              btn.innerHTML = pk.face(opt.value);
              btn.addEventListener("click", () => {
                pk.select.value = opt.value;
                pk.select.dispatchEvent(new Event("change"));
                render();
              });
              box.append(btn);
            }
          }
          drawArt();
        }
        render();
        window.addEventListener("resize", drawArt);
        document.addEventListener("game:panel-open", () =>
          requestAnimationFrame(drawArt),
        );
        void document.fonts?.ready.then(drawArt);
      }
      mountDuelUi();

      // Each menu zone is its own modal (a native <dialog>: Esc closes it and
      // focus stays inside).
      function closePanels() {
        for (const d of document.querySelectorAll<HTMLDialogElement>(
          "dialog[open]",
        )) {
          d.close();
        }
      }
      for (const btn of document.querySelectorAll<HTMLElement>(
        "[data-open-panel]",
      )) {
        btn.addEventListener("click", () => {
          const id = btn.dataset.openPanel;
          const dlg = document.querySelector<HTMLDialogElement>(
            `[data-panel="${id}"]`,
          );
          if (!dlg || dlg.open) return;
          dlg.showModal();
          dlg.scrollTop = 0;
          document.dispatchEvent(
            new CustomEvent("game:panel-open", { detail: id }),
          );
        });
      }
      for (const dlg of document.querySelectorAll<HTMLDialogElement>(
        "[data-panel]",
      )) {
        dlg.addEventListener("click", (event) => {
          if (event.target === dlg) dlg.close();
        });
        dlg
          .querySelector("[data-panel-close]")
          ?.addEventListener("click", () => dlg.close());
      }

      document
        .querySelector("[data-duel-start]")!
        .addEventListener("click", () => wipeTo(startDuelMatch));
      document
        .querySelector("[data-duel-again]")!
        .addEventListener("click", () => wipeTo(startDuelMatch));
      for (const q of ["[data-duel-quit]", "[data-duel-leave]"]) {
        document
          .querySelector(q)!
          .addEventListener("click", () => wipeTo(showLobby));
      }
      renderDuelRecord();
      backToLobbyButton.addEventListener("click", () => {
        wipeTo(() => {
          activeGame?.stop();
          activeGame = null;
          showLobby();
        });
      });

      showLobby();
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
