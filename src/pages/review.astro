---
import Layout from "../layouts/Layout.astro";
import HubHeader from "../components/HubHeader.astro";
import { loadHomeData } from "../lib/home-data";

const { unitLookup } = await loadHomeData();
---

<Layout title="Review">
  <HubHeader
    title="Review"
    subtitle="Spaced repetition works because you forget a little between visits. A quick re-check now is what makes it stick."
  />

  <div data-review-list class="mt-8 grid gap-3 sm:grid-cols-2"></div>
  <p
    data-review-empty
    class="mt-8 hidden rounded-xl border-2 border-dashed border-slate-300 p-6 text-slate-500 dark:border-slate-700 dark:text-slate-400"
  >
    Nothing is due. Finish a unit and its first re-check shows up here 7 days
    later.
  </p>

  <script
    type="application/json"
    id="unit-lookup"
    set:html={JSON.stringify(unitLookup)}
  />

  <script>
    import { getDueUnits } from "../lib/progress-gauges";

    interface DueUnit {
      track: string;
      slug: string;
      problem: string;
    }

    function buildDueCard(unit: DueUnit): HTMLAnchorElement {
      const a = document.createElement("a");
      a.href = `/${unit.track}/${unit.slug}/`;
      a.className =
        "group flex w-full flex-col rounded-lg border p-3 transition hover:brightness-95";
      a.style.borderColor = "var(--gauge-warn)";
      a.style.background =
        "color-mix(in srgb, var(--gauge-warn) 8%, transparent)";
      const eyebrowEl = document.createElement("span");
      eyebrowEl.className = "text-[10px] font-semibold tracking-wide uppercase";
      eyebrowEl.style.color = "var(--gauge-warn)";
      eyebrowEl.textContent = "Review due";
      const titleEl = document.createElement("span");
      titleEl.className =
        "mt-1 text-sm font-medium text-slate-900 group-hover:underline dark:text-slate-100";
      titleEl.textContent = unit.problem;
      a.append(eyebrowEl, titleEl);
      return a;
    }

    function initReview() {
      const list = document.querySelector<HTMLElement>("[data-review-list]");
      const empty = document.querySelector<HTMLElement>("[data-review-empty]");
      const lookupEl = document.getElementById("unit-lookup");
      if (!list || !empty || !lookupEl) return;
      if (list.dataset.wired === "true") return;
      list.dataset.wired = "true";

      let lookup: DueUnit[];
      try {
        lookup = JSON.parse(lookupEl.textContent || "[]");
      } catch {
        return;
      }
      const due = getDueUnits(lookup);
      empty.classList.toggle("hidden", due.length > 0);
      for (const unit of due) list.append(buildDueCard(unit));
    }
    initReview();
    document.addEventListener("astro:page-load", initReview);
  </script>
</Layout>
