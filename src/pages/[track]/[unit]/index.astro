---
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import LevelTabs from "../../../components/LevelTabs.astro";
import ProgressToggle from "../../../components/ProgressToggle.astro";
import { getUnit } from "../../../data/roadmap";
import { getWrittenUnits, getUnitContent } from "../../../lib/curriculum";

export async function getStaticPaths() {
  const units = await getWrittenUnits();
  return units.map((u) => ({
    params: { track: u.track, unit: u.unitSlug },
  }));
}

const { track: trackName, unit: unitSlug } = Astro.params;
const content = await getUnitContent(trackName!, unitSlug!);
const roadmapUnit = getUnit(trackName!, unitSlug!);

if (!content) {
  return Astro.redirect("/404");
}

const L1 = content.l1 ? (await render(content.l1)).Content : null;
const L2 = content.l2 ? (await render(content.l2)).Content : null;
const L3 = content.l3 ? (await render(content.l3)).Content : null;
const L3Parts = await Promise.all(
  content.l3Parts.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<Layout title={roadmapUnit?.problem ?? unitSlug!}>
  <a
    href={`/${trackName}/`}
    class="text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100"
    >&larr; {trackName}/</a
  >

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="max-w-2xl text-2xl font-bold tracking-tight">
      {roadmapUnit?.problem ?? unitSlug}
    </h1>
    <ProgressToggle track={trackName!} unitSlug={unitSlug!} />
  </div>

  <div class="mt-8">
    <LevelTabs
      hasL1={!!L1}
      hasL2={!!L2}
      hasL3={!!(L3 || L3Parts.length > 0)}
    >
      <Fragment slot="l1">{L1 && <L1 />}</Fragment>
      <Fragment slot="l2">{L2 && <L2 />}</Fragment>
      <Fragment slot="l3">
        {L3 && <L3 />}
        {L3Parts.length > 0 && (
          <div class="space-y-10">
            {L3Parts.map(({ Content }) => (
              <Content />
            ))}
          </div>
        )}
      </Fragment>
    </LevelTabs>
  </div>
</Layout>
