---
import { render } from "astro:content";
import { ArrowLeft } from "lucide-astro";
import Layout from "../../../layouts/Layout.astro";
import LevelTabs from "../../../components/LevelTabs.astro";
import ProgressToggle from "../../../components/ProgressToggle.astro";
import ExercisePanel from "../../../components/ExercisePanel.astro";
import InteractiveDemo from "../../../components/InteractiveDemo.astro";
import TrackIcon from "../../../components/TrackIcon.astro";
import UnitIllustration from "../../../components/UnitIllustration.astro";
import { getUnit } from "../../../data/roadmap";
import {
  getWrittenUnits,
  getUnitContent,
  groupExercisesIntoPools,
} from "../../../lib/curriculum";

export async function getStaticPaths() {
  const units = await getWrittenUnits();
  return units.map((u) => ({
    params: { track: u.track, unit: u.unitSlug },
  }));
}

const { track: trackName, unit: unitSlug } = Astro.params;
const content = await getUnitContent(trackName!, unitSlug!);
const roadmapUnit = getUnit(trackName!, unitSlug!);

if (!content) {
  return Astro.redirect("/404");
}

const L1 = content.l1 ? (await render(content.l1)).Content : null;
const L2 = content.l2 ? (await render(content.l2)).Content : null;
const L3 = content.l3 ? (await render(content.l3)).Content : null;
const L3Parts = await Promise.all(
  content.l3Parts.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const exercisesByLevel = {
  1: content.exercises.filter((e) => e.level === 1),
  2: content.exercises.filter((e) => e.level === 2),
  3: content.exercises.filter((e) => e.level === 3),
};
const interactivesByLevel = {
  1: content.interactives.filter((d) => d.level === 1),
  2: content.interactives.filter((d) => d.level === 2),
  3: content.interactives.filter((d) => d.level === 3),
};
// Gating tracks pass/fail per pool (one poolId can have several randomized
// variants), not per individual exercise item.
const allPoolIds = groupExercisesIntoPools(content.exercises).map(
  (p) => p.poolId,
);
---

<Layout
  title={roadmapUnit?.problem ?? unitSlug!}
  ogImage={`/og/${trackName}/${unitSlug}.png`}
>
  <a
    href={`/${trackName}/`}
    class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100"
  >
    <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
    <TrackIcon track={trackName!} class="h-3.5 w-3.5" />
    {trackName}/
  </a>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="max-w-2xl text-2xl font-bold tracking-tight">
      {roadmapUnit?.problem ?? unitSlug}
    </h1>
    <ProgressToggle
      track={trackName!}
      unitSlug={unitSlug!}
      hasExercises={allPoolIds.length > 0}
    />
  </div>

  <UnitIllustration unitSlug={unitSlug!} />

  <div class="mt-8">
    <LevelTabs hasL1={!!L1} hasL2={!!L2} hasL3={!!(L3 || L3Parts.length > 0)}>
      <Fragment slot="l1">
        {L1 && <L1 />}
        <InteractiveDemo demos={interactivesByLevel[1]} />
        <ExercisePanel
          track={trackName!}
          unitSlug={unitSlug!}
          exercises={exercisesByLevel[1]}
        />
      </Fragment>
      <Fragment slot="l2">
        <UnitIllustration unitSlug={unitSlug!} variant="l2" />
        {L2 && <L2 />}
        <InteractiveDemo demos={interactivesByLevel[2]} />
        <ExercisePanel
          track={trackName!}
          unitSlug={unitSlug!}
          exercises={exercisesByLevel[2]}
        />
      </Fragment>
      <Fragment slot="l3">
        <UnitIllustration unitSlug={unitSlug!} variant="l3" />
        {L3 && <L3 />}
        {
          L3Parts.length > 0 && (
            <div class="space-y-10">
              {L3Parts.map(({ Content }) => (
                <Content />
              ))}
            </div>
          )
        }
        <InteractiveDemo demos={interactivesByLevel[3]} />
        <ExercisePanel
          track={trackName!}
          unitSlug={unitSlug!}
          exercises={exercisesByLevel[3]}
        />
      </Fragment>
    </LevelTabs>
  </div>
</Layout>
