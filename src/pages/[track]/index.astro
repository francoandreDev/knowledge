---
import Layout from "../../layouts/Layout.astro";
import { roadmap, getTrack } from "../../data/roadmap";
import { getWrittenUnits } from "../../lib/curriculum";

export function getStaticPaths() {
  return roadmap.tracks.map((track) => ({
    params: { track: track.name },
  }));
}

const { track: trackName } = Astro.params;
const track = getTrack(trackName!)!;
const writtenUnits = await getWrittenUnits();
const writtenSlugs = new Set(
  writtenUnits.filter((u) => u.track === trackName).map((u) => u.unitSlug),
);
---

<Layout title={track.name}>
  <a
    href="/"
    class="text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100"
    >&larr; all tracks</a
  >
  <h1 class="mt-3 text-3xl font-bold tracking-tight">{track.name}/</h1>

  <ol class="mt-8 divide-y divide-slate-200 dark:divide-slate-800">
    {
      track.units.map((unit) => {
        const isWritten = writtenSlugs.has(unit.slug);
        return (
          <li class="py-3">
            {isWritten ? (
              <a
                href={`/${track.name}/${unit.slug}/`}
                class="flex items-baseline gap-3"
              >
                <span class="w-6 shrink-0 text-right text-xs text-slate-400 tabular-nums">
                  {unit.number}
                </span>
                <span class="text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900 dark:text-slate-100 dark:decoration-slate-700">
                  {unit.problem}
                </span>
              </a>
            ) : (
              <div class="flex items-baseline gap-3">
                <span class="w-6 shrink-0 text-right text-xs text-slate-400 tabular-nums">
                  {unit.number}
                </span>
                <span class="text-slate-500 dark:text-slate-500">
                  {unit.problem}
                </span>
                <span class="ml-auto shrink-0 text-xs text-slate-400">
                  {unit.status}
                </span>
              </div>
            )}
          </li>
        );
      })
    }
  </ol>
</Layout>
