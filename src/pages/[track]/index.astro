---
import { ArrowLeft, HelpCircle, Check, Lock } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import TrackIcon from "../../components/TrackIcon.astro";
import TrackIllustration from "../../components/TrackIllustration.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import ProgressGauge from "../../components/ProgressGauge.astro";
import TopicMythModal from "../../components/TopicMythModal.astro";
import { UNIT_TEASERS } from "../../data/unit-teasers";
import { roadmap, getTrack } from "../../data/roadmap";
import type { RoadmapUnit } from "../../data/roadmap";
import { getWrittenUnits } from "../../lib/curriculum";
import { groupSlugsByTrack } from "../../lib/progress-gauges";

export function getStaticPaths() {
  return roadmap.tracks.map((track) => ({
    params: { track: track.name },
  }));
}

const { track: trackName } = Astro.params;
const track = getTrack(trackName!)!;
const writtenUnits = await getWrittenUnits();
const trackWrittenUnits = writtenUnits.filter((u) => u.track === trackName);
const writtenSlugs = new Set(trackWrittenUnits.map((u) => u.unitSlug));

// Embedded for the client-side gauge script (see the bottom script block) —
// same mechanism as the homepage and roadmap: the gauge shows how much of
// *this reader's own* progress covers what's written, not just how much of
// the track exists.
const trackUnitSlugs = groupSlugsByTrack(trackWrittenUnits);

// Written units in curriculum order — the sequence the unlock rule walks
// (the visual grouping below regroups by tag, so it can't be used for this).
const orderedWrittenSlugs = track.units
  .filter((u) => writtenSlugs.has(u.slug))
  .map((u) => u.slug);

// Groups units by their primary (first) tag instead of pure sequential
// order — a 13-17 unit track reads as a wall of identical rows otherwise.
// Each unit keeps its real position number (`i`, from `track.units`), so
// "why is #7 here" is still answerable; only the *visual* order regroups
// around the dominant theme, in the order that theme first appears.
interface GroupedUnit {
  unit: RoadmapUnit;
  index: number;
}
const unitGroups: { label: string; items: GroupedUnit[] }[] = [];
const groupIndexByTag = new Map<string, number>();
track.units.forEach((unit, i) => {
  const key = unit.tags[0] ?? "general";
  if (!groupIndexByTag.has(key)) {
    groupIndexByTag.set(key, unitGroups.length);
    unitGroups.push({ label: key, items: [] });
  }
  unitGroups[groupIndexByTag.get(key)!].items.push({ unit, index: i });
});
function formatGroupLabel(tag: string): string {
  const spaced = tag.replace(/-/g, " ");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
}
---

<Layout title={track.name} ogImage={`/og/${track.name}.png`} wide>
  <a
    href="/"
    class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 dark:hover:text-slate-100"
  >
    <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
    all tracks
  </a>

  <!-- Collapses to an icon + name + % strip once the full header below
       scrolls out of view — a 13-17 unit track is a long scroll, and
       without this the reader's progress is only visible at the very top. -->
  <div
    data-track-sticky-header
    class="sticky top-0 z-20 -mx-4 hidden items-center justify-between gap-3 border-b border-slate-200 bg-white/90 px-4 py-2 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 dark:border-slate-800 dark:bg-slate-950/90"
  >
    <span class="flex min-w-0 items-center gap-2">
      <TrackIcon track={track.name} class="h-4 w-4 shrink-0" />
      <span class="truncate text-sm font-semibold">{track.name}/</span>
    </span>
    <span
      data-track-sticky-pct
      class="shrink-0 text-xs font-semibold tabular-nums"
      style="color: var(--gauge-accent)"
    >
      {writtenSlugs.size > 0 ? "0%" : "—"}
    </span>
  </div>

  <div
    data-track-header-card
    class="relative mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-20 -right-20 -z-0 h-56 w-56 rounded-full opacity-[0.12] blur-3xl"
      style="background: var(--accent)"
    >
    </div>
    <div class="relative flex flex-wrap items-center gap-4">
      <TrackIllustration
        track={track.name}
        class="hidden w-40 shrink-0 sm:block"
      />
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg"
              style="background: var(--accent-soft-bg); color: var(--accent-text)"
            >
              <TrackIcon track={track.name} class="h-6 w-6" />
            </span>
            <h1 class="text-3xl font-bold tracking-tight">{track.name}/</h1>
          </div>
          <ProgressGauge
            trackName={track.name}
            total={writtenSlugs.size}
            size={40}
            class="gap-2"
          >
            <span
              data-gauge-frac
              class="text-xs font-semibold tabular-nums text-slate-600 dark:text-slate-400"
            >
              {
                writtenSlugs.size > 0
                  ? `0/${writtenSlugs.size} done`
                  : "Not started"
              }
            </span>
          </ProgressGauge>
        </div>
        <p
          class="mt-1.5 text-xs tabular-nums text-slate-400 dark:text-slate-600"
        >
          {writtenSlugs.size} of {track.units.length} units written
        </p>
      </div>
    </div>
  </div>

  <div class="mt-8 space-y-8">
    {
      unitGroups.map((group) => (
        <section>
          <h2 class="mb-3 flex items-center gap-2 text-xs font-bold tracking-wide text-slate-400 uppercase dark:text-slate-600">
            {formatGroupLabel(group.label)}
            <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800" />
          </h2>
          <ol>
            {group.items.map(({ unit, index: i }, posInGroup) => {
              const isWritten = writtenSlugs.has(unit.slug);
              const status = isWritten ? "done" : unit.status;
              const isLast = posInGroup === group.items.length - 1;
              const hasTeaser = Boolean(
                UNIT_TEASERS[`${track.name}/${unit.slug}`],
              );
              return (
                <li
                  data-unit-row
                  data-slug={unit.slug}
                  data-state={
                    !isWritten
                      ? "planned"
                      : unit.slug === orderedWrittenSlugs[0]
                        ? "next"
                        : "locked"
                  }
                  class={`relative flex gap-3 pb-5 ${
                    isLast
                      ? ""
                      : "before:absolute before:top-6 before:bottom-[-2px] before:left-[11px] before:w-px before:bg-slate-200 before:content-[''] dark:before:bg-slate-700"
                  }`}
                >
                  <span
                    aria-hidden="true"
                    data-row-circle
                    data-status={status}
                    class="row-circle relative z-10 flex h-[23px] w-[23px] shrink-0 items-center justify-center rounded-full border text-[10px] font-bold"
                  >
                    <Check data-ic="done" class="h-3 w-3" aria-hidden="true" />
                    <Lock data-ic="locked" class="h-3 w-3" aria-hidden="true" />
                    <span data-ic="num">{i + 1}</span>
                  </span>
                  <div class="relative -mt-1 min-w-0 flex-1 rounded-lg p-1 transition hover:bg-slate-50 dark:hover:bg-slate-900/50">
                    {isWritten && (
                      <a
                        href={`/${track.name}/${unit.slug}/`}
                        aria-label={unit.problem}
                        class="absolute inset-0 z-0"
                      />
                    )}
                    <div class="pointer-events-none flex items-start gap-3">
                      <div class="min-w-0 flex-1">
                        <span
                          data-row-title
                          class={
                            isWritten
                              ? "text-base font-medium text-slate-900 dark:text-slate-100"
                              : "text-base text-slate-500 dark:text-slate-500"
                          }
                        >
                          {unit.problem}
                        </span>
                        <div class="mt-1.5 flex flex-wrap gap-1.5">
                          {unit.tags.map((tag) => (
                            <span class="rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300">
                              {tag}
                            </span>
                          ))}
                        </div>
                      </div>
                      <div class="pointer-events-auto flex shrink-0 items-center gap-1.5">
                        {hasTeaser && (
                          <button
                            type="button"
                            data-myth-trigger={`${track.name}/${unit.slug}`}
                            aria-label={`What is "${unit.problem}", really?`}
                            class="relative z-10 shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            style="color: var(--accent-text)"
                          >
                            <HelpCircle
                              class="h-3.5 w-3.5"
                              aria-hidden="true"
                            />
                          </button>
                        )}
                        {isWritten ? (
                          <span data-state-chip class="state-chip">
                            {unit.slug === orderedWrittenSlugs[0]
                              ? "Up next"
                              : "Locked"}
                          </span>
                        ) : (
                          <StatusBadge status={unit.status} />
                        )}
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>

  <TopicMythModal />

  <script
    type="application/json"
    id="ordered-written-slugs"
    set:html={JSON.stringify(orderedWrittenSlugs)}
  />
  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />

  <script>
    import {
      applyTrackGauges,
      countDoneByTrack,
    } from "../../lib/progress-gauges";
    import { unitStates } from "../../lib/unlock";

    const CHIP_LABEL: Record<string, string> = {
      done: "Done",
      next: "Up next",
      locked: "Locked",
    };

    // Stamps each written unit's row from the active profile's progress, so
    // the list shows the same done / up next / locked states as the roadmap.
    function stampUnitStates() {
      const orderEl = document.getElementById("ordered-written-slugs");
      const rows = Array.from(
        document.querySelectorAll<HTMLElement>("[data-unit-row]"),
      );
      const track = window.location.pathname.split("/").filter(Boolean)[0];
      if (!orderEl || !track) return;
      let order: string[];
      try {
        order = JSON.parse(orderEl.textContent || "[]");
      } catch {
        return;
      }
      const states = unitStates(track, order);
      const stateBySlug = new Map(order.map((slug, i) => [slug, states[i]]));
      for (const row of rows) {
        const state = stateBySlug.get(row.dataset.slug ?? "");
        if (!state) continue;
        row.dataset.state = state;
        const chip = row.querySelector<HTMLElement>("[data-state-chip]");
        if (chip) chip.textContent = CHIP_LABEL[state];
      }
    }

    function initTrackGauges() {
      const el = document.getElementById("track-unit-slugs");
      if (!el) return;
      let map: Record<string, string[]>;
      try {
        map = JSON.parse(el.textContent || "{}");
      } catch {
        return;
      }
      applyTrackGauges(map);
      stampUnitStates();

      const stickyPct = document.querySelector<HTMLElement>(
        "[data-track-sticky-pct]",
      );
      if (stickyPct) {
        const total = Object.values(map).reduce((n, arr) => n + arr.length, 0);
        const done = Object.values(countDoneByTrack(map)).reduce(
          (n, c) => n + c,
          0,
        );
        stickyPct.textContent =
          total > 0 ? `${Math.round((done / total) * 100)}%` : "—";
      }
    }
    initTrackGauges();
    document.addEventListener("astro:page-load", initTrackGauges);

    // Reveals the compact icon+name+% strip only once the full header
    // scrolls out of view, so progress stays visible through a long track
    // without the header permanently eating vertical space.
    function initStickyTrackHeader() {
      const sticky = document.querySelector<HTMLElement>(
        "[data-track-sticky-header]",
      );
      const headerCard = document.querySelector<HTMLElement>(
        "[data-track-header-card]",
      );
      const siteHeader = document.querySelector<HTMLElement>("header");
      if (!sticky || !headerCard) return;
      if (sticky.dataset.wired === "true") return;
      sticky.dataset.wired = "true";

      if (siteHeader) {
        sticky.style.top = `${siteHeader.getBoundingClientRect().height}px`;
      }

      const observer = new IntersectionObserver(
        ([entry]) => {
          sticky.classList.toggle("hidden", entry.isIntersecting);
          sticky.classList.toggle("flex", !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      observer.observe(headerCard);
    }
    initStickyTrackHeader();
    document.addEventListener("astro:page-load", initStickyTrackHeader);
  </script>
</Layout>

<style>
  .row-circle {
    border-color: #cbd5e1;
    color: #94a3b8;
  }
  :global(.dark) .row-circle {
    border-color: #475569;
    color: #64748b;
  }
  .row-circle :global([data-ic]) {
    display: none;
  }
  [data-unit-row][data-state="done"] .row-circle {
    border-color: var(--gauge-accent);
    background: var(--gauge-accent);
    color: #fff;
  }
  [data-unit-row][data-state="next"] .row-circle {
    border-color: var(--accent-text);
    color: var(--accent-text);
    box-shadow: 0 0 0 3px var(--accent-soft-bg);
  }
  [data-unit-row][data-state="locked"] .row-circle {
    background: #f1f5f9;
  }
  :global(.dark) [data-unit-row][data-state="locked"] .row-circle {
    background: #1e293b;
  }
  [data-unit-row][data-state="planned"] .row-circle {
    border-style: dashed;
  }
  [data-unit-row][data-state="done"] .row-circle :global([data-ic="done"]),
  [data-unit-row][data-state="locked"] .row-circle :global([data-ic="locked"]) {
    display: block;
  }
  [data-unit-row][data-state="next"] .row-circle :global([data-ic="num"]),
  [data-unit-row][data-state="planned"] .row-circle :global([data-ic="num"]) {
    display: block;
  }
  [data-unit-row][data-state="locked"] [data-row-title] {
    color: #64748b;
    font-weight: 400;
  }
  .state-chip {
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    background: #e2e8f0;
    color: #475569;
  }
  :global(.dark) .state-chip {
    background: #334155;
    color: #cbd5e1;
  }
  [data-unit-row][data-state="done"] .state-chip {
    background: #d1fae5;
    color: #065f46;
  }
  [data-unit-row][data-state="next"] .state-chip {
    background: var(--accent-text);
    color: #fff;
  }
</style>
