                )}
                {r.id === "frontier" && (
                  <>
                    <circle cx="60" cy="32" r="22" />
                    <path d="M60 14l6 18-6 18-6-18z" />
                    <path d="M60 14v36M38 32h44" opacity="0.4" />
                  </>
                )}
              </svg>
              <div class="min-w-0 flex-1">
                <h2 id={`region-${r.id}`} class="region-title">
                  {r.title}
                </h2>
                <p class="region-sub">{r.tagline}</p>
              </div>
