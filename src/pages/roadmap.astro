  /* Per-world colour tokens, derived from the --world-h hue set in markup.
     --wc          accents: ring, progress bar, focus
     --wc-solid    fills that carry white content (the "next" node, buttons)
     --wc-deep     borders and hard shadows under those fills
     --wc-soft     tinted backgrounds
     --wc-text     small text on the tinted background */
  .island,
  .world-modal,
  [data-world-panel] {
    --wc: hsl(var(--world-h) 72% 38%);
    --wc-solid: hsl(var(--world-h) 72% 32%);
    --wc-deep: hsl(var(--world-h) 72% 16%);
    --wc-soft: hsl(var(--world-h) 80% 95%);
    --wc-text: hsl(var(--world-h) 70% 22%);
  }
  :global(.dark) .island,
  :global(.dark) .world-modal,
  :global(.dark) [data-world-panel] {
    --wc: hsl(var(--world-h) 80% 62%);
    --wc-solid: hsl(var(--world-h) 68% 40%);
    --wc-deep: hsl(var(--world-h) 68% 16%);
    --wc-soft: hsl(var(--world-h) 45% 14%);
    --wc-text: hsl(var(--world-h) 85% 74%);
  }

  /* progress rings (islands) */
  .complete-badge {
