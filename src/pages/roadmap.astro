  /* sticky world header: sits just under the modal bar */
  .world-head {
    position: sticky;
    top: calc(var(--bar-h) + 0.5rem);
    z-index: 9;
  }

  /* level nodes */
  .trail {
    isolation: isolate; /* keep node z-indexes below the sticky headers */
  }
  .trail-row {
    --disc: clamp(3.25rem, 8vw, 4.5rem);
    --gap: 4rem; /* matches the gap-16 between rows on the <ol> */
  }
  .node {
    width: calc(100% / var(--per, 5));
  }
  /* The path itself. --per (nodes per row) comes from the <ol>, --n (nodes in
     this row) and --m (leading done nodes) from each row. */
  .trail-line,
  .trail-fill {
    position: absolute;
    top: calc(var(--disc) / 2);
    left: calc(50% / var(--per));
    height: 0;
    border-top: 6px dotted #cbd5e1;
  }
  .trail-line {
    width: calc(100% * (var(--n) - 1) / var(--per));
  }
  .trail-fill {
    width: calc(100% * var(--m, 0) / var(--per));
    border-top-style: solid;
    border-top-color: #059669;
    border-radius: 3px;
    transition: width 0.6s ease;
  }
  .trail-row.is-flipped .trail-line,
  .trail-row.is-flipped .trail-fill {
    left: auto;
    right: calc(50% / var(--per));
  }
  :global(.dark) .trail-line {
    border-top-color: #334155;
  }
  /* Elbow joining a row's last node to the next row's first node, so the
     trail reads as one continuous snake instead of stacked strips. It leaves
     the end node's centre line, bulges out into the side padding, and comes
     back in at the next row's centre line. The extra 6px is the border, so
     the bottom stroke lands exactly on the next row's line. */
  .trail-row:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(var(--disc) / 2);
    right: -0.75rem;
    width: calc(50% / var(--per) + 0.75rem);
    height: calc(100% + var(--gap) + 6px);
    border: 6px dotted #cbd5e1;
    border-left: 0;
    border-radius: 0 2rem 2rem 0;
    pointer-events: none;
  }
  .trail-row.is-flipped:not(:last-child)::after {
    right: auto;
    left: -0.75rem;
    border: 6px dotted #cbd5e1;
    border-right: 0;
    border-radius: 2rem 0 0 2rem;
  }
  :global(.dark) .trail-row:not(:last-child)::after,
  :global(.dark) .trail-row.is-flipped:not(:last-child)::after {
    border-color: #334155;
