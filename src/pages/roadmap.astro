                    <path d="M58 18v-5h8v5" />
                    <path
                      d="M52 20L22 12M72 20l30-8"
                      opacity="0.5"
                      stroke-dasharray="3 3"
                    />
                    <path d="M96 48h16l-3 6H99z" />
