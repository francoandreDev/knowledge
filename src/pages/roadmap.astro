---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import TopicMythModal from "../components/TopicMythModal.astro";
import {
  Search,
  HelpCircle,
  ChevronDown,
  RotateCcw,
  UnfoldVertical,
  FoldVertical,
  X,
} from "lucide-astro";
import { roadmap, type UnitStatus } from "../data/roadmap";
import { getWrittenUnits } from "../lib/curriculum";
import { groupSlugsByTrack } from "../lib/progress-gauges";

const writtenUnits = await getWrittenUnits();
const writtenKeys = new Set(
  writtenUnits.map((u) => `${u.track}/${u.unitSlug}`),
);

// Embedded for the client-side gauge script (see the bottom script block) —
// the pool of slugs a reader could have marked done, per track.
const trackUnitSlugs = groupSlugsByTrack(writtenUnits);

const STATUSES: UnitStatus[] = ["planned", "in-progress", "done"];

// Radius/circumference for each track section's circular progress node —
// same ring math as the homepage's track selector (index.astro).
const GAUGE_RADIUS = 16;
const GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;

// How many units show per track before the reader has to click "Show all" —
// most tracks run well past this, and an un-filtered browse view doesn't
// need every unit in view at once (see roadmap.astro's per-unit list redesign).
const UNIT_DISPLAY_LIMIT = 6;

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();

// Embedded for the wizard's tag step (see the bottom script block) — which
// tags actually occur within each track, so picking tracks in step 1
// narrows the tag options offered in step 2 instead of always showing every
// tag in the roadmap.
const tagsByTrack: Record<string, string[]> = {};
for (const track of roadmap.tracks) {
  tagsByTrack[track.name] = Array.from(
    new Set(track.units.flatMap((u) => u.tags)),
  );
}

// Content-coverage stats for the overview strip — these are the same for
// every visitor (how much of the roadmap is written), unlike the per-track
// gauges below (how much *this reader* has completed of what's written).
const totalUnitsAll = roadmap.tracks.reduce((n, t) => n + t.units.length, 0);
const tracksStartedCount = roadmap.tracks.filter((t) =>
  t.units.some((u) => writtenKeys.has(`${t.name}/${u.slug}`)),
).length;
const inProgressCount = roadmap.tracks.reduce(
  (n, t) =>
    n +
    t.units.filter(
      (u) =>
        !writtenKeys.has(`${t.name}/${u.slug}`) && u.status === "in-progress",
    ).length,
  0,
);
const plannedCount = totalUnitsAll - writtenUnits.length - inProgressCount;
const donePct = totalUnitsAll ? (writtenUnits.length / totalUnitsAll) * 100 : 0;
const progressPct = totalUnitsAll ? (inProgressCount / totalUnitsAll) * 100 : 0;
---

<Layout title="Roadmap" wide>
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Roadmap</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      Every planned unit across all tracks. Written units are linked; the rest
      are still <code>planned</code>.
    </p>
  </div>

  <!-- The coverage card used to always show the full bar + 4-item legend —
       at 100% written that's a lot of mostly-static detail to scan past
       before reaching the wizard/results below. A compact one-line summary
       button opens the same detail in a dialog instead, same pattern as
       the homepage's stats/journey modals. -->
  <button
    type="button"
    data-roadmap-stats-trigger
    class="mt-6 inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 transition hover:border-slate-400 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600"
  >
    <span class="font-semibold tabular-nums text-slate-900 dark:text-slate-100">
      {writtenUnits.length}/{totalUnitsAll}
    </span>
    units written
    <span class="tabular-nums" style="color: var(--gauge-accent)">
      {Math.round(donePct)}%
    </span>
    <ChevronDown class="h-3.5 w-3.5" aria-hidden="true" />
  </button>

  <dialog
    data-roadmap-stats-modal
    class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-0 text-slate-900 backdrop:bg-slate-950/60 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100"
  >
    <div class="p-5">
      <div class="flex items-start justify-between gap-4">
        <p
          class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
        >
          Roadmap coverage
        </p>
        <button
          type="button"
          data-roadmap-stats-close
          aria-label="Close"
          class="shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        >
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>
      <div class="mt-3 flex items-baseline justify-between gap-3">
        <div class="text-2xl font-extrabold tracking-tight tabular-nums">
          {writtenUnits.length}
          <span
            class="text-base font-semibold text-slate-400 dark:text-slate-600"
          >
            / {totalUnitsAll} units written
          </span>
        </div>
        <div
          class="text-sm font-semibold tabular-nums"
          style="color: var(--gauge-accent)"
        >
          {Math.round(donePct)}%
        </div>
      </div>
      <div class="mt-3 flex h-2.5 overflow-hidden rounded-full bg-slate-500/10">
        <div
          class="h-full"
          style={`width: ${donePct}%; background: var(--gauge-accent)`}
        >
        </div>
        <div
          class="h-full"
          style={`width: ${progressPct}%; background: var(--gauge-warn)`}
        >
        </div>
      </div>
      <div class="mt-3.5 flex flex-wrap gap-x-4 gap-y-1.5">
        <span
          class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400"
        >
          <span
            class="h-2 w-2 shrink-0 rounded-full"
            style="background: var(--gauge-accent)"></span>
          {writtenUnits.length} done
        </span>
        <span
          class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400"
        >
          <span
            class="h-2 w-2 shrink-0 rounded-full"
            style="background: var(--gauge-warn)"></span>
          {inProgressCount} in progress
        </span>
        <span
          class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400"
        >
          <span class="h-2 w-2 shrink-0 rounded-full bg-slate-500/20"></span>
          {plannedCount} planned
        </span>
        <span class="text-xs text-slate-400 dark:text-slate-600">
          {tracksStartedCount}/{roadmap.tracks.length} tracks started
        </span>
      </div>
    </div>
  </dialog>

  <!-- Flat filter bar: search + three popovers (Track/Tags/Status), always
       next to the results they narrow — replaces the old 4-step wizard
       (Track -> Tags -> Status -> Results), which stayed visible as a
       progress stepper even once results were showing, asking the reader
       to parse "step 4 of 4" before they could focus on the units
       themselves. Picking a filter here just narrows what's already on
       screen; there is nothing to "complete". -->
  <div class="mt-6">
    <div class="flex flex-wrap items-center gap-2">
      <div class="relative min-w-[220px] flex-1">
        <Search
          class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        />
        <input
          type="search"
          data-roadmap-search
          placeholder='Search units or tracks, e.g. "rebase"...'
          class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pr-3 pl-9 text-sm text-slate-900 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
        />
      </div>

      <!-- Track popover -->
      <div class="relative">
        <button
          type="button"
          data-filter-popover-trigger="track"
          aria-expanded="false"
          class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600"
        >
          Track
          <span
            data-filter-count="track"
            class="hidden rounded-full px-1.5 py-0.5 text-[11px] font-semibold text-white"
            style="background: var(--gauge-accent)"></span>
          <ChevronDown class="h-3.5 w-3.5" aria-hidden="true" />
        </button>
        <div
          data-filter-popover="track"
          class="hidden absolute top-full left-0 z-20 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-4 shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="relative">
            <Search
              class="pointer-events-none absolute top-1/2 left-3 h-3.5 w-3.5 -translate-y-1/2 text-slate-400"
              aria-hidden="true"
            />
            <input
              type="search"
              data-track-search
              placeholder='Search tracks, e.g. "web"...'
              class="w-full rounded-lg border border-slate-200 bg-white py-2 pr-3 pl-8 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
            />
          </div>
          <div
            class="mt-3 flex max-h-64 flex-wrap gap-x-3 gap-y-3 overflow-y-auto"
          >
            {
              roadmap.tracks.map((track) => (
                <button
                  type="button"
                  data-track-chip={track.name}
                  data-search-label={track.name}
                  aria-pressed="false"
                  title={track.name}
                  class="group flex w-16 flex-col items-center gap-1.5 text-center"
                >
                  <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-slate-200 bg-white text-slate-500 transition group-aria-pressed:border-[var(--gauge-accent)] group-aria-pressed:bg-[var(--gauge-accent)] group-aria-pressed:text-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                    <TrackIcon track={track.name} class="h-4.5 w-4.5" />
                  </span>
                  <span class="max-w-full truncate text-[11px] font-medium text-slate-600 group-aria-pressed:text-slate-900 dark:text-slate-400 dark:group-aria-pressed:text-slate-100">
                    {track.name}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Tags popover -->
      <div class="relative">
        <button
          type="button"
          data-filter-popover-trigger="tags"
          aria-expanded="false"
          class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600"
        >
          Tags
          <span
            data-filter-count="tags"
            class="hidden rounded-full px-1.5 py-0.5 text-[11px] font-semibold text-white"
            style="background: var(--gauge-accent)"></span>
          <ChevronDown class="h-3.5 w-3.5" aria-hidden="true" />
        </button>
        <div
          data-filter-popover="tags"
          class="hidden absolute top-full left-0 z-20 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-4 shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="relative">
            <Search
              class="pointer-events-none absolute top-1/2 left-3 h-3.5 w-3.5 -translate-y-1/2 text-slate-400"
              aria-hidden="true"
            />
            <input
              type="search"
              data-tag-search
              placeholder='Search tags, e.g. "caching"...'
              class="w-full rounded-lg border border-slate-200 bg-white py-2 pr-3 pl-8 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
            />
          </div>
          <p class="mt-2 text-xs text-slate-400 dark:text-slate-600">
            Narrowed to the tracks picked above — pick a track first for a
            shorter list, or leave it to see every tag.
          </p>
          <div
            class="mt-3 flex max-h-64 flex-wrap items-center gap-1.5 overflow-y-auto"
          >
            {
              ALL_TAGS.map((tag) => (
                <button
                  type="button"
                  data-tag-chip={tag}
                  data-search-label={tag}
                  aria-pressed="false"
                  class="inline-flex items-center gap-1 rounded-full bg-slate-500/10 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-500/15 aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:text-slate-300"
                >
                  {tag}
                </button>
              ))
            }
          </div>
          <p
            data-tag-empty
            class="mt-3 hidden text-sm text-slate-500 dark:text-slate-500"
          >
            No tags match this search among the selected tracks.
          </p>
        </div>
      </div>

      <!-- Status popover -->
      <div class="relative">
        <button
          type="button"
          data-filter-popover-trigger="status"
          aria-expanded="false"
          class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600"
        >
          Status
          <span
            data-filter-count="status"
            class="hidden rounded-full px-1.5 py-0.5 text-[11px] font-semibold text-white"
            style="background: var(--gauge-accent)"></span>
          <ChevronDown class="h-3.5 w-3.5" aria-hidden="true" />
        </button>
        <div
          data-filter-popover="status"
          class="hidden absolute top-full left-0 z-20 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-4 shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="flex flex-col gap-2">
            {
              STATUSES.map((status) => (
                <button
                  type="button"
                  data-status-chip={status}
                  data-search-label={status}
                  aria-pressed="false"
                  class="flex items-center justify-between gap-3 rounded-lg border border-slate-200 px-3.5 py-2.5 text-left text-sm font-medium text-slate-600 capitalize transition hover:border-slate-400 aria-pressed:border-[var(--gauge-accent)] dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600"
                >
                  <span class="flex items-center gap-2">
                    <span
                      aria-hidden="true"
                      class={`h-2.5 w-2.5 shrink-0 rounded-full ${
                        status === "done"
                          ? "bg-[var(--gauge-accent)]"
                          : status === "in-progress"
                            ? "bg-[var(--gauge-warn)]"
                            : "border border-slate-400 dark:border-slate-600"
                      }`}
                    />
                    {status}
                  </span>
                  <span
                    data-status-count
                    class="text-xs font-normal text-slate-400 tabular-nums normal-case dark:text-slate-600"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <button
        type="button"
        data-clear-filters
        title="Clear all filters"
        class="hidden items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold"
        style="color: var(--accent-text); border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
      >
        <RotateCcw class="h-3 w-3" aria-hidden="true" />
        Reset
      </button>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
      <p data-match-count class="text-xs text-slate-500 dark:text-slate-500">
        {writtenUnits.length} of {
          roadmap.tracks.reduce((n, t) => n + t.units.length, 0)
        } units written
      </p>
      <button
        type="button"
        data-expand-all
        data-expanded="false"
        title="Expand every visible track to scan all its units at once"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
      >
        <UnfoldVertical
          data-expand-all-icon="expand"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        />
        <FoldVertical
          data-expand-all-icon="collapse"
          class="hidden h-3.5 w-3.5"
          aria-hidden="true"
        />
        <span data-expand-all-label>Expand all</span>
      </button>
    </div>

    <p
      data-empty-state
      class="mt-10 hidden text-center text-sm text-slate-500 dark:text-slate-500"
    >
      No units match these filters.
    </p>

    <div class="mt-6 grid grid-cols-1 items-start gap-3 lg:grid-cols-2">
      {
        roadmap.tracks.map((track) => {
          const trackWrittenCount = track.units.filter((u) =>
            writtenKeys.has(`${track.name}/${u.slug}`),
          ).length;
          return (
            <section
              data-track-section={track.name}
              class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50"
            >
              <div
                data-track-toggle
                role="button"
                tabindex="0"
                aria-expanded="false"
                title={`Show ${track.units.length} units in ${track.name}/`}
                class="flex w-full cursor-pointer flex-wrap items-center gap-4 rounded-t-xl p-3 transition hover:bg-slate-50 dark:hover:bg-slate-900"
              >
                <span
                  class="relative block h-14 w-14 shrink-0"
                  data-gauge-track={track.name}
                  data-gauge-total={trackWrittenCount}
                >
                  <svg
                    width="56"
                    height="56"
                    viewBox="0 0 40 40"
                    class="absolute inset-0 -rotate-90"
                    aria-hidden="true"
                  >
                    <circle
                      cx="20"
                      cy="20"
                      r={GAUGE_RADIUS}
                      fill="none"
                      stroke-width="3"
                      class="stroke-slate-200 dark:stroke-slate-800"
                    />
                    <circle
                      data-gauge-arc
                      cx="20"
                      cy="20"
                      r={GAUGE_RADIUS}
                      fill="none"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-dasharray={GAUGE_CIRCUMFERENCE}
                      stroke-dashoffset={GAUGE_CIRCUMFERENCE}
                      class="transition-[stroke-dashoffset] duration-500"
                      style="stroke: var(--gauge-accent)"
                    />
                  </svg>
                  <span
                    data-node-icon
                    class="absolute inset-[5px] flex items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-[opacity,filter] duration-300 dark:bg-slate-800 dark:text-slate-400"
                  >
                    <TrackIcon track={track.name} class="h-5 w-5" />
                  </span>
                  <span
                    data-node-count
                    class="pointer-events-none absolute -top-0.5 -right-0.5 hidden h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold text-white ring-2 ring-white dark:ring-slate-900"
                    style="background: var(--gauge-accent)"
                  />
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class="flex items-center gap-2">
                      <span class="text-lg font-semibold tracking-tight">
                        {track.name}/
                      </span>
                      <span
                        data-track-count
                        class="text-xs text-slate-400 tabular-nums dark:text-slate-600"
                      >
                        {track.units.length} units
                      </span>
                    </span>
                    <span class="flex items-center gap-3">
                      <button
                        type="button"
                        data-myth-trigger={track.name}
                        title={`What is ${track.name}, really?`}
                        aria-label={`What is ${track.name}, really?`}
                        class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
                      >
                        <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
                      </button>
                      <span
                        data-track-chevron
                        class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition-transform dark:border-slate-700 dark:text-slate-400"
                      >
                        <ChevronDown class="h-4 w-4" aria-hidden="true" />
                      </span>
                    </span>
                  </div>
                </div>
              </div>
              <div
                data-reader-filter-group
                class="flex items-center gap-1.5 px-3 pb-2"
              >
                <button
                  type="button"
                  data-reader-filter-chip="new"
                  aria-pressed="false"
                  class="group rounded-full border border-slate-200 px-2.5 py-1 text-[11px] font-medium text-slate-500 transition hover:border-slate-400 hover:text-slate-900 aria-pressed:border-transparent aria-pressed:text-white dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-100"
                  style="--pressed-bg: var(--gauge-warn)"
                >
                  <span class="group-aria-pressed:[background:var(--pressed-bg)] group-aria-pressed:text-white">
                    New
                  </span>
                </button>
                <button
                  type="button"
                  data-reader-filter-chip="completed"
                  aria-pressed="false"
                  class="group rounded-full border border-slate-200 px-2.5 py-1 text-[11px] font-medium text-slate-500 transition hover:border-slate-400 hover:text-slate-900 aria-pressed:border-transparent aria-pressed:text-white dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-100"
                  style="--pressed-bg: var(--gauge-accent)"
                >
                  <span class="group-aria-pressed:[background:var(--pressed-bg)] group-aria-pressed:text-white">
                    Completed
                  </span>
                </button>
              </div>
              <ol data-track-body class="hidden space-y-2 px-3 pb-3">
                {track.units.map((unit, unitIndex) => {
                  const isWritten = writtenKeys.has(
                    `${track.name}/${unit.slug}`,
                  );
                  const status = isWritten ? "done" : unit.status;
                  const searchText =
                    `${unit.problem} ${unit.slug} ${track.name}`.toLowerCase();
                  const shownTags = unit.tags.slice(0, 2);
                  const extraTagCount = unit.tags.length - shownTags.length;
                  return (
                    <li
                      data-unit-row
                      data-track={track.name}
                      data-status={status}
                      data-row-index={unitIndex}
                      data-search={searchText}
                      data-tags={unit.tags.join(" ")}
                      style={
                        status !== "planned"
                          ? `border-left-color: ${
                              status === "done"
                                ? "var(--gauge-accent)"
                                : "var(--gauge-warn)"
                            }`
                          : undefined
                      }
                      class={`flex items-start gap-3 rounded-lg border border-l-[3px] p-3 transition hover:border-slate-300 hover:bg-slate-50 dark:hover:border-slate-700 dark:hover:bg-slate-900/50 ${
                        status === "planned"
                          ? "border-slate-200 border-l-slate-300 dark:border-slate-800 dark:border-l-slate-600"
                          : "border-slate-200 dark:border-slate-800"
                      }`}
                    >
                      <div class="min-w-0 flex-1">
                        {isWritten ? (
                          <a
                            href={`/${track.name}/${unit.slug}/`}
                            class="text-base font-medium text-slate-900 hover:underline dark:text-slate-100"
                          >
                            {unit.problem}
                          </a>
                        ) : (
                          <span class="text-base text-slate-500 dark:text-slate-500">
                            {unit.problem}
                          </span>
                        )}
                        <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                          {shownTags.map((tag) => (
                            <span class="rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300">
                              {tag}
                            </span>
                          ))}
                          {extraTagCount > 0 && (
                            <span class="text-[10px] text-slate-400 dark:text-slate-600">
                              +{extraTagCount}
                            </span>
                          )}
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ol>
              {track.units.length > UNIT_DISPLAY_LIMIT && (
                <div class="px-3 pb-3">
                  <button
                    type="button"
                    data-show-more-trigger={track.name}
                    class="text-xs font-medium text-slate-500 hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-slate-100"
                  >
                    Show all {track.units.length} units
                  </button>
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </div>

  <TopicMythModal />

  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />
  <script
    type="application/json"
    id="tags-by-track"
    set:html={JSON.stringify(tagsByTrack)}
  />

  <script>
    import {
      getActiveProfile,
      updateProfileInterests,
      pStorage,
    } from "../lib/profile";
    import { applyTrackGauges, countDoneByTrack } from "../lib/progress-gauges";

    // The reader's own completion state (distinct from a unit's *content*
    // status — written/in-progress/planned, already covered by the Status
    // wizard step). Read once per mount and stamped onto each row as
    // data-reader-done so the new "New"/"Completed" chips can filter on it
    // without touching the content-status filtering logic.
    function markReaderDone() {
      document
        .querySelectorAll<HTMLElement>("[data-unit-row]")
        .forEach((row) => {
          const track = row.dataset.track ?? "";
          const slug = row.querySelector("a")?.getAttribute("href");
          const slugMatch = slug?.match(/\/([^/]+)\/$/);
          const unitSlug = slugMatch?.[1];
          if (!track || !unitSlug) {
            row.dataset.readerDone = "false";
            return;
          }
          const raw = pStorage.getItem(`progress:${track}/${unitSlug}`);
          let done = false;
          if (raw) {
            try {
              done = Boolean(JSON.parse(raw).done);
            } catch {
              // Malformed entry — treat as not done.
            }
          }
          row.dataset.readerDone = String(done);
        });
    }

    // Same native <dialog> open/close pattern as the homepage's modals
    // (index.astro) and LevelsModal.astro/TopicMythModal.astro.
    function initRoadmapStatsModal() {
      const dialog = document.querySelector<HTMLDialogElement>(
        "[data-roadmap-stats-modal]",
      );
      if (!dialog) return;
      if (dialog.dataset.modalWired === "true") return;
      dialog.dataset.modalWired = "true";

      document
        .querySelectorAll<HTMLElement>("[data-roadmap-stats-trigger]")
        .forEach((trigger) => {
          trigger.addEventListener("click", () => dialog.showModal());
        });
      dialog
        .querySelector("[data-roadmap-stats-close]")
        ?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
    initRoadmapStatsModal();
    document.addEventListener("astro:page-load", initRoadmapStatsModal);

    // Mirrors the homepage's track-grid treatment (index.astro) — a track
    // the reader has actually started gets an "in progress" badge and keeps
    // its illustration at full strength; an untouched one gets its
    // illustration muted, so scanning 18 collapsed accordion rows has one
    // real signal instead of 18 identically-weighted diagrams.
    function applyTrackSectionWeight(trackUnits: Record<string, string[]>) {
      const counts = countDoneByTrack(trackUnits);
      document
        .querySelectorAll<HTMLElement>("[data-track-section]")
        .forEach((section) => {
          const track = section.dataset.trackSection;
          if (!track) return;
          const done = counts[track] ?? 0;
          const started = done > 0;
          const countBadge =
            section.querySelector<HTMLElement>("[data-node-count]");
          if (countBadge) countBadge.textContent = String(done);
          countBadge?.classList.toggle("hidden", !started);
          countBadge?.classList.toggle("flex", started);
          const icon = section.querySelector<HTMLElement>("[data-node-icon]");
          icon?.classList.toggle("opacity-50", !started);
          icon?.classList.toggle("saturate-50", !started);
        });
    }

    function initTrackGauges() {
      const el = document.getElementById("track-unit-slugs");
      if (!el) return;
      let map: Record<string, string[]>;
      try {
        map = JSON.parse(el.textContent || "{}");
      } catch {
        return;
      }
      applyTrackGauges(map);
      applyTrackSectionWeight(map);
    }
    initTrackGauges();
    document.addEventListener("astro:page-load", initTrackGauges);

    function initRoadmapFilters() {
      // Stamps data-reader-done fresh on every page-load event (first visit
      // or back-navigation) so the New/Completed chips reflect the reader's
      // latest progress, independent of whether the filter listeners below
      // get (re-)wired this time.
      markReaderDone();

      const root = document.body;
      if (root.dataset.roadmapFiltersWired === "true") return;
      root.dataset.roadmapFiltersWired = "true";

      const searchInput = document.querySelector<HTMLInputElement>(
        "[data-roadmap-search]",
      );
      const trackChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-track-chip]"),
      );
      const statusChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-status-chip]"),
      );
      const tagChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-tag-chip]"),
      );
      const clearButton = document.querySelector<HTMLButtonElement>(
        "[data-clear-filters]",
      );
      const rows = Array.from(
        document.querySelectorAll<HTMLElement>("[data-unit-row]"),
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>("[data-track-section]"),
      );
      const matchCount =
        document.querySelector<HTMLElement>("[data-match-count]");
      const emptyState =
        document.querySelector<HTMLElement>("[data-empty-state]");
      if (!searchInput || !matchCount || !emptyState) return;

      const readerFilterChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-reader-filter-chip]",
        ),
      );
      const showMoreButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-show-more-trigger]",
        ),
      );

      const activeTracks = new Set<string>();
      const activeStatuses = new Set<string>();
      const activeTags = new Set<string>();
      const activeReaderFilters = new Set<string>();
      const expandedTracks = new Set<string>();
      // Kept in sync by eye with UNIT_DISPLAY_LIMIT in this file's frontmatter —
      // the client script can't import a server-side const.
      const UNIT_DISPLAY_LIMIT = 6;

      // The roadmap's tags step *is* the interests picker now (the profile
      // modal's separate one was removed) — whatever tags are active here
      // persist as the active profile's interests, the same way the old
      // modal chips did on every click.
      function syncInterestsFromTags() {
        const profile = getActiveProfile();
        if (!profile) return;
        updateProfileInterests(profile.id, [...activeTags]);
      }

      function applyFilters() {
        const query = searchInput!.value.trim().toLowerCase();
        const isFiltering =
          query !== "" ||
          activeTracks.size > 0 ||
          activeStatuses.size > 0 ||
          activeTags.size > 0 ||
          activeReaderFilters.size > 0;
        let visible = 0;

        for (const row of rows) {
          const matchesQuery =
            !query || (row.dataset.search ?? "").includes(query);
          const matchesTrack =
            activeTracks.size === 0 ||
            activeTracks.has(row.dataset.track ?? "");
          const matchesStatus =
            activeStatuses.size === 0 ||
            activeStatuses.has(row.dataset.status ?? "");
          const rowTags = (row.dataset.tags ?? "").split(" ");
          const matchesTags =
            activeTags.size === 0 || rowTags.some((t) => activeTags.has(t));
          const readerDone = row.dataset.readerDone === "true";
          const matchesReader =
            activeReaderFilters.size === 0 ||
            (activeReaderFilters.has("completed") && readerDone) ||
            (activeReaderFilters.has("new") && !readerDone);
          const matchesFilters =
            matchesQuery &&
            matchesTrack &&
            matchesStatus &&
            matchesTags &&
            matchesReader;

          // Outside of any active filter, a track only shows its first N
          // units at a glance — "Show all" (per section) or any filter
          // (which implies the reader is specifically looking for something)
          // lifts the cap.
          const rowIndex = Number(row.dataset.rowIndex ?? "0");
          const track = row.dataset.track ?? "";
          const overLimit =
            !isFiltering &&
            rowIndex >= UNIT_DISPLAY_LIMIT &&
            !expandedTracks.has(track);

          const show = matchesFilters && !overLimit;
          row.classList.toggle("hidden", !show);
          if (show) visible++;
        }

        for (const section of sections) {
          const name = section.dataset.trackSection ?? "";
          const sectionRows = rows.filter((r) => r.dataset.track === name);
          const visibleCount = sectionRows.filter(
            (r) => !r.classList.contains("hidden"),
          ).length;
          section.classList.toggle("hidden", visibleCount === 0);
          const countEl =
            section.querySelector<HTMLElement>("[data-track-count]");
          if (countEl) {
            countEl.textContent =
              visibleCount === sectionRows.length
                ? `${visibleCount} units`
                : `${visibleCount} of ${sectionRows.length} units`;
          }
          const moreBtn = section.querySelector<HTMLElement>(
            "[data-show-more-trigger]",
          );
          moreBtn?.classList.toggle(
            "hidden",
            isFiltering ||
              expandedTracks.has(name) ||
              sectionRows.length <= UNIT_DISPLAY_LIMIT,
          );
        }

        matchCount!.textContent = `${visible} of ${rows.length} units match`;
        emptyState!.classList.toggle("hidden", visible !== 0);
        updateStatusCounts();
        renderFilterChrome();
        updateAccordionDefaults();
      }

      // Track sections stay collapsed by default — the exception is landing
      // on exactly one visible track, where opening it saves a click since
      // there's nothing else to scan. This recomputes on every filter
      // change (not just once on load), so browsing back out to a broader
      // set of tracks collapses things again rather than leaving a stale
      // manually-opened section behind.
      function setSectionOpen(section: HTMLElement, open: boolean) {
        const body = section.querySelector<HTMLElement>("[data-track-body]");
        const chevron = section.querySelector<HTMLElement>(
          "[data-track-chevron]",
        );
        const toggle = section.querySelector<HTMLElement>(
          "[data-track-toggle]",
        );
        body?.classList.toggle("hidden", !open);
        chevron?.classList.toggle("rotate-180", open);
        toggle?.setAttribute("aria-expanded", String(open));
      }

      function updateAccordionDefaults() {
        const visibleSections = sections.filter(
          (s) => !s.classList.contains("hidden"),
        );
        const openBecauseOnly = visibleSections.length === 1;
        for (const section of sections) {
          if (section.classList.contains("hidden")) continue;
          setSectionOpen(section, openBecauseOnly);
        }
        // A filter change re-collapses everything above — the expand-all
        // button's own label/icon need to fall back to "Expand all" too, or
        // it would claim "Collapse all" over a freshly-collapsed list.
        setExpandAllState(false);
      }

      // "Browse everything" is the whole point of this page, but opening 18
      // accordion sections one at a time to scan 246 units is tedious — this
      // is the one-click way to see (or hide) every visible section's units
      // at once. Resets to "Expand all" on any further filter change, same
      // as the single-track auto-open default above.
      const expandAllButton =
        document.querySelector<HTMLButtonElement>("[data-expand-all]");
      const expandIcon = expandAllButton?.querySelector<HTMLElement>(
        '[data-expand-all-icon="expand"]',
      );
      const collapseIcon = expandAllButton?.querySelector<HTMLElement>(
        '[data-expand-all-icon="collapse"]',
      );
      const expandAllLabel = expandAllButton?.querySelector<HTMLElement>(
        "[data-expand-all-label]",
      );
      function setExpandAllState(expanded: boolean) {
        if (!expandAllButton) return;
        expandAllButton.dataset.expanded = String(expanded);
        expandIcon?.classList.toggle("hidden", expanded);
        collapseIcon?.classList.toggle("hidden", !expanded);
        if (expandAllLabel) {
          expandAllLabel.textContent = expanded ? "Collapse all" : "Expand all";
        }
      }
      expandAllButton?.addEventListener("click", () => {
        const expand = expandAllButton.dataset.expanded !== "true";
        const visibleSections = sections.filter(
          (s) => !s.classList.contains("hidden"),
        );
        for (const section of visibleSections) setSectionOpen(section, expand);
        setExpandAllState(expand);
      });

      sections.forEach((section) => {
        const toggle = section.querySelector<HTMLElement>(
          "[data-track-toggle]",
        );
        if (!toggle) return;
        const toggleOpen = () => {
          const body = section.querySelector<HTMLElement>("[data-track-body]");
          const isOpen = body ? !body.classList.contains("hidden") : false;
          setSectionOpen(section, !isOpen);
        };
        // A <div role="button"> (not a real <button>, so the "what is this,
        // really?" trigger can sit inside the clickable area — a real
        // <button> can't nest an interactive descendant) needs both handlers
        // wired by hand — native buttons get click-on-Enter/Space for free,
        // this doesn't.
        toggle.addEventListener("click", toggleOpen);
        toggle.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggleOpen();
          }
        });
      });

      // Replaces the old text summary ("Track: web, systems · Tags: ...")
      // with a small count badge directly on the popover button it
      // describes, plus a Reset button that only exists once something is
      // actually active — nothing to read when nothing is filtered.
      function renderFilterChrome() {
        const counts: [string, Set<string>][] = [
          ["track", activeTracks],
          ["tags", activeTags],
          ["status", activeStatuses],
        ];
        for (const [name, set] of counts) {
          const badge = document.querySelector<HTMLElement>(
            `[data-filter-count="${name}"]`,
          );
          if (!badge) continue;
          badge.textContent = String(set.size);
          badge.classList.toggle("hidden", set.size === 0);
        }
        const anyActive =
          activeTracks.size > 0 ||
          activeTags.size > 0 ||
          activeStatuses.size > 0 ||
          searchInput!.value.trim() !== "";
        clearButton?.classList.toggle("hidden", !anyActive);
        clearButton?.classList.toggle("flex", anyActive);
      }

      searchInput.addEventListener("input", applyFilters);

      trackChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const name = chip.dataset.trackChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeTracks.add(name);
          else activeTracks.delete(name);
          applyFilters();
          filterTagOptionsByTrack();
        });
      });

      statusChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const status = chip.dataset.statusChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeStatuses.add(status);
          else activeStatuses.delete(status);
          applyFilters();
        });
      });

      tagChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const tag = chip.dataset.tagChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeTags.add(tag);
          else activeTags.delete(tag);
          applyFilters();
          syncInterestsFromTags();
        });
      });

      // "New" and "Completed" are mutually exclusive (one reader-progress
      // axis), unlike track/status/tags which are each multi-select — picking
      // one deselects the other rather than stacking both into "show none".
      readerFilterChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const key = chip.dataset.readerFilterChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          readerFilterChips.forEach((c) => {
            if (c !== chip) {
              c.setAttribute("aria-pressed", "false");
              activeReaderFilters.delete(c.dataset.readerFilterChip!);
            }
          });
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeReaderFilters.add(key);
          else activeReaderFilters.delete(key);
          applyFilters();
        });
      });

      showMoreButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const track = button.dataset.showMoreTrigger!;
          expandedTracks.add(track);
          applyFilters();
        });
      });

      function resetFilters() {
        searchInput!.value = "";
        activeTracks.clear();
        activeStatuses.clear();
        activeTags.clear();
        activeReaderFilters.clear();
        expandedTracks.clear();
        [
          ...trackChips,
          ...statusChips,
          ...tagChips,
          ...readerFilterChips,
        ].forEach((chip) => chip.setAttribute("aria-pressed", "false"));
        applyFilters();
        filterTagOptionsByTrack();
        syncInterestsFromTags();
      }

      clearButton?.addEventListener("click", resetFilters);

      // Progressive-enhancement target for the homepage's search box
      // (submits a plain GET form to /roadmap?search=...) — prefill and
      // run the filter once on load so it works even if this script is the
      // first thing to touch the input.
      const params = new URLSearchParams(location.search);
      const initialQuery = params.get("search");
      if (initialQuery) searchInput.value = initialQuery;

      // Pre-select tag chips matching the active profile's interests, if
      // any — purely a starting point for the filter UI, not a forced
      // choice; the reader can deselect/clear as normal. A profile with no
      // interests set leaves every chip unselected, same as today.
      const interests = new Set(getActiveProfile()?.interests ?? []);
      if (interests.size > 0) {
        tagChips.forEach((chip) => {
          const tag = chip.dataset.tagChip!;
          if (interests.has(tag)) {
            chip.setAttribute("aria-pressed", "true");
            activeTags.add(tag);
          }
        });
      }

      applyFilters();

      // ---- popovers: Track/Tags/Status, each its own open/close + search ----

      const filterPopoverTriggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-filter-popover-trigger]",
        ),
      );
      const filterPopovers = Array.from(
        document.querySelectorAll<HTMLElement>("[data-filter-popover]"),
      );

      function closeAllPopovers() {
        filterPopovers.forEach((p) => p.classList.add("hidden"));
        filterPopoverTriggers.forEach((t) =>
          t.setAttribute("aria-expanded", "false"),
        );
      }

      filterPopoverTriggers.forEach((trigger) => {
        const name = trigger.dataset.filterPopoverTrigger!;
        const panel = document.querySelector<HTMLElement>(
          `[data-filter-popover="${name}"]`,
        );
        if (!panel) return;
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const wasHidden = panel.classList.contains("hidden");
          closeAllPopovers();
          if (wasHidden) {
            panel.classList.remove("hidden");
            trigger.setAttribute("aria-expanded", "true");
          }
        });
      });

      // Clicking a chip inside a popover (track/tag/status) never closes it —
      // those clicks land on a descendant of the panel, so `contains()` below
      // keeps it open for picking more than one before dismissing.
      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        const insideAny =
          filterPopovers.some((p) => p.contains(target)) ||
          filterPopoverTriggers.some((t) => t.contains(target));
        if (!insideAny) closeAllPopovers();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAllPopovers();
      });

      // Each popover's own search box filters that popover's option list
      // (which tracks/tags are offered), not the final unit results below.
      function wireOptionSearch(
        inputSelector: string,
        chips: HTMLButtonElement[],
        emptySelector?: string,
      ) {
        const input = document.querySelector<HTMLInputElement>(inputSelector);
        if (!input) return;
        input.addEventListener("input", () => {
          const q = input.value.trim().toLowerCase();
          let visibleCount = 0;
          for (const chip of chips) {
            if (chip.classList.contains("hidden-by-track")) continue;
            const label = (chip.dataset.searchLabel ?? "").toLowerCase();
            const show = !q || label.includes(q);
            chip.classList.toggle("hidden", !show);
            if (show) visibleCount++;
          }
          if (emptySelector) {
            document
              .querySelector(emptySelector)
              ?.classList.toggle("hidden", visibleCount !== 0);
          }
        });
      }
      wireOptionSearch("[data-track-search]", trackChips);
      wireOptionSearch("[data-tag-search]", tagChips, "[data-tag-empty]");

      // Tags popover: narrow the offered tag chips to only those that occur
      // in at least one currently-selected track (all tags stay available if
      // no track is selected).
      let tagsByTrack: Record<string, string[]> = {};
      try {
        tagsByTrack = JSON.parse(
          document.getElementById("tags-by-track")?.textContent || "{}",
        );
      } catch {
        tagsByTrack = {};
      }

      function filterTagOptionsByTrack() {
        const allowed =
          activeTracks.size === 0
            ? null
            : new Set([...activeTracks].flatMap((t) => tagsByTrack[t] ?? []));
        for (const chip of tagChips) {
          const tag = chip.dataset.tagChip!;
          const allowedByTrack = allowed === null || allowed.has(tag);
          chip.classList.toggle("hidden-by-track", !allowedByTrack);
          if (!allowedByTrack) chip.classList.add("hidden");
          else {
            const searchInputEl =
              document.querySelector<HTMLInputElement>("[data-tag-search]");
            const q = (searchInputEl?.value ?? "").trim().toLowerCase();
            const label = (chip.dataset.searchLabel ?? "").toLowerCase();
            chip.classList.toggle("hidden", !(!q || label.includes(q)));
          }
        }
      }
      filterTagOptionsByTrack();

      // Status popover: show how many currently track/tag-matching units
      // fall into each status, so picking one isn't a guess. Kept fresh by
      // applyFilters() on every change, not just while the popover is open.
      function updateStatusCounts() {
        for (const chip of statusChips) {
          const status = chip.dataset.statusChip!;
          const count = rows.filter((r) => {
            const matchesTrack =
              activeTracks.size === 0 ||
              activeTracks.has(r.dataset.track ?? "");
            const rowTags = (r.dataset.tags ?? "").split(" ");
            const matchesTags =
              activeTags.size === 0 || rowTags.some((t) => activeTags.has(t));
            return matchesTrack && matchesTags && r.dataset.status === status;
          }).length;
          const countEl = chip.querySelector("[data-status-count]");
          if (countEl) countEl.textContent = `${count} units`;
        }
      }
    }

    initRoadmapFilters();
    document.addEventListener("astro:page-load", initRoadmapFilters);
  </script>
</Layout>
