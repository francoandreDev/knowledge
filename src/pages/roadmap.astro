---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import TopicMythModal from "../components/TopicMythModal.astro";
import {
  Search,
  HelpCircle,
  ChevronDown,
  RotateCcw,
  Check,
  Play,
  Lock,
  Flag,
} from "lucide-astro";
import { roadmap } from "../data/roadmap";
import { loadHomeData } from "../lib/home-data";

const { writtenUnits } = await loadHomeData();
const writtenKeys = new Set(
  writtenUnits.map((u) => `${u.track}/${u.unitSlug}`),
);

const PER_ROW = 5;
const CHECKPOINT_EVERY = 5;

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();

const STATUS_FILTERS = [
  { key: "done", label: "Done" },
  { key: "next", label: "Up next" },
  { key: "locked", label: "Locked" },
];

// Each world is one track laid out as a path of level nodes: its units in
// curriculum order, plus a checkpoint node after every fifth unit and at the
// end. The path is cut into rows of PER_ROW; odd rows run right-to-left so the
// trail snakes. The client script stamps each node's state (done / next /
// locked) from the active profile's progress.
const worlds = roadmap.tracks.map((track) => {
  const nodes: Array<
    | {
        kind: "unit";
        index: number;
        slug: string;
        problem: string;
        short: string;
        tags: string[];
        written: boolean;
      }
    | { kind: "check"; label: string; group: string[] }
  > = [];
  let group: string[] = [];
  track.units.forEach((u, i) => {
    const written = writtenKeys.has(`${track.name}/${u.slug}`);
    nodes.push({
      kind: "unit",
      index: i,
      slug: u.slug,
      problem: u.problem,
      short: u.problem.replace(/\s*\(.*$/, "").trim(),
      tags: u.tags,
      written,
    });
    if (written) group.push(u.slug);
    const isLast = i === track.units.length - 1;
    if ((i + 1) % CHECKPOINT_EVERY === 0 || isLast) {
      nodes.push({
        kind: "check",
        label: isLast
          ? "Final checkpoint"
          : `Checkpoint ${(i + 1) / CHECKPOINT_EVERY}`,
        group: [...group],
      });
      group = [];
    }
  });
  const rows: (typeof nodes)[] = [];
  for (let i = 0; i < nodes.length; i += PER_ROW) {
    rows.push(nodes.slice(i, i + PER_ROW));
  }
  return { name: track.name, total: track.units.length, rows };
});
const totalWritten = writtenUnits.length;
---

<Layout title="Roadmap" wide>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1
        class="text-5xl font-extrabold tracking-tight sm:text-6xl"
        style="letter-spacing: -0.02em; line-height: 1.05"
      >
        Roadmap
      </h1>
      <p class="mt-3 text-lg text-slate-500 dark:text-slate-400">
        Finish a unit to unlock the next one. Every world starts at unit 1.
      </p>
    </div>
    <span
      data-done-pill
      class="inline-flex items-center rounded-full px-4 py-2 text-sm font-extrabold"
      style="background: #d1fae5; color: #065f46"
    >
      0 of {totalWritten} done
    </span>
  </div>

  <!-- Filter bar: dims what doesn't match instead of removing it, so the
       shape of the path never changes under the reader's hands. -->
  <div class="mt-7 flex flex-wrap items-center gap-3">
    <div class="game-btn relative min-w-[220px] flex-1 !p-0">
      <Search
        class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-slate-400"
        aria-hidden="true"
      />
      <input
        type="search"
        data-roadmap-search
        aria-label="Search units"
        placeholder='Search units, e.g. "rebase"'
        class="h-12 w-full rounded-[12px] bg-transparent pr-4 pl-12 text-[15px] font-semibold outline-none placeholder:text-slate-400"
      />
    </div>

    <div class="relative">
      <button
        type="button"
        data-filter-trigger="tags"
        aria-expanded="false"
        class="game-btn"
      >
        Tags
        <span
          data-filter-count="tags"
          class="hidden rounded-full px-1.5 text-xs font-bold text-white"
          style="background: var(--gauge-accent)"></span>
        <ChevronDown class="h-4 w-4" aria-hidden="true" />
      </button>
      <div
        data-filter-panel="tags"
        class="game-panel absolute top-full left-0 z-20 mt-3 hidden w-80 max-w-[calc(100vw-2rem)]"
      >
        <input
          type="search"
          data-tag-search
          aria-label="Search tags"
          placeholder='Search tags, e.g. "caching"'
          class="w-full rounded-lg border-2 border-slate-200 bg-transparent px-3 py-2 text-sm font-semibold outline-none focus:border-slate-900 dark:border-slate-700 dark:focus:border-slate-100"
        />
        <div class="mt-3 flex max-h-64 flex-wrap gap-1.5 overflow-y-auto">
          {
            ALL_TAGS.map((tag) => (
              <button
                type="button"
                data-tag-chip={tag}
                aria-pressed="false"
                class="rounded-full bg-slate-500/10 px-2.5 py-1 text-xs font-semibold text-slate-600 transition hover:bg-slate-500/20 aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:text-slate-300"
              >
                {tag}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="relative">
      <button
        type="button"
        data-filter-trigger="status"
        aria-expanded="false"
        class="game-btn"
      >
        Status
        <span
          data-filter-count="status"
          class="hidden rounded-full px-1.5 text-xs font-bold text-white"
          style="background: var(--gauge-accent)"></span>
        <ChevronDown class="h-4 w-4" aria-hidden="true" />
      </button>
      <div
        data-filter-panel="status"
        class="game-panel absolute top-full left-0 z-20 mt-3 hidden w-56"
      >
        <div class="flex flex-col gap-2">
          {
            STATUS_FILTERS.map((s) => (
              <button
                type="button"
                data-status-chip={s.key}
                aria-pressed="false"
                class="rounded-lg border-2 border-slate-200 px-3.5 py-2.5 text-left text-sm font-bold transition hover:border-slate-400 aria-pressed:border-[var(--gauge-accent)] aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:border-slate-700"
              >
                {s.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <button
      type="button"
      data-clear-filters
      class="hidden items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-bold"
      style="color: var(--accent-text); border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
    >
      <RotateCcw class="h-3.5 w-3.5" aria-hidden="true" />
      Reset
    </button>
  </div>
  <p
    data-match-summary
    class="mt-3 hidden text-sm font-medium text-slate-500 dark:text-slate-400"
  >
  </p>

  <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-start">
    <!-- World rail: one button per track. Doubles as the track filter. -->
    <nav aria-label="Worlds" class="lg:w-60 lg:shrink-0">
      <p
        class="mb-3 text-xs font-extrabold tracking-wider text-slate-500 uppercase dark:text-slate-400"
      >
        Worlds
      </p>
      <div
        data-rail
        class="no-scrollbar flex gap-4 overflow-x-auto pb-3 lg:grid lg:grid-cols-3 lg:gap-x-2 lg:gap-y-5 lg:overflow-visible lg:pb-0"
      >
        {
          worlds.map((w) => (
            <button
              type="button"
              data-world={w.name}
              aria-pressed="false"
              title={`${w.name}/`}
              aria-label={`${w.name}, ${w.total} units`}
              class="world-btn group flex shrink-0 flex-col items-center gap-1.5 lg:shrink"
            >
              <span class="world-ring" data-ring style="--p: 0">
                <span class="world-core">
                  <TrackIcon track={w.name} class="h-6 w-6" />
                </span>
                <span
                  data-world-badge
                  class="absolute -top-1 -right-1 hidden h-5 min-w-5 items-center justify-center rounded-full px-1 text-[10px] font-extrabold text-white ring-2 ring-white dark:ring-slate-950"
                  style="background: var(--gauge-warn)"
                />
              </span>
              <span class="w-16 truncate text-center text-[11px] font-bold text-slate-600 dark:text-slate-400">
                {w.name}
              </span>
            </button>
          ))
        }
      </div>
    </nav>

    <div class="min-w-0 flex-1">
      {
        worlds.map((w) => (
          <section
            data-world-panel={w.name}
            data-total={w.total}
            class="hidden"
          >
            <div class="game-panel flex flex-wrap items-center gap-4 !py-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900">
                <TrackIcon track={w.name} class="h-6 w-6" />
              </span>
              <div class="min-w-0 flex-1 basis-48">
                <div class="flex items-baseline gap-3">
                  <h2 class="text-xl font-extrabold">{w.name}/</h2>
                  <span
                    data-world-count
                    class="text-sm font-bold text-slate-500 dark:text-slate-400"
                  >
                    0 of {w.total} units
                  </span>
                </div>
                <div class="mt-2 h-3 overflow-hidden rounded-full bg-slate-500/15">
                  <div
                    data-world-fill
                    class="h-full rounded-full transition-[width] duration-700"
                    style="width: 0%; background: var(--gauge-accent)"
                  />
                </div>
              </div>
              <button
                type="button"
                data-myth-trigger={w.name}
                title={`What is ${w.name}, really?`}
                aria-label={`What is ${w.name}, really?`}
                class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-slate-300 text-slate-600 transition hover:border-slate-900 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-100 dark:hover:text-slate-100"
              >
                <HelpCircle class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>

            <ol class="mt-10 flex flex-col gap-16 px-1 pb-6 sm:px-4">
              {w.rows.map((row, r) => (
                <li
                  class={`trail-row relative flex justify-between ${r % 2 ? "flex-row-reverse" : "flex-row"}`}
                >
                  <div
                    aria-hidden="true"
                    class="trail-line absolute top-[calc(var(--disc)/2)] right-[10%] left-[10%] h-0 border-t-[6px] border-dotted border-slate-300 dark:border-slate-700"
                  />
                  {row.map((node) =>
                    node.kind === "unit" ? (
                      <div
                        data-node
                        data-kind="unit"
                        data-track={w.name}
                        data-slug={node.slug}
                        data-written={String(node.written)}
                        data-state={
                          !node.written
                            ? "planned"
                            : node.index === 0
                              ? "next"
                              : "locked"
                        }
                        data-search={`${node.problem} ${node.slug} ${w.name}`.toLowerCase()}
                        data-tags={node.tags.join(" ")}
                        class="node relative z-10 flex w-[20%] flex-col items-center"
                      >
                        <span data-start-tag class="start-tag">
                          START HERE
                        </span>
                        {node.written ? (
                          <a
                            href={`/${w.name}/${node.slug}/`}
                            data-disc
                            title={node.problem}
                            aria-label={`Unit ${node.index + 1}: ${node.problem}`}
                            class="disc"
                          >
                            <Check
                              data-ic="done"
                              class="h-[45%] w-[45%]"
                              stroke-width="3"
                              aria-hidden="true"
                            />
                            <Play
                              data-ic="next"
                              class="h-[42%] w-[42%]"
                              fill="currentColor"
                              aria-hidden="true"
                            />
                            <Lock
                              data-ic="locked"
                              class="h-[38%] w-[38%]"
                              stroke-width="2.6"
                              aria-hidden="true"
                            />
                          </a>
                        ) : (
                          <span data-disc class="disc" title={node.problem}>
                            {node.index + 1}
                          </span>
                        )}
                        <span class="node-label" title={node.problem}>
                          {node.short}
                        </span>
                      </div>
                    ) : (
                      <div
                        data-node
                        data-kind="check"
                        data-track={w.name}
                        data-group={node.group.join(" ")}
                        data-state="locked"
                        class="node relative z-10 flex w-[20%] flex-col items-center"
                      >
                        <span data-disc class="disc check" aria-hidden="true">
                          <Flag
                            data-ic="done"
                            class="h-[40%] w-[40%]"
                            fill="currentColor"
                            aria-hidden="true"
                          />
                          <Lock
                            data-ic="locked"
                            class="h-[38%] w-[38%]"
                            stroke-width="2.6"
                            aria-hidden="true"
                          />
                        </span>
                        <span class="node-label">{node.label}</span>
                      </div>
                    ),
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      <p
        data-empty-state
        class="mt-10 hidden text-center text-sm text-slate-500 dark:text-slate-400"
      >
        No units match these filters.
      </p>
    </div>
  </div>

  <TopicMythModal />

  <script
    type="application/json"
    id="world-order"
    set:html={JSON.stringify(worlds.map((w) => w.name))}
  />

  <script>
    import { unitStates, lastTouchedTrack } from "../lib/unlock";

    const WORLD_KEY = "roadmap:world";
    const q = <T extends HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => root.querySelector<T>(sel);
    const qa = <T extends HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => Array.from(root.querySelectorAll<T>(sel));

    // ---- state: stamp every node from the active profile's progress -----
    function stampStates() {
      let doneTotal = 0;
      for (const panel of qa("[data-world-panel]")) {
        const track = panel.dataset.worldPanel!;
        const unitNodes = qa<HTMLElement>(
          '[data-kind="unit"][data-written="true"]',
          panel,
        );
        const states = unitStates(
          track,
          unitNodes.map((n) => n.dataset.slug!),
        );
        const stateBySlug = new Map<string, string>();
        unitNodes.forEach((n, i) => {
          n.dataset.state = states[i];
          stateBySlug.set(n.dataset.slug!, states[i]);
        });
        const firstNext = unitNodes.find((_, i) => states[i] === "next");
        qa("[data-node]", panel).forEach((n) =>
          n.removeAttribute("data-start"),
        );
        firstNext?.setAttribute("data-start", "true");

        for (const c of qa<HTMLElement>('[data-kind="check"]', panel)) {
          const group = (c.dataset.group ?? "").split(" ").filter(Boolean);
          const allDone =
            group.length > 0 &&
            group.every((s) => stateBySlug.get(s) === "done");
          c.dataset.state = allDone ? "done" : "locked";
        }

        const done = states.filter((s) => s === "done").length;
        doneTotal += done;
        const total = Number(panel.dataset.total ?? "0");
        const count = q("[data-world-count]", panel);
        if (count) count.textContent = `${done} of ${total} units`;
        const fill = q("[data-world-fill]", panel);
        if (fill) fill.style.width = `${total ? (done / total) * 100 : 0}%`;
        const ring = q(`[data-world="${CSS.escape(track)}"] [data-ring]`);
        ring?.style.setProperty("--p", String(total ? done / total : 0));
      }
      const pill = q("[data-done-pill]");
      const totalWritten = qa('[data-kind="unit"][data-written="true"]').length;
      if (pill) pill.textContent = `${doneTotal} of ${totalWritten} done`;
    }

    // ---- world selection ------------------------------------------------
    function selectWorld(name: string) {
      for (const p of qa("[data-world-panel]")) {
        p.classList.toggle("hidden", p.dataset.worldPanel !== name);
      }
      for (const b of qa("[data-world]")) {
        b.setAttribute("aria-pressed", String(b.dataset.world === name));
      }
      try {
        localStorage.setItem(WORLD_KEY, name);
      } catch {
        // Private mode — selection just isn't remembered.
      }
      history.replaceState(null, "", `#${name}`);
      q(`[data-world="${CSS.escape(name)}"]`)?.scrollIntoView({
        block: "nearest",
        inline: "center",
      });
    }

    function currentWorld(): string | null {
      return q("[data-world][aria-pressed='true']")?.dataset.world ?? null;
    }

    // ---- filters --------------------------------------------------------
    const filters = {
      query: "",
      tags: new Set<string>(),
      statuses: new Set<string>(),
    };
    const filtersActive = () =>
      filters.query !== "" ||
      filters.tags.size > 0 ||
      filters.statuses.size > 0;

    function nodeMatches(n: HTMLElement): boolean {
      if (filters.query && !(n.dataset.search ?? "").includes(filters.query))
        return false;
      if (filters.tags.size > 0) {
        const tags = (n.dataset.tags ?? "").split(" ");
        if (!tags.some((t) => filters.tags.has(t))) return false;
      }
      if (
        filters.statuses.size > 0 &&
        !filters.statuses.has(n.dataset.state ?? "")
      )
        return false;
      return true;
    }

    function applyFilters() {
      const active = filtersActive();
      const perWorld = new Map<string, number>();
      let total = 0;
      for (const n of qa('[data-kind="unit"]')) {
        const match = !active || nodeMatches(n);
        n.classList.toggle("is-dim", !match);
        if (active && match) {
          const t = n.dataset.track!;
          perWorld.set(t, (perWorld.get(t) ?? 0) + 1);
          total++;
        }
      }
      for (const b of qa("[data-world]")) {
        const badge = q("[data-world-badge]", b);
        const count = perWorld.get(b.dataset.world!) ?? 0;
        if (!badge) continue;
        badge.textContent = String(count);
        badge.classList.toggle("hidden", !(active && count > 0));
        badge.classList.toggle("flex", active && count > 0);
      }
      const summary = q("[data-match-summary]");
      if (summary) {
        summary.classList.toggle("hidden", !active);
        summary.textContent = `${total} ${total === 1 ? "unit matches" : "units match"} across ${perWorld.size} ${perWorld.size === 1 ? "world" : "worlds"}`;
      }
      q("[data-empty-state]")?.classList.toggle(
        "hidden",
        !(active && total === 0),
      );
      q("[data-clear-filters]")?.classList.toggle("hidden", !active);
      q("[data-clear-filters]")?.classList.toggle("inline-flex", active);
      for (const kind of ["tags", "status"] as const) {
        const el = q(`[data-filter-count="${kind}"]`);
        const n = kind === "tags" ? filters.tags.size : filters.statuses.size;
        if (!el) continue;
        el.textContent = String(n);
        el.classList.toggle("hidden", n === 0);
      }
      // Don't leave the reader on a world with nothing lit up.
      const cur = currentWorld();
      if (active && cur && (perWorld.get(cur) ?? 0) === 0) {
        const first = qa("[data-world]").find(
          (b) => (perWorld.get(b.dataset.world!) ?? 0) > 0,
        );
        if (first) selectWorld(first.dataset.world!);
      }
    }

    function wireFilters() {
      const search = q<HTMLInputElement>("[data-roadmap-search]");
      if (!search || search.dataset.wired === "true") return;
      search.dataset.wired = "true";

      search.addEventListener("input", () => {
        filters.query = search.value.trim().toLowerCase();
        applyFilters();
      });

      for (const chip of qa("[data-tag-chip]")) {
        chip.addEventListener("click", () => {
          const tag = chip.dataset.tagChip!;
          const on = !filters.tags.has(tag);
          if (on) filters.tags.add(tag);
          else filters.tags.delete(tag);
          chip.setAttribute("aria-pressed", String(on));
          applyFilters();
        });
      }
      for (const chip of qa("[data-status-chip]")) {
        chip.addEventListener("click", () => {
          const s = chip.dataset.statusChip!;
          const on = !filters.statuses.has(s);
          if (on) filters.statuses.add(s);
          else filters.statuses.delete(s);
          chip.setAttribute("aria-pressed", String(on));
          applyFilters();
        });
      }
      q<HTMLInputElement>("[data-tag-search]")?.addEventListener(
        "input",
        (e) => {
          const text = (e.target as HTMLInputElement).value
            .trim()
            .toLowerCase();
          for (const chip of qa("[data-tag-chip]")) {
            chip.classList.toggle(
              "hidden",
              !!text &&
                !(chip.dataset.tagChip ?? "").toLowerCase().includes(text),
            );
          }
        },
      );
      q("[data-clear-filters]")?.addEventListener("click", () => {
        filters.query = "";
        filters.tags.clear();
        filters.statuses.clear();
        search.value = "";
        for (const c of qa("[data-tag-chip], [data-status-chip]")) {
          c.setAttribute("aria-pressed", "false");
        }
        applyFilters();
      });

      // Popovers: one open at a time, closed by outside click or Escape.
      const triggers = qa("[data-filter-trigger]");
      const closeAll = () => {
        for (const t of triggers) {
          t.setAttribute("aria-expanded", "false");
          q(`[data-filter-panel="${t.dataset.filterTrigger}"]`)?.classList.add(
            "hidden",
          );
        }
      };
      for (const t of triggers) {
        t.addEventListener("click", (e) => {
          e.stopPropagation();
          const panel = q(`[data-filter-panel="${t.dataset.filterTrigger}"]`);
          const wasOpen = panel && !panel.classList.contains("hidden");
          closeAll();
          if (panel && !wasOpen) {
            panel.classList.remove("hidden");
            t.setAttribute("aria-expanded", "true");
          }
        });
      }
      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("[data-filter-panel]"))
          closeAll();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAll();
      });
    }

    function wireRail() {
      const rail = q("[data-rail]");
      if (!rail || rail.dataset.wired === "true") return;
      rail.dataset.wired = "true";
      for (const b of qa("[data-world]", rail)) {
        b.addEventListener("click", () => selectWorld(b.dataset.world!));
      }
    }

    function initRoadmap() {
      if (!q("[data-rail]")) return;
      wireRail();
      wireFilters();
      stampStates();

      let order: string[] = [];
      try {
        order = JSON.parse(q("#world-order")?.textContent || "[]");
      } catch {
        order = [];
      }
      const fromHash = decodeURIComponent(location.hash.slice(1));
      const saved = (() => {
        try {
          return localStorage.getItem(WORLD_KEY);
        } catch {
          return null;
        }
      })();
      const start =
        [fromHash, lastTouchedTrack(order), saved, order[0]].find(
          (t): t is string => !!t && order.includes(t),
        ) ?? order[0];
      if (start) selectWorld(start);
      applyFilters();
    }
    initRoadmap();
    document.addEventListener("astro:page-load", initRoadmap);
  </script>
</Layout>

<style>
  .game-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3rem;
    padding: 0 1rem;
    border-radius: 0.875rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
    font-size: 0.9375rem;
    font-weight: 800;
    box-shadow: 0 4px 0 #cbd5e1;
    transition:
      border-color 0.08s,
      box-shadow 0.08s;
  }
  .game-btn:hover,
  .game-btn:focus-within {
    border-color: #0f172a;
    box-shadow: 0 4px 0 #0f172a;
  }
  .game-btn:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 3px;
  }
  :global(.dark) .game-btn {
    border-color: #334155;
    background: #0f172a;
    color: #f1f5f9;
    box-shadow: 0 4px 0 #334155;
  }
  :global(.dark) .game-btn:hover,
  :global(.dark) .game-btn:focus-within {
    border-color: #f1f5f9;
    box-shadow: 0 4px 0 #f1f5f9;
  }
  .game-panel {
    border-radius: 1.125rem;
    border: 2px solid #0f172a;
    background: #fff;
    color: #0f172a;
    box-shadow: 0 6px 0 #0f172a;
    padding: 1rem;
  }
  :global(.dark) .game-panel {
    border-color: #f1f5f9;
    background: #0f172a;
    color: #f1f5f9;
    box-shadow: 0 6px 0 #f1f5f9;
  }

  /* world rail */
  .world-ring {
    position: relative;
    display: flex;
    height: 4rem;
    width: 4rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: conic-gradient(
      var(--gauge-accent) calc(var(--p, 0) * 1turn),
      #e2e8f0 0
    );
  }
  :global(.dark) .world-ring {
    background: conic-gradient(
      var(--gauge-accent) calc(var(--p, 0) * 1turn),
      #334155 0
    );
  }
  .world-core {
    display: flex;
    height: 3.125rem;
    width: 3.125rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #fff;
    color: #0f172a;
  }
  :global(.dark) .world-core {
    background: #0f172a;
    color: #f1f5f9;
  }
  .world-btn[aria-pressed="true"] .world-ring {
    box-shadow:
      0 0 0 4px #fff,
      0 0 0 7px #0f172a;
  }
  :global(.dark) .world-btn[aria-pressed="true"] .world-ring {
    box-shadow:
      0 0 0 4px #020617,
      0 0 0 7px #f1f5f9;
  }
  .world-btn[aria-pressed="true"] .world-core {
    background: #0f172a;
    color: #fff;
  }
  :global(.dark) .world-btn[aria-pressed="true"] .world-core {
    background: #f1f5f9;
    color: #0f172a;
  }
  .world-btn:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  /* level nodes */
  .trail-row {
    --disc: clamp(3.25rem, 8vw, 4.5rem);
  }
  .disc {
    position: relative;
    display: flex;
    height: var(--disc);
    width: var(--disc);
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 3px solid #cbd5e1;
    background: #e2e8f0;
    color: #475569;
    box-shadow: 0 5px 0 #cbd5e1;
    font-weight: 800;
    transition:
      transform 0.08s,
      box-shadow 0.08s;
  }
  a.disc:hover {
    transform: translateY(-2px);
  }
  a.disc:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 #cbd5e1;
  }
  a.disc:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 4px;
  }
  .disc :global([data-ic]) {
    display: none;
  }
  .node[data-state="done"] .disc {
    background: #059669;
    border-color: #064e3b;
    box-shadow: 0 5px 0 #064e3b;
    color: #fff;
  }
  .node[data-state="done"] .disc :global([data-ic="done"]),
  .node[data-state="next"] .disc :global([data-ic="next"]),
  .node[data-state="locked"] .disc :global([data-ic="locked"]) {
    display: block;
  }
  .node[data-state="next"] .disc {
    background: #0369a1;
    border-color: #082f49;
    box-shadow: 0 5px 0 #082f49;
    color: #fff;
    animation: node-pulse 1.8s infinite;
  }
  .node[data-state="planned"] .disc {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
    color: #94a3b8;
  }
  :global(.dark) .disc {
    border-color: #475569;
    background: #1e293b;
    color: #cbd5e1;
    box-shadow: 0 5px 0 #475569;
  }
  :global(.dark) .node[data-state="done"] .disc {
    background: #059669;
    border-color: #064e3b;
    box-shadow: 0 5px 0 #064e3b;
    color: #fff;
  }
  :global(.dark) .node[data-state="next"] .disc {
    background: #0369a1;
    border-color: #082f49;
    box-shadow: 0 5px 0 #082f49;
    color: #fff;
  }
  :global(.dark) .node[data-state="planned"] .disc {
    background: transparent;
    box-shadow: none;
    color: #64748b;
  }

  /* checkpoints */
  .disc.check {
    border-radius: 1.5rem;
    background: #fff7ed;
    border-color: #fdba74;
    box-shadow: 0 5px 0 #fdba74;
    color: #c2410c;
  }
  :global(.dark) .disc.check {
    background: #431407;
    border-color: #9a3412;
    box-shadow: 0 5px 0 #9a3412;
    color: #fdba74;
  }
  .node[data-state="done"] .disc.check,
  :global(.dark) .node[data-state="done"] .disc.check {
    background: #c2410c;
    border-color: #7c2d12;
    box-shadow: 0 5px 0 #7c2d12;
    color: #fff;
  }

  .node-label {
    margin-top: 1rem;
    max-width: 7rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .node-label {
    color: #f1f5f9;
  }
  .node[data-state="locked"] .node-label,
  .node[data-state="planned"] .node-label {
    color: #64748b;
  }
  :global(.dark) .node[data-state="locked"] .node-label,
  :global(.dark) .node[data-state="planned"] .node-label {
    color: #94a3b8;
  }

  .start-tag {
    display: none;
    position: absolute;
    top: -1.75rem;
    white-space: nowrap;
    border-radius: 9999px;
    background: #0369a1;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.1875rem 0.625rem;
  }
  .node[data-start="true"] .start-tag {
    display: block;
  }

  .node {
    transition: opacity 0.2s;
  }
  .node.is-dim {
    opacity: 0.22;
  }

  @keyframes node-pulse {
    0% {
      box-shadow:
        0 5px 0 #082f49,
        0 0 0 0 rgb(3 105 161 / 0.45);
    }
    100% {
      box-shadow:
        0 5px 0 #082f49,
        0 0 0 16px rgb(3 105 161 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .node[data-state="next"] .disc {
      animation: none;
    }
    .disc,
    a.disc:hover,
    a.disc:active {
      transition: none;
      transform: none;
    }
  }
</style>
