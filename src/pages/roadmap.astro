              )}
              {r.id === "observatory" && (
                <>
                  <path
                    d="M200 14A32 32 0 1 0 200 78A24 24 0 1 1 200 14Z"
                    fill="currentColor"
                    stroke="none"
                  />
                  <path
                    d="M120 24v10M115 29h10M160 78v8M156 82h8M90 62v6M87 65h6M226 96v8M222 100h8"
                    stroke-width="2"
                  />
                  <circle
                    cx="142"
                    cy="44"
                    r="2"
                    fill="currentColor"
                    stroke="none"
                  />
                  <circle
                    cx="104"
                    cy="92"
                    r="1.6"
                    fill="currentColor"
                    stroke="none"
                  />
                </>
              )}
              {r.id === "harbor" && (
                <>
                  <path d="M112 30q8-9 16 0q8-9 16 0M164 54q6-7 12 0q6-7 12 0" />
                  <path d="M200 134l5-52h22l5 52z" />
                  <path d="M205 82h22l-3-12h-16z" />
                  <path d="M209 70v-6h14v6" />
                  <path
                    d="M206 62L130 38M226 62L240 50"
                    stroke-dasharray="4 4"
                    opacity="0.6"
                  />
                  <path d="M96 118h22l-4 8H100z" />
                  <path d="M107 118V100l10 18" />
                </>
              )}
              {r.id === "frontier" && (
                <>
                  <circle cx="190" cy="60" r="34" />
                  <path d="M190 26l8 34-8 34-8-34z" />
                  <path d="M156 60h68" opacity="0.5" />
                </>
              )}
            </svg>
            <header class="region-head">
              <svg
                class="region-art"
                viewBox="0 0 120 64"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {r.id === "workshop" && (
                  <>
                    <circle cx="40" cy="34" r="11" />
