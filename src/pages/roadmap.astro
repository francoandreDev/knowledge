  <TopicMythModal />

  <script
    type="application/json"
    id="world-order"
    set:html={JSON.stringify(worlds.map((w) => w.name))}
  />

  <script>
    import { unitStates, lastTouchedTrack } from "../lib/unlock";
    import { pStorage } from "../lib/profile";

    const VIEW_KEY = "roadmap:view";
    const CELEBRATED_KEY = "roadmap:celebrated";
    const STATE_LABEL: Record<string, string> = {
      done: "Completed",
      next: "Up next",
      locked: "Locked",
      planned: "Coming soon",
    };
    const STATE_HINT: Record<string, string> = {
      done: "You've finished this one.",
      next: "Open it to start.",
      locked: "Finish the previous unit to unlock it.",
      planned: "Not written yet.",
    };
    const STATUS_LABEL: Record<string, string> = {
      done: "Done",
      next: "Up next",
      locked: "Locked",
    };
    const q = <T extends HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => root.querySelector<T>(sel);
    const qa = <T extends HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => Array.from(root.querySelectorAll<T>(sel));

    // ---- trail layout: 5 / 4 / 3 nodes per row by viewport -----------------
    // The server renders rows of 5. On narrower screens the same node elements
    // are re-chunked into shorter rows (moved, not cloned, so listeners,
    // state and focus targets survive).
    const mqDesktop = matchMedia("(min-width: 1024px)");
    const mqTablet = matchMedia("(min-width: 640px)");
    const perRowNow = () => (mqDesktop.matches ? 5 : mqTablet.matches ? 4 : 3);

    function layoutTrails() {
      const per = perRowNow();
      for (const ol of qa<HTMLElement>("[data-trail]")) {
        const nodes = qa<HTMLElement>("[data-node]", ol);
        nodes.forEach((n, i) => n.style.setProperty("--i", String(i)));
        if (ol.style.getPropertyValue("--per").trim() === String(per)) continue;
        const firstRow = q<HTMLElement>(".trail-row", ol);
        const line = q<HTMLElement>(".trail-line", ol);
        const fill = q<HTMLElement>(".trail-fill", ol);
        if (!firstRow || !line || !fill) continue;
        const rowProto = firstRow.cloneNode(false) as HTMLElement;
        const lineProto = line.cloneNode(false) as HTMLElement;
        const fillProto = fill.cloneNode(false) as HTMLElement;
        const rows: HTMLElement[] = [];
        for (let i = 0; i < nodes.length; i += per) {
          const chunk = nodes.slice(i, i + per);
          const flipped = (i / per) % 2 === 1;
          const li = rowProto.cloneNode(false) as HTMLElement;
          li.className = `trail-row relative flex justify-between ${flipped ? "flex-row-reverse is-flipped" : "flex-row"}`;
          li.style.setProperty("--n", String(chunk.length));
          li.append(
            lineProto.cloneNode(false),
            fillProto.cloneNode(false),
            ...chunk,
          );
          rows.push(li);
        }
        ol.style.setProperty("--per", String(per));
        ol.replaceChildren(...rows);
      }
      paintTrails();
    }

    // Completed stretches of the trail turn solid green. A segment is green
    // when the node before it (in walking order) is done; the elbow to the
    // next row is green when the row's last node is done.
    function paintTrails() {
      for (const ol of qa<HTMLElement>("[data-trail]")) {
        const per = Number(ol.style.getPropertyValue("--per")) || 5;
        for (const li of qa<HTMLElement>(".trail-row", ol)) {
          const nodes = qa<HTMLElement>("[data-node]", li);
          let lead = 0;
          while (lead < nodes.length && nodes[lead].dataset.state === "done")
            lead++;
          li.style.setProperty("--m", String(Math.min(lead, nodes.length - 1)));
          const full = nodes.length === per;
          if (full && lead === nodes.length) li.dataset.elbow = "done";
          else delete li.dataset.elbow;
        }
      }
    }

    // ---- celebrations: checkpoints pop once, the first time they're seen done
    function readCelebrated(): Set<string> {
      try {
        const raw = pStorage.getItem(CELEBRATED_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return new Set(Array.isArray(arr) ? arr : []);
      } catch {
        return new Set();
      }
    }
    function playCelebrations(panel: HTMLElement) {
      const pending = qa<HTMLElement>('[data-celebrate="pending"]', panel);
      if (pending.length === 0) return;
      const seen = readCelebrated();
      for (const c of pending) {
        const disc = q<HTMLElement>("[data-disc]", c);
        disc?.classList.remove("celebrate");
        void disc?.offsetWidth;
        disc?.classList.add("celebrate");
        seen.add(`${panel.dataset.worldPanel}:${c.dataset.label}`);
        delete c.dataset.celebrate;
      }
      try {
        pStorage.setItem(CELEBRATED_KEY, JSON.stringify([...seen]));
      } catch {
        // Storage full or blocked — the animation may just replay next visit.
      }
    }

    // ---- "Continue" banner ------------------------------------------------
    function updateContinue() {
      for (const panel of qa("[data-world-panel]")) {
        const card = q("[data-continue]", panel);
        if (!card) continue;
        const next = q('[data-kind="unit"][data-state="next"]', panel);
        const written = qa('[data-kind="unit"][data-written="true"]', panel);
        const allDone =
          written.length > 0 &&
          written.every((n) => n.dataset.state === "done");
        const title = q("[data-continue-title]", card)!;
        const kicker = q(".continue-kicker", card)!;
        const link = q<HTMLAnchorElement>("[data-continue-link]", card)!;
        if (next) {
          const label = q(".node-label", next)?.textContent ?? "";
          kicker.textContent = "Continue";
          title.textContent = `Unit ${next.dataset.index}: ${label}`;
          link.href = q<HTMLAnchorElement>("a.disc", next)?.href ?? "#";
          link.classList.remove("hidden");
          card.classList.remove("hidden");
        } else if (allDone) {
          kicker.textContent = "Nice work";
          title.textContent = `Every written unit in ${panel.dataset.worldPanel}/ is done.`;
          link.classList.add("hidden");
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      }
    }

    // ---- overview: global ring, stacked bar and the island map ---------------
    const RING_LEN = 2 * Math.PI * 42;
    function updateOverview() {
      const count: Record<string, number> = {
        done: 0,
        next: 0,
        locked: 0,
        planned: 0,
      };
      const units = qa('[data-kind="unit"]');
      for (const n of units) {
        const st = n.dataset.state ?? "locked";
        count[st] = (count[st] ?? 0) + 1;
      }
      const total = units.length || 1;
      const written = count.done + count.next + count.locked;
      for (const key of Object.keys(count)) {
        const seg = q(`[data-seg="${key}"]`);
        if (seg) seg.style.width = `${(count[key] / total) * 100}%`;
        const c = q(`[data-ov-count="${key}"]`);
        if (c) c.textContent = String(count[key]);
      }
      const pct = written ? count.done / written : 0;
      q("[data-ov-ring]")?.setAttribute(
        "stroke-dasharray",
        `${pct * RING_LEN} ${RING_LEN}`,
      );
      const pctEl = q("[data-ov-pct]");
      if (pctEl) pctEl.textContent = `${Math.round(pct * 100)}%`;
      const doneEl = q("[data-ov-done]");
      if (doneEl) doneEl.textContent = String(count.done);
      q("[data-ov-stack]")?.setAttribute(
        "aria-label",
        `${count.done} done, ${count.next} up next, ${count.locked} locked, ${count.planned} planned`,
      );
    }

    // Each island mirrors its world: ring, done/total and one dot per unit,
    // copied from the node's state so the two can never disagree.
    function syncIslands() {
      for (const isl of qa("[data-island]")) {
        const panel = q(
          `[data-world-panel="${CSS.escape(isl.dataset.island!)}"]`,
        );
        if (!panel) continue;
        const dots = qa(".dot", isl);
        let done = 0;
        for (const d of dots) {
          const node = q(
            `[data-kind="unit"][data-slug="${CSS.escape(d.dataset.slug!)}"]`,
            panel,
          );
          const st = node?.dataset.state ?? "planned";
          d.dataset.state = st;
          if (st === "done") done++;
        }
        const count = q("[data-island-count]", isl);
        if (count) count.textContent = `${done}/${dots.length}`;
        q("[data-island-ring]", isl)?.style.setProperty(
          "--p",
          String(dots.length ? done / dots.length : 0),
        );
        isl.dataset.complete = String(dots.length > 0 && done === dots.length);
        isl.dataset.done = String(done);
        isl.dataset.total = String(dots.length);
      }
      for (const reg of qa("section.region")) {
        const isl = qa("[data-island]", reg);
        const done = isl.reduce((n, i) => n + Number(i.dataset.done ?? 0), 0);
        const total = isl.reduce((n, i) => n + Number(i.dataset.total ?? 0), 0);
        const out = q("[data-region-count]", reg);
        if (out) out.textContent = `${done}/${total} units`;
      }
    }

    // The hero's path strip mirrors each node's state, same as the islands.
    function syncJourney() {
      for (const panel of qa("[data-world-panel]")) {
        for (const j of qa("[data-jslug]", panel)) {
          const node = q(
            `[data-kind="unit"][data-slug="${CSS.escape(j.dataset.jslug!)}"]`,
            panel,
          );
          j.dataset.state = node?.dataset.state ?? "planned";
        }
        const checks = qa('[data-kind="check"]', panel);
        for (const j of qa("[data-jcheck]", panel)) {
          j.dataset.state =
            checks.find((c) => c.dataset.label === j.dataset.jcheck)?.dataset
              .state ?? "locked";
        }
      }
    }

    function wireOverview() {
      const stage = q("[data-islands]");
      if (!stage || stage.dataset.wired === "true") return;
      stage.dataset.wired = "true";
      stage.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-island]",
        );
        if (b) openWorld(b.dataset.island!);
      });
    }

    // ---- state: stamp every node from the active profile's progress -----
    function stampStates() {
      let doneTotal = 0;
      for (const panel of qa("[data-world-panel]")) {
        const track = panel.dataset.worldPanel!;
        const unitNodes = qa<HTMLElement>(
          '[data-kind="unit"][data-written="true"]',
          panel,
        );
        const states = unitStates(
          track,
          unitNodes.map((n) => n.dataset.slug!),
        );
        const stateBySlug = new Map<string, string>();
        unitNodes.forEach((n, i) => {
          n.dataset.state = states[i];
          stateBySlug.set(n.dataset.slug!, states[i]);
        });
        const firstNext = unitNodes.find((_, i) => states[i] === "next");
        qa("[data-node]", panel).forEach((n) =>
          n.removeAttribute("data-start"),
        );
        firstNext?.setAttribute("data-start", "true");

        const celebrated = readCelebrated();
        for (const c of qa<HTMLElement>('[data-kind="check"]', panel)) {
          const group = (c.dataset.group ?? "").split(" ").filter(Boolean);
          const members = (c.dataset.members ?? "").split(" ").filter(Boolean);
          const allDone =
            group.length > 0 &&
            group.every((s) => stateBySlug.get(s) === "done");
          c.dataset.state = allDone ? "done" : "locked";
          const doneInGroup = members.filter(
            (s) => stateBySlug.get(s) === "done",
          ).length;
          for (const pip of qa("[data-pip]", c))
            pip.classList.toggle(
              "on",
              stateBySlug.get(pip.dataset.pip!) === "done",
            );
          const sum = q("[data-check-sum]", c);
          if (sum) sum.textContent = `${doneInGroup}/${members.length} done`;
          const key = `${track}:${c.dataset.label}`;
          if (allDone && !celebrated.has(key)) c.dataset.celebrate = "pending";
        }

        const done = states.filter((s) => s === "done").length;
        doneTotal += done;
        const total = Number(panel.dataset.total ?? "0");
        const count = q("[data-world-count]", panel);
        if (count) count.textContent = `${done} of ${total} units`;
        const fill = q("[data-world-fill]", panel);
        if (fill) fill.style.width = `${total ? (done / total) * 100 : 0}%`;
        const share = total ? done / total : 0;
        q("[data-hero-ring]", panel)?.setAttribute(
          "stroke-dasharray",
          `${share * RING_LEN} ${RING_LEN}`,
        );
        const heroPct = q("[data-hero-pct]", panel);
        if (heroPct) heroPct.textContent = `${Math.round(share * 100)}%`;
      }
      paintTrails();
      updateContinue();
      updateOverview();
      syncIslands();
      syncJourney();
      syncRoving();
      const pill = q("[data-done-pill]");
      const totalWritten = qa('[data-kind="unit"][data-written="true"]').length;
      if (pill) pill.textContent = `${doneTotal} of ${totalWritten} done`;
    }

    // ---- world selection: the map picks, the modal shows --------------------
    let order: string[] = [];
    function loadOrder() {
      try {
        order = JSON.parse(q("#world-order")?.textContent || "[]");
      } catch {
        order = [];
      }
    }
    const modalEl = () => q<HTMLDialogElement>("[data-world-modal]");

    let shownWorld: string | null = null;
    function selectWorld(name: string) {
      hideCard();
      for (const p of qa("[data-world-panel]")) {
        p.classList.toggle("hidden", p.dataset.worldPanel !== name);
      }
      for (const i of qa("[data-island]")) {
        i.setAttribute("aria-pressed", String(i.dataset.island === name));
      }
      const panel = q(`[data-world-panel="${CSS.escape(name)}"]`);
      const modal = modalEl();
      if (panel && modal) {
        // The dialog's own scenery and accent follow the world on show.
        modal.dataset.region = panel.dataset.region ?? "";
        modal.style.setProperty(
          "--world-h",
          panel.style.getPropertyValue("--world-h"),
        );
        modal.scrollTo({ top: 0 });
      }
      const i = order.indexOf(name);
      if (i >= 0) {
        const prev = order[(i - 1 + order.length) % order.length];
        const next = order[(i + 1) % order.length];
        const set = (sel: string, text: string) => {
          const el = q(sel);
          if (el) el.textContent = text;
        };
        set("[data-modal-index]", String(i + 1));
        set("[data-modal-prev-name]", prev);
        set("[data-modal-next-name]", next);
      }
      if (panel && shownWorld !== name) {
        const trail = q("[data-trail]", panel);
        trail?.classList.remove("is-entering");
        void trail?.offsetWidth;
        trail?.classList.add("is-entering");
      }
      shownWorld = name;
      if (panel) playCelebrations(panel);
    }

    function openWorld(name: string) {
      selectWorld(name);
      const modal = modalEl();
      if (modal && !modal.open) modal.showModal();
      history.replaceState(null, "", `#${name}`);
    }

    function wireModal() {
      const modal = modalEl();
      if (!modal || modal.dataset.wired === "true") return;
      modal.dataset.wired = "true";
      const step = (d: number) => {
        const cur = shownWorld ? order.indexOf(shownWorld) : 0;
        openWorld(order[(cur + d + order.length) % order.length]);
      };
      q("[data-modal-prev]")?.addEventListener("click", () => step(-1));
      q("[data-modal-next]")?.addEventListener("click", () => step(1));
      q("[data-modal-close]")?.addEventListener("click", () => modal.close());
      // A click on the dim backdrop lands on the <dialog> itself.
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.close();
          return;
        }
        const j = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-jslug]",
        );
        if (!j) return;
        const node = q(
          `[data-kind="unit"][data-slug="${CSS.escape(j.dataset.jslug!)}"]`,
          modal,
        );
        q("[data-disc]", node ?? modal)?.focus();
      });
      modal.addEventListener("close", () => {
        hideCard();
        shownWorld = null;
        history.replaceState(null, "", location.pathname + location.search);
      });
    }

    // ---- filters --------------------------------------------------------
    const filters = {
      query: "",
      tags: new Set<string>(),
      statuses: new Set<string>(),
    };
    const filtersActive = () =>
      filters.query !== "" ||
      filters.tags.size > 0 ||
      filters.statuses.size > 0;

    function nodeMatches(n: HTMLElement): boolean {
      if (filters.query && !(n.dataset.search ?? "").includes(filters.query))
        return false;
      if (filters.tags.size > 0) {
        const tags = (n.dataset.tags ?? "").split(" ");
        if (!tags.some((t) => filters.tags.has(t))) return false;
      }
      if (
        filters.statuses.size > 0 &&
        !filters.statuses.has(n.dataset.state ?? "")
      )
        return false;
      return true;
    }

    function applyFilters() {
      const active = filtersActive();
      const perWorld = new Map<string, number>();
      let total = 0;
      for (const n of qa('[data-kind="unit"]')) {
        const match = !active || nodeMatches(n);
        n.classList.toggle("is-dim", !match);
        if (active && match) {
          const t = n.dataset.track!;
          perWorld.set(t, (perWorld.get(t) ?? 0) + 1);
          total++;
        }
      }
      for (const i of qa("[data-island]")) {
        const count = perWorld.get(i.dataset.island!) ?? 0;
        i.classList.toggle("is-dim", active && count === 0);
        const badge = q("[data-island-badge]", i);
        if (!badge) continue;
        badge.textContent = `${count} ${count === 1 ? "match" : "matches"}`;
        badge.hidden = !(active && count > 0);
      }
      const summary = q("[data-match-summary]");
      if (summary) {
        summary.classList.toggle("hidden", !active);
        summary.textContent = `${total} ${total === 1 ? "unit matches" : "units match"} across ${perWorld.size} ${perWorld.size === 1 ? "world" : "worlds"}`;
      }
      q("[data-empty-state]")?.classList.toggle(
        "hidden",
        !(active && total === 0),
      );
      renderChips();
      q("[data-clear-filters]")?.classList.toggle("hidden", !active);
      q("[data-clear-filters]")?.classList.toggle("inline-flex", active);
      for (const kind of ["tags", "status"] as const) {
        const el = q(`[data-filter-count="${kind}"]`);
        const n = kind === "tags" ? filters.tags.size : filters.statuses.size;
        if (!el) continue;
        el.textContent = String(n);
        el.classList.toggle("hidden", n === 0);
      }
    }

    // Active filters as removable chips under the bar. Built with DOM calls
    // (not innerHTML) because the search text is whatever the reader typed.
    const X_ICON =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    function renderChips() {
      const box = q("[data-active-chips]");
      if (!box) return;
      const make = (kind: string, value: string, text: string) => {
        const b = document.createElement("button");
        b.type = "button";
        b.dataset.chipKind = kind;
        b.dataset.chipValue = value;
        b.className =
          "inline-flex items-center gap-1.5 rounded-full border-2 border-slate-300 px-3 py-1 text-xs font-bold transition hover:border-slate-900 dark:border-slate-700 dark:hover:border-slate-100";
        b.setAttribute("aria-label", `Remove filter: ${text}`);
        const span = document.createElement("span");
        span.textContent = text;
        b.append(span);
        b.insertAdjacentHTML("beforeend", X_ICON);
        return b;
      };
      const chips: HTMLElement[] = [];
      if (filters.query) chips.push(make("query", "", `“${filters.query}”`));
      for (const t of filters.tags) chips.push(make("tag", t, t));
      for (const s of filters.statuses)
        chips.push(make("status", s, STATUS_LABEL[s] ?? s));
      box.replaceChildren(...chips);
      box.classList.toggle("hidden", chips.length === 0);
      box.classList.toggle("flex", chips.length > 0);
    }

    function wireFilters() {
      const search = q<HTMLInputElement>("[data-roadmap-search]");
      if (!search || search.dataset.wired === "true") return;
      search.dataset.wired = "true";

      q("[data-active-chips]")?.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-chip-kind]",
        );
        if (!b) return;
        const value = b.dataset.chipValue ?? "";
        if (b.dataset.chipKind === "query") {
          filters.query = "";
          search.value = "";
        } else if (b.dataset.chipKind === "tag") {
          filters.tags.delete(value);
          qa("[data-tag-chip]")
            .find((c) => c.dataset.tagChip === value)
            ?.setAttribute("aria-pressed", "false");
        } else {
          filters.statuses.delete(value);
          qa("[data-status-chip]")
            .find((c) => c.dataset.statusChip === value)
            ?.setAttribute("aria-pressed", "false");
        }
        applyFilters();
      });

      search.addEventListener("input", () => {
        filters.query = search.value.trim().toLowerCase();
        applyFilters();
      });

      for (const chip of qa("[data-tag-chip]")) {
        chip.addEventListener("click", () => {
          const tag = chip.dataset.tagChip!;
          const on = !filters.tags.has(tag);
          if (on) filters.tags.add(tag);
          else filters.tags.delete(tag);
          chip.setAttribute("aria-pressed", String(on));
          applyFilters();
        });
      }
      for (const chip of qa("[data-status-chip]")) {
        chip.addEventListener("click", () => {
          const s = chip.dataset.statusChip!;
          const on = !filters.statuses.has(s);
          if (on) filters.statuses.add(s);
          else filters.statuses.delete(s);
          chip.setAttribute("aria-pressed", String(on));
          applyFilters();
        });
      }
      q<HTMLInputElement>("[data-tag-search]")?.addEventListener(
        "input",
        (e) => {
          const text = (e.target as HTMLInputElement).value
            .trim()
            .toLowerCase();
          for (const chip of qa("[data-tag-chip]")) {
            chip.classList.toggle(
              "hidden",
              !!text &&
                !(chip.dataset.tagChip ?? "").toLowerCase().includes(text),
            );
          }
        },
      );
      q("[data-clear-filters]")?.addEventListener("click", () => {
        filters.query = "";
        filters.tags.clear();
        filters.statuses.clear();
        search.value = "";
        for (const c of qa("[data-tag-chip], [data-status-chip]")) {
          c.setAttribute("aria-pressed", "false");
        }
        applyFilters();
      });

      // Popovers: one open at a time, closed by outside click or Escape.
      const triggers = qa("[data-filter-trigger]");
      const closeAll = () => {
        for (const t of triggers) {
          t.setAttribute("aria-expanded", "false");
          q(`[data-filter-panel="${t.dataset.filterTrigger}"]`)?.classList.add(
            "hidden",
          );
        }
      };
      for (const t of triggers) {
        t.addEventListener("click", (e) => {
          e.stopPropagation();
          const panel = q(`[data-filter-panel="${t.dataset.filterTrigger}"]`);
          const wasOpen = panel && !panel.classList.contains("hidden");
          closeAll();
          if (panel && !wasOpen) {
            panel.classList.remove("hidden");
            t.setAttribute("aria-expanded", "true");
          }
        });
      }
      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("[data-filter-panel]"))
          closeAll();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAll();
      });
    }

    // ---- floating card for the hovered / focused node ----------------------
    const cardEl = () => q("[data-node-card]");
    let cardNode: HTMLElement | null = null;
    function el(tag: string, cls: string, text?: string) {
      const n = document.createElement(tag);
      n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    }
    function hideCard() {
      const card = cardEl();
      if (card) card.hidden = true;
      q("[data-disc][aria-describedby]")?.removeAttribute("aria-describedby");
      cardNode = null;
    }
    // Small stroke icons for the card, built once as markup strings.
    const ico = (paths: string) =>
      `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
    const ICON = {
      clock: ico('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
      target: ico(
        '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/>',
      ),
      spark: ico(
        '<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/>',
      ),
      play: ico('<path d="M7 5l12 7-12 7z" fill="currentColor"/>'),
      lock: ico(
        '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
      ),
      check: ico('<path d="M5 12.5l4.5 4.5L19 7.5"/>'),
      flag: ico('<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>'),
      soon: ico('<circle cx="12" cy="12" r="9" stroke-dasharray="3 3.5"/>'),
    };
    const STATE_ICON: Record<string, string> = {
      done: ICON.check,
      next: ICON.play,
      locked: ICON.lock,
      planned: ICON.soon,
    };
    const tagIcon = (tag: string) =>
      q(`[data-tag-icons] [data-tag="${CSS.escape(tag)}"] svg`)?.cloneNode(
        true,
      ) ?? null;
    function statePill(state: string, label?: string) {
      const p = el("span", `nc-pill nc-${state}`);
      p.insertAdjacentHTML("beforeend", STATE_ICON[state] ?? "");
      p.append(label ?? STATE_LABEL[state] ?? state);
      return p;
    }
    function fact(icon: string, value: string, label: string) {
      const t = el("span", "nc-fact");
      t.insertAdjacentHTML("beforeend", icon);
      t.append(el("b", "", value), el("span", "", label));
      return t;
    }

    function showCard(node: HTMLElement) {
      const card = cardEl();
      if (!card) return;
      const kind = node.dataset.kind;
      const state = node.dataset.state ?? "locked";
      card.replaceChildren();
      card.style.removeProperty("--uh");
      if (kind === "unit") {
        const uh = node.style.getPropertyValue("--uh");
        if (uh) card.style.setProperty("--uh", uh);
        card.dataset.pat = node.dataset.pat ?? "dots";
        // A tall themed header (emblem with pulsing rings, drifting topic
        // icons, giant numeral), then the title, icon facts, the unit's place
        // in its world, a length gauge, tags and a footer line.
        const panel = node.closest<HTMLElement>("[data-world-panel]");
        const units = qa<HTMLElement>('[data-kind="unit"]', panel ?? document);
        const at = units.indexOf(node);
        const hero = el("div", "nc-hero nc-hero-big");
        const orb = el("span", "nc-orb");
        const primary = (node.dataset.tags ?? "").split(" ")[0] ?? "";
        const orbIcon =
          q(".unit-deco .deco-0", node)?.cloneNode(true) ?? tagIcon(primary);
        if (orbIcon) orb.append(orbIcon);
        const emblem = el("span", "nc-emblem");
        emblem.append(
          el("i", "nc-ring nc-ring-1"),
          el("i", "nc-ring nc-ring-2"),
        );
        emblem.append(orb);
        const head = el("div", "nc-head");
        head.append(
          el("span", "nc-kicker", `Unit ${node.dataset.index}`),
          el("span", "nc-rank", `${at + 1} of ${units.length}`),
          statePill(state),
        );
        const scatter = el("span", "nc-scatter");
        const themeTags = (node.dataset.tags ?? "").split(" ").filter(Boolean);
        for (let k = 0; k < 7; k++) {
          const ic =
            k === 0
              ? q(".unit-deco .deco-0", node)?.cloneNode(true)
              : tagIcon(themeTags[k % Math.max(themeTags.length, 1)] ?? "");
          if (!ic) continue;
          const holder = el("i", `nc-sc nc-sc-${k}`);
          holder.append(ic);
          scatter.append(holder);
        }
        const num = el("span", "nc-num", node.dataset.index ?? "");
        hero.append(scatter, num, emblem, head);
        card.append(hero, el("p", "nc-title", node.dataset.problem ?? ""));

        const facts = el("div", "nc-facts");
        if (node.dataset.written === "true")
          facts.append(fact(ICON.clock, node.dataset.minutes ?? "", "min"));
        if (Number(node.dataset.topics) > 0)
          facts.append(fact(ICON.target, node.dataset.topics ?? "", "topics"));
        if (node.dataset.demo === "true")
          facts.append(fact(ICON.spark, "Demo", "live"));
        if (facts.childElementCount) card.append(facts);

        // Where this unit sits in its world: one dot per unit.
        const way = el("div", "nc-way");
        const dots = el("div", "nc-way-dots");
        units.forEach((u, k) => {
          dots.append(
            el(
              "i",
              `nc-wd nc-wd-${u.dataset.state ?? "planned"}${k === at ? " here" : ""}`,
            ),
          );
        });
        way.append(el("span", "nc-way-label", "Your path"), dots);
        card.append(way);

        if (node.dataset.written === "true") {
          const gauge = el("div", "nc-gauge");
          const len = el("div", "nc-len");
          const bar = el("i", "");
          bar.style.width = `${Math.max(Number(node.dataset.len), 6)}%`;
          len.append(bar);
          len.title =
            "Reading time compared with the longest unit in this world";
          gauge.append(el("span", "", "Quick"), len, el("span", "", "Long"));
          card.append(gauge);
        }
        // What the unit's exercises actually practise, from its topic ids.
        const names = (node.dataset.topicNames ?? "")
          .split("|")
          .filter(Boolean);
        if (names.length) {
          const learn = el("div", "nc-learn");
          learn.append(el("span", "nc-way-label", "You will practise"));
          const list = el("div", "nc-learn-list");
          for (const n of names.slice(0, 4)) {
            const pretty = n.replace(/[-_]+/g, " ");
            const li = el("span", "nc-learn-item");
            li.append(
              el("i", ""),
              pretty.charAt(0).toUpperCase() + pretty.slice(1),
            );
            list.append(li);
          }
          if (names.length > 4)
            list.append(
              el("span", "nc-learn-more", `+${names.length - 4} more`),
            );
          learn.append(list);
          card.append(learn);
        }
        const tags = themeTags;
        if (tags.length) {
          const row = el("div", "nc-tags");
          for (const t of tags.slice(0, 5)) {
            const chip = el("span", "nc-tag");
            const ic = tagIcon(t);
            if (ic) chip.append(ic);
            chip.append(t);
            row.append(chip);
          }
          card.append(row);
        }
        const foot = el("div", "nc-foot");
        const prev = units[at - 1];
        foot.append(
          state === "locked" && prev
            ? `After: ${q(".node-label", prev)?.textContent ?? "the previous unit"}`
            : (STATE_HINT[state] ?? ""),
        );
        card.append(foot);
      } else {
        const panel = node.closest<HTMLElement>("[data-world-panel]");
        const members = (node.dataset.members ?? "").split(" ").filter(Boolean);
        const bySlug = new Map<string, HTMLElement>();
        for (const n of qa<HTMLElement>(
          '[data-kind="unit"]',
          panel ?? document,
        ))
          bySlug.set(n.dataset.slug!, n);
        const doneCount = members.filter(
          (s) => bySlug.get(s)?.dataset.state === "done",
        ).length;
        const cleared = state === "done";
        const hero = el("div", "nc-hero nc-hero-check");
        const orb = el("span", "nc-orb");
        orb.insertAdjacentHTML("beforeend", ICON.flag);
        const head = el("div", "nc-head");
        head.append(
          el("span", "nc-kicker", node.dataset.label ?? "Checkpoint"),
          statePill(cleared ? "done" : "locked", cleared ? "Cleared" : "Open"),
        );
        hero.append(orb, head);
        card.append(hero);

        const big = el("div", "nc-big");
        big.append(el("b", "", `${doneCount}/${members.length}`), "units done");
        card.append(big);
        const pips = el("div", "nc-pips");
        for (const s of members)
          pips.append(
            el("i", bySlug.get(s)?.dataset.state === "done" ? "on" : ""),
          );
        card.append(pips);

        // One icon per unit in the group, coloured by its state.
        const grid = el("div", "nc-mems");
        for (const s of members) {
          const u = bySlug.get(s);
          const m = el(
            "span",
            `nc-mem nc-mem-${u?.dataset.state ?? "planned"}`,
          );
          const ic = q(".tag-badge svg", u ?? node)?.cloneNode(true);
          if (ic) m.append(ic);
          grid.append(m);
        }
        card.append(grid);
      }
      card.hidden = false;
      const disc = q("[data-disc]", node);
      disc?.setAttribute("aria-describedby", "node-card");
      // Centred in the viewport like a modal, so it always opens in the same
      // place whatever node is hovered. It ignores the pointer, so the node
      // underneath keeps its hover.
      const w = card.offsetWidth;
      const h = card.offsetHeight;
      const left = Math.max(8, (window.innerWidth - w) / 2);
      const top2 = Math.max(8, (window.innerHeight - h) / 2);
      card.style.left = `${left}px`;
      card.style.top = `${top2}px`;
      cardNode = node;
    }

    function wireCard() {
      const card = cardEl();
      if (!card || card.dataset.wired === "true") return;
      card.dataset.wired = "true";
      let lastPointer = "mouse";
      const nodeOf = (t: EventTarget | null) =>
        (t as HTMLElement | null)?.closest?.<HTMLElement>("[data-node]") ??
        null;
      document.addEventListener(
        "pointerdown",
        (e) => {
          lastPointer = e.pointerType;
          if (e.pointerType === "touch" && !nodeOf(e.target)) hideCard();
        },
        true,
      );
      document.addEventListener("pointerover", (e) => {
        if (e.pointerType === "touch") return;
        const n = nodeOf(e.target);
        if (n && n !== cardNode) showCard(n);
      });
      document.addEventListener("pointerout", (e) => {
        if (e.pointerType === "touch") return;
        const n = nodeOf(e.target);
        if (n && !n.contains(e.relatedTarget as Node | null)) hideCard();
      });
      document.addEventListener("focusin", (e) => {
        const n = nodeOf(e.target);
        if (n) showCard(n);
      });
      document.addEventListener("focusout", (e) => {
        if (nodeOf(e.target)) hideCard();
      });
      // First tap on a node shows its card; a second tap follows the link.
      document.addEventListener("click", (e) => {
        if (lastPointer !== "touch") return;
        const n = nodeOf(e.target);
        if (n && n !== cardNode) {
          e.preventDefault();
          showCard(n);
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") hideCard();
      });
      // Capture, so scrolling inside the modal (not just the page) hides it.
      document.addEventListener("scroll", hideCard, {
        passive: true,
        capture: true,
      });
      window.addEventListener("resize", hideCard);
    }

    // ---- keyboard: roving tabindex, arrows walk the trail in order ---------
    function syncRoving() {
      for (const panel of qa("[data-world-panel]")) {
        const discs = qa("[data-disc]", panel);
        const target =
          q('[data-start="true"] [data-disc]', panel) ?? discs[0] ?? null;
        for (const d of discs) d.tabIndex = d === target ? 0 : -1;
      }
    }
    function wireKeyboard() {
      for (const ol of qa("[data-trail]")) {
        if (ol.dataset.wired === "true") continue;
        ol.dataset.wired = "true";
        ol.addEventListener("focusin", (e) => {
          const d = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-disc]",
          );
          if (!d) return;
          for (const o of qa("[data-disc]", ol)) o.tabIndex = o === d ? 0 : -1;
        });
        ol.addEventListener("keydown", (e) => {
          const cur = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-disc]",
          );
          if (!cur) return;
          const discs = qa("[data-disc]", ol);
          const i = discs.indexOf(cur);
          let to = -1;
          if (e.key === "ArrowRight" || e.key === "ArrowDown") to = i + 1;
          else if (e.key === "ArrowLeft" || e.key === "ArrowUp") to = i - 1;
          else if (e.key === "Home") to = 0;
          else if (e.key === "End") to = discs.length - 1;
          else if (e.key === "Enter" && !(cur instanceof HTMLAnchorElement)) {
            const n = cur.closest<HTMLElement>("[data-node]");
            if (n) showCard(n);
            return;
          }
          if (to < 0 || to >= discs.length) return;
          e.preventDefault();
          discs[to].focus();
        });
      }
    }

    // ---- trail / list view ---------------------------------------------------
    function setView(view: string) {
      for (const ol of qa("[data-trail]")) ol.dataset.view = view;
      for (const b of qa("[data-view-btn]"))
        b.setAttribute("aria-pressed", String(b.dataset.viewBtn === view));
      hideCard();
      try {
        localStorage.setItem(VIEW_KEY, view);
      } catch {
        // Not remembered in private mode.
      }
    }
    function wireView() {
      const group = q("[data-view-btn]")?.parentElement;
      if (!group || group.dataset.wired === "true") return;
      group.dataset.wired = "true";
      for (const b of qa("[data-view-btn]", group))
        b.addEventListener("click", () => setView(b.dataset.viewBtn!));
      mqDesktop.addEventListener("change", layoutTrails);
      mqTablet.addEventListener("change", layoutTrails);
    }

    function initRoadmap() {
      if (!q("[data-islands]")) return;
      loadOrder();
      wireModal();
      wireFilters();
      wireOverview();
      wireView();
      wireCard();
      layoutTrails();
      wireKeyboard();
      stampStates();
      try {
        setView(localStorage.getItem(VIEW_KEY) === "list" ? "list" : "trail");
      } catch {
        setView("trail");
      }

      // Mark where the reader last made progress, then honour a #world link.
      const last = lastTouchedTrack(order);
      for (const i of qa("[data-island]"))
        i.dataset.last = String(i.dataset.island === last);
      const fromHash = decodeURIComponent(location.hash.slice(1));
      if (order.includes(fromHash)) openWorld(fromHash);
      applyFilters();
    }
    initRoadmap();
    document.addEventListener("astro:page-load", initRoadmap);
  </script>
</Layout>

