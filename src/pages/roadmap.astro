                    <circle
                      cx="82"
                      cy="22"
                      r="10.5"
                      stroke-dasharray="3.5 3"
                      stroke-width="3.5"
                      opacity="0.55"
                    />
                    <path d="M92 52l16-16" />
                    <circle cx="110" cy="34" r="5" />
                    <path d="M8 58h104" opacity="0.4" />
                  </>
                )}
                {r.id === "observatory" && (
                  <>
                    <path d="M26 54V40a24 24 0 0 1 48 0v14z" />
                    <path d="M46 18l8 22" />
                    <path d="M52 34l28-20" stroke-width="4" />
                    <path d="M92 14v8M88 18h8" />
                    <path d="M104 34v6M101 37h6" opacity="0.6" />
                    <circle cx="14" cy="18" r="1.5" fill="currentColor" />
                    <path d="M100 56a8 8 0 1 1-8-12 6 6 0 0 0 8 12z" />
                    <path d="M8 58h104" opacity="0.4" />
                  </>
                )}
                {r.id === "harbor" && (
                  <>
                    <path d="M52 56l4-30h12l4 30z" />
