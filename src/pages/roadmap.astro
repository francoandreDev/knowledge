---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import StatusBadge from "../components/StatusBadge.astro";
import TrackIllustration from "../components/TrackIllustration.astro";
import TopicMythModal from "../components/TopicMythModal.astro";
import { Search, X, HelpCircle } from "lucide-astro";
import { roadmap, type UnitStatus } from "../data/roadmap";
import { getWrittenUnits } from "../lib/curriculum";

const writtenUnits = await getWrittenUnits();
const writtenKeys = new Set(
  writtenUnits.map((u) => `${u.track}/${u.unitSlug}`),
);

const STATUSES: UnitStatus[] = ["planned", "in-progress", "done"];

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();
---

<Layout title="Roadmap">
  <h1 class="text-3xl font-bold tracking-tight">Roadmap</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">
    Every planned unit across all tracks. Written units are linked; the rest are
    still <code>planned</code>.
  </p>

  <div class="mt-6 space-y-3">
    <div class="relative max-w-lg">
      <Search
        class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400"
        aria-hidden="true"
      />
      <input
        type="search"
        data-roadmap-search
        placeholder='Search by topic, e.g. "caching", "feedback", "rebase"...'
        class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pr-3 pl-9 text-sm text-slate-900 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
      />
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="mr-1 text-xs font-medium text-slate-500 dark:text-slate-500"
        >Track:</span
      >
      {
        roadmap.tracks.map((track) => (
          <button
            type="button"
            data-track-chip={track.name}
            aria-pressed="false"
            class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:border-slate-400 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:aria-pressed:border-slate-100 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900"
          >
            <TrackIcon track={track.name} class="h-3 w-3" />
            {track.name}
          </button>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="mr-1 text-xs font-medium text-slate-500 dark:text-slate-500"
        >Tags:</span
      >
      {
        ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-chip={tag}
            aria-pressed="false"
            class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:border-slate-400 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:aria-pressed:border-slate-100 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900"
          >
            {tag}
          </button>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="mr-1 text-xs font-medium text-slate-500 dark:text-slate-500"
        >Status:</span
      >
      {
        STATUSES.map((status) => (
          <button
            type="button"
            data-status-chip={status}
            aria-pressed="false"
            class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 capitalize transition hover:border-slate-400 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:aria-pressed:border-slate-100 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900"
          >
            {status}
          </button>
        ))
      }
      <button
        type="button"
        data-clear-filters
        class="ml-2 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-900 dark:text-slate-500 dark:hover:text-slate-100"
      >
        <X class="h-3 w-3" aria-hidden="true" />
        Clear filters
      </button>
    </div>

    <p data-match-count class="text-xs text-slate-500 dark:text-slate-500">
      {writtenUnits.length} of {
        roadmap.tracks.reduce((n, t) => n + t.units.length, 0)
      } units written
    </p>
  </div>

  <p
    data-empty-state
    class="mt-10 hidden text-center text-sm text-slate-500 dark:text-slate-500"
  >
    No units match these filters.
  </p>

  <div class="mt-6 space-y-10">
    {
      roadmap.tracks.map((track) => (
        <section data-track-section={track.name}>
          <div class="flex flex-wrap items-center gap-4">
            <TrackIllustration
              track={track.name}
              class="hidden w-40 shrink-0 sm:block"
            />
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <div class="rounded-md bg-slate-100 p-1.5 text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                  <TrackIcon track={track.name} class="h-4 w-4" />
                </div>
                <h2 class="text-lg font-semibold tracking-tight">
                  {track.name}/
                </h2>
              </div>
              <button
                type="button"
                data-myth-trigger={track.name}
                class="mt-1.5 inline-flex items-center gap-1 text-xs font-medium hover:underline"
                style="color: var(--accent-text)"
              >
                <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
                What is this, really?
              </button>
            </div>
          </div>
          <ol class="mt-3 divide-y divide-slate-200 dark:divide-slate-800">
            {track.units.map((unit) => {
              const isWritten = writtenKeys.has(`${track.name}/${unit.slug}`);
              const status = isWritten ? "done" : unit.status;
              const searchText =
                `${unit.problem} ${unit.slug} ${track.name}`.toLowerCase();
              return (
                <li
                  data-unit-row
                  data-track={track.name}
                  data-status={status}
                  data-search={searchText}
                  data-tags={unit.tags.join(" ")}
                  class="flex items-center justify-between gap-4 py-2"
                >
                  <span class="flex items-baseline gap-3">
                    <span class="w-6 shrink-0 text-right text-xs text-slate-400 tabular-nums">
                      {unit.number}
                    </span>
                    {isWritten ? (
                      <a
                        href={`/${track.name}/${unit.slug}/`}
                        class="text-sm text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900 dark:text-slate-100 dark:decoration-slate-700 dark:hover:decoration-slate-100"
                      >
                        {unit.problem}
                      </a>
                    ) : (
                      <span class="text-sm text-slate-500 dark:text-slate-500">
                        {unit.problem}
                      </span>
                    )}
                  </span>
                  <span class="shrink-0">
                    <StatusBadge status={isWritten ? "written" : unit.status} />
                  </span>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>

  <TopicMythModal />

  <script>
    import { getActiveProfile } from "../lib/profile";

    function initRoadmapFilters() {
      const root = document.body;
      if (root.dataset.roadmapFiltersWired === "true") return;
      root.dataset.roadmapFiltersWired = "true";

      const searchInput = document.querySelector<HTMLInputElement>(
        "[data-roadmap-search]",
      );
      const trackChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-track-chip]"),
      );
      const statusChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-status-chip]"),
      );
      const tagChips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-tag-chip]"),
      );
      const clearButton = document.querySelector<HTMLButtonElement>(
        "[data-clear-filters]",
      );
      const rows = Array.from(
        document.querySelectorAll<HTMLElement>("[data-unit-row]"),
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>("[data-track-section]"),
      );
      const matchCount =
        document.querySelector<HTMLElement>("[data-match-count]");
      const emptyState =
        document.querySelector<HTMLElement>("[data-empty-state]");
      if (!searchInput || !matchCount || !emptyState) return;

      const activeTracks = new Set<string>();
      const activeStatuses = new Set<string>();
      const activeTags = new Set<string>();

      function applyFilters() {
        const query = searchInput!.value.trim().toLowerCase();
        let visible = 0;

        for (const row of rows) {
          const matchesQuery =
            !query || (row.dataset.search ?? "").includes(query);
          const matchesTrack =
            activeTracks.size === 0 ||
            activeTracks.has(row.dataset.track ?? "");
          const matchesStatus =
            activeStatuses.size === 0 ||
            activeStatuses.has(row.dataset.status ?? "");
          const rowTags = (row.dataset.tags ?? "").split(" ");
          const matchesTags =
            activeTags.size === 0 || rowTags.some((t) => activeTags.has(t));
          const show =
            matchesQuery && matchesTrack && matchesStatus && matchesTags;
          row.classList.toggle("hidden", !show);
          if (show) visible++;
        }

        for (const section of sections) {
          const name = section.dataset.trackSection ?? "";
          const hasVisibleRow = rows.some(
            (r) => r.dataset.track === name && !r.classList.contains("hidden"),
          );
          section.classList.toggle("hidden", !hasVisibleRow);
        }

        matchCount!.textContent = `${visible} of ${rows.length} units match`;
        emptyState!.classList.toggle("hidden", visible !== 0);
      }

      searchInput.addEventListener("input", applyFilters);

      trackChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const name = chip.dataset.trackChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeTracks.add(name);
          else activeTracks.delete(name);
          applyFilters();
        });
      });

      statusChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const status = chip.dataset.statusChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeStatuses.add(status);
          else activeStatuses.delete(status);
          applyFilters();
        });
      });

      tagChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const tag = chip.dataset.tagChip!;
          const nowActive = chip.getAttribute("aria-pressed") !== "true";
          chip.setAttribute("aria-pressed", String(nowActive));
          if (nowActive) activeTags.add(tag);
          else activeTags.delete(tag);
          applyFilters();
        });
      });

      clearButton?.addEventListener("click", () => {
        searchInput.value = "";
        activeTracks.clear();
        activeStatuses.clear();
        activeTags.clear();
        [...trackChips, ...statusChips, ...tagChips].forEach((chip) =>
          chip.setAttribute("aria-pressed", "false"),
        );
        applyFilters();
      });

      // Progressive-enhancement target for the homepage's search box
      // (submits a plain GET form to /roadmap?search=...) — prefill and
      // run the filter once on load so it works even if this script is the
      // first thing to touch the input.
      const params = new URLSearchParams(location.search);
      const initialQuery = params.get("search");
      if (initialQuery) searchInput.value = initialQuery;

      // Pre-select tag chips matching the active profile's interests, if
      // any — purely a starting point for the filter UI, not a forced
      // choice; the reader can deselect/clear as normal. A profile with no
      // interests set leaves every chip unselected, same as today.
      const interests = new Set(getActiveProfile()?.interests ?? []);
      if (interests.size > 0) {
        tagChips.forEach((chip) => {
          const tag = chip.dataset.tagChip!;
          if (interests.has(tag)) {
            chip.setAttribute("aria-pressed", "true");
            activeTags.add(tag);
          }
        });
      }

      applyFilters();
    }

    initRoadmapFilters();
    document.addEventListener("astro:page-load", initRoadmapFilters);
  </script>
</Layout>
