---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import TopicMythModal from "../components/TopicMythModal.astro";
import TagIcon from "../components/TagIcon.astro";
import UnitEmblem from "../components/UnitEmblem.astro";
import { REGIONS } from "../data/regions";
import { makeUnitHue, unitPattern } from "../lib/unit-theme";
import TrackIllustration from "../components/TrackIllustration.astro";
import { TRACK_TEASERS } from "../data/track-teasers";
import {
  Search,
  HelpCircle,
  ChevronDown,
  RotateCcw,
  Check,
  Play,
  Lock,
  Flag,
  Route,
  List,
  ArrowRight,
  ChevronLeft,
  ChevronRight,
  X,
  Clock,
  Target,
  Sparkles,
  Layers,
} from "lucide-astro";
import { roadmap } from "../data/roadmap";
import { loadHomeData } from "../lib/home-data";

const { writtenUnits } = await loadHomeData();
const writtenKeys = new Set(
  writtenUnits.map((u) => `${u.track}/${u.unitSlug}`),
);

// Reading time and exercise-topic count per written unit, from the real
// content (about 200 words a minute), so the chips never invent numbers.
const unitMeta = new Map<
  string,
  { minutes: number; topics: number; names: string[]; demo: boolean }
>();
for (const u of writtenUnits) {
  const words = [u.l1, u.l2, u.l3, ...u.l3Parts].reduce(
    (n, e) => n + (e?.body ? e.body.split(/\s+/).filter(Boolean).length : 0),
    0,
  );
  const topics = new Set(u.exercises.map((e) => e.topicId ?? e.poolId ?? e.id));
  unitMeta.set(`${u.track}/${u.unitSlug}`, {
    minutes: Math.max(1, Math.round(words / 200)),
    topics: topics.size,
    names: [...topics].map((t) => String(t)),
    demo: u.interactives.length > 0,
  });
}

const PER_ROW = 5;
const CHECKPOINT_EVERY = 5;

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();

const unitHue = makeUnitHue(ALL_TAGS);

const STATUS_FILTERS = [
  { key: "done", label: "Done" },
  { key: "next", label: "Up next" },
  { key: "locked", label: "Locked" },
];

// Each world is one track laid out as a path of level nodes: its units in
// curriculum order, plus a checkpoint node after every fifth unit and at the
// end. The path is cut into rows of PER_ROW; odd rows run right-to-left so the
// trail snakes. The client script stamps each node's state (done / next /
// locked) from the active profile's progress.
const worlds = roadmap.tracks.map((track) => {
  const nodes: Array<
    | {
        kind: "unit";
        index: number;
        slug: string;
        problem: string;
        short: string;
        tags: string[];
        written: boolean;
        minutes: number;
        topics: number;
        names: string[];
        demo: boolean;
        len: number;
      }
    | { kind: "check"; label: string; group: string[]; members: string[] }
  > = [];
  let group: string[] = [];
  let members: string[] = [];
  track.units.forEach((u, i) => {
    const written = writtenKeys.has(`${track.name}/${u.slug}`);
    nodes.push({
      kind: "unit",
      index: i,
      slug: u.slug,
      problem: u.problem,
      short: u.problem.replace(/\s*\(.*$/, "").trim(),
      tags: u.tags,
      written,
      minutes: unitMeta.get(`${track.name}/${u.slug}`)?.minutes ?? 0,
      topics: unitMeta.get(`${track.name}/${u.slug}`)?.topics ?? 0,
      names: unitMeta.get(`${track.name}/${u.slug}`)?.names ?? [],
      demo: unitMeta.get(`${track.name}/${u.slug}`)?.demo ?? false,
      len: 0,
    });
    if (written) group.push(u.slug);
    members.push(u.slug);
    const isLast = i === track.units.length - 1;
    if ((i + 1) % CHECKPOINT_EVERY === 0 || isLast) {
      nodes.push({
        kind: "check",
        label: isLast
          ? "Final checkpoint"
          : `Checkpoint ${(i + 1) / CHECKPOINT_EVERY}`,
        group: [...group],
        members: [...members],
      });
      group = [];
      members = [];
    }
  });
  const rows: (typeof nodes)[] = [];
  for (let i = 0; i < nodes.length; i += PER_ROW) {
    rows.push(nodes.slice(i, i + PER_ROW));
  }
  const unitNodes = nodes.filter((n) => n.kind === "unit");
  // Each unit's reading time as a share of the world's longest unit, so a
  // bar can show "short or long" without anyone reading the minutes.
  const maxMinutes = Math.max(0, ...unitNodes.map((u) => u.minutes));
  for (const u of unitNodes)
    u.len = maxMinutes ? Math.round((u.minutes / maxMinutes) * 100) : 0;
  const tagCount = new Map<string, number>();
  for (const u of track.units)
    for (const t of u.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
  const topTags = [...tagCount]
    .sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0]))
    .slice(0, 4)
    .map(([t]) => t);
  return {
    name: track.name,
    topTags,
    total: track.units.length,
    rows,
    units: unitNodes,
    writtenCount: unitNodes.filter((n) => n.written).length,
    minutes: unitNodes.reduce((n, u) => n + u.minutes, 0),
    topics: unitNodes.reduce((n, u) => n + u.topics, 0),
    demos: unitNodes.filter((u) => u.demo).length,
  };
});

// Faint scenery behind each world's trail: its own icon and the icons of its
// most common tags, scattered down the margins. A number picks that rank in
// the world's top tags; "track" is the world's own icon.
const SCENE_SLOTS = [
  { x: "2%", y: "3%", s: "7rem", r: "-12deg" },
  { x: "85%", y: "8%", s: "5rem", r: "14deg" },
  { x: "90%", y: "30%", s: "6.5rem", r: "-8deg" },
  { x: "1%", y: "42%", s: "5.5rem", r: "10deg" },
  { x: "87%", y: "58%", s: "5rem", r: "-16deg" },
  { x: "3%", y: "74%", s: "6.5rem", r: "8deg" },
  { x: "82%", y: "88%", s: "7rem", r: "-10deg" },
];
const SCENE_PLAN: Array<"track" | number> = [
  "track",
  0,
  "track",
  1,
  2,
  "track",
  3,
];

const fmtDuration = (min: number) =>
  min >= 90 ? `${Math.round(min / 60)} h` : `${min} min`;

// One hue per world, spread by the golden angle so neighbours in the rail
// never land on similar colours. The CSS turns it into light/dark tokens.
const worldHue = (i: number) => Math.round((i * 137.508 + 205) % 360);
const totalWritten = writtenUnits.length;
const totalUnits = worlds.reduce((n, w) => n + w.total, 0);

const regions = REGIONS.map((r) => ({
  ...r,
  worlds: worlds.filter((w) => r.tracks.includes(w.name)),
}));
const unplaced = worlds.filter(
  (w) => !REGIONS.some((r) => r.tracks.includes(w.name)),
);
if (unplaced.length > 0)
  regions.push({
    id: "frontier",
    title: "The Frontier",
    tagline: "Newer worlds, still being charted.",
    tracks: [],
    worlds: unplaced,
  });
const regionOf = (name: string) =>
  regions.find((r) => r.worlds.some((w) => w.name === name))?.id ?? "frontier";
---

<Layout title="Roadmap" wide>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1
        class="text-5xl font-extrabold tracking-tight sm:text-6xl"
        style="letter-spacing: -0.02em; line-height: 1.05"
      >
        Roadmap
      </h1>
      <p class="mt-3 text-lg text-slate-500 dark:text-slate-400">
        Finish a unit to unlock the next one. Every world starts at unit 1.
      </p>
    </div>
    <span
      data-done-pill
      class="inline-flex items-center rounded-full px-4 py-2 text-sm font-extrabold"
      style="background: #d1fae5; color: #065f46"
    >
      0 of {totalWritten} done
    </span>
  </div>

  <!-- Filter bar: dims what doesn't match instead of removing it, so the
       shape of the path never changes under the reader's hands. -->
  <div class="mt-7 flex flex-wrap items-center gap-3">
    <div class="game-btn relative min-w-[220px] flex-1 !p-0">
      <Search
        class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-slate-400"
        aria-hidden="true"
      />
      <input
        type="search"
        data-roadmap-search
        aria-label="Search units"
        placeholder='Search units, e.g. "rebase"'
        class="h-12 w-full rounded-[12px] bg-transparent pr-4 pl-12 text-[15px] font-semibold outline-none placeholder:text-slate-400"
      />
    </div>

    <div class="relative">
      <button
        type="button"
        data-filter-trigger="tags"
        aria-expanded="false"
        class="game-btn"
      >
        Tags
        <span
          data-filter-count="tags"
          class="hidden rounded-full px-1.5 text-xs font-bold text-white"
          style="background: var(--gauge-accent)"></span>
        <ChevronDown class="h-4 w-4" aria-hidden="true" />
      </button>
      <div
        data-filter-panel="tags"
        class="game-panel absolute top-full left-0 z-20 mt-3 hidden w-80 max-w-[calc(100vw-2rem)]"
      >
        <input
          type="search"
          data-tag-search
          aria-label="Search tags"
          placeholder='Search tags, e.g. "caching"'
          class="w-full rounded-lg border-2 border-slate-200 bg-transparent px-3 py-2 text-sm font-semibold outline-none focus:border-slate-900 dark:border-slate-700 dark:focus:border-slate-100"
        />
        <div class="mt-3 flex max-h-64 flex-wrap gap-1.5 overflow-y-auto">
          {
            ALL_TAGS.map((tag) => (
              <button
                type="button"
                data-tag-chip={tag}
                aria-pressed="false"
                class="rounded-full bg-slate-500/10 px-2.5 py-1 text-xs font-semibold text-slate-600 transition hover:bg-slate-500/20 aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:text-slate-300"
              >
                {tag}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="relative">
      <button
        type="button"
        data-filter-trigger="status"
        aria-expanded="false"
        class="game-btn"
      >
        Status
        <span
          data-filter-count="status"
          class="hidden rounded-full px-1.5 text-xs font-bold text-white"
          style="background: var(--gauge-accent)"></span>
        <ChevronDown class="h-4 w-4" aria-hidden="true" />
      </button>
      <div
        data-filter-panel="status"
        class="game-panel absolute top-full left-0 z-20 mt-3 hidden w-56"
      >
        <div class="flex flex-col gap-2">
          {
            STATUS_FILTERS.map((s) => (
              <button
                type="button"
                data-status-chip={s.key}
                aria-pressed="false"
                class="rounded-lg border-2 border-slate-200 px-3.5 py-2.5 text-left text-sm font-bold transition hover:border-slate-400 aria-pressed:border-[var(--gauge-accent)] aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:border-slate-700"
              >
                {s.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <button
      type="button"
      data-clear-filters
      class="hidden items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-bold"
      style="color: var(--accent-text); border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
    >
      <RotateCcw class="h-3.5 w-3.5" aria-hidden="true" />
      Reset
    </button>
  </div>
  <div
    data-active-chips
    class="mt-3 hidden flex-wrap items-center gap-2"
    aria-label="Active filters"
  >
  </div>
  <p
    data-match-summary
    class="mt-3 hidden text-sm font-medium text-slate-500 dark:text-slate-400"
  >
  </p>

  <p
    data-empty-state
    class="mt-6 hidden text-center text-sm text-slate-500 dark:text-slate-400"
  >
    No units match these filters.
  </p>

  <!-- Arrowhead markers for the world illustrations. Each TrackIllustration
       defines its own, but those sit inside hidden world panels, where some
       browsers won't resolve url(#id); this copy is always rendered. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <marker
        id="arrow-accent"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path d="M0 0l6 4-6 4" stroke="context-stroke" fill="none"></path>
      </marker>
      <marker
        id="arrow-dim"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path
          d="M0 0l6 4-6 4"
          stroke="context-stroke"
          stroke-opacity="0.5"
          fill="none"></path>
      </marker>
    </defs>
  </svg>

  <!-- Overview: global progress, a stacked bar of every unit by state, and one
       "island" per world with a dot per unit. Filled in by the client script. -->
  <!-- Step 1: the map. A sea with clouds and waves, three regions of
       illustrated islands, and the global progress on top. Choosing an island
       opens that world's trail in the modal below. -->
  <section class="stage mt-6" aria-label="World map">
    <div class="sea-deco" aria-hidden="true">
      <svg class="cloud cloud-1" viewBox="0 0 80 32" fill="currentColor">
        <circle cx="24" cy="20" r="10"></circle><circle cx="38" cy="14" r="13"
        ></circle><circle cx="54" cy="19" r="11"></circle><rect
          x="14"
          y="20"
          width="50"
          height="10"
          rx="5"></rect>
      </svg>
      <svg class="cloud cloud-2" viewBox="0 0 80 32" fill="currentColor">
        <circle cx="24" cy="20" r="10"></circle><circle cx="38" cy="14" r="13"
        ></circle><circle cx="54" cy="19" r="11"></circle><rect
          x="14"
          y="20"
          width="50"
          height="10"
          rx="5"></rect>
      </svg>
      <svg class="cloud cloud-3" viewBox="0 0 80 32" fill="currentColor">
        <circle cx="24" cy="20" r="10"></circle><circle cx="38" cy="14" r="13"
        ></circle><circle cx="54" cy="19" r="11"></circle><rect
          x="14"
          y="20"
          width="50"
          height="10"
          rx="5"></rect>
      </svg>
      <svg
        class="compass"
        viewBox="0 0 100 100"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      >
        <circle cx="50" cy="50" r="44"></circle><circle
          cx="50"
          cy="50"
          r="35"
          stroke-dasharray="2 4"></circle>
        <path d="M50 6l8 36 36 8-36 8-8 36-8-36-36-8 36-8z"></path>
        <path d="M50 6v88M6 50h88" opacity="0.4"></path>
      </svg>
      <svg class="waves" width="100%" height="64" fill="none">
        <defs>
          <pattern
            id="wave-pat"
            width="80"
            height="22"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M0 11q10-9 20 0t20 0t20 0t20 0"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </pattern>
        </defs>
        <rect width="100%" height="64" fill="url(#wave-pat)"></rect>
      </svg>
    </div>

    <div data-islands class="stage-inner">
      <div class="stats game-panel">
        <div class="ring-wrap">
          <svg
            viewBox="0 0 100 100"
            class="h-full w-full -rotate-90"
            aria-hidden="true"
          >
            <circle
              cx="50"
              cy="50"
              r="42"
              fill="none"
              stroke-width="12"
              class="ring-track"></circle>
            <circle
              data-ov-ring
              cx="50"
              cy="50"
              r="42"
              fill="none"
              stroke-width="12"
              stroke-linecap="round"
              stroke-dasharray="0 263.9"
              class="ring-fill"></circle>
          </svg>
          <span data-ov-pct class="ring-pct">0%</span>
        </div>
        <div class="min-w-0 flex-1 basis-64">
          <p class="text-lg font-extrabold">
            <span data-ov-done>0</span> of {totalWritten} written units done
          </p>
          <div
            data-ov-stack
            role="img"
            aria-label="Units by state"
            class="stack mt-3"
          >
            <span data-seg="done" class="seg seg-done" style="width: 0%"></span>
            <span data-seg="next" class="seg seg-next" style="width: 0%"></span>
            <span
              data-seg="locked"
              class="seg seg-locked"
              style={`width: ${(totalWritten / totalUnits) * 100}%`}></span>
            <span
              data-seg="planned"
              class="seg seg-planned"
              style={`width: ${((totalUnits - totalWritten) / totalUnits) * 100}%`}
            ></span>
          </div>
          <ul class="legend mt-3">
            <li>
              <i class="sw sw-done"></i>Done <b data-ov-count="done">0</b>
            </li>
            <li>
              <i class="sw sw-next"></i>Up next <b data-ov-count="next">0</b>
            </li>
            <li>
              <i class="sw sw-locked"></i>Locked <b data-ov-count="locked"
                >{totalWritten}</b
              >
            </li>
            <li>
              <i class="sw sw-planned"></i>Planned <b data-ov-count="planned"
                >{totalUnits - totalWritten}</b
              >
            </li>
          </ul>
        </div>
      </div>

      {
        regions.map((r) => (
          <section
            class="region"
            data-region={r.id}
            aria-labelledby={`region-${r.id}`}
          >
            <svg
              class="region-deco"
              viewBox="0 0 240 140"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {r.id === "workshop" && (
                <>
                  <circle cx="190" cy="50" r="22" />
                  <circle cx="190" cy="50" r="8" />
                  <circle
                    cx="190"
                    cy="50"
                    r="30"
                    stroke-width="9"
                    stroke-dasharray="6.5 5.9"
                    opacity="0.6"
                  />
                  <circle cx="138" cy="94" r="13" />
                  <circle cx="138" cy="94" r="4.5" />
                  <circle
                    cx="138"
                    cy="94"
                    r="18.5"
                    stroke-width="6"
                    stroke-dasharray="4.5 4.2"
                    opacity="0.6"
                  />
                  <path d="M92 30l22 22M88 34l8-8M108 56l8-8" />
                  <circle cx="224" cy="112" r="7" />
