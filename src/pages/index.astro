---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import {
  Search,
  ArrowRight,
  ArrowLeft,
  Sparkles,
  Shuffle,
  BookOpen,
  Flame,
  Layers,
  Rocket,
  History,
  Lightbulb,
  RotateCcw,
} from "lucide-astro";
import { roadmap, getUnit } from "../data/roadmap";
import { getWrittenUnits } from "../lib/curriculum";
import { groupSlugsByTrack } from "../lib/progress-gauges";
import { TRACK_CATEGORIES, CATEGORY_LABELS } from "../lib/track-categories";

const writtenUnits = await getWrittenUnits();
const writtenByTrack = new Map<string, number>();
const writtenSlugsByTrack = new Map<string, Set<string>>();
for (const u of writtenUnits) {
  writtenByTrack.set(u.track, (writtenByTrack.get(u.track) ?? 0) + 1);
  if (!writtenSlugsByTrack.has(u.track))
    writtenSlugsByTrack.set(u.track, new Set());
  writtenSlugsByTrack.get(u.track)!.add(u.unitSlug);
}

// Embedded for the client-side gauge script (see the bottom script block) —
// the pool of slugs a reader could have marked done, per track.
const trackUnitSlugs = groupSlugsByTrack(writtenUnits);

const totalUnits = roadmap.tracks.reduce((n, t) => n + t.units.length, 0);
const totalWritten = writtenUnits.length;
const tracksStarted = roadmap.tracks.filter(
  (t) => (writtenByTrack.get(t.name) ?? 0) > 0,
).length;

const GAUGE_RADIUS = 16;
const GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;

// Client-side "continue learning" needs to resolve a bare track/slug key
// (pStorage's progress:<track>/<slug>, scoped to the active profile) back
// to a title + href — embed the minimal lookup table it needs rather than
// shipping the whole roadmap.
const unitLookup = roadmap.tracks.flatMap((t) =>
  t.units
    .filter((u) => writtenSlugsByTrack.get(t.name)?.has(u.slug))
    .map((u) => ({
      track: t.name,
      slug: u.slug,
      problem: u.problem,
    })),
);

// Per-track, in roadmap order, written units only — lets the "continue
// where you left off" carousel find what comes right after the reader's
// current unit without ever linking to a merely-planned page.
const trackSequences = Object.fromEntries(
  roadmap.tracks.map((t) => [
    t.name,
    t.units
      .filter((u) => writtenSlugsByTrack.get(t.name)?.has(u.slug))
      .map((u) => ({ slug: u.slug, problem: u.problem })),
  ]),
);

// "Surprise me" picks uniformly from every written unit — a flat href list
// is all the client needs.
const writtenUnitHrefs = writtenUnits.map((u) => `/${u.track}/${u.unitSlug}/`);

// "Try a real question" pool — one representative level-1 quiz item per
// written unit (favoring L1 since it's the most accessible without having
// read the unit first), tagged with that unit's roadmap tags so the
// client-side script can prefer questions matching the active profile's
// interests. Picked randomly client-side on every load instead of always
// showing the same hardcoded HTTP-429 question.
const previewPool = writtenUnits
  .map((u) => {
    const quizL1 = u.exercises.find((e) => e.type === "quiz" && e.level === 1);
    if (!quizL1 || quizL1.type !== "quiz") return null;
    const roadmapUnit = getUnit(u.track, u.unitSlug);
    return {
      track: u.track,
      slug: u.unitSlug,
      problem: roadmapUnit?.problem ?? "",
      prompt: quizL1.prompt,
      choices: quizL1.choices,
      correctIndex: quizL1.correctIndex,
      tags: roadmapUnit?.tags ?? [],
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

// Fixed pick for brand-new readers with no progress yet: the most
// foundational problem on the site, one most other web/ units assume you
// already feel. Shown in place of "continue learning" only when there's
// nothing yet to continue.
const STARTER_UNIT = {
  track: "web",
  slug: "http-request-response-basics",
  reason:
    "The most foundational problem on the site — most other web/ units assume you already feel this one.",
};
const starterProblem =
  getUnit(STARTER_UNIT.track, STARTER_UNIT.slug)?.problem ?? "";

// Per-track tag vocabulary, embedded as a data attribute below — lets the
// client-side personalization script (see the bottom script block) decide
// which track cards match the active profile's interests without shipping
// the whole roadmap again.
const trackTags = new Map<string, string[]>(
  roadmap.tracks.map((t) => [
    t.name,
    Array.from(new Set(t.units.flatMap((u) => u.tags))),
  ]),
);
---

<Layout title="Home" wide>
  <section class="relative overflow-hidden text-center sm:text-left">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-28 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full opacity-[0.15] blur-3xl sm:left-0 sm:h-80 sm:w-80 sm:translate-x-0"
      style="background: var(--accent)"
    >
    </div>
    <p
      class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
    >
      <Sparkles class="h-3.5 w-3.5" aria-hidden="true" />
      A self-study curriculum
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
      From junior to <span style="color: var(--accent-text)">staff-level</span>,
      one problem at a time.
    </h1>
    <p
      class="mt-4 max-w-2xl text-lg text-slate-600 sm:mx-0 dark:text-slate-400"
    >
      {roadmap.tracks.length} tracks, each a sequence of real problems to understand
      — not a pile of definitions. One unit per session, by design.
    </p>

    <section
      data-due-review
      class="mt-6 hidden animate-fade-slide-in rounded-xl border p-4 text-left"
      style="border-color: var(--gauge-warn); background: color-mix(in srgb, var(--gauge-warn) 10%, transparent)"
    >
      <p
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase"
        style="color: var(--gauge-warn)"
      >
        <RotateCcw class="h-3.5 w-3.5" aria-hidden="true" />
        <span data-due-review-heading>Due for review</span>
      </p>
      <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
        Spaced repetition works because you forget a little between visits —
        that's the point. A quick re-check now is what makes it stick.
      </p>
      <div data-carousel class="relative mt-3">
        <div
          data-carousel-track
          data-due-review-cards
          class="no-scrollbar flex gap-3 overflow-x-auto pb-1"
        >
        </div>
        <div
          data-carousel-fade-start
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 hidden w-12"
          style="background: linear-gradient(to right, color-mix(in srgb, var(--gauge-warn) 10%, transparent), transparent)"
        >
        </div>
        <div
          data-carousel-fade-end
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 hidden w-12"
          style="background: linear-gradient(to left, color-mix(in srgb, var(--gauge-warn) 10%, transparent), transparent)"
        >
        </div>
        <button
          type="button"
          data-carousel-prev
          aria-label="Show previous review cards"
          class="absolute top-1/2 left-0 hidden h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-white shadow"
          style="background: var(--gauge-warn)"
        >
          <ArrowLeft class="h-4 w-4" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Show more review cards"
          class="absolute top-1/2 right-0 hidden h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-white shadow"
          style="background: var(--gauge-warn)"
        >
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>
    </section>

    <section
      data-continue-learning
      class="mt-3 hidden animate-fade-slide-in rounded-xl border border-slate-200 bg-slate-50 p-4 text-left dark:border-slate-800 dark:bg-slate-900/50"
    >
      <p
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        <History class="h-3.5 w-3.5" aria-hidden="true" />
        Continue where you left off
      </p>
      <div data-continue-cards class="mt-3 flex gap-3 overflow-x-auto pb-1">
      </div>
    </section>

    <section
      data-starter-suggestion
      class="mt-6 hidden animate-fade-slide-in rounded-xl border p-5 text-left"
      style="border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
    >
      <p
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase"
        style="color: var(--accent-text)"
      >
        <Rocket class="h-3.5 w-3.5" aria-hidden="true" />
        New here? Start with this one
      </p>
      <p class="mt-2 font-medium text-slate-900 dark:text-slate-100">
        {starterProblem}
      </p>
      <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
        {STARTER_UNIT.reason}
      </p>
      <a
        href={`/${STARTER_UNIT.track}/${STARTER_UNIT.slug}/`}
        class="mt-3 inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold text-white transition hover:brightness-95"
        style="background: var(--accent-text)"
      >
        Start with the first problem
        <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
      </a>
    </section>

    <form
      action="/roadmap"
      method="get"
      class="mt-6 flex max-w-xl items-center gap-2 sm:mx-0"
    >
      <div class="relative flex-1">
        <Search
          class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        />
        <input
          type="search"
          name="search"
          list="search-suggestions"
          placeholder='Search topics — e.g. "debugging", "merge conflicts", "feedback"...'
          class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pr-3 pl-9 text-sm text-slate-900 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
        />
        <datalist id="search-suggestions">
          {roadmap.tracks.map((t) => <option value={t.name} />)}
          {unitLookup.map((u) => <option value={u.problem} />)}
        </datalist>
      </div>
      <button
        type="submit"
        class="shrink-0 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
      >
        Search
      </button>
      <button
        type="button"
        data-surprise-me
        title="Open a random written unit"
        class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
      >
        <Shuffle class="h-4 w-4" aria-hidden="true" />
        <span class="hidden sm:inline">Surprise me</span>
      </button>
    </form>

    <div
      data-content-preview
      class="relative mt-6 max-w-xl overflow-hidden rounded-xl border border-slate-200 bg-white p-4 text-left shadow-sm sm:mx-0 dark:border-slate-800 dark:bg-slate-900/50"
    >
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-1"
        style="background: var(--accent)"
      >
      </div>
      <p
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        <span
          class="flex h-5 w-5 items-center justify-center rounded-full"
          style="background: var(--accent-soft-bg); color: var(--accent-text)"
        >
          <Lightbulb class="h-3 w-3" aria-hidden="true" />
        </span>
        Try a real question
      </p>
      <p
        data-preview-prompt
        class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100"
      >
        What does an HTTP 429 response mean?
      </p>
      <div data-preview-choices class="mt-3 grid gap-2">
        <button
          type="button"
          data-preview-choice
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          A server-side error — try again later
        </button>
        <button
          type="button"
          data-preview-choice
          data-correct="true"
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          Too many requests — the client should back off
        </button>
        <button
          type="button"
          data-preview-choice
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          The resource moved permanently
        </button>
      </div>
      <a
        data-preview-followup
        href="/web/http-request-response-basics/"
        class="mt-3 hidden items-center gap-1 text-sm font-medium hover:underline"
        style="color: var(--accent-text)"
      >
        <span data-preview-followup-text
          >See the full breakdown in web/http-request-response-basics</span
        >
        <ArrowRight class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
      </a>
    </div>

    <div data-stats-strip class="mt-8 hidden flex-col gap-3 sm:max-w-2xl">
      <!-- Content totals: what's written, not what the reader has done —
           kept quiet and separate from "Your progress" below so the two
           never read as contradicting each other. -->
      <div
        class="flex items-center gap-2 rounded-lg border border-dashed border-slate-300 px-3 py-2 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-500"
      >
        <BookOpen class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        <span>
          Full curriculum live — <span class="tabular-nums"
            >{totalWritten}/{totalUnits}</span
          > units ·
          <span class="tabular-nums"
            >{tracksStarted}/{roadmap.tracks.length}</span
          > tracks ·
          <span class="tabular-nums"
            >{Math.round((totalWritten / totalUnits) * 100)}%</span
          > of the roadmap
        </span>
      </div>

      <div
        data-streak-gauge
        class="rounded-lg border border-slate-200 bg-white p-3 sm:max-w-xs dark:border-slate-800 dark:bg-slate-900/50"
      >
        <div data-streak-active>
          <div
            data-streak-icon-row
            class="flex items-center gap-1.5 text-slate-400 dark:text-slate-600"
          >
            <Flame class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
            <span class="text-[10px] font-semibold tracking-wide uppercase"
              >Streak</span
            >
          </div>
          <p data-streak-label class="mt-1 text-xl font-bold tabular-nums">
            0 days
          </p>
          <div
            data-streak-strip
            class="mt-1.5 flex items-center gap-1"
            aria-hidden="true"
          >
            {
              Array.from({ length: 7 }).map(() => (
                <span
                  data-day-dot
                  class="h-1.5 w-1.5 rounded-full bg-slate-200 dark:bg-slate-700"
                />
              ))
            }
          </div>
        </div>
        <div data-streak-invite class="hidden items-center gap-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
            style="background: color-mix(in srgb, var(--gauge-warn) 15%, transparent)"
          >
            <Flame
              class="h-4 w-4"
              style="color: var(--gauge-warn)"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
              Start your streak today
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-500">
              Finish one unit to light it up.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <p
    data-interest-notice
    class="mt-10 hidden text-xs text-slate-500 dark:text-slate-500"
  >
    Showing tracks that match your interests. See the
    <a
      href="/roadmap"
      class="underline hover:text-slate-900 dark:hover:text-slate-100"
      >full roadmap</a
    >
    for everything, or update your interests from the profile menu.
  </p>

  <section
    class="mt-10 animate-fade-slide-in rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/50"
  >
    <p
      class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
    >
      Your journey
    </p>
    <div class="relative mt-3 mb-1.5">
      <div
        class="h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"
      >
        <div
          data-journey-fill
          class="h-full rounded-full transition-[width] duration-700"
          style="width: 0%; background: var(--gauge-accent)"
        >
        </div>
      </div>
      <div
        data-journey-marker
        class="absolute top-1/2 transition-[left] duration-700"
        style="left: 0%; transform: translate(-50%, -50%)"
      >
        <span
          class="block h-4 w-4 rounded-full border-2 border-white shadow dark:border-slate-950"
          style="background: var(--gauge-accent)"></span>
      </div>
    </div>
    <div
      class="flex justify-between text-[10px] font-semibold tracking-wide text-slate-400 uppercase dark:text-slate-600"
    >
      <span>Junior</span>
      <span>Mid</span>
      <span>Senior</span>
      <span>Staff-level</span>
    </div>
    <p
      data-journey-note
      class="mt-2 text-xs font-medium text-slate-600 dark:text-slate-400"
    >
      Just getting started.
    </p>

    <div
      class="mt-5 flex flex-wrap items-center gap-6 border-t border-slate-200 pt-4 dark:border-slate-800"
    >
      <div class="flex items-center gap-3.5">
        <span
          class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full"
          style="background: var(--accent-soft-bg)"
        >
          <svg width="56" height="56" viewBox="0 0 40 40" aria-hidden="true">
            <circle
              cx="20"
              cy="20"
              r={GAUGE_RADIUS}
              fill="none"
              stroke-width="4"
              class="stroke-slate-200 dark:stroke-slate-800"></circle>
            <circle
              data-overall-arc
              cx="20"
              cy="20"
              r={GAUGE_RADIUS}
              fill="none"
              stroke-width="4"
              stroke-linecap="round"
              stroke-dasharray={GAUGE_CIRCUMFERENCE}
              stroke-dashoffset={GAUGE_CIRCUMFERENCE}
              transform="rotate(-90 20 20)"
              class="transition-[stroke-dashoffset] duration-500"
              style="stroke: var(--gauge-accent)"></circle>
          </svg>
        </span>
        <div>
          <p
            class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
          >
            Your progress
          </p>
          <p
            data-overall-label
            class="text-base font-semibold text-slate-900 dark:text-slate-100"
          >
            Nothing done yet
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-10 flex items-baseline justify-between gap-3">
    <h2
      class="inline-flex items-center gap-1.5 text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
    >
      <Layers class="h-3.5 w-3.5" aria-hidden="true" />
      Explore all tracks
    </h2>
    <a
      href="/roadmap"
      class="text-xs font-medium hover:underline"
      style="color: var(--accent-text)"
    >
      Filter the full roadmap →
    </a>
  </div>

  <div data-category-filters class="mt-3 flex flex-wrap gap-1.5">
    <button
      type="button"
      data-category-chip="all"
      aria-pressed="true"
      class="rounded-full bg-slate-500/10 px-3 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-500/15 aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:text-slate-300"
    >
      All {roadmap.tracks.length}
    </button>
    {
      Object.entries(CATEGORY_LABELS).map(([key, label]) => (
        <button
          type="button"
          data-category-chip={key}
          aria-pressed="false"
          class="rounded-full bg-slate-500/10 px-3 py-1 text-xs font-medium text-slate-600 transition hover:bg-slate-500/15 aria-pressed:bg-[var(--gauge-accent)] aria-pressed:text-white dark:text-slate-300"
        >
          {label}
        </button>
      ))
    }
  </div>

  <!-- Game-style track selector: one circular node per track (icon + a
       progress ring + a small done-count badge, the same shape as the
       gamepad nav icon's run-count badge) instead of 18 illustrated cards.
       The whole node is the link, same destination as the old card
       (`/${track}/`) — lighter to scan, same interaction underneath. -->
  <div data-track-grid class="mt-4 flex flex-wrap gap-x-5 gap-y-6">
    {
      roadmap.tracks.map((track, i) => {
        const written = writtenByTrack.get(track.name) ?? 0;
        return (
          <a
            href={`/${track.name}/`}
            data-track-card
            data-track={track.name}
            data-tags={(trackTags.get(track.name) ?? []).join(" ")}
            data-category={TRACK_CATEGORIES[track.name] ?? ""}
            data-gauge-track={track.name}
            data-gauge-total={written}
            title={`${track.name} — ${written} unit${written === 1 ? "" : "s"} written`}
            style={`animation-delay: ${Math.min(i, 10) * 30}ms`}
            class="animate-fade-slide-in group flex w-20 flex-col items-center gap-2 text-center"
          >
            <span class="relative block h-16 w-16 shrink-0">
              <svg
                width="64"
                height="64"
                viewBox="0 0 40 40"
                class="absolute inset-0 -rotate-90"
                aria-hidden="true"
              >
                <circle
                  cx="20"
                  cy="20"
                  r={GAUGE_RADIUS}
                  fill="none"
                  stroke-width="3"
                  class="stroke-slate-200 dark:stroke-slate-800"
                />
                <circle
                  data-gauge-arc
                  cx="20"
                  cy="20"
                  r={GAUGE_RADIUS}
                  fill="none"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-dasharray={GAUGE_CIRCUMFERENCE}
                  stroke-dashoffset={GAUGE_CIRCUMFERENCE}
                  class="transition-[stroke-dashoffset] duration-500"
                  style="stroke: var(--gauge-accent)"
                />
              </svg>
              <span
                data-node-icon
                class="absolute inset-[6px] flex items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-[opacity,filter,background-color,color] duration-300 group-hover:bg-slate-900 group-hover:text-white dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-slate-100 dark:group-hover:text-slate-900"
              >
                <TrackIcon track={track.name} class="h-6 w-6" />
              </span>
              <span
                data-node-count
                class="pointer-events-none absolute -top-0.5 -right-0.5 hidden h-5 w-5 items-center justify-center rounded-full text-[10px] font-bold text-white ring-2 ring-white dark:ring-slate-950"
                style="background: var(--gauge-accent)"
              />
              <span
                data-interest-badge
                title="Matches your interests"
                class="pointer-events-none absolute -bottom-0.5 -left-0.5 hidden h-5 w-5 items-center justify-center rounded-full bg-slate-900 text-white ring-2 ring-white dark:bg-slate-100 dark:text-slate-900 dark:ring-slate-950"
              >
                <Sparkles class="h-2.5 w-2.5" aria-hidden="true" />
              </span>
            </span>
            <span class="max-w-full truncate text-xs font-medium text-slate-600 transition group-hover:text-slate-900 dark:text-slate-400 dark:group-hover:text-slate-100">
              {track.name}
            </span>
          </a>
        );
      })
    }
  </div>

  <script
    type="application/json"
    id="unit-lookup"
    set:html={JSON.stringify(unitLookup)}
  />
  <script
    type="application/json"
    id="track-sequences"
    set:html={JSON.stringify(trackSequences)}
  />
  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />
  <script
    type="application/json"
    id="written-unit-hrefs"
    set:html={JSON.stringify(writtenUnitHrefs)}
  />
  <script
    type="application/json"
    id="preview-questions-pool"
    set:html={JSON.stringify(previewPool)}
  />

  <script>
    import { pStorage, getActiveProfile } from "../lib/profile";
    import {
      applyTrackGauges,
      countTotalDone,
      countDoneByTrack,
      computeStreak,
      isDayActive,
      getDueUnits,
      GAUGE_CIRCUMFERENCE,
    } from "../lib/progress-gauges";

    interface ProgressState {
      done: boolean;
      doneAt?: number;
      nextReviewAt?: number;
      stage: number;
    }
    interface UnitRef {
      track: string;
      slug: string;
      problem: string;
    }
    interface SequenceUnit {
      slug: string;
      problem: string;
    }

    function buildContinueCard(
      problem: string,
      href: string,
      eyebrow: string,
      highlighted: boolean,
    ): HTMLAnchorElement {
      const a = document.createElement("a");
      a.href = href;
      a.className = highlighted
        ? "group flex w-56 shrink-0 flex-col rounded-lg border p-3 transition hover:brightness-95"
        : "group flex w-56 shrink-0 flex-col rounded-lg border border-slate-200 p-3 transition hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600";
      if (highlighted) {
        a.style.borderColor = "var(--accent-soft-border)";
        a.style.background = "var(--accent-soft-bg)";
      }
      const eyebrowEl = document.createElement("span");
      eyebrowEl.className =
        "text-[10px] font-semibold tracking-wide uppercase text-slate-500 dark:text-slate-500";
      eyebrowEl.textContent = eyebrow;
      const titleEl = document.createElement("span");
      titleEl.className =
        "mt-1 text-sm font-medium text-slate-900 group-hover:underline dark:text-slate-100";
      titleEl.textContent = problem;
      a.append(eyebrowEl, titleEl);
      return a;
    }

    function initContinueLearning() {
      const continueSection = document.querySelector<HTMLElement>(
        "[data-continue-learning]",
      );
      const cardsHost = document.querySelector<HTMLElement>(
        "[data-continue-cards]",
      );
      const starterSection = document.querySelector<HTMLElement>(
        "[data-starter-suggestion]",
      );
      const lookupEl = document.getElementById("unit-lookup");
      const sequencesEl = document.getElementById("track-sequences");
      if (!continueSection || !cardsHost || !starterSection || !lookupEl)
        return;
      if (continueSection.dataset.wired === "true") return;
      continueSection.dataset.wired = "true";

      let lookup: UnitRef[];
      try {
        lookup = JSON.parse(lookupEl.textContent || "[]");
      } catch {
        return;
      }
      const byKey = new Map(lookup.map((u) => [`${u.track}/${u.slug}`, u]));

      let sequences: Record<string, SequenceUnit[]> = {};
      try {
        sequences = JSON.parse(sequencesEl?.textContent || "{}");
      } catch {
        // Malformed embed — fall back to no sequence data.
      }

      // Prefer the most recently touched unit that isn't currently marked
      // done — either never finished, or a spaced-repetition reset just
      // cleared it (see spaced-repetition.ts) — that's the one worth
      // resurfacing. Falls back to the most recently completed unit.
      let bestNotDone: { key: string; at: number } | null = null;
      let bestDone: { key: string; at: number } | null = null;

      for (const key of pStorage.keys()) {
        if (!key.startsWith("progress:")) continue;
        const unitKey = key.slice("progress:".length);
        if (!byKey.has(unitKey)) continue;
        let state: ProgressState;
        try {
          state = JSON.parse(pStorage.getItem(key) || "{}");
        } catch {
          continue;
        }
        const at = state.doneAt ?? 0;
        if (state.done) {
          if (!bestDone || at > bestDone.at) bestDone = { key: unitKey, at };
        } else {
          if (!bestNotDone || at > bestNotDone.at)
            bestNotDone = { key: unitKey, at };
        }
      }

      const pick = bestNotDone ?? bestDone;
      if (!pick) {
        // Nothing to continue yet — invite a brand-new reader to a fixed
        // starting point instead.
        starterSection.classList.remove("hidden");
        return;
      }
      const unit = byKey.get(pick.key);
      if (!unit) {
        starterSection.classList.remove("hidden");
        return;
      }

      cardsHost.innerHTML = "";
      cardsHost.appendChild(
        buildContinueCard(
          unit.problem,
          `/${unit.track}/${unit.slug}/`,
          "Continue",
          true,
        ),
      );
      const seq = sequences[unit.track] ?? [];
      const idx = seq.findIndex((u) => u.slug === unit.slug);
      if (idx >= 0) {
        const labels = ["Next", "Then"];
        for (let i = 0; i < 2; i++) {
          const next = seq[idx + 1 + i];
          if (!next) break;
          cardsHost.appendChild(
            buildContinueCard(
              next.problem,
              `/${unit.track}/${next.slug}/`,
              labels[i],
              false,
            ),
          );
        }
      }

      continueSection.classList.remove("hidden");
    }

    initContinueLearning();
    document.addEventListener("astro:page-load", initContinueLearning);

    // The tagline promises a path ("junior to staff-level"), not a pile —
    // this projects the exact same done/total fraction the ring already
    // uses onto that path instead of a bare percentage, so "46%" reads as
    // a position on the journey the headline already described.
    const JOURNEY_STAGES: { at: number; note: string }[] = [
      { at: 0, note: "Just getting started." },
      { at: 0.25, note: "Early — building the fundamentals." },
      { at: 0.5, note: "Solid mid-range progress." },
      {
        at: 0.85,
        note: "Deep into the range where most of the skill-building happens.",
      },
      { at: 1.01, note: "Closing in on staff-level breadth." },
    ];
    function renderJourney(fraction: number) {
      const fill = document.querySelector<HTMLElement>("[data-journey-fill]");
      const marker = document.querySelector<HTMLElement>(
        "[data-journey-marker]",
      );
      const note = document.querySelector<HTMLElement>("[data-journey-note]");
      const pct = Math.round(fraction * 100);
      if (fill) fill.style.width = `${pct}%`;
      if (marker) {
        // Clamped so the marker dot never overflows outside the bar at
        // either end, even at exactly 0% or 100%.
        marker.style.left = `${Math.min(98, Math.max(2, pct))}%`;
      }
      if (note) {
        let text = JOURNEY_STAGES[0].note;
        for (const stage of JOURNEY_STAGES) {
          if (fraction >= stage.at) text = stage.note;
        }
        note.textContent = text;
      }
    }

    // Each node's ring (data-gauge-track/data-gauge-arc) is already filled
    // in by applyTrackGauges above — this adds the two things that gauge
    // pass doesn't: the small done-count badge (hidden at 0, same shape as
    // the gamepad nav icon's run-count badge) and muting the icon itself
    // for a track the reader hasn't touched, so the one real signal
    // (progress) doesn't compete for attention with 17 identical nodes.
    function applyTrackCardWeight(trackUnits: Record<string, string[]>) {
      const counts = countDoneByTrack(trackUnits);
      document
        .querySelectorAll<HTMLElement>("[data-track-card]")
        .forEach((card) => {
          const track = card.dataset.track;
          if (!track) return;
          const done = counts[track] ?? 0;
          const started = done > 0;
          const countBadge =
            card.querySelector<HTMLElement>("[data-node-count]");
          if (countBadge) countBadge.textContent = String(done);
          countBadge?.classList.toggle("hidden", !started);
          countBadge?.classList.toggle("flex", started);
          const icon = card.querySelector<HTMLElement>("[data-node-icon]");
          icon?.classList.toggle("opacity-50", !started);
          icon?.classList.toggle("saturate-50", !started);
        });
    }

    function initTrackGauges() {
      const el = document.getElementById("track-unit-slugs");
      if (!el) return;
      let map: Record<string, string[]>;
      try {
        map = JSON.parse(el.textContent || "{}");
      } catch {
        return;
      }
      applyTrackGauges(map);
      applyTrackCardWeight(map);

      const totalWritten = Object.values(map).reduce(
        (n, arr) => n + arr.length,
        0,
      );
      const done = countTotalDone(map);
      const fraction = totalWritten > 0 ? done / totalWritten : 0;
      const overallArc =
        document.querySelector<SVGCircleElement>("[data-overall-arc]");
      const overallLabel = document.querySelector<HTMLElement>(
        "[data-overall-label]",
      );
      if (overallArc) {
        overallArc.style.strokeDashoffset = String(
          GAUGE_CIRCUMFERENCE * (1 - fraction),
        );
      }
      if (overallLabel) {
        overallLabel.textContent =
          totalWritten > 0
            ? `${done}/${totalWritten} done (${Math.round(fraction * 100)}%)`
            : "Nothing written yet";
      }

      // A brand-new profile sees zero everywhere on this strip before
      // they've read a single unit — that's honest but not a reason to
      // stay. Hide it until there's a real number to show; the hero's
      // starter-suggestion CTA carries the "why stay" job instead.
      const statsStrip =
        document.querySelector<HTMLElement>("[data-stats-strip]");
      if (statsStrip) {
        statsStrip.classList.toggle("hidden", done === 0);
        statsStrip.classList.toggle("flex", done > 0);
      }

      renderJourney(fraction);
      renderStreak();
    }
    initTrackGauges();
    document.addEventListener("astro:page-load", initTrackGauges);

    // Real day-over-day continuity, not a weekly quota — a streak is what
    // actually makes someone open the app again tomorrow instead of
    // "sometime this week." See lib/progress-gauges.ts's computeStreak for
    // how this is derived from existing progress records (no new storage).
    function renderStreak() {
      const streakActive = document.querySelector<HTMLElement>(
        "[data-streak-active]",
      );
      const streakInvite = document.querySelector<HTMLElement>(
        "[data-streak-invite]",
      );
      const streakLabel = document.querySelector<HTMLElement>(
        "[data-streak-label]",
      );
      const streakIconRow = document.querySelector<HTMLElement>(
        "[data-streak-icon-row]",
      );
      const dayDots = document.querySelectorAll<HTMLElement>(
        "[data-streak-strip] [data-day-dot]",
      );
      const { current, longest, activeToday } = computeStreak();

      // A "0 days" streak with seven empty dots reads as a failure state on
      // a reader's very first visit — swap it for an invitation instead of
      // showing an empty chart. Only once a real streak exists does the
      // dots view (which can show it slipping) earn its place.
      streakActive?.classList.toggle("hidden", current === 0);
      streakInvite?.classList.toggle("hidden", current > 0);
      streakInvite?.classList.toggle("flex", current === 0);
      if (current === 0) return;

      if (streakLabel) {
        streakLabel.textContent = current === 1 ? "1 day" : `${current} days`;
        streakLabel.title = activeToday
          ? `${current}-day streak — you're in today. Best: ${longest}.`
          : current > 0
            ? `${current}-day streak — do one unit today to keep it alive. Best: ${longest}.`
            : `No active streak yet. Best so far: ${longest}.`;
      }
      if (streakIconRow) {
        const lit = current > 0;
        streakIconRow.classList.toggle("text-orange-500", lit);
        streakIconRow.classList.toggle("dark:text-orange-400", lit);
        streakIconRow.classList.toggle("text-slate-400", !lit);
        streakIconRow.classList.toggle("dark:text-slate-600", !lit);
      }

      const DAY_MS = 24 * 60 * 60 * 1000;
      const today = Date.now();
      dayDots.forEach((dot, i) => {
        // Dots run oldest (6 days ago) to newest (today), left to right.
        const offsetFromToday = dayDots.length - 1 - i;
        const active = isDayActive(today - offsetFromToday * DAY_MS);
        dot.classList.toggle("bg-orange-400", active);
        dot.classList.toggle("dark:bg-orange-500", active);
        dot.classList.toggle("bg-slate-200", !active);
        dot.classList.toggle("dark:bg-slate-700", !active);
      });
    }

    interface DueUnit {
      track: string;
      slug: string;
      problem: string;
    }

    function buildDueCard(unit: DueUnit): HTMLAnchorElement {
      const a = document.createElement("a");
      a.href = `/${unit.track}/${unit.slug}/`;
      a.className =
        "group flex w-56 shrink-0 flex-col rounded-lg border p-3 transition hover:brightness-95";
      a.style.borderColor = "var(--gauge-warn)";
      a.style.background =
        "color-mix(in srgb, var(--gauge-warn) 8%, transparent)";
      const eyebrowEl = document.createElement("span");
      eyebrowEl.className = "text-[10px] font-semibold tracking-wide uppercase";
      eyebrowEl.style.color = "var(--gauge-warn)";
      eyebrowEl.textContent = "Review due";
      const titleEl = document.createElement("span");
      titleEl.className =
        "mt-1 text-sm font-medium text-slate-900 group-hover:underline dark:text-slate-100";
      titleEl.textContent = unit.problem;
      a.append(eyebrowEl, titleEl);
      return a;
    }

    // The only signal that a horizontally-scrolling card row holds more
    // than what's visible used to be a thin native scrollbar — easy to miss,
    // especially on mobile. Adds a right-edge fade plus a visible "next"
    // button, both of which disappear once there's nothing left to scroll to.
    function wireCarouselAffordance(root: HTMLElement) {
      const track = root.querySelector<HTMLElement>("[data-carousel-track]");
      const fadeStart = root.querySelector<HTMLElement>(
        "[data-carousel-fade-start]",
      );
      const fadeEnd = root.querySelector<HTMLElement>(
        "[data-carousel-fade-end]",
      );
      const prev = root.querySelector<HTMLButtonElement>(
        "[data-carousel-prev]",
      );
      const next = root.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );
      if (!track || !fadeStart || !fadeEnd || !prev || !next) return;

      // Symmetric in both directions — the first pass only ever showed a
      // forward arrow, so once a reader scrolled right there was no visible
      // way back except the (now-hidden) native scrollbar or a swipe gesture.
      function update() {
        if (!track) return;
        const overflows = track.scrollWidth > track.clientWidth + 4;
        const atStart = track.scrollLeft <= 4;
        const atEnd =
          track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        const showPrev = overflows && !atStart;
        const showNext = overflows && !atEnd;
        fadeStart?.classList.toggle("hidden", !showPrev);
        fadeEnd?.classList.toggle("hidden", !showNext);
        prev?.classList.toggle("hidden", !showPrev);
        prev?.classList.toggle("flex", showPrev);
        next?.classList.toggle("hidden", !showNext);
        next?.classList.toggle("flex", showNext);
      }
      prev.addEventListener("click", () => {
        track.scrollBy({
          left: -track.clientWidth * 0.8,
          behavior: "smooth",
        });
      });
      next.addEventListener("click", () => {
        track.scrollBy({ left: track.clientWidth * 0.8, behavior: "smooth" });
      });
      track.addEventListener("scroll", update);
      new ResizeObserver(update).observe(track);
      update();
    }

    // Spaced repetition already schedules re-exams (7/30/90 days after a
    // unit is marked done) — this is what actually surfaces that schedule
    // as a reason to open the app, instead of it silently waiting until
    // the reader happens to revisit that one unit's own page.
    function initDueReview() {
      const section = document.querySelector<HTMLElement>("[data-due-review]");
      const carousel = section?.querySelector<HTMLElement>("[data-carousel]");
      const cardsHost = document.querySelector<HTMLElement>(
        "[data-due-review-cards]",
      );
      const heading = document.querySelector<HTMLElement>(
        "[data-due-review-heading]",
      );
      const lookupEl = document.getElementById("unit-lookup");
      if (!section || !carousel || !cardsHost || !heading || !lookupEl) return;
      if (section.dataset.wired === "true") return;
      section.dataset.wired = "true";

      let lookup: DueUnit[];
      try {
        lookup = JSON.parse(lookupEl.textContent || "[]");
      } catch {
        return;
      }

      const due = getDueUnits(lookup);
      if (due.length === 0) return;

      heading.textContent =
        due.length === 1
          ? "1 unit due for review"
          : `${due.length} units due for review`;
      cardsHost.innerHTML = "";
      for (const unit of due.slice(0, 6)) {
        cardsHost.append(buildDueCard(unit));
      }
      section.classList.remove("hidden");
      wireCarouselAffordance(carousel);
    }
    initDueReview();
    document.addEventListener("astro:page-load", initDueReview);

    function initInterestPersonalization() {
      const grid = document.querySelector<HTMLElement>("[data-track-grid]");
      const notice = document.querySelector<HTMLElement>(
        "[data-interest-notice]",
      );
      if (!grid || grid.dataset.wired === "true") return;
      grid.dataset.wired = "true";

      const interests = new Set(getActiveProfile()?.interests ?? []);
      if (interests.size === 0) return;

      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-track-card]"),
      );
      let matchCount = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
        const isMatch = tags.some((tag) => interests.has(tag));
        // A profile with interests set should only ever see tracks that
        // match at least one of them here — a non-matching track stays
        // hidden until the reader updates their interests, not just
        // pushed further down the page.
        card.classList.toggle("hidden", !isMatch);
        card.dataset.interestMatch = String(isMatch);
        if (isMatch) {
          card
            .querySelector<HTMLElement>("[data-interest-badge]")
            ?.classList.remove("hidden");
          card
            .querySelector<HTMLElement>("[data-interest-badge]")
            ?.classList.add("flex");
          matchCount++;
        }
      }
      notice?.classList.toggle("hidden", matchCount === 0);
    }
    initInterestPersonalization();
    document.addEventListener("astro:page-load", initInterestPersonalization);

    // A card's final visibility ANDs the category filter with whatever the
    // interest-personalization pass above already decided — clicking a
    // category chip should narrow further, never resurface a track the
    // reader's own stated interests already excluded.
    function initCategoryFilters() {
      const bar = document.querySelector<HTMLElement>(
        "[data-category-filters]",
      );
      const grid = document.querySelector<HTMLElement>("[data-track-grid]");
      if (!bar || !grid) return;
      if (bar.dataset.wired === "true") return;
      bar.dataset.wired = "true";

      const chips = Array.from(
        bar.querySelectorAll<HTMLButtonElement>("[data-category-chip]"),
      );
      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-track-card]"),
      );

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const category = chip.dataset.categoryChip!;
          chips.forEach((c) =>
            c.setAttribute("aria-pressed", String(c === chip)),
          );
          for (const card of cards) {
            const matchesCategory =
              category === "all" || card.dataset.category === category;
            const matchesInterest = card.dataset.interestMatch !== "false";
            card.classList.toggle(
              "hidden",
              !(matchesCategory && matchesInterest),
            );
          }
        });
      });
    }
    initCategoryFilters();
    document.addEventListener("astro:page-load", initCategoryFilters);

    interface PreviewQuestion {
      track: string;
      slug: string;
      problem: string;
      prompt: string;
      choices: string[];
      correctIndex: number;
      tags: string[];
    }

    function wireChoiceButtons(
      choices: HTMLButtonElement[],
      followup: HTMLElement | null,
    ) {
      for (const btn of choices) {
        btn.addEventListener("click", () => {
          const pickedCorrect = btn.dataset.correct === "true";
          for (const b of choices) {
            b.disabled = true;
            if (b.dataset.correct === "true") {
              b.classList.add(
                "border-emerald-500",
                "bg-emerald-50",
                "font-semibold",
                "text-emerald-700",
                "dark:border-emerald-400",
                "dark:bg-emerald-950/40",
                "dark:text-emerald-300",
              );
            }
          }
          if (!pickedCorrect) {
            btn.classList.add(
              "border-rose-400",
              "bg-rose-50",
              "text-rose-700",
              "dark:border-rose-500",
              "dark:bg-rose-950/40",
              "dark:text-rose-300",
            );
          }
          followup?.classList.remove("hidden");
          followup?.classList.add("flex", "animate-fade-slide-in");
        });
      }
    }

    function initContentPreview() {
      const root = document.querySelector<HTMLElement>(
        "[data-content-preview]",
      );
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";

      const poolEl = document.getElementById("preview-questions-pool");
      let pool: PreviewQuestion[] = [];
      try {
        pool = JSON.parse(poolEl?.textContent || "[]");
      } catch {
        // pool stays []
      }

      // Prefer questions from tracks matching the active profile's stated
      // interests (same tag vocabulary as the track-card personalization
      // above); fall back to the full pool for a fresh/interest-less
      // profile, or if no match happens to exist.
      const interests = new Set(getActiveProfile()?.interests ?? []);
      let candidates = pool;
      if (interests.size > 0) {
        const matching = pool.filter((q) =>
          q.tags.some((tag) => interests.has(tag)),
        );
        if (matching.length > 0) candidates = matching;
      }

      const promptEl = root.querySelector<HTMLElement>("[data-preview-prompt]");
      const choicesContainer = root.querySelector<HTMLElement>(
        "[data-preview-choices]",
      );
      const followup = root.querySelector<HTMLAnchorElement>(
        "[data-preview-followup]",
      );
      if (!promptEl || !choicesContainer || !followup) return;

      if (candidates.length === 0) {
        // No pool available (e.g. a build with no written units yet) — keep
        // whatever static fallback question is already in the markup.
        const choices = Array.from(
          choicesContainer.querySelectorAll<HTMLButtonElement>(
            "[data-preview-choice]",
          ),
        );
        wireChoiceButtons(choices, followup);
        return;
      }

      const picked = candidates[Math.floor(Math.random() * candidates.length)];
      promptEl.textContent = picked.prompt;
      choicesContainer.innerHTML = "";
      const newChoices: HTMLButtonElement[] = [];
      picked.choices.forEach((choiceText, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.dataset.previewChoice = "true";
        if (i === picked.correctIndex) btn.dataset.correct = "true";
        btn.className =
          "rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600";
        btn.textContent = choiceText;
        choicesContainer.appendChild(btn);
        newChoices.push(btn);
      });
      followup.href = `/${picked.track}/${picked.slug}/`;
      const followupText = followup.querySelector<HTMLElement>(
        "[data-preview-followup-text]",
      );
      if (followupText) {
        followupText.textContent = `See the full breakdown in ${picked.track}/${picked.slug}`;
      }
      followup.classList.add("hidden");
      followup.classList.remove("flex", "animate-fade-slide-in");

      wireChoiceButtons(newChoices, followup);
    }
    initContentPreview();
    document.addEventListener("astro:page-load", () => {
      // A fresh question on every navigation back to "/" — undo the
      // wired/hidden state left over from the previous render.
      const root = document.querySelector<HTMLElement>(
        "[data-content-preview]",
      );
      if (root) root.dataset.wired = "false";
      initContentPreview();
    });

    function initSurpriseMe() {
      const btn =
        document.querySelector<HTMLButtonElement>("[data-surprise-me]");
      const el = document.getElementById("written-unit-hrefs");
      if (!btn || !el || btn.dataset.wired === "true") return;
      btn.dataset.wired = "true";

      btn.addEventListener("click", () => {
        let hrefs: string[];
        try {
          hrefs = JSON.parse(el.textContent || "[]");
        } catch {
          return;
        }
        if (hrefs.length === 0) return;
        const pick = hrefs[Math.floor(Math.random() * hrefs.length)];
        window.location.href = pick;
      });
    }
    initSurpriseMe();
    document.addEventListener("astro:page-load", initSurpriseMe);
  </script>
</Layout>
