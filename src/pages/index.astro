---
import Layout from "../layouts/Layout.astro";
import {
  Play,
  RotateCcw,
  Lightbulb,
  Flame,
  TrendingUp,
  Layers,
  Search,
  ChevronRight,
  Gamepad2,
} from "lucide-astro";
import TrackIcon from "../components/TrackIcon.astro";
import { roadmap } from "../data/roadmap";
import { loadHomeData, STARTER_UNIT, starterProblem } from "../lib/home-data";

const { unitLookup, trackUnitSlugs } = await loadHomeData();

// The home page answers one question: what do I do now. Continue is the hero,
// three tiles carry the numbers that matter today, and the rest are quick
// doors. Every live number is filled in client-side from the active profile.
const tiles = [
  {
    key: "review",
    href: "/review",
    label: "Review",
    sub: "due today",
    icon: RotateCcw,
    tone: "warn",
  },
  {
    key: "stats",
    href: "/stats",
    label: "Streak",
    sub: "stats & streak",
    icon: Flame,
    tone: "flame",
  },
  {
    key: "progress",
    href: "/progress",
    label: "Progress",
    sub: "your progress",
    icon: TrendingUp,
    tone: "done",
  },
];
const doors = [
  {
    key: "question",
    href: "/question",
    label: "Try a real question",
    icon: Lightbulb,
    pill: "30 sec",
  },
  {
    key: "game",
    href: "/game",
    label: "Game",
    icon: Gamepad2,
    pill: "…",
  },
  {
    key: "tracks",
    href: "/tracks",
    label: "Tracks",
    icon: Layers,
    pill: String(roadmap.tracks.length),
  },
  { key: "search", href: "/search", label: "Search", icon: Search, pill: "" },
];
const totalUnits = roadmap.tracks.reduce((n, t) => n + t.units.length, 0);
const TONE_ICON: Record<string, string> = {
  warn: "background: var(--gauge-warn); color: #fff",
  flame: "background: #ffedd5; color: #c2410c",
  done: "background: #d1fae5; color: #047857",
  accent: "background: var(--accent-soft-bg); color: var(--accent-text)",
};
---

<Layout title="Home" wide>
  <div class="home-glow" aria-hidden="true"></div>
  <div class="relative flex flex-col gap-8 py-6 lg:py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <p
          class="text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400"
        >
          {roadmap.tracks.length} tracks · {totalUnits} units
        </p>
        <h1
          class="mt-1 text-4xl font-extrabold tracking-tight sm:text-5xl"
          style="letter-spacing: -0.025em; line-height: 1.05"
        >
          From junior to <span class="home-gradient-text">staff-level.</span>
        </h1>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span
          data-chip-streak
          class="hidden items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-semibold"
          style="background: #ffedd5; color: #9a3412"
        >
          <Flame class="h-4 w-4" aria-hidden="true" />
          <span data-chip-streak-label></span>
        </span>
      </div>
    </header>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <section class="flex min-w-0 flex-col gap-4" aria-label="Today">
        <a
          href={`/${STARTER_UNIT.track}/${STARTER_UNIT.slug}/`}
          data-menu="continue"
          class="menu-row menu-hero"
        >
          <span class="menu-icon" style="background: #fff; color: #0369a1">
            <Play class="h-7 w-7" aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span
              data-continue-eyebrow
              class="block text-xs font-bold tracking-wider uppercase opacity-85"
              >New here? Start with this one</span
            >
            <span
              data-continue-title
              class="mt-0.5 line-clamp-3 block text-xl leading-snug font-extrabold"
              >{starterProblem}</span
            >
          </span>
          <ChevronRight class="h-6 w-6 shrink-0" aria-hidden="true" />
        </a>

        <a
          href="/progress"
          class="menu-row journey"
          aria-label="Your journey: open progress"
        >
          <span class="min-w-0 flex-1">
            <span class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-extrabold">Your journey</span>
              <span
                data-journey-label
                class="text-sm font-bold text-slate-500 dark:text-slate-400"
                >0 of {totalUnits} done</span
              >
            </span>
            <span class="journey-track mt-2 block">
              <span data-journey-bar class="journey-fill"></span>
            </span>
          </span>
        </a>

        <div class="grid grid-cols-3 gap-3">
          {
            tiles.map((t) => (
              <a
                href={t.href}
                data-menu={t.key}
                class={`menu-row menu-tile ${t.tone === "warn" ? "menu-warn" : ""}`}
              >
                <span class="menu-icon" style={TONE_ICON[t.tone]}>
                  <t.icon class="h-5 w-5" aria-hidden="true" />
                </span>
                <span data-pill class="tile-num">
                  …
                </span>
                <span class="tile-label">{t.label}</span>
              </a>
            ))
          }
        </div>
      </section>

      <nav
        aria-label="Quick doors"
        class="flex min-w-0 flex-col gap-3.5 lg:pt-0"
      >
        {
          doors.map((item) => (
            <a href={item.href} data-menu={item.key} class="menu-row">
              <span class="menu-icon" style={TONE_ICON.accent}>
                <item.icon class="h-5 w-5" aria-hidden="true" />
              </span>
              <span class="flex-1 text-lg font-extrabold">{item.label}</span>
              {item.pill && (
                <span data-pill class="menu-pill">
                  {item.pill}
                </span>
              )}
            </a>
          ))
        }
      </nav>
    </div>

    <section aria-label="Tracks">
      <p
        class="mb-3 text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400"
      >
        Jump into a track
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          roadmap.tracks.map((t) => (
            <li>
              <a href={`/${t.name}/`} class="track-chip">
                <TrackIcon track={t.name} class="h-4 w-4" />
                {t.name.replace(/-/g, " ")}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <script
    type="application/json"
    id="unit-lookup"
    set:html={JSON.stringify(unitLookup)}
  />
  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />

  <script>
    import { pStorage } from "../lib/profile";
    import { getTokenCount } from "../lib/game/tokens";
    import {
      computeStreak,
      countTotalDone,
      getDueUnits,
    } from "../lib/progress-gauges";

    interface UnitRef {
      track: string;
      slug: string;
      problem: string;
    }
    interface ProgressState {
      done: boolean;
      doneAt?: number;
    }

    function setPill(key: string, text: string) {
      const pill = document.querySelector<HTMLElement>(
        `[data-menu="${key}"] [data-pill]`,
      );
      if (pill) pill.textContent = text;
    }

    function readJson<T>(id: string, fallback: T): T {
      try {
        return JSON.parse(document.getElementById(id)?.textContent || "");
      } catch {
        return fallback;
      }
    }

    // Prefer the most recently touched unit that isn't marked done — either
    // never finished, or a spaced-repetition reset just cleared it. Falls
    // back to the most recently completed one, then to the fixed starter
    // already in the markup.
    function applyContinue(lookup: UnitRef[]) {
      const byKey = new Map(lookup.map((u) => [`${u.track}/${u.slug}`, u]));
      let bestNotDone: { key: string; at: number } | null = null;
      let bestDone: { key: string; at: number } | null = null;
      for (const key of pStorage.keys()) {
        if (!key.startsWith("progress:")) continue;
        const unitKey = key.slice("progress:".length);
        if (!byKey.has(unitKey)) continue;
        let state: ProgressState;
        try {
          state = JSON.parse(pStorage.getItem(key) || "{}");
        } catch {
          continue;
        }
        const at = state.doneAt ?? 0;
        if (state.done) {
          if (!bestDone || at > bestDone.at) bestDone = { key: unitKey, at };
        } else if (!bestNotDone || at > bestNotDone.at) {
          bestNotDone = { key: unitKey, at };
        }
      }
      const pick = bestNotDone ?? bestDone;
      const unit = pick ? byKey.get(pick.key) : undefined;
      if (!unit) return;
      const row = document.querySelector<HTMLAnchorElement>(
        '[data-menu="continue"]',
      );
      if (!row) return;
      row.href = `/${unit.track}/${unit.slug}/`;
      const eyebrow = row.querySelector("[data-continue-eyebrow]");
      const title = row.querySelector("[data-continue-title]");
      if (eyebrow) eyebrow.textContent = "Continue where you left off";
      if (title) title.textContent = unit.problem;
    }

    function initHome() {
      const root = document.querySelector<HTMLElement>('[data-menu="review"]');
      if (!root) return;

      const lookup = readJson<UnitRef[]>("unit-lookup", []);
      const slugs = readJson<Record<string, string[]>>("track-unit-slugs", {});

      applyContinue(lookup);

      const due = getDueUnits(lookup).length;
      setPill("review", String(due));
      root.classList.toggle("menu-dim", due === 0);
      root.classList.toggle("menu-attention", due > 0);

      const { current } = computeStreak();
      setPill("stats", current === 0 ? "0" : `${current} d`);
      setPill("game", `${getTokenCount()} tokens`);

      const totalWritten = Object.values(slugs).reduce(
        (n, arr) => n + arr.length,
        0,
      );
      const done = countTotalDone(slugs);
      const pct =
        totalWritten > 0 ? Math.round((done / totalWritten) * 100) : 0;
      setPill("progress", `${pct}%`);
      const bar = document.querySelector<HTMLElement>("[data-journey-bar]");
      if (bar) bar.style.width = `${Math.max(pct, done > 0 ? 2 : 0)}%`;
      const jl = document.querySelector<HTMLElement>("[data-journey-label]");
      if (jl) jl.textContent = `${done} of ${totalWritten} done`;

      const streakChip =
        document.querySelector<HTMLElement>("[data-chip-streak]");
      const streakLabel = document.querySelector<HTMLElement>(
        "[data-chip-streak-label]",
      );
      if (streakChip && streakLabel && current > 0) {
        streakLabel.textContent =
          current === 1 ? "1-day streak" : `${current}-day streak`;
        streakChip.classList.remove("hidden");
        streakChip.classList.add("inline-flex");
      }
    }
    initHome();
    document.addEventListener("astro:page-load", initHome);
  </script>
</Layout>

<style>
  .home-glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 40rem;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        42rem 24rem at 15% 20%,
        rgb(56 189 248 / 18%),
        transparent 70%
      ),
      radial-gradient(
        34rem 22rem at 85% 30%,
        rgb(16 185 129 / 12%),
        transparent 70%
      ),
      radial-gradient(rgb(148 163 184 / 22%) 1px, transparent 1px) 0 0 / 22px
        22px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .home-gradient-text {
    background: linear-gradient(90deg, #0284c7, #10b981);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global(.dark) .home-gradient-text {
    background-image: linear-gradient(90deg, #7dd3fc, #6ee7b7);
  }
  .track-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1.5px solid #cbd5e1;
    background: #fff;
    color: #334155;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: capitalize;
    transition:
      border-color 0.12s,
      transform 0.12s;
  }
  .track-chip:hover {
    border-color: var(--accent-text);
    transform: translateY(-2px);
  }
  :global(.dark) .track-chip {
    border-color: #334155;
    background: #0f172a;
    color: #cbd5e1;
  }
  .menu-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.5rem 1.25rem 0.5rem 1rem;
    border-radius: 0.875rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
    box-shadow: 0 4px 0 #cbd5e1;
    transition:
      transform 0.08s,
      box-shadow 0.08s,
      border-color 0.08s;
  }
  .menu-row:hover {
    border-color: #0f172a;
    box-shadow: 0 4px 0 #0f172a;
    transform: translateX(6px);
  }
  .menu-row:active {
    transform: translate(6px, 4px);
    box-shadow: 0 0 0 #0f172a;
  }
  .menu-row:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 4px;
  }
  :global(.dark) .menu-row {
    border-color: #334155;
    background: #0f172a;
    color: #f1f5f9;
    box-shadow: 0 4px 0 #334155;
  }
  :global(.dark) .menu-row:hover {
    border-color: #f1f5f9;
    box-shadow: 0 4px 0 #f1f5f9;
  }
  .menu-hero {
    min-height: 6rem;
    padding: 0.5rem 1.5rem 0.5rem 1.25rem;
    background: #0369a1;
    color: #fff;
    border-color: #082f49;
    box-shadow: 0 6px 0 #082f49;
  }
  .menu-hero:hover {
    border-color: #082f49;
    box-shadow: 0 6px 0 #082f49;
  }
  :global(.dark) .menu-hero {
    background: #0369a1;
    color: #fff;
    border-color: #082f49;
    box-shadow: 0 6px 0 #082f49;
  }
  :global(.dark) .menu-hero:hover {
    border-color: #082f49;
    box-shadow: 0 6px 0 #082f49;
  }
  .menu-warn.menu-attention {
    background: #fff7ed;
    border-color: #c2410c;
    box-shadow: 0 4px 0 #c2410c;
    color: #0f172a;
  }
  :global(.dark) .menu-warn.menu-attention {
    background: #431407;
    color: #f1f5f9;
  }
  .menu-dim {
    opacity: 0.6;
  }
  .menu-tile {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
  }
  .tile-num {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .tile-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #64748b;
  }
  :global(.dark) .tile-label {
    color: #94a3b8;
  }
  .journey {
    min-height: 0;
    padding: 0.85rem 1.25rem;
  }
  .journey-track {
    height: 0.75rem;
    border-radius: 999px;
    background: #e2e8f0;
    overflow: hidden;
  }
  :global(.dark) .journey-track {
    background: #334155;
  }
  .journey-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #0ea5e9, #10b981);
    transition: width 0.6s ease-out;
  }
  .menu-icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
  }
  .menu-hero .menu-icon {
    width: 3.25rem;
    height: 3.25rem;
  }
  .menu-pill {
    white-space: nowrap;
    border-radius: 999px;
    background: #e2e8f0;
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0f172a;
  }
  :global(.dark) .menu-pill {
    background: #334155;
    color: #f1f5f9;
  }
  .menu-attention .tile-num {
    color: #c2410c;
  }
  :global(.dark) .menu-attention .tile-num {
    color: #fdba74;
  }
  @media (prefers-reduced-motion: reduce) {
    .track-chip,
    .track-chip:hover,
    .menu-row,
    .menu-row:hover,
    .menu-row:active {
      transition: none;
      transform: none;
    }
  }
</style>
