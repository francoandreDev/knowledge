---
import Layout from "../layouts/Layout.astro";
import { roadmap } from "../data/roadmap";
import { getWrittenUnits } from "../lib/curriculum";

const writtenUnits = await getWrittenUnits();
const writtenByTrack = new Map<string, number>();
for (const u of writtenUnits) {
  writtenByTrack.set(u.track, (writtenByTrack.get(u.track) ?? 0) + 1);
}
---

<Layout title="Home">
  <h1 class="text-3xl font-bold tracking-tight">systems-mastery</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
    A self-study curriculum from junior to a solid staff-level engineer,
    across sixteen tracks. One unit per session, by design.
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      roadmap.tracks.map((track) => {
        const written = writtenByTrack.get(track.name) ?? 0;
        return (
          <a
            href={`/${track.name}/`}
            class="group rounded-xl border border-slate-200 p-5 transition hover:border-slate-400 hover:shadow-sm dark:border-slate-800 dark:hover:border-slate-600"
          >
            <div class="flex items-center justify-between">
              <h2 class="font-semibold tracking-tight group-hover:text-slate-950 dark:group-hover:text-white">
                {track.name}
              </h2>
              <span class="text-xs text-slate-500 dark:text-slate-500">
                {written}/{track.units.length}
              </span>
            </div>
            <div class="mt-3 h-1.5 w-full rounded-full bg-slate-100 dark:bg-slate-800">
              <div
                class="h-1.5 rounded-full bg-slate-900 dark:bg-slate-100"
                style={`width: ${track.units.length ? (written / track.units.length) * 100 : 0}%`}
              />
            </div>
          </a>
        );
      })
    }
  </div>
</Layout>
