    box-shadow: 0 4px 0 var(--uc-deep);
  }
  :global(.dark) .continue-go {
    color: #0f172a;
  }

  /* next units */
  .next {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .next[hidden] {
    display: none;
  }
  .next-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .next-list :global(.next-card) {
    --uc: hsl(var(--uh, 200) 65% 42%);
    --uc-soft: hsl(var(--uh, 200) 85% 94%);
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: 1rem;
    border: 2px solid #cbd5e1;
    border-top: 5px solid var(--uc);
    background:
      radial-gradient(
          circle,
          hsl(var(--uh, 200) 60% 55% / 0.2) 1px,
          transparent 1.6px
        )
        0 0 / 10px 10px,
      #fff;
    padding: 0.75rem;
    color: #0f172a;
    box-shadow: 0 4px 0 #cbd5e1;
    transition:
      transform 0.1s,
      border-color 0.1s;
    animation: rise 0.4s ease-out backwards;
    animation-delay: calc(var(--i, 0) * 70ms + 450ms);
  }
  :global(.dark) .next-list :global(.next-card) {
    --uc: hsl(var(--uh, 200) 70% 68%);
    --uc-soft: hsl(var(--uh, 200) 40% 16%);
    border-color: #334155;
    border-top-color: var(--uc);
    background:
      radial-gradient(
          circle,
          hsl(var(--uh, 200) 70% 65% / 0.18) 1px,
          transparent 1.6px
        )
        0 0 / 10px 10px,
      #0f172a;
    color: #f1f5f9;
    box-shadow: 0 4px 0 #334155;
  }
  .next-list :global(.next-card:hover) {
    transform: translateY(-3px);
    border-color: var(--uc);
  }
  .next-list :global(.next-orb) {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    padding: 0.55rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--uc-soft);
    color: var(--uc);
  }
  .next-list :global(.next-title) {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .next-list :global(.next-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 800;
    color: #64748b;
  }
  .next-list :global(.next-state) {
    border-radius: 999px;
    background: var(--uc-soft);
    padding: 0.0625rem 0.5rem;
    color: var(--uc);
  }

  /* question of the day */
  .dq {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: 1.25rem;
    border: 2px solid #6d28d9;
    background:
      radial-gradient(circle, rgb(124 58 237 / 0.16) 1px, transparent 1.6px) 0
        0 / 12px 12px,
      #f5f3ff;
    padding: 1rem 1.25rem 1.25rem;
    box-shadow: 0 5px 0 #6d28d9;
  }
  .dq[hidden] {
    display: none;
  }
  :global(.dark) .dq {
    border-color: #a78bfa;
    background:
      radial-gradient(circle, rgb(167 139 250 / 0.16) 1px, transparent 1.6px) 0
        0 / 12px 12px,
      #1e1b4b;
    box-shadow: 0 5px 0 #a78bfa;
  }
  .dq-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .dq-ic {
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #6d28d9;
    color: #fff;
  }
  .dq-pill {
    margin-left: auto;
    border-radius: 999px;
    background: #ddd6fe;
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #5b21b6;
  }
  :global(.dark) .dq-pill {
    background: #4c1d95;
    color: #ddd6fe;
  }
  .dq-prompt {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .dq-choices {
    display: grid;
    gap: 0.5rem;
  }
  .dq-choices :global(.dq-choice) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.875rem;
    border: 2px solid #c4b5fd;
    background: #fff;
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    transition:
      border-color 0.1s,
      transform 0.1s;
  }
  :global(.dark) .dq-choices :global(.dq-choice) {
    border-color: #4c1d95;
    background: #0f172a;
    color: #f1f5f9;
  }
  .dq-choices :global(.dq-choice:hover:not(:disabled)) {
    border-color: #6d28d9;
    transform: translateX(4px);
  }
  .dq-choices :global(.dq-choice:focus-visible) {
    outline: 3px solid #6d28d9;
    outline-offset: 2px;
  }
  .dq-choices :global(.dq-choice i) {
    display: flex;
    height: 1.625rem;
    width: 1.625rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #ede9fe;
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 800;
    color: #5b21b6;
  }
  .dq-choices :global(.dq-choice:disabled) {
    cursor: default;
  }
  .dq-choices :global(.dq-choice.is-right) {
    border-color: #059669;
    background: #d1fae5;
    color: #064e3b;
    animation: pop 0.3s ease-out;
  }
  .dq-choices :global(.dq-choice.is-wrong) {
    border-color: #dc2626;
    background: #fee2e2;
    color: #7f1d1d;
    animation: shake 0.35s ease-out;
  }
  .dq-after {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .dq-after[hidden] {
    display: none;
  }
  .dq-verdict {
    font-size: 0.9375rem;
    font-weight: 800;
    color: #b91c1c;
  }
  .dq-verdict.ok {
    color: #047857;
  }
  .dq-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: #5b21b6;
  }
  .dq-link[hidden] {
    display: none;
  }
  :global(.dark) .dq-link {
    color: #c4b5fd;
  }

  /* side cards */
  .side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .card,
  .tour {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: 1.125rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding: 0.875rem 1rem;
    color: #0f172a;
    box-shadow: 0 4px 0 #cbd5e1;
    transition:
      transform 0.1s,
      border-color 0.1s,
      box-shadow 0.1s;
  }
  :global(.dark) .card,
  :global(.dark) .tour {
    border-color: #334155;
    background: #0f172a;
    color: #f1f5f9;
    box-shadow: 0 4px 0 #334155;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: #0f172a;
    box-shadow: 0 6px 0 #0f172a;
  }
  :global(.dark) .card:hover {
    border-color: #f1f5f9;
    box-shadow: 0 6px 0 #f1f5f9;
  }
  .card:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 4px;
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .card-title {
    font-size: 1rem;
    font-weight: 800;
  }
  .side-title {
    font-size: 1rem;
    font-weight: 800;
  }

  /* streak */
  .streak {
    border-color: #fdba74;
    background: linear-gradient(180deg, #fff7ed, #fff);
    box-shadow: 0 4px 0 #fdba74;
  }
  :global(.dark) .streak {
    border-color: #9a3412;
    background: linear-gradient(180deg, #431407, #0f172a);
    box-shadow: 0 4px 0 #9a3412;
  }
  .flame {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #ffedd5;
    color: #c2410c;
  }
  .flame :global(svg) {
    animation: flicker 1.8s ease-in-out infinite;
    transform-origin: 50% 90%;
  }
  .streak-num {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .streak-num b {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: #c2410c;
  }
  :global(.dark) .streak-num b {
    color: #fdba74;
  }
  .streak-num i {
    font-style: normal;
    font-size: 0.875rem;
    font-weight: 800;
    color: #64748b;
  }
  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.375rem;
  }
  .week :global(.day) {
    display: flex;
    height: 2.125rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 2px solid #e2e8f0;
    background: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #94a3b8;
  }
  :global(.dark) .week :global(.day) {
    border-color: #334155;
    background: #0f172a;
  }
  .week :global(.day i) {
    font-style: normal;
  }
  .week :global(.day.on) {
    border-color: #ea580c;
    background: #f97316;
    color: #fff;
  }
  .week :global(.day.today) {
    box-shadow: 0 0 0 3px rgb(14 165 233 / 0.45);
  }

  /* review */
  .review-ic,
  .prog-ic {
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
  }
  .review-ic {
    background: #e2e8f0;
    color: #475569;
  }
  .review .count {
    margin-left: auto;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
  }
  .review.is-due {
    border-color: #c2410c;
    background: #fff7ed;
    box-shadow: 0 4px 0 #c2410c;
  }
  :global(.dark) .review.is-due {
    background: #431407;
  }
  .review.is-due .review-ic {
    background: #ea580c;
    color: #fff;
  }
  .review.is-due .count {
    color: #c2410c;
  }
  :global(.dark) .review.is-due .count {
    color: #fdba74;
  }
  .review.is-dim {
    opacity: 0.75;
  }
  .due {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .due :global(.due-empty),
  .due :global(.due-more) {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #64748b;
  }
  .due :global(.due-item) {
    --uc: hsl(var(--uh, 200) 65% 42%);
    --uc-soft: hsl(var(--uh, 200) 85% 94%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    background: #fff;
    border: 1.5px solid #fed7aa;
    padding: 0.25rem 0.5rem;
  }
  :global(.dark) .due :global(.due-item) {
    --uc: hsl(var(--uh, 200) 70% 68%);
    --uc-soft: hsl(var(--uh, 200) 40% 16%);
    background: #0f172a;
    border-color: #9a3412;
  }
  .due :global(.due-orb) {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    padding: 0.35rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--uc-soft);
    color: var(--uc);
  }
  .due :global(.due-title) {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .due :global(.due-late) {
    border-radius: 999px;
    background: #ffedd5;
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #9a3412;
  }

  /* progress rings */
  .prog-ic {
    background: #d1fae5;
    color: #047857;
  }
  .journey-label {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 800;
    color: #64748b;
  }
  .rings {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ring-big {
    position: relative;
    height: 5.5rem;
    width: 5.5rem;
    flex-shrink: 0;
  }
  .ring-big b {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .ring-small-list {
    display: flex;
    flex: 1;
    justify-content: space-around;
    gap: 0.5rem;
  }
  .ring-small {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    width: 3.25rem;
  }
  .ring-small i {
    font-style: normal;
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748b;
  }
  .ring-bg,
  .ring-fg {
    fill: none;
    stroke-width: 3.4;
  }
  .ring-bg {
    stroke: #e2e8f0;
  }
  :global(.dark) .ring-bg {
    stroke: #334155;
  }
  .ring-fg {
    stroke: #059669;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    animation: ringfill 0.9s ease-out backwards;
  }
  :global(.dark) .ring-fg {
    stroke: #34d399;
  }
  .ring-small[data-region="workshop"] .ring-fg {
    stroke: #d97706;
  }
  .ring-small[data-region="observatory"] .ring-fg {
    stroke: #6366f1;
  }
  .ring-small[data-region="harbor"] .ring-fg {
    stroke: #0891b2;
  }
  .ring-small svg {
    height: 2.75rem;
    width: 2.75rem;
  }
  .ring-big svg {
    height: 100%;
    width: 100%;
  }

  /* tour (first visit) */
  .tour-steps {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tour-steps li {
    display: flex;
    gap: 0.75rem;
  }
  .tour-steps li span:last-child {
    display: flex;
    flex-direction: column;
  }
  .tour-steps b {
    font-size: 0.9375rem;
    font-weight: 800;
  }
  .tour-steps i {
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #64748b;
  }
  .tour-ic {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #e0f2fe;
    color: #0369a1;
  }
  .tour-steps li:nth-child(2) .tour-ic {
    background: #ede9fe;
    color: #6d28d9;
  }
  .tour-steps li:nth-child(3) .tour-ic {
    background: #ffedd5;
    color: #c2410c;
  }

  /* first visit vs returning */
  [data-only="new"] {
    display: none;
  }
  [data-state="new"] [data-only="new"] {
    display: flex;
  }
  [data-state="new"] [data-only="returning"] {
    display: none;
  }

  /* ---- worlds ---- */
  .worlds {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .worlds-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .worlds-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mini-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 800;
    color: #334155;
  }
  .mini-link b {
    border-radius: 999px;
    background: #e2e8f0;
    padding: 0 0.5rem;
  }
  .mini-link:hover {
    border-color: #0f172a;
  }
  :global(.dark) .mini-link {
    border-color: #334155;
    background: #0f172a;
    color: #cbd5e1;
  }
  :global(.dark) .mini-link b {
    background: #334155;
  }

  .region {
    --rc: #b45309;
    --rbg: #fffbeb;
    --rline: rgb(180 83 9 / 0.35);
    border-radius: 1.5rem;
    border: 2px solid var(--rline);
    background:
      linear-gradient(var(--rline) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--rline) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--rbg);
    background-blend-mode: soft-light, soft-light, normal;
    padding: 1rem 1.125rem 1.25rem;
  }
  .region[data-region="observatory"] {
    --rc: #4338ca;
    --rbg: #eef2ff;
    --rline: rgb(67 56 202 / 0.3);
  }
  .region[data-region="harbor"] {
    --rc: #0e7490;
    --rbg: #ecfeff;
    --rline: rgb(14 116 144 / 0.3);
  }
  .region[data-region="frontier"] {
    --rc: #475569;
    --rbg: #f8fafc;
    --rline: rgb(71 85 105 / 0.3);
  }
  :global(.dark) .region {
    --rbg: #1c1917;
    --rc: #fbbf24;
    --rline: rgb(251 191 36 / 0.22);
  }
  :global(.dark) .region[data-region="observatory"] {
    --rbg: #0f0d2b;
    --rc: #a5b4fc;
    --rline: rgb(165 180 252 / 0.22);
  }
  :global(.dark) .region[data-region="harbor"] {
    --rbg: #04202a;
    --rc: #67e8f9;
    --rline: rgb(103 232 249 / 0.2);
  }
  :global(.dark) .region[data-region="frontier"] {
    --rbg: #0f172a;
    --rc: #94a3b8;
    --rline: rgb(148 163 184 / 0.2);
  }
  .region-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.875rem;
  }
  .region-head h3 {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--rc);
  }
  .region-head p {
    flex: 1 1 14rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #64748b;
  }
  :global(.dark) .region-head p {
    color: #94a3b8;
  }
  .region-count {
    border-radius: 999px;
    border: 1.5px solid var(--rline);
    padding: 0 0.625rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--rc);
  }
  .world-row {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  }
  @media (max-width: 639px) {
    .world-row {
      display: flex;
      margin-inline: -1.125rem;
      padding: 0.25rem 1.125rem 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.125rem;
      -webkit-overflow-scrolling: touch;
    }
    .world-li {
      flex: 0 0 68%;
      scroll-snap-align: start;
    }
  }
  .world {
    --wc: hsl(var(--world-h) 72% 38%);
    --wc-deep: hsl(var(--world-h) 72% 18%);
    --wc-soft: hsl(var(--world-h) 80% 95%);
    --wc-text: hsl(var(--world-h) 70% 22%);
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.375rem;
    overflow: hidden;
    border-radius: 1.125rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding-bottom: 0.75rem;
    color: #0f172a;
    box-shadow: 0 4px 0 #cbd5e1;
    transition:
      transform 0.1s,
      border-color 0.1s,
      box-shadow 0.1s;
  }
  :global(.dark) .world {
    --wc: hsl(var(--world-h) 80% 62%);
    --wc-deep: hsl(var(--world-h) 68% 16%);
    --wc-soft: hsl(var(--world-h) 45% 14%);
    --wc-text: hsl(var(--world-h) 85% 74%);
    border-color: #334155;
    background: #0f172a;
    color: #f1f5f9;
    box-shadow: 0 4px 0 #334155;
  }
  .world:hover {
    transform: translateY(-3px);
    border-color: var(--wc);
    box-shadow: 0 7px 0 var(--wc);
  }
  .world:focus-visible {
    outline: 3px solid var(--wc);
    outline-offset: 3px;
  }
  .world.is-complete {
