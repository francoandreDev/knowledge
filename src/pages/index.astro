---
import Layout from "../layouts/Layout.astro";
import {
  Play,
  RotateCcw,
  Flame,
  TrendingUp,
  Search,
  ArrowRight,
  Gamepad2,
  Clock,
  Compass,
  BookOpen,
  Repeat,
  Lightbulb,
  CalendarCheck,
} from "lucide-astro";
import TrackIllustration from "../components/TrackIllustration.astro";
import UnitEmblem from "../components/UnitEmblem.astro";
import { roadmap } from "../data/roadmap";
import { REGIONS } from "../data/regions";
import { makeUnitHue } from "../lib/unit-theme";
import { loadHomeData, STARTER_UNIT, starterProblem } from "../lib/home-data";

const { writtenUnits, unitLookup, trackUnitSlugs, previewPool } =
  await loadHomeData();

// The home page answers one question: what do I do now. Continue is the hero,
// the next units sit under it, the reader's own numbers live in a side column
// and the worlds are the way in. Every live number is filled in client-side
// from the active profile.
const totalUnits = roadmap.tracks.reduce((n, t) => n + t.units.length, 0);
const totalWritten = unitLookup.length;

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();
const unitHue = makeUnitHue(ALL_TAGS);
// Same hue per world as the roadmap map, so a world keeps its colour.
const worldHue = (i: number) => Math.round((i * 137.508 + 205) % 360);

// Reading minutes per written unit (about 200 words a minute), same rule as
// the roadmap, so the minutes shown here match the map.
const minutesByKey = new Map<string, number>();
for (const u of writtenUnits) {
  const words = [u.l1, u.l2, u.l3, ...u.l3Parts].reduce(
    (n, e) => n + (e?.body ? e.body.split(/\s+/).filter(Boolean).length : 0),
    0,
  );
  minutesByKey.set(
    `${u.track}/${u.unitSlug}`,
    Math.max(1, Math.round(words / 200)),
  );
}

const writtenKeys = new Set(unitLookup.map((u) => `${u.track}/${u.slug}`));
const homeUnits = roadmap.tracks.flatMap((t) =>
  t.units
    .map((u, i) => ({
      t: t.name,
      s: u.slug,
      p: u.problem,
      tg: u.tags,
      i,
      m: minutesByKey.get(`${t.name}/${u.slug}`) ?? 0,
      h: unitHue(u.tags[0] ?? "", u.slug),
    }))
    .filter((u) => writtenKeys.has(`${u.t}/${u.s}`)),
);

const worlds = roadmap.tracks.map((t, i) => ({
  name: t.name,
  total: t.units.length,
  written: trackUnitSlugs[t.name]?.length ?? 0,
  hue: worldHue(i),
}));
const regions = REGIONS.map((r) => ({
  ...r,
  worlds: worlds.filter((w) => r.tracks.includes(w.name)),
}));
const unplaced = worlds.filter(
  (w) => !REGIONS.some((r) => r.tracks.includes(w.name)),
);
if (unplaced.length > 0)
  regions.push({
    id: "frontier",
    title: "The Frontier",
    tagline: "Newer worlds, still being charted.",
    tracks: [],
    worlds: unplaced,
  });
const regionTracks = Object.fromEntries(
  regions.map((r) => [r.id, r.worlds.map((w) => w.name)]),
);

const starter = homeUnits.find(
  (u) => u.t === STARTER_UNIT.track && u.s === STARTER_UNIT.slug,
);
---

<Layout title="Home" wide>
  <!-- Arrowhead markers for the world illustrations (always rendered, so
       url(#id) resolves inside the scrolling carousel too). -->
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <marker
        id="arrow-accent"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path d="M0 0l6 4-6 4" stroke="context-stroke" fill="none"></path>
      </marker>
      <marker
        id="arrow-dim"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path
          d="M0 0l6 4-6 4"
          stroke="context-stroke"
          stroke-opacity="0.5"
          fill="none"></path>
      </marker>
    </defs>
  </svg>

  <!-- One emblem per written unit, cloned by the script wherever a unit is
       shown (continue, next units, due reviews, search suggestions). -->
  <div hidden aria-hidden="true" data-emblems>
    {
      homeUnits.map((u) => (
        <span data-emblem={`${u.t}/${u.s}`}>
          <UnitEmblem
            text={`${u.p} ${u.s}`}
            tag={u.tg[0] ?? ""}
            class="h-full w-full"
          />
        </span>
      ))
    }
  </div>

  <div class="home" data-home data-state="returning">
    <header class="hero">
      <div class="scene" aria-hidden="true">
        <svg class="cloud cloud-1" viewBox="0 0 120 50" fill="currentColor">
          <path
            d="M20 44a16 16 0 0 1 2-31 22 22 0 0 1 42-4 18 18 0 0 1 34 10 14 14 0 0 1 2 25z"
          ></path>
        </svg>
        <svg class="cloud cloud-2" viewBox="0 0 120 50" fill="currentColor">
          <path
            d="M20 44a16 16 0 0 1 2-31 22 22 0 0 1 42-4 18 18 0 0 1 34 10 14 14 0 0 1 2 25z"
          ></path>
        </svg>
        <svg
          class="compass"
          viewBox="0 0 64 64"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="32" cy="32" r="26"></circle>
          <circle cx="32" cy="32" r="21" stroke-dasharray="2 5"></circle>
          <path d="M32 12l6 20-6 20-6-20z" fill="currentColor" opacity="0.35"
          ></path>
          <path d="M32 12v40M12 32h40" opacity="0.4"></path>
        </svg>
        <svg
          class="waves"
          viewBox="0 0 400 40"
          preserveAspectRatio="none"
          fill="currentColor"
        >
          <path
            d="M0 22q25-16 50 0t50 0 50 0 50 0 50 0 50 0 50 0 50 0v18H0z"
            opacity="0.55"></path>
          <path d="M0 30q25-14 50 0t50 0 50 0 50 0 50 0 50 0 50 0 50 0v10H0z"
          ></path>
        </svg>
      </div>

      <div class="hero-in">
        <p class="eyebrow rise" style="--i: 0">
          {roadmap.tracks.length} worlds · {totalUnits} units · exercises and live
          demos
        </p>
        <p class="greet rise" style="--i: 1" data-greeting>
          Welcome. One unit takes about twenty minutes.
        </p>
        <h1 class="rise" style="--i: 2">
          Learn how systems, teams and careers <span class="home-gradient-text"
            >really work.</span
          >
        </h1>
        <div class="hero-row rise" style="--i: 3">
          <form
            class="searchbar"
            role="search"
            action="/search/"
            data-home-search
          >
            <Search class="h-5 w-5 shrink-0" aria-hidden="true" />
            <input
              type="search"
              name="q"
              id="home-search"
              autocomplete="off"
              placeholder="Search units: caching, merge conflicts, feedback…"
              aria-label="Search units"
              aria-controls="home-suggest"
              aria-expanded="false"
              role="combobox"
              aria-autocomplete="list"
            />
            <ul
              id="home-suggest"
              class="suggest"
              role="listbox"
              data-suggest
              hidden
            >
            </ul>
          </form>
          <span
            data-chip-streak
            class="streak-chip hidden"
            title="Consecutive days with activity"
          >
            <Flame class="h-4 w-4" aria-hidden="true" />
            <span data-chip-streak-label></span>
          </span>
        </div>
      </div>
    </header>

    <div class="board">
      <a
        href={`/${STARTER_UNIT.track}/${STARTER_UNIT.slug}/`}
        data-menu="continue"
        class="continue rise"
        style={`--i: 4; --uh: ${starter?.h ?? 200}`}
      >
        <span class="continue-orb" data-continue-emblem>
          <UnitEmblem
            text={`${starterProblem} ${STARTER_UNIT.slug}`}
            tag={starter?.tg[0] ?? ""}
            class="h-full w-full"
          />
        </span>
        <span class="continue-body">
          <span data-continue-eyebrow class="continue-eyebrow"
            >New here? Start with this one</span
          >
          <span data-continue-title class="continue-title"
            >{starterProblem}</span
          >
          <span class="continue-meta">
            <span class="cm-chip" data-continue-world
              >{STARTER_UNIT.track.replace(/-/g, " ")}</span
            >
            <span class="cm-chip">
              <Clock class="h-3.5 w-3.5" aria-hidden="true" />
              <span data-continue-min>{starter?.m ?? 0}</span> min
            </span>
          </span>
          <span class="continue-prog">
            <span class="continue-bar"
              ><i data-continue-bar style="width: 0%"></i></span
            >
            <span class="continue-prog-label" data-continue-progress
              >0 units done in this world</span
            >
          </span>
        </span>
        <span class="continue-go">
          <Play class="h-5 w-5" fill="currentColor" aria-hidden="true" />
          Open unit
        </span>
      </a>

      <aside class="side" aria-label="Your numbers">
        <div class="tour rise" style="--i: 5" data-only="new">
          <h2 class="side-title">How it works</h2>
          <ol class="tour-steps">
            <li>
              <span class="tour-ic"
                ><Compass class="h-5 w-5" aria-hidden="true" /></span
              >
              <span
                ><b>Pick a world</b><i
                  >{roadmap.tracks.length} of them, from web to leading teams.</i
                ></span
              >
            </li>
            <li>
              <span class="tour-ic"
                ><BookOpen class="h-5 w-5" aria-hidden="true" /></span
              >
              <span
                ><b>Read, then try</b><i
                  >A problem first, then the idea, then the detail.</i
                ></span
              >
            </li>
            <li>
              <span class="tour-ic"
                ><Repeat class="h-5 w-5" aria-hidden="true" /></span
              >
              <span
                ><b>Come back to it</b><i
                  >Reviews return at 7, 30 and 90 days.</i
                ></span
              >
            </li>
          </ol>
        </div>

        <a
          href="/stats"
          data-menu="stats"
          class="card streak rise"
          style="--i: 5"
          data-only="returning"
        >
          <span class="card-head">
            <span class="flame"
              ><Flame class="h-6 w-6" aria-hidden="true" /></span
            >
            <span class="streak-num"><b data-pill>0</b><i>day streak</i></span>
          </span>
          <span class="week" data-week aria-label="Last seven days"></span>
        </a>

        <a
          href="/review"
          data-menu="review"
          class="card review rise"
          style="--i: 6"
          data-only="returning"
        >
          <span class="card-head">
            <span class="review-ic"
              ><RotateCcw class="h-5 w-5" aria-hidden="true" /></span
            >
            <span class="card-title">Review</span>
            <b class="count" data-pill>0</b>
          </span>
          <ul class="due" data-due-list>
            <li class="due-empty">Nothing due. Nice.</li>
          </ul>
        </a>

        <a
          href="/progress"
          data-menu="progress"
          class="card progress rise"
          style="--i: 7"
          data-only="returning"
        >
          <span class="card-head">
            <span class="prog-ic"
              ><TrendingUp class="h-5 w-5" aria-hidden="true" /></span
            >
            <span class="card-title">Your journey</span>
            <span class="journey-label" data-journey-label
              >0 of {totalWritten} done</span
            >
          </span>
          <span class="rings">
            <span class="ring-big">
              <svg viewBox="0 0 36 36" aria-hidden="true">
                <circle
                  class="ring-bg"
                  cx="18"
                  cy="18"
                  r="15.9"
                  pathLength="100"></circle>
                <circle
                  class="ring-fg"
                  data-ring-all
                  cx="18"
                  cy="18"
                  r="15.9"
                  pathLength="100"
                  stroke-dasharray="0 100"></circle>
              </svg>
              <b data-pill>0%</b>
            </span>
            <span class="ring-small-list">
              {
                regions.map((r) => (
                  <span class="ring-small" data-region={r.id}>
                    <svg viewBox="0 0 36 36" aria-hidden="true">
                      <circle
                        class="ring-bg"
                        cx="18"
                        cy="18"
                        r="15.9"
                        pathLength="100"
                      />
                      <circle
                        class="ring-fg"
                        data-ring-region={r.id}
                        cx="18"
                        cy="18"
                        r="15.9"
                        pathLength="100"
                        stroke-dasharray="0 100"
                      />
                    </svg>
                    <i>{r.title.replace("The ", "")}</i>
                  </span>
                ))
              }
            </span>
          </span>
        </a>
      </aside>

      <section class="next rise" style="--i: 6" aria-label="Next units">
        <h2 class="section-title">Up next in this world</h2>
        <ul class="next-list" data-next></ul>
      </section>

      <section
        class="dq rise"
        style="--i: 7"
        aria-label="Question of the day"
        data-dq
      >
        <div class="dq-head">
          <span class="dq-ic"
            ><Lightbulb class="h-5 w-5" aria-hidden="true" /></span
          >
          <h2 class="section-title">Question of the day</h2>
          <span class="dq-pill">30 sec</span>
        </div>
        <p class="dq-prompt" data-dq-prompt>
          Answer one real question, no sign-up, no score.
        </p>
        <div class="dq-choices" data-dq-choices></div>
        <div class="dq-after" data-dq-after hidden>
          <span data-dq-verdict class="dq-verdict"></span>
          <a href="/question" class="dq-link"
            >Another question <ArrowRight
              class="h-4 w-4"
              aria-hidden="true"
            /></a
          >
          <a href="/" class="dq-link" data-dq-learn hidden></a>
        </div>
      </section>
    </div>

    <section class="worlds" aria-label="Worlds">
      <div class="worlds-head">
        <h2 class="section-title">Pick a world</h2>
        <span class="worlds-links">
          <a href="/game" data-menu="game" class="mini-link">
            <Gamepad2 class="h-4 w-4" aria-hidden="true" />
            Game <b data-pill>…</b>
          </a>
          <a href="/study" class="mini-link">
            <CalendarCheck class="h-4 w-4" aria-hidden="true" />
            Plan your week
          </a>
        </span>
      </div>

      {
        regions.map((r) => (
          <div class="region" data-region={r.id}>
            <div class="region-head">
              <h3>{r.title}</h3>
              <p>{r.tagline}</p>
              <span class="region-count" data-region-count={r.id} />
            </div>
            <ul class="world-row">
              {r.worlds.map((w) => (
                <li class="world-li">
                  <a
                    href={`/${w.name}/`}
                    class="world"
                    data-world={w.name}
                    data-total={w.total}
                    data-written={w.written}
                    style={`--world-h: ${w.hue}`}
                  >
                    <span class="world-art">
                      <TrackIllustration track={w.name} class="world-illus" />
                      <span class="world-ring">
                        <svg viewBox="0 0 36 36" aria-hidden="true">
                          <circle
                            class="ring-bg"
                            cx="18"
                            cy="18"
                            r="15.9"
                            pathLength="100"
                          />
                          <circle
                            class="ring-fg"
                            data-world-ring={w.name}
                            cx="18"
                            cy="18"
                            r="15.9"
                            pathLength="100"
                            stroke-dasharray="0 100"
                          />
                        </svg>
                        <b data-world-pct={w.name}>0%</b>
                      </span>
                    </span>
                    <span class="world-name">{w.name.replace(/-/g, " ")}</span>
                    <span class="world-sub" data-world-sub={w.name}>
                      {w.total} units
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>

  <script
    type="application/json"
    id="home-units"
    set:html={JSON.stringify(homeUnits)}
  />
  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />
  <script
    type="application/json"
    id="region-tracks"
    set:html={JSON.stringify(regionTracks)}
  />
  <script
    type="application/json"
    id="home-question-pool"
    set:html={JSON.stringify(previewPool)}
  />

  <script>
    import { pStorage, getActiveProfile } from "../lib/profile";
    import { getTokenCount } from "../lib/game/tokens";
    import {
      computeStreak,
      countDoneByTrack,
      isDayActive,
    } from "../lib/progress-gauges";

    interface HomeUnit {
      t: string;
      s: string;
      p: string;
      tg: string[];
      i: number;
      m: number;
      h: number;
    }
    interface ProgressState {
      done: boolean;
      doneAt?: number;
      nextReviewAt?: number;
    }
    interface PoolQuestion {
      track: string;
      slug: string;
      problem: string;
      prompt: string;
      choices: string[];
      correctIndex: number;
      tags: string[];
    }

    const DAY = 24 * 60 * 60 * 1000;
    const q = <T extends Element = HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => root.querySelector<T>(sel);
    const qa = <T extends Element = HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => Array.from(root.querySelectorAll<T>(sel));
    const el = (tag: string, cls = "", text = "") => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    };
    const readJson = <T,>(id: string, fallback: T): T => {
      try {
        return JSON.parse(document.getElementById(id)?.textContent || "");
      } catch {
        return fallback;
      }
    };
    const pretty = (t: string) => t.replace(/-/g, " ");
    const setPill = (key: string, text: string) => {
      const pill = q(`[data-menu="${key}"] [data-pill]`);
      if (pill) pill.textContent = text;
    };
    const emblem = (key: string) =>
      q(`[data-emblems] [data-emblem="${CSS.escape(key)}"] svg`)?.cloneNode(
        true,
      ) ?? null;
    const progressOf = (key: string): ProgressState | null => {
      const raw = pStorage.getItem(`progress:${key}`);
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };

    // Prefer the most recently touched unit that isn't done, then the most
    // recently completed one; null leaves the starter already in the markup.
    function pickContinue(byKey: Map<string, HomeUnit>): HomeUnit | null {
      let bestNotDone: { key: string; at: number } | null = null;
      let bestDone: { key: string; at: number } | null = null;
      for (const key of pStorage.keys()) {
        if (!key.startsWith("progress:")) continue;
        const unitKey = key.slice("progress:".length);
        if (!byKey.has(unitKey)) continue;
        const state = progressOf(unitKey);
        if (!state) continue;
        const at = state.doneAt ?? 0;
        if (state.done) {
          if (!bestDone || at > bestDone.at) bestDone = { key: unitKey, at };
        } else if (!bestNotDone || at > bestNotDone.at) {
          bestNotDone = { key: unitKey, at };
        }
      }
      const pick = bestNotDone ?? bestDone;
      return pick ? (byKey.get(pick.key) ?? null) : null;
    }

    function setUnitTheme(node: HTMLElement, u: HomeUnit) {
      node.style.setProperty("--uh", String(u.h));
    }

    function fillContinue(
      u: HomeUnit,
      isStarter: boolean,
      slugs: Record<string, string[]>,
      counts: Record<string, number>,
    ) {
      const row = q<HTMLAnchorElement>('[data-menu="continue"]');
      if (!row) return;
      row.href = `/${u.t}/${u.s}/`;
      setUnitTheme(row, u);
      const eyebrow = q("[data-continue-eyebrow]", row);
      const title = q("[data-continue-title]", row);
      if (eyebrow)
        eyebrow.textContent = isStarter
          ? "New here? Start with this one"
          : "Continue where you left off";
      if (title) title.textContent = u.p;
      const orb = q("[data-continue-emblem]", row);
      const ic = emblem(`${u.t}/${u.s}`);
      if (orb && ic) orb.replaceChildren(ic);
      const world = q("[data-continue-world]", row);
      if (world) world.textContent = pretty(u.t);
      const min = q("[data-continue-min]", row);
      if (min) min.textContent = String(u.m);
      const total = slugs[u.t]?.length ?? 0;
      const done = counts[u.t] ?? 0;
      const bar = q("[data-continue-bar]", row);
      if (bar)
        bar.style.width = `${total ? Math.max((done / total) * 100, done ? 4 : 0) : 0}%`;
      const label = q("[data-continue-progress]", row);
      if (label)
        label.textContent = `${done} of ${total} units done in ${pretty(u.t)}`;
    }

    // The next three written units of the current world that aren't done.
    function fillNext(
      current: HomeUnit,
      units: HomeUnit[],
      slugs: Record<string, string[]>,
    ) {
      const list = q("[data-next]");
      if (!list) return;
      list.replaceChildren();
      const inWorld = units
        .filter((u) => u.t === current.t)
        .sort((a, b) => a.i - b.i);
      const open = inWorld.filter(
        (u) => u.s !== current.s && !progressOf(`${u.t}/${u.s}`)?.done,
      );
      // Units after the current one first, then any earlier ones left open.
      const ordered = [
        ...open.filter((u) => u.i > current.i),
        ...open.filter((u) => u.i < current.i),
      ].slice(0, 3);
      ordered.forEach((u, k) => {
        const li = el("li");
        const a = el("a", "next-card") as HTMLAnchorElement;
        a.href = `/${u.t}/${u.s}/`;
        a.style.setProperty("--uh", String(u.h));
        a.style.setProperty("--i", String(k));
        const orb = el("span", "next-orb");
        const ic = emblem(`${u.t}/${u.s}`);
        if (ic) orb.append(ic);
        a.append(
          orb,
          el("span", "next-title", u.p.replace(/\s*\(.*$/, "").trim()),
        );
        const meta = el("span", "next-meta");
        meta.append(
          el("span", "next-state", k === 0 ? "Up next" : "In line"),
          el("span", "next-min", `${u.m} min`),
        );
        a.append(meta);
        li.append(a);
        list.append(li);
      });
      const sec = q("section.next");
      if (sec)
        sec.hidden =
          ordered.length === 0 || (slugs[current.t]?.length ?? 0) < 2;
    }

    function fillStreak() {
      const wrap = q("[data-week]");
      if (!wrap) return;
      wrap.replaceChildren();
      const now = Date.now();
      for (let k = 6; k >= 0; k--) {
        const ts = now - k * DAY;
        const day = el("span", "day");
        if (isDayActive(ts)) day.classList.add("on");
        if (k === 0) day.classList.add("today");
        day.append(
          el(
            "i",
            "",
            new Date(ts).toLocaleDateString("en", { weekday: "narrow" }),
          ),
        );
        wrap.append(day);
      }
    }

    function fillReview(units: HomeUnit[]) {
      const list = q("[data-due-list]");
      const card = q('[data-menu="review"]');
      if (!list || !card) return;
      const now = Date.now();
      const due = units
        .map((u) => {
          const st = progressOf(`${u.t}/${u.s}`);
          return st?.done && st.nextReviewAt && now >= st.nextReviewAt
            ? { u, late: Math.floor((now - st.nextReviewAt) / DAY) }
            : null;
        })
        .filter((x): x is { u: HomeUnit; late: number } => x !== null)
        .sort((a, b) => b.late - a.late);
      setPill("review", String(due.length));
      card.classList.toggle("is-dim", due.length === 0);
      card.classList.toggle("is-due", due.length > 0);
      list.replaceChildren();
      if (due.length === 0) {
        list.append(el("li", "due-empty", "Nothing due. Nice."));
        return;
      }
      for (const { u, late } of due.slice(0, 3)) {
        const li = el("li", "due-item");
        li.style.setProperty("--uh", String(u.h));
        const orb = el("span", "due-orb");
        const ic = emblem(`${u.t}/${u.s}`);
        if (ic) orb.append(ic);
        li.append(
          orb,
          el("span", "due-title", u.p.replace(/\s*\(.*$/, "").trim()),
          el("span", "due-late", late === 0 ? "today" : `${late}d late`),
        );
        list.append(li);
      }
      if (due.length > 3)
        list.append(el("li", "due-more", `+${due.length - 3} more`));
    }

    function setRing(sel: string, pct: number) {
      const c = q<SVGCircleElement>(sel);
      if (c)
        c.setAttribute(
          "stroke-dasharray",
          `${Math.max(0, Math.min(100, pct))} 100`,
        );
    }

    function fillRings(
      slugs: Record<string, string[]>,
      counts: Record<string, number>,
    ) {
      const regionTracks = readJson<Record<string, string[]>>(
        "region-tracks",
        {},
      );
      let all = 0;
      let allTotal = 0;
      for (const [track, list] of Object.entries(slugs)) {
        all += counts[track] ?? 0;
        allTotal += list.length;
      }
      const pct = allTotal ? Math.round((all / allTotal) * 100) : 0;
      setPill("progress", `${pct}%`);
      setRing("[data-ring-all]", all > 0 ? Math.max(pct, 2) : 0);
      const jl = q("[data-journey-label]");
      if (jl) jl.textContent = `${all} of ${allTotal} done`;
      for (const [region, tracks] of Object.entries(regionTracks)) {
        let d = 0;
        let t = 0;
        for (const tr of tracks) {
          d += counts[tr] ?? 0;
          t += slugs[tr]?.length ?? 0;
        }
        setRing(`[data-ring-region="${region}"]`, t ? (d / t) * 100 : 0);
        const count = q(`[data-region-count="${region}"]`);
        if (count) count.textContent = `${d}/${t} done`;
      }
      for (const card of qa("[data-world]")) {
        const track = card.dataset.world!;
        const total = slugs[track]?.length ?? 0;
        const done = counts[track] ?? 0;
        const p = total ? (done / total) * 100 : 0;
        setRing(`[data-world-ring="${track}"]`, p);
        const pctEl = q(`[data-world-pct="${track}"]`);
        if (pctEl) pctEl.textContent = `${Math.round(p)}%`;
        const sub = q(`[data-world-sub="${track}"]`);
        if (sub)
          sub.textContent =
            total === 0
              ? `${card.dataset.total} units · soon`
              : `${done}/${total} done · ${card.dataset.total} planned`;
        card.classList.toggle("is-complete", total > 0 && done === total);
      }
    }

    function greet(
      returning: boolean,
      current: number,
      activeToday: boolean,
      due: number,
    ) {
      const out = q("[data-greeting]");
      if (!out) return;
      const hour = new Date().getHours();
      const part =
        hour < 12
          ? "Good morning"
          : hour < 19
            ? "Good afternoon"
            : "Good evening";
      if (!returning) {
        out.textContent = "Welcome. One unit takes about twenty minutes.";
        return;
      }
      const name = getActiveProfile()?.name;
      const who = name ? `${part}, ${name}.` : `${part}.`;
      const bits: string[] = [];
      if (current > 0)
        bits.push(
          activeToday
            ? `${current}-day streak, and you already practised today.`
            : `${current}-day streak, keep it going today.`,
        );
      if (due > 0)
        bits.push(`${due} ${due === 1 ? "review is" : "reviews are"} due.`);
      out.textContent = [who, ...bits].join(" ");
    }

    function wireSearch(units: HomeUnit[]) {
      const form = q<HTMLFormElement>("[data-home-search]");
      const input = form ? q<HTMLInputElement>("input", form) : null;
      const list = q("[data-suggest]");
      if (!form || !input || !list || form.dataset.wired === "true") return;
      form.dataset.wired = "true";
      let active = -1;
      let hits: HomeUnit[] = [];
      const close = () => {
        list.hidden = true;
        input.setAttribute("aria-expanded", "false");
        active = -1;
      };
      const paint = () => {
        qa("li", list).forEach((li, k) =>
          li.setAttribute("aria-selected", String(k === active)),
        );
      };
      input.addEventListener("input", () => {
        const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        list.replaceChildren();
        if (words.length === 0) return close();
        hits = units
          .filter((u) => {
            const hay = `${u.p} ${u.s} ${u.t} ${u.tg.join(" ")}`.toLowerCase();
            return words.every((w) => hay.includes(w));
          })
          .slice(0, 5);
        if (hits.length === 0) return close();
        hits.forEach((u) => {
          const li = el("li");
          li.setAttribute("role", "option");
          const a = el("a", "sg-item") as HTMLAnchorElement;
          a.href = `/${u.t}/${u.s}/`;
          a.style.setProperty("--uh", String(u.h));
          const orb = el("span", "sg-orb");
          const ic = emblem(`${u.t}/${u.s}`);
          if (ic) orb.append(ic);
          a.append(
            orb,
            el("span", "sg-title", u.p.replace(/\s*\(.*$/, "").trim()),
            el("span", "sg-world", pretty(u.t)),
          );
          li.append(a);
          list.append(li);
        });
        list.hidden = false;
        input.setAttribute("aria-expanded", "true");
        active = -1;
      });
      input.addEventListener("keydown", (e) => {
        if (list.hidden) return;
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          const n = hits.length;
          if (e.key === "ArrowDown") active = active + 1 >= n ? -1 : active + 1;
          else active = active - 1 < -1 ? n - 1 : active - 1;
          paint();
        } else if (e.key === "Enter" && active >= 0 && hits[active]) {
          e.preventDefault();
          window.location.href = `/${hits[active]!.t}/${hits[active]!.s}/`;
        } else if (e.key === "Escape") close();
      });
      document.addEventListener("click", (e) => {
        if (!form.contains(e.target as Node)) close();
      });
    }

    function fillQuestion() {
      const root = q("[data-dq]");
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";
      const pool = readJson<PoolQuestion[]>("home-question-pool", []);
      if (pool.length === 0) {
        root.hidden = true;
        return;
      }
      const interests = new Set(getActiveProfile()?.interests ?? []);
      let candidates = pool;
      if (interests.size > 0) {
        const match = pool.filter((x) => x.tags.some((t) => interests.has(t)));
        if (match.length > 0) candidates = match;
      }
      // One question per calendar day, the same all day for this profile.
      const day = Math.floor(
        (Date.now() - new Date().getTimezoneOffset() * 60000) / DAY,
      );
      const pick = candidates[day % candidates.length]!;
      const prompt = q("[data-dq-prompt]", root);
      const box = q("[data-dq-choices]", root);
      const after = q("[data-dq-after]", root);
      const verdict = q("[data-dq-verdict]", root);
      const learn = q<HTMLAnchorElement>("[data-dq-learn]", root);
      if (!prompt || !box || !after || !verdict || !learn) return;
      prompt.textContent = pick.prompt;
      box.replaceChildren();
      const buttons = pick.choices.map((text, k) => {
        const b = el("button", "dq-choice") as HTMLButtonElement;
        b.type = "button";
        b.append(
          el("i", "", String.fromCharCode(65 + k)),
          el("span", "", text),
        );
        box.append(b);
        return b;
      });
      buttons.forEach((b, k) =>
        b.addEventListener("click", () => {
          const right = k === pick.correctIndex;
          buttons.forEach((x, j) => {
            x.disabled = true;
            if (j === pick.correctIndex) x.classList.add("is-right");
          });
          if (!right) b.classList.add("is-wrong");
          verdict.textContent = right
            ? "Right."
            : "Not quite. The highlighted answer is the correct one.";
          verdict.classList.toggle("ok", right);
          learn.href = `/${pick.track}/${pick.slug}/`;
          learn.textContent = `Learn it: ${pick.problem.replace(/\s*\(.*$/, "").trim()}`;
          learn.hidden = false;
          after.hidden = false;
        }),
      );
    }

    function initHome() {
      const root = q("[data-home]");
      if (!root) return;
      const units = readJson<HomeUnit[]>("home-units", []);
      const slugs = readJson<Record<string, string[]>>("track-unit-slugs", {});
      const byKey = new Map(units.map((u) => [`${u.t}/${u.s}`, u]));
      const counts = countDoneByTrack(slugs);

      const returning = pStorage.keys().some((k) => k.startsWith("progress:"));
      root.dataset.state = returning ? "returning" : "new";

      const picked = pickContinue(byKey);
      const starter = byKey.get("web/http-request-response-basics") ?? units[0];
      const current = picked ?? starter;
      if (current) {
        fillContinue(current, !picked, slugs, counts);
        fillNext(current, units, slugs);
      }

      const { current: streak, activeToday } = computeStreak();
      setPill("stats", String(streak));
      fillStreak();
      fillReview(units);
      fillRings(slugs, counts);
      setPill("game", `${getTokenCount()} tokens`);

      const chip = q("[data-chip-streak]");
      const label = q("[data-chip-streak-label]");
      if (chip && label && streak > 0) {
        label.textContent =
          streak === 1 ? "1-day streak" : `${streak}-day streak`;
        chip.classList.remove("hidden");
      }
      const dueCount =
        Number(q('[data-menu="review"] [data-pill]')?.textContent ?? 0) || 0;
      greet(returning, streak, activeToday, dueCount);
      wireSearch(units);
      fillQuestion();
    }
    initHome();
    document.addEventListener("astro:page-load", initHome);
  </script>
</Layout>

