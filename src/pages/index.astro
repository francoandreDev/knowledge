---
import Layout from "../layouts/Layout.astro";
import TrackIcon from "../components/TrackIcon.astro";
import TrackIllustration from "../components/TrackIllustration.astro";
import TopicMythModal from "../components/TopicMythModal.astro";
import ProgressGauge from "../components/ProgressGauge.astro";
import {
  Search,
  ArrowRight,
  Sparkles,
  HelpCircle,
  Shuffle,
} from "lucide-astro";
import { roadmap, getUnit } from "../data/roadmap";
import { getWrittenUnits } from "../lib/curriculum";
import { groupSlugsByTrack } from "../lib/progress-gauges";

const writtenUnits = await getWrittenUnits();
const writtenByTrack = new Map<string, number>();
const writtenSlugsByTrack = new Map<string, Set<string>>();
for (const u of writtenUnits) {
  writtenByTrack.set(u.track, (writtenByTrack.get(u.track) ?? 0) + 1);
  if (!writtenSlugsByTrack.has(u.track))
    writtenSlugsByTrack.set(u.track, new Set());
  writtenSlugsByTrack.get(u.track)!.add(u.unitSlug);
}

// Embedded for the client-side gauge script (see the bottom script block) —
// the pool of slugs a reader could have marked done, per track.
const trackUnitSlugs = groupSlugsByTrack(writtenUnits);

const totalUnits = roadmap.tracks.reduce((n, t) => n + t.units.length, 0);
const totalWritten = writtenUnits.length;
const tracksStarted = roadmap.tracks.filter(
  (t) => (writtenByTrack.get(t.name) ?? 0) > 0,
).length;

const GAUGE_RADIUS = 16;
const GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;

// Client-side "continue learning" needs to resolve a bare track/slug key
// (pStorage's progress:<track>/<slug>, scoped to the active profile) back
// to a title + href — embed the minimal lookup table it needs rather than
// shipping the whole roadmap.
const unitLookup = roadmap.tracks.flatMap((t) =>
  t.units
    .filter((u) => writtenSlugsByTrack.get(t.name)?.has(u.slug))
    .map((u) => ({
      track: t.name,
      slug: u.slug,
      problem: u.problem,
    })),
);

// Per-track, in roadmap order, written units only — lets the "continue
// where you left off" carousel find what comes right after the reader's
// current unit without ever linking to a merely-planned page.
const trackSequences = Object.fromEntries(
  roadmap.tracks.map((t) => [
    t.name,
    t.units
      .filter((u) => writtenSlugsByTrack.get(t.name)?.has(u.slug))
      .map((u) => ({ slug: u.slug, problem: u.problem })),
  ]),
);

// "Surprise me" picks uniformly from every written unit — a flat href list
// is all the client needs.
const writtenUnitHrefs = writtenUnits.map((u) => `/${u.track}/${u.unitSlug}/`);

// "Try a real question" pool — one representative level-1 quiz item per
// written unit (favoring L1 since it's the most accessible without having
// read the unit first), tagged with that unit's roadmap tags so the
// client-side script can prefer questions matching the active profile's
// interests. Picked randomly client-side on every load instead of always
// showing the same hardcoded HTTP-429 question.
const previewPool = writtenUnits
  .map((u) => {
    const quizL1 = u.exercises.find((e) => e.type === "quiz" && e.level === 1);
    if (!quizL1 || quizL1.type !== "quiz") return null;
    const roadmapUnit = getUnit(u.track, u.unitSlug);
    return {
      track: u.track,
      slug: u.unitSlug,
      problem: roadmapUnit?.problem ?? "",
      prompt: quizL1.prompt,
      choices: quizL1.choices,
      correctIndex: quizL1.correctIndex,
      tags: roadmapUnit?.tags ?? [],
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

// Fixed pick for brand-new readers with no progress yet: the most
// foundational problem on the site, one most other web/ units assume you
// already feel. Shown in place of "continue learning" only when there's
// nothing yet to continue.
const STARTER_UNIT = {
  track: "web",
  slug: "http-request-response-basics",
  reason:
    "The most foundational problem on the site — most other web/ units assume you already feel this one.",
};
const starterProblem =
  getUnit(STARTER_UNIT.track, STARTER_UNIT.slug)?.problem ?? "";

// Per-track tag vocabulary, embedded as a data attribute below — lets the
// client-side personalization script (see the bottom script block) decide
// which track cards match the active profile's interests without shipping
// the whole roadmap again.
const trackTags = new Map<string, string[]>(
  roadmap.tracks.map((t) => [
    t.name,
    Array.from(new Set(t.units.flatMap((u) => u.tags))),
  ]),
);

const gaugeTracks = roadmap.tracks.filter(
  (t) => (writtenByTrack.get(t.name) ?? 0) > 0,
);
---

<Layout title="Home">
  <section class="text-center sm:text-left">
    <p
      class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
    >
      <Sparkles class="h-3.5 w-3.5" aria-hidden="true" />
      A self-study curriculum
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
      From junior to <span style="color: var(--accent-text)">staff-level</span>,
      one problem at a time.
    </h1>
    <p
      class="mt-4 max-w-2xl text-lg text-slate-600 sm:mx-0 dark:text-slate-400"
    >
      {roadmap.tracks.length} tracks, each a sequence of real problems to understand
      — not a pile of definitions. One unit per session, by design.
    </p>

    <form
      action="/roadmap"
      method="get"
      class="mt-6 flex max-w-xl items-center gap-2 sm:mx-0"
    >
      <div class="relative flex-1">
        <Search
          class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        />
        <input
          type="search"
          name="search"
          placeholder='Search topics — e.g. "debugging", "merge conflicts", "feedback"...'
          class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pr-3 pl-9 text-sm text-slate-900 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-slate-600"
        />
      </div>
      <button
        type="submit"
        class="shrink-0 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
      >
        Search
      </button>
      <button
        type="button"
        data-surprise-me
        title="Open a random written unit"
        class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
      >
        <Shuffle class="h-4 w-4" aria-hidden="true" />
        <span class="hidden sm:inline">Surprise me</span>
      </button>
    </form>

    <div
      data-content-preview
      class="mt-6 max-w-xl rounded-xl border border-slate-200 bg-white p-4 text-left sm:mx-0 dark:border-slate-800 dark:bg-slate-900/50"
    >
      <p
        class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        Try a real question
      </p>
      <p
        data-preview-prompt
        class="mt-1.5 text-sm font-medium text-slate-900 dark:text-slate-100"
      >
        What does an HTTP 429 response mean?
      </p>
      <div data-preview-choices class="mt-3 grid gap-2">
        <button
          type="button"
          data-preview-choice
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          A server-side error — try again later
        </button>
        <button
          type="button"
          data-preview-choice
          data-correct="true"
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          Too many requests — the client should back off
        </button>
        <button
          type="button"
          data-preview-choice
          class="rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600"
        >
          The resource moved permanently
        </button>
      </div>
      <a
        data-preview-followup
        href="/web/http-request-response-basics/"
        class="mt-3 hidden items-center gap-1 text-sm font-medium hover:underline"
        style="color: var(--accent-text)"
      >
        <span data-preview-followup-text
          >See the full breakdown in web/http-request-response-basics</span
        >
        <ArrowRight class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
      </a>
    </div>

    <div
      class="mt-8 grid grid-cols-3 gap-4 border-t border-slate-200 pt-6 sm:max-w-xl dark:border-slate-800"
    >
      <div>
        <div class="text-2xl font-bold tabular-nums">
          {totalWritten}<span class="text-slate-400 dark:text-slate-600"
            >/{totalUnits}</span
          >
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-500">
          units written
        </div>
      </div>
      <div>
        <div class="text-2xl font-bold tabular-nums">
          {tracksStarted}<span class="text-slate-400 dark:text-slate-600"
            >/{roadmap.tracks.length}</span
          >
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-500">
          tracks started
        </div>
      </div>
      <div>
        <div class="text-2xl font-bold tabular-nums">
          {Math.round((totalWritten / totalUnits) * 100)}%
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-500">
          of the roadmap
        </div>
      </div>
    </div>

    <div
      data-streak-gauge
      class="mt-6 flex max-w-xl items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:mx-0 dark:border-slate-800 dark:bg-slate-900/50"
    >
      <span class="inline-flex items-center">
        <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
          <circle
            cx="20"
            cy="20"
            r={GAUGE_RADIUS}
            fill="none"
            stroke-width="4"
            class="stroke-slate-200 dark:stroke-slate-800"></circle>
          <circle
            data-streak-arc
            cx="20"
            cy="20"
            r={GAUGE_RADIUS}
            fill="none"
            stroke-width="4"
            stroke-linecap="round"
            stroke-dasharray={GAUGE_CIRCUMFERENCE}
            stroke-dashoffset={GAUGE_CIRCUMFERENCE}
            transform="rotate(-90 20 20)"
            class="transition-[stroke-dashoffset] duration-500"
            style="stroke: var(--gauge-accent)"></circle>
        </svg>
      </span>
      <div>
        <p
          class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
        >
          This week
        </p>
        <p
          data-streak-label
          class="text-sm font-medium text-slate-900 dark:text-slate-100"
        >
          0/5 units done
        </p>
      </div>
    </div>
  </section>

  <section
    data-continue-learning
    class="mt-10 hidden animate-fade-slide-in rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/50"
  >
    <p
      class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
    >
      Continue where you left off
    </p>
    <div data-continue-cards class="mt-2 flex gap-3 overflow-x-auto pb-1"></div>
  </section>

  <section
    data-starter-suggestion
    class="mt-10 hidden animate-fade-slide-in rounded-xl border p-4"
    style="border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
  >
    <p
      class="text-xs font-semibold tracking-wide uppercase"
      style="color: var(--accent-text)"
    >
      New here? Start with this one
    </p>
    <a
      href={`/${STARTER_UNIT.track}/${STARTER_UNIT.slug}/`}
      class="mt-1.5 flex items-center justify-between gap-3 font-medium text-slate-900 hover:underline dark:text-slate-100"
    >
      <span>{starterProblem}</span>
      <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
    </a>
    <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400">
      {STARTER_UNIT.reason}
    </p>
  </section>

  <p
    data-interest-notice
    class="mt-10 hidden text-xs text-slate-500 dark:text-slate-500"
  >
    Showing tracks that match your interests. See the
    <a
      href="/roadmap"
      class="underline hover:text-slate-900 dark:hover:text-slate-100"
      >full roadmap</a
    >
    for everything, or update your interests from the profile menu.
  </p>

  <section
    class="mt-10 animate-fade-slide-in rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/50"
  >
    <div class="flex flex-wrap items-center gap-6">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center">
          <svg width="64" height="64" viewBox="0 0 40 40" aria-hidden="true">
            <circle
              cx="20"
              cy="20"
              r={GAUGE_RADIUS}
              fill="none"
              stroke-width="4"
              class="stroke-slate-200 dark:stroke-slate-800"></circle>
            <circle
              data-overall-arc
              cx="20"
              cy="20"
              r={GAUGE_RADIUS}
              fill="none"
              stroke-width="4"
              stroke-linecap="round"
              stroke-dasharray={GAUGE_CIRCUMFERENCE}
              stroke-dashoffset={GAUGE_CIRCUMFERENCE}
              transform="rotate(-90 20 20)"
              class="transition-[stroke-dashoffset] duration-500"
              style="stroke: var(--gauge-accent)"></circle>
          </svg>
        </span>
        <div>
          <p
            class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
          >
            Your progress
          </p>
          <p
            data-overall-label
            class="text-sm font-medium text-slate-900 dark:text-slate-100"
          >
            Nothing done yet
          </p>
        </div>
      </div>
      <div
        class="grid flex-1 grid-cols-4 gap-3 border-l border-slate-200 pl-6 sm:grid-cols-6 dark:border-slate-800"
      >
        {
          gaugeTracks.map((t) => (
            <div
              class="flex flex-col items-center gap-1 text-center"
              title={t.name}
            >
              <ProgressGauge
                trackName={t.name}
                total={writtenByTrack.get(t.name) ?? 0}
                size={28}
              />
              <span class="flex items-center gap-1 text-[10px] font-medium text-slate-600 dark:text-slate-400">
                <TrackIcon track={t.name} class="h-3 w-3 shrink-0" />
                <span class="max-w-[4.5rem] truncate">{t.name}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div data-track-grid class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      roadmap.tracks.map((track, i) => {
        const written = writtenByTrack.get(track.name) ?? 0;
        return (
          <div
            data-track-card
            data-tags={(trackTags.get(track.name) ?? []).join(" ")}
            style={`animation-delay: ${Math.min(i, 10) * 40}ms`}
            class="animate-fade-slide-in group relative overflow-hidden rounded-xl border border-slate-200 transition duration-200 hover:-translate-y-0.5 hover:border-slate-400 hover:shadow-md dark:border-slate-800 dark:hover:border-slate-600"
          >
            <a
              href={`/${track.name}/`}
              aria-label={`Open ${track.name} track`}
              class="absolute inset-0 z-0"
            />
            <TrackIllustration
              track={track.name}
              class="pointer-events-none rounded-none border-0 border-b border-slate-200 dark:border-slate-800"
            />
            <span
              data-interest-badge
              class="pointer-events-none absolute top-2 right-2 z-10 hidden items-center gap-1 rounded-full bg-slate-900/90 px-2 py-1 text-[10px] font-semibold text-white shadow-sm dark:bg-slate-100/90 dark:text-slate-900"
            >
              <Sparkles class="h-3 w-3" aria-hidden="true" />
              For you
            </span>
            <div class="pointer-events-none flex items-start gap-4 p-5">
              <div class="rounded-lg bg-slate-100 p-2.5 text-slate-600 transition group-hover:bg-slate-900 group-hover:text-white dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-slate-100 dark:group-hover:text-slate-900">
                <TrackIcon track={track.name} class="h-5 w-5" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <h2 class="truncate font-semibold tracking-tight group-hover:text-slate-950 dark:group-hover:text-white">
                    {track.name}
                  </h2>
                  <span class="shrink-0 text-xs text-slate-500 dark:text-slate-500">
                    {written}/{track.units.length} written
                  </span>
                </div>
                <ProgressGauge
                  trackName={track.name}
                  total={written}
                  size={30}
                  class="mt-3 gap-2"
                >
                  <span
                    data-gauge-frac
                    class="text-xs font-medium tabular-nums text-slate-500 dark:text-slate-500"
                  >
                    {written > 0 ? `0/${written} done` : "Not started"}
                  </span>
                </ProgressGauge>
              </div>
            </div>
            <button
              type="button"
              data-myth-trigger={track.name}
              class="relative z-10 mx-5 mb-4 inline-flex items-center gap-1 text-xs font-medium hover:underline"
              style="color: var(--accent-text)"
            >
              <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
              What is this, really?
            </button>
          </div>
        );
      })
    }
  </div>

  <TopicMythModal />

  <script
    type="application/json"
    id="unit-lookup"
    set:html={JSON.stringify(unitLookup)}
  />
  <script
    type="application/json"
    id="track-sequences"
    set:html={JSON.stringify(trackSequences)}
  />
  <script
    type="application/json"
    id="track-unit-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />
  <script
    type="application/json"
    id="written-unit-hrefs"
    set:html={JSON.stringify(writtenUnitHrefs)}
  />
  <script
    type="application/json"
    id="preview-questions-pool"
    set:html={JSON.stringify(previewPool)}
  />

  <script>
    import { pStorage, getActiveProfile } from "../lib/profile";
    import {
      applyTrackGauges,
      countTotalDone,
      countDoneInLastDays,
      GAUGE_CIRCUMFERENCE,
    } from "../lib/progress-gauges";

    interface ProgressState {
      done: boolean;
      doneAt?: number;
      nextReviewAt?: number;
      stage: number;
    }
    interface UnitRef {
      track: string;
      slug: string;
      problem: string;
    }
    interface SequenceUnit {
      slug: string;
      problem: string;
    }

    function buildContinueCard(
      problem: string,
      href: string,
      eyebrow: string,
      highlighted: boolean,
    ): HTMLAnchorElement {
      const a = document.createElement("a");
      a.href = href;
      a.className = highlighted
        ? "group flex w-56 shrink-0 flex-col rounded-lg border p-3 transition hover:brightness-95"
        : "group flex w-56 shrink-0 flex-col rounded-lg border border-slate-200 p-3 transition hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600";
      if (highlighted) {
        a.style.borderColor = "var(--accent-soft-border)";
        a.style.background = "var(--accent-soft-bg)";
      }
      const eyebrowEl = document.createElement("span");
      eyebrowEl.className =
        "text-[10px] font-semibold tracking-wide uppercase text-slate-500 dark:text-slate-500";
      eyebrowEl.textContent = eyebrow;
      const titleEl = document.createElement("span");
      titleEl.className =
        "mt-1 text-sm font-medium text-slate-900 group-hover:underline dark:text-slate-100";
      titleEl.textContent = problem;
      a.append(eyebrowEl, titleEl);
      return a;
    }

    function initContinueLearning() {
      const continueSection = document.querySelector<HTMLElement>(
        "[data-continue-learning]",
      );
      const cardsHost = document.querySelector<HTMLElement>(
        "[data-continue-cards]",
      );
      const starterSection = document.querySelector<HTMLElement>(
        "[data-starter-suggestion]",
      );
      const lookupEl = document.getElementById("unit-lookup");
      const sequencesEl = document.getElementById("track-sequences");
      if (!continueSection || !cardsHost || !starterSection || !lookupEl)
        return;
      if (continueSection.dataset.wired === "true") return;
      continueSection.dataset.wired = "true";

      let lookup: UnitRef[];
      try {
        lookup = JSON.parse(lookupEl.textContent || "[]");
      } catch {
        return;
      }
      const byKey = new Map(lookup.map((u) => [`${u.track}/${u.slug}`, u]));

      let sequences: Record<string, SequenceUnit[]> = {};
      try {
        sequences = JSON.parse(sequencesEl?.textContent || "{}");
      } catch {
        // Malformed embed — fall back to no sequence data.
      }

      // Prefer the most recently touched unit that isn't currently marked
      // done — either never finished, or a spaced-repetition reset just
      // cleared it (see spaced-repetition.ts) — that's the one worth
      // resurfacing. Falls back to the most recently completed unit.
      let bestNotDone: { key: string; at: number } | null = null;
      let bestDone: { key: string; at: number } | null = null;

      for (const key of pStorage.keys()) {
        if (!key.startsWith("progress:")) continue;
        const unitKey = key.slice("progress:".length);
        if (!byKey.has(unitKey)) continue;
        let state: ProgressState;
        try {
          state = JSON.parse(pStorage.getItem(key) || "{}");
        } catch {
          continue;
        }
        const at = state.doneAt ?? 0;
        if (state.done) {
          if (!bestDone || at > bestDone.at) bestDone = { key: unitKey, at };
        } else {
          if (!bestNotDone || at > bestNotDone.at)
            bestNotDone = { key: unitKey, at };
        }
      }

      const pick = bestNotDone ?? bestDone;
      if (!pick) {
        // Nothing to continue yet — invite a brand-new reader to a fixed
        // starting point instead.
        starterSection.classList.remove("hidden");
        return;
      }
      const unit = byKey.get(pick.key);
      if (!unit) {
        starterSection.classList.remove("hidden");
        return;
      }

      cardsHost.innerHTML = "";
      cardsHost.appendChild(
        buildContinueCard(
          unit.problem,
          `/${unit.track}/${unit.slug}/`,
          "Continue",
          true,
        ),
      );
      const seq = sequences[unit.track] ?? [];
      const idx = seq.findIndex((u) => u.slug === unit.slug);
      if (idx >= 0) {
        const labels = ["Next", "Then"];
        for (let i = 0; i < 2; i++) {
          const next = seq[idx + 1 + i];
          if (!next) break;
          cardsHost.appendChild(
            buildContinueCard(
              next.problem,
              `/${unit.track}/${next.slug}/`,
              labels[i],
              false,
            ),
          );
        }
      }

      continueSection.classList.remove("hidden");
    }

    initContinueLearning();
    document.addEventListener("astro:page-load", initContinueLearning);

    function initTrackGauges() {
      const el = document.getElementById("track-unit-slugs");
      if (!el) return;
      let map: Record<string, string[]>;
      try {
        map = JSON.parse(el.textContent || "{}");
      } catch {
        return;
      }
      applyTrackGauges(map);

      const totalWritten = Object.values(map).reduce(
        (n, arr) => n + arr.length,
        0,
      );
      const done = countTotalDone(map);
      const fraction = totalWritten > 0 ? done / totalWritten : 0;
      const overallArc =
        document.querySelector<SVGCircleElement>("[data-overall-arc]");
      const overallLabel = document.querySelector<HTMLElement>(
        "[data-overall-label]",
      );
      if (overallArc) {
        overallArc.style.strokeDashoffset = String(
          GAUGE_CIRCUMFERENCE * (1 - fraction),
        );
      }
      if (overallLabel) {
        overallLabel.textContent =
          totalWritten > 0
            ? `${done}/${totalWritten} done (${Math.round(fraction * 100)}%)`
            : "Nothing written yet";
      }

      const streakArc =
        document.querySelector<SVGCircleElement>("[data-streak-arc]");
      const streakLabel = document.querySelector<HTMLElement>(
        "[data-streak-label]",
      );
      const streakGoal = 5;
      const streakDone = countDoneInLastDays(7);
      const streakFraction = Math.min(1, streakDone / streakGoal);
      if (streakArc) {
        streakArc.style.strokeDashoffset = String(
          GAUGE_CIRCUMFERENCE * (1 - streakFraction),
        );
      }
      if (streakLabel) {
        streakLabel.textContent = `${streakDone}/${streakGoal} units done`;
      }
    }
    initTrackGauges();
    document.addEventListener("astro:page-load", initTrackGauges);

    function initInterestPersonalization() {
      const grid = document.querySelector<HTMLElement>("[data-track-grid]");
      const notice = document.querySelector<HTMLElement>(
        "[data-interest-notice]",
      );
      if (!grid || grid.dataset.wired === "true") return;
      grid.dataset.wired = "true";

      const interests = new Set(getActiveProfile()?.interests ?? []);
      if (interests.size === 0) return;

      const cards = Array.from(
        grid.querySelectorAll<HTMLElement>("[data-track-card]"),
      );
      let matchCount = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
        const isMatch = tags.some((tag) => interests.has(tag));
        // A profile with interests set should only ever see tracks that
        // match at least one of them here — a non-matching track stays
        // hidden until the reader updates their interests, not just
        // pushed further down the page.
        card.classList.toggle("hidden", !isMatch);
        if (isMatch) {
          card
            .querySelector<HTMLElement>("[data-interest-badge]")
            ?.classList.remove("hidden");
          card
            .querySelector<HTMLElement>("[data-interest-badge]")
            ?.classList.add("flex");
          matchCount++;
        }
      }
      notice?.classList.toggle("hidden", matchCount === 0);
    }
    initInterestPersonalization();
    document.addEventListener("astro:page-load", initInterestPersonalization);

    interface PreviewQuestion {
      track: string;
      slug: string;
      problem: string;
      prompt: string;
      choices: string[];
      correctIndex: number;
      tags: string[];
    }

    function wireChoiceButtons(
      choices: HTMLButtonElement[],
      followup: HTMLElement | null,
    ) {
      for (const btn of choices) {
        btn.addEventListener("click", () => {
          const pickedCorrect = btn.dataset.correct === "true";
          for (const b of choices) {
            b.disabled = true;
            if (b.dataset.correct === "true") {
              b.classList.add(
                "border-emerald-500",
                "bg-emerald-50",
                "font-semibold",
                "text-emerald-700",
                "dark:border-emerald-400",
                "dark:bg-emerald-950/40",
                "dark:text-emerald-300",
              );
            }
          }
          if (!pickedCorrect) {
            btn.classList.add(
              "border-rose-400",
              "bg-rose-50",
              "text-rose-700",
              "dark:border-rose-500",
              "dark:bg-rose-950/40",
              "dark:text-rose-300",
            );
          }
          followup?.classList.remove("hidden");
          followup?.classList.add("flex", "animate-fade-slide-in");
        });
      }
    }

    function initContentPreview() {
      const root = document.querySelector<HTMLElement>(
        "[data-content-preview]",
      );
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";

      const poolEl = document.getElementById("preview-questions-pool");
      let pool: PreviewQuestion[] = [];
      try {
        pool = JSON.parse(poolEl?.textContent || "[]");
      } catch {
        // pool stays []
      }

      // Prefer questions from tracks matching the active profile's stated
      // interests (same tag vocabulary as the track-card personalization
      // above); fall back to the full pool for a fresh/interest-less
      // profile, or if no match happens to exist.
      const interests = new Set(getActiveProfile()?.interests ?? []);
      let candidates = pool;
      if (interests.size > 0) {
        const matching = pool.filter((q) =>
          q.tags.some((tag) => interests.has(tag)),
        );
        if (matching.length > 0) candidates = matching;
      }

      const promptEl = root.querySelector<HTMLElement>("[data-preview-prompt]");
      const choicesContainer = root.querySelector<HTMLElement>(
        "[data-preview-choices]",
      );
      const followup = root.querySelector<HTMLAnchorElement>(
        "[data-preview-followup]",
      );
      if (!promptEl || !choicesContainer || !followup) return;

      if (candidates.length === 0) {
        // No pool available (e.g. a build with no written units yet) — keep
        // whatever static fallback question is already in the markup.
        const choices = Array.from(
          choicesContainer.querySelectorAll<HTMLButtonElement>(
            "[data-preview-choice]",
          ),
        );
        wireChoiceButtons(choices, followup);
        return;
      }

      const picked = candidates[Math.floor(Math.random() * candidates.length)];
      promptEl.textContent = picked.prompt;
      choicesContainer.innerHTML = "";
      const newChoices: HTMLButtonElement[] = [];
      picked.choices.forEach((choiceText, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.dataset.previewChoice = "true";
        if (i === picked.correctIndex) btn.dataset.correct = "true";
        btn.className =
          "rounded-lg border border-slate-200 px-3 py-2 text-left text-sm transition hover:border-slate-400 disabled:cursor-default dark:border-slate-800 dark:hover:border-slate-600";
        btn.textContent = choiceText;
        choicesContainer.appendChild(btn);
        newChoices.push(btn);
      });
      followup.href = `/${picked.track}/${picked.slug}/`;
      const followupText = followup.querySelector<HTMLElement>(
        "[data-preview-followup-text]",
      );
      if (followupText) {
        followupText.textContent = `See the full breakdown in ${picked.track}/${picked.slug}`;
      }
      followup.classList.add("hidden");
      followup.classList.remove("flex", "animate-fade-slide-in");

      wireChoiceButtons(newChoices, followup);
    }
    initContentPreview();
    document.addEventListener("astro:page-load", () => {
      // A fresh question on every navigation back to "/" — undo the
      // wired/hidden state left over from the previous render.
      const root = document.querySelector<HTMLElement>(
        "[data-content-preview]",
      );
      if (root) root.dataset.wired = "false";
      initContentPreview();
    });

    function initSurpriseMe() {
      const btn =
        document.querySelector<HTMLButtonElement>("[data-surprise-me]");
      const el = document.getElementById("written-unit-hrefs");
      if (!btn || !el || btn.dataset.wired === "true") return;
      btn.dataset.wired = "true";

      btn.addEventListener("click", () => {
        let hrefs: string[];
        try {
          hrefs = JSON.parse(el.textContent || "[]");
        } catch {
          return;
        }
        if (hrefs.length === 0) return;
        const pick = hrefs[Math.floor(Math.random() * hrefs.length)];
        window.location.href = pick;
      });
    }
    initSurpriseMe();
    document.addEventListener("astro:page-load", initSurpriseMe);
  </script>
</Layout>
