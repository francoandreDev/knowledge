  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateX(24px) scale(0.98);
    }
  }
  @keyframes choice-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes float-y {
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes confetti {
    to {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    }
  }
  @keyframes coin-flip {
    50% {
      transform: scale(1.3) rotateY(180deg);
    }
  }
  @keyframes earned-glow {
    30% {
      box-shadow:
        0 5px 0 #6d28d9,
        0 0 0 6px rgb(251 191 36 / 0.6);
    }
  }
  @keyframes shake {
    25% {
      transform: translateX(-6px);
    }
    75% {
      transform: translateX(6px);
    }
  }
  @keyframes pop {
    50% {
      transform: scale(1.04);
    }
  }
  @keyframes flicker {
