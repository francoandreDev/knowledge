    height: 100%;
    width: 100%;
  }
  .session-list :global(.qchip) {
    position: absolute;
    top: 0.625rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    background: var(--wc);
    padding: 0.125rem 0.625rem 0.125rem 0.375rem;
