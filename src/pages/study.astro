  .demo-go {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.875rem 0;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--wc);
  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .demo,
    .cell,
    .bar i {
      transition: none;
    }
    .demo:hover,
    .cell:hover {
      transform: none;
    }
