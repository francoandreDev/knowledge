  .session-list :global(.qchoice.is-wrong) {
    border-color: #dc2626;
    background: #fee2e2;
    color: #7f1d1d;
  }
  .session-list :global(.qchoice.is-wrong i) {
    background: #dc2626;
    color: #fff;
