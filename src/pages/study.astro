---
import Layout from "../layouts/Layout.astro";
import HubHeader from "../components/HubHeader.astro";
import TagIcon from "../components/TagIcon.astro";
import TrackIcon from "../components/TrackIcon.astro";
import TrackIllustration from "../components/TrackIllustration.astro";
import {
  CalendarDays,
  Timer,
  LayoutGrid,
  FlaskConical,
  ArrowRight,
} from "lucide-astro";
import { roadmap } from "../data/roadmap";
import { REGIONS } from "../data/regions";
import { makeUnitHue } from "../lib/unit-theme";
import { loadHomeData } from "../lib/home-data";

const { writtenUnits, unitLookup, trackUnitSlugs } = await loadHomeData();

// Study is where the reader decides what to do with the time they have: plan
// a week, fill a spare slot, see which skills have gaps, or just play with a
// demo. Everything that depends on progress is computed client-side from the
// active profile; this file only ships the catalogue.
const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();
const unitHue = makeUnitHue(ALL_TAGS);
const worldHue = (i: number) => Math.round((i * 137.508 + 205) % 360);

const minutesByKey = new Map<string, number>();
const demoUnits: typeof writtenUnits = [];
for (const u of writtenUnits) {
  const words = [u.l1, u.l2, u.l3, ...u.l3Parts].reduce(
    (n, e) => n + (e?.body ? e.body.split(/\s+/).filter(Boolean).length : 0),
    0,
  );
  minutesByKey.set(
    `${u.track}/${u.unitSlug}`,
    Math.max(1, Math.round(words / 200)),
  );
  if (u.interactives.length > 0) demoUnits.push(u);
}

// Practice questions for the quick session: up to four distinct quiz topics
// per unit (easy practice-tier items first), each with its explanation, so a
// session has far more to draw from than one question per unit.
const unitProblem = new Map(
  roadmap.tracks.flatMap((t) =>
    t.units.map((u) => [`${t.name}/${u.slug}`, u] as const),
  ),
);
const studyPool = writtenUnits.flatMap((u) => {
  const meta = unitProblem.get(`${u.track}/${u.unitSlug}`);
  const seen = new Set<string>();
  return u.exercises
    .filter((e) => e.type === "quiz")
    .sort(
      (a, b) =>
        (a.tier === "practice" ? 0 : 1) - (b.tier === "practice" ? 0 : 1),
    )
    .filter((e) => {
      const k = e.topicId ?? e.poolId ?? e.id;
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    })
    .slice(0, 4)
    .map((e) =>
      e.type === "quiz"
        ? {
            id: `${u.track}/${u.unitSlug}/${e.id}`,
            track: u.track,
            slug: u.unitSlug,
            problem: meta?.problem ?? u.unitSlug,
            prompt: e.prompt,
            choices: e.choices,
            correctIndex: e.correctIndex,
            explanation: e.explanation,
            tags: meta?.tags ?? [],
          }
        : null,
    )
    .filter((x) => x !== null);
});

const writtenKeys = new Set(unitLookup.map((u) => `${u.track}/${u.slug}`));
const units = roadmap.tracks.flatMap((t) =>
  t.units
    .map((u, i) => ({
      t: t.name,
      s: u.slug,
      p: u.problem,
      tg: u.tags,
      i,
      m: minutesByKey.get(`${t.name}/${u.slug}`) ?? 0,
      h: unitHue(u.tags[0] ?? "", u.slug),
    }))
    .filter((u) => writtenKeys.has(`${u.t}/${u.s}`)),
);

// Skills matrix: how many written units each tag has in each world.
const worldNames = roadmap.tracks
  .map((t) => t.name)
  .filter((n) => (trackUnitSlugs[n]?.length ?? 0) > 0);
const tagRows = ALL_TAGS.map((tag) => {
  const perWorld: Record<string, number> = {};
  const first: Record<string, string> = {};
  for (const u of units)
    if (u.tg.includes(tag)) {
      perWorld[u.t] = (perWorld[u.t] ?? 0) + 1;
      first[u.t] ??= u.s;
    }
  return {
    tag,
    perWorld,
    first,
    total: Object.values(perWorld).reduce((a, b) => a + b, 0),
  };
})
  .filter((r) => r.total > 0)
  .sort((a, b) => b.total - a.total || a.tag.localeCompare(b.tag));

// Demo gallery: sweep each demo's chart parameter once at build time and keep
// the first output as a small sparkline. compute is author-written repo
// content (see CLAUDE.md "Interactive demos"), so evaluating it here is safe.
interface Demo {
  t: string;
  s: string;
  unit: string;
  id: string;
  title: string;
  description: string;
  level: number;
  sliders: number;
  color: string;
  line: string;
  area: string;
  h: number;
}
const demos: Demo[] = [];
for (const u of demoUnits) {
  const roadmapUnit = roadmap.tracks
    .find((t) => t.name === u.track)
    ?.units.find((x) => x.slug === u.unitSlug);
  for (const d of u.interactives) {
    let line = "";
    let area = "";
    try {
      const fn = new Function("params", d.compute) as (
        p: Record<string, number>,
      ) => Record<string, number>;
      const base: Record<string, number> = {};
      for (const p of d.params) base[p.name] = p.default;
      const sweep =
        d.params.find((p) => p.name === d.chartParam) ?? d.params[0]!;
      const key = d.outputs[0]!.key;
      const ys: number[] = [];
      const N = 28;
      for (let k = 0; k < N; k++) {
        const v = sweep.min + ((sweep.max - sweep.min) * k) / (N - 1);
        const out = fn({ ...base, [sweep.name]: v });
        const y = Number(out[key]);
        ys.push(Number.isFinite(y) ? y : NaN);
      }
      const finite = ys.filter((y) => !Number.isNaN(y));
      if (finite.length > 2) {
        const lo = Math.min(...finite);
        const hi = Math.max(...finite);
        const span = hi - lo || 1;
        const pts = ys.map((y, k) => {
          const yy = Number.isNaN(y) ? 0.5 : (y - lo) / span;
          return [4 + (k * 112) / (N - 1), 40 - 4 - yy * 32] as const;
        });
        line = pts
          .map(([x, y], k) => `${k ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`)
          .join("");
        area = `${line}L116 40L4 40Z`;
      }
    } catch {
      // A demo whose compute throws still gets a card, just without a preview.
    }
    demos.push({
      t: u.track,
      s: u.unitSlug,
      unit: roadmapUnit?.problem ?? u.unitSlug,
      id: d.id,
      title: d.title,
      description: d.description,
      level: d.level,
      sliders: d.params.length,
      color: d.outputs[0]!.color,
      line,
      area,
      h: unitHue(roadmapUnit?.tags[0] ?? "", u.unitSlug),
    });
  }
}
const demoWorlds = Array.from(new Set(demos.map((d) => d.t)));
const regionOf = (track: string) =>
  REGIONS.find((r) => r.tracks.includes(track))?.id ?? "frontier";
const worldIdx = (name: string) =>
  roadmap.tracks.findIndex((t) => t.name === name);

const TABS = [
  { key: "week", label: "Week", icon: CalendarDays, hint: "Plan the week" },
  { key: "session", label: "Session", icon: Timer, hint: "I have 20 minutes" },
  {
    key: "skills",
    label: "Skills",
    icon: LayoutGrid,
    hint: "Where the gaps are",
  },
  {
    key: "demos",
    label: "Demos",
    icon: FlaskConical,
    hint: "Play with an idea",
  },
];
---

<Layout title="Study" wide>
  <HubHeader
    title="Study"
    subtitle="Plan a week, fill a spare twenty minutes, see where the gaps are, or just play with a demo."
  />

  <!-- Arrowhead markers for the world illustrations cloned into practice cards. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <marker
        id="arrow-accent"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path d="M0 0l6 4-6 4" stroke="context-stroke" fill="none"></path>
      </marker>
      <marker
        id="arrow-dim"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path
          d="M0 0l6 4-6 4"
          stroke="context-stroke"
          stroke-opacity="0.5"
          fill="none"></path>
      </marker>
    </defs>
  </svg>
  <div hidden aria-hidden="true" data-track-ics>
    {
      worldNames.map((w) => (
        <span data-ic={w}>
          <TrackIcon track={w} class="h-full w-full" />
        </span>
      ))
    }
  </div>
  <div hidden aria-hidden="true" data-illus>
    {
      worldNames.map((w) => (
        <span data-illus-for={w}>
          <TrackIllustration track={w} class="qart-illus" />
        </span>
      ))
    }
  </div>

  <div class="study" data-study>
    <div class="tabs" role="tablist" aria-label="Study tools">
      {
        TABS.map((tab, k) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.key}`}
            aria-controls={`panel-${tab.key}`}
            aria-selected={k === 0 ? "true" : "false"}
            data-tab={tab.key}
            class="tab"
          >
            <tab.icon class="h-5 w-5" aria-hidden="true" />
            <span class="tab-text">
              <b>{tab.label}</b>
              <i>{tab.hint}</i>
            </span>
          </button>
        ))
      }
    </div>

    <!-- ============ WEEK ============ -->
    <section
      id="panel-week"
      role="tabpanel"
      aria-labelledby="tab-week"
      data-panel="week"
      class="panel"
    >
      <div class="controls">
        <label class="field">
          <span>Hours per week</span>
          <select id="plan-hours" data-plan-hours>
            <option value="1">1 hour</option>
            <option value="2">2 hours</option>
            <option value="3" selected>3 hours</option>
            <option value="5">5 hours</option>
            <option value="8">8 hours</option>
          </select>
        </label>
        <div class="field days-field">
          <span>Study days</span>
          <div class="day-pick" role="group" aria-label="Study days">
            {
              ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((d, k) => (
                <button
                  type="button"
                  data-day-pick={k}
                  aria-pressed="false"
                  aria-label={d}
                >
                  {d}
                </button>
              ))
            }
          </div>
        </div>
        <details class="interests" data-plan-interests>
          <summary>
            <span>Interests</span>
            <b data-interest-count>any</b>
          </summary>
          <div class="chips">
            {
              tagRows.map((r) => (
                <button
                  type="button"
                  class="chip"
                  data-interest={r.tag}
                  aria-pressed="false"
                >
                  <TagIcon tag={r.tag} class="h-3.5 w-3.5" />
                  {r.tag}
                </button>
              ))
            }
          </div>
        </details>
        <button type="button" class="btn primary" data-plan-make>
          Build my week
        </button>
        <button type="button" class="btn" data-plan-reset>Reset</button>
      </div>

      <div class="week-sum" data-week-sum>
        <span class="week-sum-text" data-week-sum-text>Building your week…</span
        >
        <span class="bar"><i data-week-bar style="width: 0%"></i></span>
      </div>
      <div class="week" data-week></div>
      <p class="fine">
        Blocks are sized from each unit's reading time. Units you finish
        elsewhere tick themselves; reviews tick once they are no longer due. The
        plan is saved for this profile and rebuilt every Monday.
      </p>
    </section>

    <!-- ============ SESSION ============ -->
    <section
      id="panel-session"
      role="tabpanel"
      aria-labelledby="tab-session"
      data-panel="session"
      class="panel"
      hidden
    >
      <div class="controls">
        <div class="seg" role="group" aria-label="Time available">
          <button type="button" data-time="10" aria-pressed="false"
            >10 min</button
          >
          <button type="button" data-time="20" aria-pressed="true"
            >20 min</button
          >
          <button type="button" data-time="45" aria-pressed="false"
            >45 min</button
          >
        </div>
        <div class="seg" role="group" aria-label="Mode">
          <button type="button" data-mode="learn" aria-pressed="true"
            >Learn</button
          >
          <button type="button" data-mode="review" aria-pressed="false"
            >Review</button
          >
          <button type="button" data-mode="practice" aria-pressed="false"
            >Practice</button
          >
        </div>
        <button type="button" class="btn" data-session-shuffle>Shuffle</button>
      </div>
      <div class="session-sum" data-session-sum>
        <span data-session-sum-text>Pick a time and a mode.</span>
        <span class="reward" data-practice-reward hidden></span>
        <a href="/" class="btn primary" data-session-start hidden>
          Start
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
      <ol class="session-list" data-session-list></ol>
    </section>

    <!-- ============ SKILLS ============ -->
    <section
      id="panel-skills"
      role="tabpanel"
      aria-labelledby="tab-skills"
      data-panel="skills"
      class="panel"
      hidden
    >
      <div class="skills-top">
        <p class="fine">
          Each square is the units you have done out of those available for a
          skill in a world. Click a number to open the next unit to do there, or
          a skill name to list all its units.
        </p>
        <div class="legend" aria-hidden="true">
          <span>0%</span>
          <i></i>
          <span>100% done</span>
        </div>
      </div>
      <div class="gaps" data-gaps aria-label="Biggest gaps"></div>
      <div class="matrix-wrap">
        <table class="matrix" data-matrix>
          <thead>
            <tr>
              <th scope="col" class="corner">Skill</th>
              {
                worldNames.map((w) => (
                  <th scope="col" title={w.replace(/-/g, " ")}>
                    <span class="col-ic">
                      <TrackIcon track={w} class="h-4 w-4" />
                    </span>
                    <span class="col-name">{w.replace(/-/g, " ")}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              tagRows.map((r) => (
                <tr data-row={r.tag}>
                  <th scope="row">
                    <button
                      type="button"
                      class="row-btn"
                      data-tag-pick={r.tag}
                      aria-pressed="false"
                    >
                      <TagIcon tag={r.tag} class="h-4 w-4" />
                      <span>{r.tag}</span>
                      <i class="gap-flag" data-gap-flag hidden>
                        gap
                      </i>
                    </button>
                  </th>
                  {worldNames.map((w) => {
                    const n = r.perWorld[w] ?? 0;
                    return n > 0 ? (
                      <td>
                        <a
                          href={`/${w}/${r.first[w]}/`}
                          class="cell"
                          data-cell
                          data-tag={r.tag}
                          data-world={w}
                          data-avail={n}
                          style="--f: 0"
                          aria-label={`${r.tag} in ${w}: 0 of ${n} done`}
                        >
                          {n}
                        </a>
                      </td>
                    ) : (
                      <td class="empty" />
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="tag-units" data-tag-units hidden>
        <h3 data-tag-units-title></h3>
        <ul data-tag-units-list></ul>
      </div>
    </section>

    <!-- ============ DEMOS ============ -->
    <section
      id="panel-demos"
      role="tabpanel"
      aria-labelledby="tab-demos"
      data-panel="demos"
      class="panel"
      hidden
    >
      <div class="chips demo-filter" role="group" aria-label="Filter by world">
        <button
          type="button"
          class="chip"
          data-demo-filter="all"
          aria-pressed="true"
        >
          All {demos.length}
        </button>
        {
          demoWorlds.map((w) => (
            <button
              type="button"
              class="chip"
              data-demo-filter={w}
              aria-pressed="false"
            >
              <TrackIcon track={w} class="h-3.5 w-3.5" />
              {w.replace(/-/g, " ")}
              <b>{demos.filter((d) => d.t === w).length}</b>
            </button>
          ))
        }
      </div>
      <ul class="demo-grid">
        {
          demos.map((d) => (
            <li data-demo-card data-world={d.t}>
              <a
                href={`/${d.t}/${d.s}/`}
                class="demo"
                style={`--world-h: ${worldHue(worldIdx(d.t))}; --dc: ${d.color}`}
              >
                <svg viewBox="0 0 120 40" class="spark" aria-hidden="true">
                  {d.line ? (
                    <>
                      <path d={d.area} fill="var(--dc)" opacity="0.16" />
                      <path
                        d={d.line}
                        fill="none"
                        stroke="var(--dc)"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </>
                  ) : (
                    <path
                      d="M4 20h112"
                      stroke="var(--dc)"
                      stroke-dasharray="3 4"
                    />
                  )}
                </svg>
                <span class="demo-title">{d.title}</span>
                <span class="demo-desc">{d.description}</span>
                <span class="demo-meta">
                  <span class="dm world" data-region={regionOf(d.t)}>
                    {d.t.replace(/-/g, " ")}
                  </span>
                  <span class="dm">
                    {d.sliders} {d.sliders === 1 ? "slider" : "sliders"}
                  </span>
                  <span class="dm">L{d.level}</span>
                </span>
                <span class="demo-go">
                  Open in unit{" "}
                  <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        demos.length === 0 && (
          <p class="fine">No interactive demos are published yet.</p>
        )
      }
    </section>
  </div>

  <!-- unit emblems are not needed here; the catalogue below drives every tool -->
  <script
    type="application/json"
    id="study-hues"
    set:html={JSON.stringify(
      Object.fromEntries(worldNames.map((w) => [w, worldHue(worldIdx(w))])),
    )}
  />
  <script
    type="application/json"
    id="study-units"
    set:html={JSON.stringify(units)}
  />
  <script
    type="application/json"
    id="study-slugs"
    set:html={JSON.stringify(trackUnitSlugs)}
  />
  <script
    type="application/json"
    id="study-pool"
    set:html={JSON.stringify(studyPool)}
  />

  <script>
    import { pStorage, getActiveProfile } from "../lib/profile";
    import { addToken } from "../lib/game/tokens";

    interface U {
      t: string;
      s: string;
      p: string;
      tg: string[];
      i: number;
      m: number;
      h: number;
    }
    interface Q {
      id: string;
      explanation: string;
      track: string;
      slug: string;
      problem: string;
      prompt: string;
      choices: string[];
      correctIndex: number;
      tags: string[];
    }
    interface Progress {
      done?: boolean;
      doneAt?: number;
      nextReviewAt?: number;
    }
    interface Block {
      id: string;
      kind: "unit" | "review" | "practice";
      key?: string;
      min: number;
      day: number;
      done: boolean;
    }
    interface Plan {
      week: string;
      hours: number;
      interests: string[];
      days: number[];
      blocks: Block[];
    }

    const DAY = 86400000;
    const q = <T extends Element = HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => root.querySelector<T>(sel);
    const qa = <T extends Element = HTMLElement>(
      sel: string,
      root: ParentNode = document,
    ) => Array.from(root.querySelectorAll<T>(sel));
    const el = (tag: string, cls = "", text = "") => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    };
    const readJson = <T,>(id: string, fallback: T): T => {
      try {
        return JSON.parse(document.getElementById(id)?.textContent || "");
      } catch {
        return fallback;
      }
    };
    const short = (p: string) => p.replace(/\s*\(.*$/, "").trim();
    const pretty = (t: string) => t.replace(/-/g, " ");
    const keyOf = (u: U) => `${u.t}/${u.s}`;

    const progressOf = (key: string): Progress | null => {
      const raw = pStorage.getItem(`progress:${key}`);
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };
    const isDone = (key: string) => !!progressOf(key)?.done;
    const isDue = (key: string) => {
      const p = progressOf(key);
      return !!(p?.done && p.nextReviewAt && Date.now() >= p.nextReviewAt);
    };

    let units: U[] = [];
    let byKey = new Map<string, U>();
    let pool: Q[] = [];

    /* ---------------- tabs ---------------- */
    function selectTab(key: string, push = true) {
      const valid = qa("[data-tab]").some((b) => b.dataset.tab === key);
      if (!valid) key = "week";
      for (const b of qa("[data-tab]")) {
        const on = b.dataset.tab === key;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      for (const p of qa("[data-panel]")) p.hidden = p.dataset.panel !== key;
      if (push && location.hash !== `#${key}`)
        history.replaceState(null, "", `#${key}`);
    }
    function wireTabs() {
      const bar = q(".tabs");
      if (!bar || bar.dataset.wired === "true") return;
      bar.dataset.wired = "true";
      bar.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>("[data-tab]");
        if (b) selectTab(b.dataset.tab!);
      });
      bar.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const tabs = qa("[data-tab]");
        const at = tabs.findIndex(
          (t) => t.getAttribute("aria-selected") === "true",
        );
        const next =
          tabs[
            (at + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length
          ]!;
        selectTab(next.dataset.tab!);
        next.focus();
      });
      window.addEventListener("hashchange", () =>
        selectTab(location.hash.slice(1), false),
      );
    }

    /* ---------------- week plan ---------------- */
    const weekStart = () => {
      const d = new Date();
      d.setHours(0, 0, 0, 0);
      d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
      return d;
    };
    const dateKey = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    const PLAN_KEY = "study:plan";
    const DAYSETS: Record<number, number[]> = {
      3: [0, 2, 4],
      4: [0, 1, 3, 5],
      5: [0, 1, 2, 3, 4],
      6: [0, 1, 2, 3, 4, 5],
      7: [0, 1, 2, 3, 4, 5, 6],
    };
    const daysFor = (hours: number) =>
      DAYSETS[
        hours <= 1 ? 3 : hours <= 2 ? 4 : hours <= 3 ? 5 : hours <= 5 ? 6 : 7
      ]!;

    function nextUndone(track: string): U[] {
      return units
        .filter((u) => u.t === track && !isDone(keyOf(u)))
        .sort((a, b) => a.i - b.i);
    }

    function rankTracks(interests: string[]): string[] {
      const tracks = Array.from(new Set(units.map((u) => u.t)));
      const score = (t: string) =>
        units
          .filter((u) => u.t === t)
          .reduce(
            (n, u) => n + u.tg.filter((x) => interests.includes(x)).length,
            0,
          );
      // The world you touched last goes first so the week continues, not restarts.
      let last = "";
      let lastAt = -1;
      for (const k of pStorage.keys()) {
        if (!k.startsWith("progress:")) continue;
        const p = progressOf(k.slice(9));
        const at = p?.doneAt ?? 0;
        if (p && at >= lastAt) {
          lastAt = at;
          last = k.slice(9).split("/")[0]!;
        }
      }
      return tracks
        .filter((t) => nextUndone(t).length > 0)
        .sort((a, b) => {
          if (a === last) return -1;
          if (b === last) return 1;
          return interests.length ? score(b) - score(a) : 0;
        });
    }

    function generatePlan(
      hours: number,
      interests: string[],
      chosenDays: number[],
    ): Plan {
      const budget = hours * 60;
      const days = chosenDays.length
        ? [...chosenDays].sort((a, b) => a - b)
        : daysFor(hours);
      let n = 0;
      const mk = (b: Omit<Block, "id" | "done">): Block => ({
        ...b,
        id: `b${n++}`,
        done: false,
      });

      // Reviews first: they are the cheapest way to keep what you learned.
      const due = units
        .filter((u) => isDue(keyOf(u)))
        .sort(
          (a, b) =>
            (progressOf(keyOf(a))!.nextReviewAt ?? 0) -
            (progressOf(keyOf(b))!.nextReviewAt ?? 0),
        );
      let spent = 0;
      const reviewCap = Math.floor(budget * 0.25);
      const reviews: Block[] = [];
      for (const u of due) {
        if (spent + 10 > reviewCap) break;
        reviews.push(mk({ kind: "review", key: keyOf(u), min: 10, day: 0 }));
        spent += 10;
      }
      const practiceCount = Math.max(
        2,
        Math.min(days.length, Math.round((budget * 0.15) / 6)),
      );
      spent += practiceCount * 6;

      // New units: round-robin over up to three worlds, in curriculum order.
      const ranked = rankTracks(interests).slice(0, 3);
      const queues = ranked.map((t) => nextUndone(t));
      const learn: Block[] = [];
      let guard = 0;
      while (spent < budget && queues.some((x) => x.length) && guard++ < 60) {
        for (const queue of queues) {
          const u = queue.shift();
          if (!u) continue;
          const min = Math.min(Math.max(u.m, 5), 45);
          if (spent + min > budget && learn.length > 0) continue;
          learn.push(mk({ kind: "unit", key: keyOf(u), min, day: 0 }));
          spent += min;
          if (spent >= budget) break;
        }
      }

      // Lay learning blocks out across the active days in order, then sprinkle
      // reviews and one short practice block on the active days.
      const learnTotal = learn.reduce((a, b) => a + b.min, 0);
      const cap = Math.max(20, Math.ceil(learnTotal / days.length) + 8);
      let at = 0;
      const load = new Map<number, number>(days.map((d) => [d, 0]));
      for (const b of learn) {
        while (
          at < days.length - 1 &&
          (load.get(days[at]!) ?? 0) + b.min > cap &&
          (load.get(days[at]!) ?? 0) > 0
        )
          at++;
        b.day = days[at]!;
        load.set(b.day, (load.get(b.day) ?? 0) + b.min);
      }
      reviews.forEach((b, k) => (b.day = days[(k * 2) % days.length]!));
      const practice: Block[] = [];
      for (let k = 0; k < practiceCount; k++) {
        practice.push(
          mk({
            kind: "practice",
            min: 6,
            day: days[Math.floor((k * days.length) / practiceCount)]!,
          }),
        );
      }
      return {
        week: dateKey(weekStart()),
        hours,
        interests,
        days,
        blocks: [...reviews, ...learn, ...practice],
      };
    }

    let plan: Plan | null = null;
    const loadPlan = (): Plan | null => {
      try {
        const p = JSON.parse(
          pStorage.getItem(PLAN_KEY) || "null",
        ) as Plan | null;
        return p && Array.isArray(p.blocks) ? p : null;
      } catch {
        return null;
      }
    };
    const savePlan = () => {
      if (plan) pStorage.setItem(PLAN_KEY, JSON.stringify(plan));
    };
    const blockDone = (b: Block) => {
      if (b.done) return true;
      if (b.kind === "unit" && b.key) return isDone(b.key);
      if (b.kind === "review" && b.key) return !isDue(b.key);
      return false;
    };

    function selectedInterests(): string[] {
      return qa("[data-interest]")
        .filter((c) => c.getAttribute("aria-pressed") === "true")
        .map((c) => c.dataset.interest!);
    }
    function syncInterestCount() {
      const n = selectedInterests().length;
      const out = q("[data-interest-count]");
      if (out) out.textContent = n === 0 ? "any" : `${n} selected`;
    }

    const ICONS: Record<string, string> = {
      unit: '<path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/>',
      review:
        '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
      practice:
        '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
      moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/>',
    };
    const svg = (name: string, size = 16) =>
      `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;

    function renderWeek() {
      const grid = q("[data-week]");
      if (!grid || !plan) return;
      grid.replaceChildren();
      const start = weekStart();
      const todayIdx = (new Date().getDay() + 6) % 7;
      let totalMin = 0;
      let doneMin = 0;
      let totalBlocks = 0;
      let doneBlocks = 0;
      for (let d = 0; d < 7; d++) {
        const date = new Date(start.getTime() + d * DAY);
        const active = plan.days.includes(d);
        const col = el("section", "day");
        if (d === todayIdx) col.classList.add("is-today");
        if (d < todayIdx) col.classList.add("is-past");
        if (!active) col.classList.add("is-rest");

        const head = el("header", "day-head");
        const name = el("div", "day-name");
        name.append(
          el("b", "", date.toLocaleDateString("en", { weekday: "short" })),
          el(
            "i",
            "",
            date.toLocaleDateString("en", { month: "short", day: "numeric" }),
          ),
        );
        head.append(name);
        if (d === todayIdx) head.append(el("span", "day-today", "Today"));

        const blocks = plan.blocks.filter((b) => b.day === d);
        const mins = blocks.reduce((a, b) => a + b.min, 0);
        const doneHere = blocks.filter(blockDone).length;
        if (active) {
          const meter = el("div", "day-meter");
          const bar = el("span", "day-meter-bar");
          const fill = el("i", "");
          fill.style.width = `${blocks.length ? Math.round((doneHere / blocks.length) * 100) : 0}%`;
          bar.append(fill);
          meter.append(
            bar,
            el(
              "span",
              "day-meter-text",
              blocks.length
                ? `${doneHere}/${blocks.length} · ${mins} min`
                : "nothing planned",
            ),
          );
          head.append(meter);
        }
        col.append(head);

        if (!active) {
          const rest = el("div", "rest");
          const icon = el("span", "rest-ic");
          icon.innerHTML = svg("moon", 22);
          const add = el(
            "button",
            "rest-add",
            "Study this day",
          ) as HTMLButtonElement;
          add.type = "button";
          add.addEventListener("click", () => toggleDay(d));
          rest.append(icon, el("span", "rest-text", "Rest day"), add);
          col.append(rest);
          grid.append(col);
          continue;
        }

        const list = el("ul", "blocks");
        for (const b of blocks) {
          const done = blockDone(b);
          totalMin += b.min;
          totalBlocks++;
          if (done) {
            doneMin += b.min;
            doneBlocks++;
          }
          const unit = b.key ? byKey.get(b.key) : undefined;
          const li = el("li", `block kind-${b.kind}${done ? " is-done" : ""}`);
          if (unit) li.style.setProperty("--uh", String(unit.h));

          const icon = el("span", "block-ic");
          icon.innerHTML = svg(b.kind, 18);
          const link = el("a", "block-link") as HTMLAnchorElement;
          if (b.kind === "practice") {
            link.href = "/question";
            link.append(
              el("span", "block-kind", "Practice"),
              el("span", "block-title", "Quick questions"),
            );
          } else if (unit) {
            link.href =
              b.kind === "review" ? "/review" : `/${unit.t}/${unit.s}/`;
            link.append(
              el(
                "span",
                "block-kind",
                b.kind === "review"
                  ? `Review · ${pretty(unit.t)}`
                  : pretty(unit.t),
              ),
              el("span", "block-title", short(unit.p)),
            );
          }
          const foot = el("span", "block-foot");
          foot.append(el("span", "block-min", `${b.min} min`));
          const check = el("button", "check") as HTMLButtonElement;
          check.type = "button";
          check.setAttribute("aria-pressed", String(done));
          check.setAttribute(
            "aria-label",
            done ? "Mark as not done" : "Mark as done",
          );
          check.innerHTML =
            '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
          check.append(el("span", "check-text", done ? "Done" : "Mark done"));
          check.addEventListener("click", () => {
            b.done = !done;
            savePlan();
            renderWeek();
          });
          foot.append(check);
          link.append(foot);
          li.append(icon, link);
          list.append(li);
        }
        if (blocks.length === 0)
          list.append(el("li", "block-rest", "Nothing planned. A free day."));
        col.append(list);
        grid.append(col);
      }
      const text = q("[data-week-sum-text]");
      if (text)
        text.textContent = `${doneBlocks} of ${totalBlocks} blocks done · ${doneMin} of ${totalMin} minutes · ${plan.hours} h/week over ${plan.days.length} days`;
      const bar = q<HTMLElement>("[data-week-bar]");
      if (bar)
        bar.style.width = `${totalMin ? Math.round((doneMin / totalMin) * 100) : 0}%`;
    }

    // Study days chosen by the reader. Until they touch the picker the days
    // follow the hours (more hours, more days).
    let studyDays: number[] = [];
    let daysTouched = false;
    const syncDayPick = () => {
      for (const b of qa("[data-day-pick]"))
        b.setAttribute(
          "aria-pressed",
          String(studyDays.includes(Number(b.dataset.dayPick))),
        );
    };
    function rebuild() {
      const hoursSel = q<HTMLSelectElement>("[data-plan-hours]");
      if (!hoursSel) return;
      // Keep what was already ticked when the same block survives the rebuild.
      const kept = new Map<string, boolean>();
      for (const b of plan?.blocks ?? [])
        if (b.done && b.key) kept.set(`${b.kind}:${b.key}`, true);
      plan = generatePlan(
        Number(hoursSel.value),
        selectedInterests(),
        studyDays,
      );
      for (const b of plan.blocks)
        if (b.key && kept.has(`${b.kind}:${b.key}`)) b.done = true;
      savePlan();
      renderWeek();
    }
    function toggleDay(d: number) {
      daysTouched = true;
      studyDays = studyDays.includes(d)
        ? studyDays.filter((x) => x !== d)
        : [...studyDays, d].sort((a, b) => a - b);
      // A plan needs at least one day to land on.
      if (studyDays.length === 0) studyDays = [d];
      syncDayPick();
      rebuild();
    }

    function wirePlan() {
      const root = q('[data-panel="week"]');
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";
      const hoursSel = q<HTMLSelectElement>("[data-plan-hours]")!;
      const profileInterests = getActiveProfile()?.interests ?? [];
      const saved = loadPlan();
      const fresh = !!saved && saved.week === dateKey(weekStart());
      const initialInterests = saved?.interests ?? profileInterests;
      for (const c of qa("[data-interest]"))
        c.setAttribute(
          "aria-pressed",
          String(initialInterests.includes(c.dataset.interest!)),
        );
      if (saved) hoursSel.value = String(saved.hours);
      studyDays =
        saved?.days && saved.days.length
          ? saved.days
          : daysFor(Number(hoursSel.value));
      daysTouched = !!saved?.days?.length;
      syncInterestCount();
      syncDayPick();

      for (const c of qa("[data-interest]"))
        c.addEventListener("click", () => {
          c.setAttribute(
            "aria-pressed",
            String(c.getAttribute("aria-pressed") !== "true"),
          );
          syncInterestCount();
        });
      for (const b of qa("[data-day-pick]"))
        b.addEventListener("click", () => toggleDay(Number(b.dataset.dayPick)));
      hoursSel.addEventListener("change", () => {
        if (!daysTouched) {
          studyDays = daysFor(Number(hoursSel.value));
          syncDayPick();
        }
        rebuild();
      });
      q("[data-plan-make]")?.addEventListener("click", rebuild);
      q("[data-plan-reset]")?.addEventListener("click", () => {
        pStorage.removeItem(PLAN_KEY);
        plan = null;
        for (const c of qa("[data-interest]"))
          c.setAttribute("aria-pressed", "false");
        hoursSel.value = "3";
        daysTouched = false;
        studyDays = daysFor(3);
        syncInterestCount();
        syncDayPick();
        rebuild();
      });

      if (fresh) {
        plan = { ...saved!, days: studyDays };
        renderWeek();
      } else {
        rebuild();
      }
    }

    /* ---------------- quick session ---------------- */
    const sess = {
      time: 20,
      mode: "learn" as "learn" | "review" | "practice",
      // Random per visit, so practice never opens on the same questions.
      seed: Math.floor(Math.random() * 2 ** 31),
      shuffled: false,
    };
    // Small seeded generator: the same seed gives the same list, so changing
    // the time or mode does not reshuffle; the Shuffle button draws a new seed.
    const rng = (salt: number) => {
      let a = (sess.seed + salt * 977) >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = a;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };
    const shuffle = <T,>(arr: T[], rand: () => number) => {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(rand() * (i + 1));
        [a[i], a[j]] = [a[j]!, a[i]!];
      }
      return a;
    };

    // Practice answers: a question counts once, the first time it is answered
    // right. Every third new right answer pays one game token, the same token
    // a finished unit pays, so a quick session earns something too.
    const PRACTICE_KEY = "study:practice";
    const PER_TOKEN = 3;
    interface PracticeState {
      done: string[];
      progress: number;
    }
    const loadPractice = (): PracticeState => {
      try {
        const st = JSON.parse(pStorage.getItem(PRACTICE_KEY) || "null");
        if (st && Array.isArray(st.done))
          return { done: st.done, progress: Number(st.progress) || 0 };
      } catch {
        // fall through to a fresh state
      }
      return { done: [], progress: 0 };
    };
    const savePractice = (st: PracticeState) =>
      pStorage.setItem(PRACTICE_KEY, JSON.stringify(st));

    function showReward() {
      const out = q("[data-practice-reward]");
      if (!out) return;
      if (sess.mode !== "practice") {
        out.hidden = true;
        return;
      }
      const st = loadPractice();
      out.hidden = false;
      out.textContent = `${st.progress}/${PER_TOKEN} new right answers to your next game token · ${st.done.length} of ${pool.length} questions done`;
    }

    function toast(text: string) {
      const t = el(
        "div",
        "animate-pop fixed right-4 bottom-4 z-50 flex max-w-xs items-center gap-2 rounded-2xl border border-emerald-300/60 bg-slate-900/95 px-4 py-3 text-sm font-bold text-emerald-100 shadow-xl",
        text,
      );
      t.setAttribute("role", "status");
      document.body.append(t);
      window.setTimeout(() => {
        t.style.transition = "opacity 0.4s";
        t.style.opacity = "0";
        window.setTimeout(() => t.remove(), 450);
      }, 3500);
    }

    /* ---- practice arena: one question at a time, with feedback ---- */
    const worldHues = () => readJson<Record<string, number>>("study-hues", {});
    const iconOf = (w: string) =>
      q(`[data-track-ics] [data-ic="${CSS.escape(w)}"] svg`)?.cloneNode(true) ??
      null;
    const illusOf = (w: string) =>
      q(`[data-illus] [data-illus-for="${CSS.escape(w)}"] > *`)?.cloneNode(
        true,
      ) ?? null;
    const reduced = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const FLAME =
      '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>';
    const COIN =
      '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h4a1.8 1.8 0 0 1 0 3.6h-3a1.8 1.8 0 0 0 0 3.6h4"/></svg>';

    // A small burst of confetti (or a few red specks) from where you clicked.
    function burst(origin: HTMLElement, host: HTMLElement, good: boolean) {
      if (reduced()) return;
      const r = origin.getBoundingClientRect();
      const h = host.getBoundingClientRect();
      const cx = r.left - h.left + r.width / 2;
      const cy = r.top - h.top + r.height / 2;
      const colors = good
        ? ["#10b981", "#f59e0b", "#0ea5e9", "#8b5cf6", "#ec4899"]
        : ["#ef4444", "#f97316"];
      for (let k = 0; k < (good ? 20 : 7); k++) {
        const p = el("i", "confetti");
        const a = Math.random() * Math.PI * 2;
        const d = 40 + Math.random() * 80;
        p.style.cssText = `left:${cx}px;top:${cy}px;background:${colors[k % colors.length]};--dx:${Math.cos(a) * d}px;--dy:${Math.sin(a) * d - 30}px;--rot:${Math.random() * 540 - 270}deg`;
        p.addEventListener("animationend", () => p.remove());
        host.append(p);
      }
    }

    function renderArena(host: HTMLElement, chosen: Q[]) {
      host.className = "arena";
      if (chosen.length === 0) {
        host.append(el("p", "empty-state", "No questions are published yet."));
        return;
      }
      const n = chosen.length;
      const results: Array<"" | "right" | "wrong"> = chosen.map(() => "");
      let at = 0;
      let combo = 0;
      let best = 0;
      let fresh = 0;
      let earned = 0;

      const top = el("div", "arena-top");
      const meter = el("div", "coin-meter");
      meter.setAttribute("aria-label", "Progress to your next game token");
      const coins = Array.from({ length: PER_TOKEN }, () => {
        const c = el("i", "coin");
        c.innerHTML = COIN;
        return c;
      });
      meter.append(el("span", "coin-label", "Token"), ...coins);
      const comboEl = el("div", "combo");
      const countEl = el("div", "arena-count");
      top.append(meter, comboEl, countEl);
      const steps = el("ol", "steps");
      const stepEls = chosen.map(() => el("li", "step"));
      steps.append(...stepEls);
      const stage = el("div", "arena-stage");
      host.append(top, steps, stage);

      const paint = () => {
        const st = loadPractice();
        coins.forEach((c, k) => c.classList.toggle("on", k < st.progress));
        comboEl.className = `combo${combo >= 2 ? " hot" : ""}`;
        comboEl.innerHTML =
          combo >= 2 ? `${FLAME}<b>${combo}</b> in a row` : "";
        countEl.textContent = `${Math.min(at + 1, n)} / ${n}`;
        stepEls.forEach((s, k) => {
          s.className = `step${k === at ? " current" : ""}${results[k] ? ` ${results[k]}` : ""}`;
        });
      };

      function showCard() {
        paint();
        const x = chosen[at]!;
        const hue = worldHues()[x.track] ?? 200;
        const was = new Set(loadPractice().done).has(x.id);
        const card = el("article", "qcard card-in");
        card.style.setProperty("--world-h", String(hue));

        const art = el("div", "qart");
        const ill = illusOf(x.track);
        if (ill) art.append(ill);
        const mark = el("span", "qmark");
        const big = iconOf(x.track);
        if (big) mark.append(big);
        art.append(mark);
        const chip = el("span", "qchip");
        const ic = iconOf(x.track);
        if (ic) chip.append(ic);
        chip.append(pretty(x.track));
        art.append(chip);
        if (was) art.append(el("span", "qdone", "Done before"));

        const prompt = el("p", "qprompt", x.prompt);
        const choices = el("div", "qchoices");
        const after = el("div", "qafter");
        after.hidden = true;
        const buttons = x.choices.map((text, k) => {
          const b = el("button", "qchoice") as HTMLButtonElement;
          b.type = "button";
          b.style.setProperty("--d", `${120 + k * 70}ms`);
          b.append(
            el("i", "", String.fromCharCode(65 + k)),
            el("span", "", text),
          );
          choices.append(b);
          return b;
        });
        buttons.forEach((b, k) =>
          b.addEventListener("click", () => {
            const right = k === x.correctIndex;
            buttons.forEach((y, j) => {
              y.disabled = true;
              if (j === x.correctIndex) y.classList.add("is-right");
            });
            if (!right) {
              b.classList.add("is-wrong");
              card.classList.add("shake");
            }
            results[at] = right ? "right" : "wrong";
            combo = right ? combo + 1 : 0;
            best = Math.max(best, combo);
            burst(b, host, right);

            let reward = "";
            if (right) {
              const st = loadPractice();
              if (!st.done.includes(x.id)) {
                st.done.push(x.id);
                st.progress += 1;
                fresh++;
                reward = "Marked as done";
                if (st.progress >= PER_TOKEN) {
                  st.progress = 0;
                  earned++;
                  addToken();
                  reward = "Marked as done. +1 game token!";
                  toast("+1 game token");
                  host.classList.add("earned");
                  for (const c of coins) c.classList.add("on", "flash");
                  window.setTimeout(() => {
                    host.classList.remove("earned");
                    for (const c of coins) c.classList.remove("flash");
                    paint();
                  }, 1400);
                }
                savePractice(st);
                showReward();
              } else {
                reward = "Already counted before";
              }
            }
            const wasEarned = host.classList.contains("earned");
            if (!wasEarned) paint();
            else {
              comboEl.className = `combo${combo >= 2 ? " hot" : ""}`;
              comboEl.innerHTML =
                combo >= 2 ? `${FLAME}<b>${combo}</b> in a row` : "";
              stepEls[at]!.className = `step current ${results[at]}`;
            }

            after.hidden = false;
            after.replaceChildren();
            const head = el("p", `qverdict ${right ? "ok" : "no"}`);
            head.textContent = right
              ? combo >= 3
                ? "On fire!"
                : "Right!"
              : "Not quite";
            after.append(head, el("p", "qexplain", x.explanation));
            const foot = el("div", "qfoot");
            if (reward) foot.append(el("span", "qreward", reward));
            const learn = el(
              "a",
              "qlearn",
              `Learn it: ${short(x.problem)}`,
            ) as HTMLAnchorElement;
            learn.href = `/${x.track}/${x.slug}/`;
            foot.append(learn);
            const next = el(
              "button",
              "qnext",
              at + 1 < n ? "Next question" : "See results",
            ) as HTMLButtonElement;
            next.type = "button";
            next.addEventListener("click", () => {
              if (at + 1 < n) {
                at++;
                showCard();
              } else {
                showResults();
              }
            });
            foot.append(next);
            after.append(foot);
            next.focus({ preventScroll: true });
          }),
        );

        card.append(art, prompt, choices, after);
        stage.replaceChildren(card);
      }

      function showResults() {
        at = n;
        paint();
        countEl.textContent = "Done";
        const right = results.filter((r) => r === "right").length;
        const pct = Math.round((right / n) * 100);
        const box = el("article", "qresults card-in");
        const ring = el("div", "qring");
        ring.innerHTML = `<svg viewBox="0 0 36 36" aria-hidden="true"><circle class="ring-bg" cx="18" cy="18" r="15.9" pathLength="100"/><circle class="ring-fg" cx="18" cy="18" r="15.9" pathLength="100" stroke-dasharray="${pct} 100"/></svg>`;
        ring.append(el("b", "", `${right}/${n}`));
        const message =
          pct === 100
            ? "Perfect round."
            : pct >= 60
              ? "Solid. Keep going."
              : "Good practice. The explanations are the useful part.";
        const stats = el("ul", "qstats");
        const stat = (label: string, value: string) => {
          const li = el("li");
          li.append(el("b", "", value), el("span", "", label));
          stats.append(li);
        };
        stat("best streak", String(best));
        stat("new questions done", String(fresh));
        stat("tokens earned", String(earned));
        const again = el(
          "button",
          "btn primary",
          "Play another round",
        ) as HTMLButtonElement;
        again.type = "button";
        again.addEventListener("click", () =>
          q<HTMLButtonElement>("[data-session-shuffle]")?.click(),
        );
        box.append(
          ring,
          el("h3", "", message),
          stats,
          el(
            "p",
            "qnote",
            `${loadPractice().progress}/${PER_TOKEN} new right answers to your next game token.`,
          ),
          again,
        );
        stage.replaceChildren(box);
        if (pct >= 60 && !reduced()) {
          const r = ring.getBoundingClientRect();
          const h = host.getBoundingClientRect();
          const fake = document.createElement("span");
          fake.style.cssText = `position:absolute;left:${r.left - h.left}px;top:${r.top - h.top}px;width:${r.width}px;height:${r.height}px`;
          host.append(fake);
          burst(fake, host, true);
          fake.remove();
        }
      }

      showCard();
    }

    function renderSession() {
      const list = q("[data-session-list]");
      const text = q("[data-session-sum-text]");
      const start = q<HTMLAnchorElement>("[data-session-start]");
      if (!list || !text || !start) return;
      list.replaceChildren();
      start.hidden = true;
      showReward();
      const T = sess.time;
      const interests = getActiveProfile()?.interests ?? [];

      if (sess.mode === "practice") {
        const n = Math.max(3, Math.min(8, Math.round(T / 3)));
        const done = new Set(loadPractice().done);
        // Questions you have not answered right yet come first, then ones that
        // match your interests; within each group the order is the shuffle.
        const score = (x: Q) =>
          (done.has(x.id) ? 2 : 0) +
          (interests.length && !x.tags.some((t) => interests.includes(t))
            ? 1
            : 0);
        const ordered = shuffle(pool, rng(1)).sort(
          (a, b) => score(a) - score(b),
        );
        const chosen: Q[] = [];
        const units = new Set<string>();
        // One question per unit first, then fill up from the same units.
        for (const x of ordered) {
          if (units.has(`${x.track}/${x.slug}`)) continue;
          units.add(`${x.track}/${x.slug}`);
          chosen.push(x);
          if (chosen.length === n) break;
        }
        for (const x of ordered) {
          if (chosen.length >= n) break;
          if (!chosen.includes(x)) chosen.push(x);
        }
        renderArena(list.appendChild(el("li", "arena-li")), chosen);
        text.textContent = chosen.length
          ? `${chosen.length} questions from ${pool.length}, about ${T} minutes with thinking time.`
          : "No questions are published yet.";
        return;
      }

      type Item = { u: U; min: number; note?: string };
      let items: Item[] = [];
      let total = 0;
      if (sess.mode === "review") {
        let due = units
          .filter((u) => isDue(keyOf(u)))
          .sort(
            (a, b) =>
              (progressOf(keyOf(a))!.nextReviewAt ?? 0) -
              (progressOf(keyOf(b))!.nextReviewAt ?? 0),
          );
        if (sess.shuffled) due = shuffle(due, rng(2));
        for (const u of due) {
          if (total + 8 > T && items.length > 0) break;
          items.push({ u, min: 8 });
          total += 8;
        }
      } else {
        let ranked = rankTracks(interests);
        if (sess.shuffled) ranked = shuffle(ranked, rng(3));
        const queues = ranked.map((t) => nextUndone(t));
        // Round-robin across worlds, taking only units that still fit.
        let progress = true;
        while (progress && total < T) {
          progress = false;
          for (const queue of queues) {
            const idx = queue.findIndex((u) => total + u.m <= T * 1.1);
            if (idx === -1) continue;
            const [u] = queue.splice(idx, 1);
            items.push({ u: u!, min: u!.m });
            total += u!.m;
            progress = true;
            if (total >= T) break;
          }
        }
        if (items.length === 0) {
          // Nothing fits: offer the shortest next unit and say it runs over.
          const shortest = ranked
            .flatMap((t) => nextUndone(t).slice(0, 1))
            .sort((a, b) => a.m - b.m)[0];
          if (shortest) {
            items = [
              {
                u: shortest,
                min: shortest.m,
                note: `Runs ${shortest.m - T} min over`,
              },
            ];
            total = shortest.m;
          }
        }
      }

      if (items.length === 0) {
        const empty = el("li", "empty-state");
        empty.append(
          el(
            "b",
            "",
            sess.mode === "review"
              ? "Nothing is due for review."
              : "You have finished every published unit.",
          ),
          el(
            "span",
            "",
            sess.mode === "review"
              ? "Try a practice session instead."
              : "Try review or practice.",
          ),
        );
        list.append(empty);
        text.textContent = "Nothing to schedule.";
        return;
      }
      items.forEach(({ u, min, note }, k) => {
        const li = el("li", "si");
        li.style.setProperty("--uh", String(u.h));
        const a = el("a", "si-link") as HTMLAnchorElement;
        a.href = sess.mode === "review" ? "/review" : `/${u.t}/${u.s}/`;
        a.append(
          el("span", "si-n", String(k + 1)),
          el("span", "si-body"),
          el("span", "si-min", `${min} min`),
        );
        const body = q(".si-body", a)!;
        body.append(
          el("b", "", short(u.p)),
          el("i", "", note ? `${pretty(u.t)} · ${note}` : pretty(u.t)),
        );
        li.append(a);
        list.append(li);
      });
      text.textContent = `${items.length} ${items.length === 1 ? "item" : "items"}, about ${total} of ${T} minutes.`;
      start.href = q<HTMLAnchorElement>(".si-link", list)!.href;
      start.hidden = false;
    }

    function wireSession() {
      const root = q('[data-panel="session"]');
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";
      root.addEventListener("click", (e) => {
        const t = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-time],[data-mode],[data-session-shuffle]",
        );
        if (!t) return;
        if (t.dataset.time) sess.time = Number(t.dataset.time);
        if (t.dataset.mode) sess.mode = t.dataset.mode as typeof sess.mode;
        if (t.hasAttribute("data-session-shuffle")) {
          sess.seed = Math.floor(Math.random() * 2 ** 31);
          sess.shuffled = true;
        }
        for (const b of qa("[data-time]", root))
          b.setAttribute(
            "aria-pressed",
            String(Number(b.dataset.time) === sess.time),
          );
        for (const b of qa("[data-mode]", root))
          b.setAttribute("aria-pressed", String(b.dataset.mode === sess.mode));
        renderSession();
      });
      renderSession();
    }

    /* ---------------- skills map ---------------- */
    function paintSkills() {
      const doneByTagWorld = new Map<string, number>();
      const availByTag = new Map<string, number>();
      for (const u of units) {
        const done = isDone(keyOf(u));
        for (const tag of u.tg) {
          const k = `${tag}|${u.t}`;
          doneByTagWorld.set(k, (doneByTagWorld.get(k) ?? 0) + (done ? 1 : 0));
          availByTag.set(tag, (availByTag.get(tag) ?? 0) + 1);
        }
      }
      const remaining = new Map<string, number>();
      for (const cell of qa<HTMLButtonElement>("[data-cell]")) {
        const tag = cell.dataset.tag!;
        const avail = Number(cell.dataset.avail);
        const done = doneByTagWorld.get(`${tag}|${cell.dataset.world}`) ?? 0;
        cell.style.setProperty("--f", String(avail ? done / avail : 0));
        cell.classList.toggle("is-full", done === avail);
        cell.setAttribute(
          "aria-label",
          `${tag} in ${pretty(cell.dataset.world!)}: ${done} of ${avail} done`,
        );
        // The number is a link to the next unit still to do for this skill in
        // this world (or the first one when everything there is done).
        const here = units
          .filter((u) => u.t === cell.dataset.world && u.tg.includes(tag))
          .sort((a, b) => a.i - b.i);
        const target = here.find((u) => !isDone(keyOf(u))) ?? here[0];
        if (target) {
          cell.href = `/${target.t}/${target.s}/`;
          cell.title = `${done} of ${avail} done. ${done === avail ? "Review" : "Next"}: ${short(target.p)}`;
        }
        remaining.set(tag, (remaining.get(tag) ?? 0) + (avail - done));
      }
      // The five skills with the most units still to do are flagged as gaps.
      const ranked = [...remaining.entries()]
        .filter(([, n]) => n > 0)
        .sort(
          (a, b) =>
            b[1] - a[1] ||
            (availByTag.get(b[0]) ?? 0) - (availByTag.get(a[0]) ?? 0),
        )
        .slice(0, 5);
      const gapSet = new Set(ranked.map(([t]) => t));
      for (const row of qa("[data-row]")) {
        const flag = q("[data-gap-flag]", row);
        if (flag) flag.hidden = !gapSet.has(row.dataset.row!);
      }
      const gaps = q("[data-gaps]");
      if (gaps) {
        gaps.replaceChildren();
        if (ranked.length)
          gaps.append(el("span", "gaps-label", "Biggest gaps"));
        for (const [tag, n] of ranked) {
          const b = el("button", "gap-chip") as HTMLButtonElement;
          b.type = "button";
          b.append(tag, el("b", "", `${n} to do`));
          b.addEventListener("click", () => pickTag(tag, true));
          gaps.append(b);
        }
      }
    }

    function pickTag(tag: string, scroll = false) {
      for (const b of qa("[data-tag-pick]"))
        b.setAttribute("aria-pressed", String(b.dataset.tagPick === tag));
      const box = q("[data-tag-units]");
      const title = q("[data-tag-units-title]");
      const list = q("[data-tag-units-list]");
      if (!box || !title || !list) return;
      const hits = units
        .filter((u) => u.tg.includes(tag))
        .sort((a, b) => a.t.localeCompare(b.t) || a.i - b.i);
      const done = hits.filter((u) => isDone(keyOf(u))).length;
      title.textContent = `${tag}: ${done} of ${hits.length} done`;
      list.replaceChildren();
      for (const u of hits) {
        const li = el("li", isDone(keyOf(u)) ? "tu is-done" : "tu");
        li.style.setProperty("--uh", String(u.h));
        const a = el("a", "tu-link") as HTMLAnchorElement;
        a.href = `/${u.t}/${u.s}/`;
        a.append(
          el("span", "tu-state", isDone(keyOf(u)) ? "Done" : "To do"),
          el("b", "", short(u.p)),
          el("i", "", `${pretty(u.t)} · ${u.m} min`),
        );
        li.append(a);
        list.append(li);
      }
      box.hidden = false;
      if (scroll) box.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function wireSkills() {
      const root = q('[data-panel="skills"]');
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";
      root.addEventListener("click", (e) => {
        const t = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-tag-pick]",
        );
        if (!t) return;
        pickTag(t.dataset.tagPick!);
      });
      paintSkills();
    }

    /* ---------------- demos ---------------- */
    function wireDemos() {
      const root = q('[data-panel="demos"]');
      if (!root || root.dataset.wired === "true") return;
      root.dataset.wired = "true";
      root.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>(
          "[data-demo-filter]",
        );
        if (!b) return;
        const w = b.dataset.demoFilter!;
        for (const x of qa("[data-demo-filter]", root))
          x.setAttribute("aria-pressed", String(x === b));
        for (const c of qa("[data-demo-card]", root))
          c.hidden = w !== "all" && c.dataset.world !== w;
      });
    }

    function initStudy() {
      if (!q("[data-study]")) return;
      units = readJson<U[]>("study-units", []);
      byKey = new Map(units.map((u) => [keyOf(u), u]));
      pool = readJson<Q[]>("study-pool", []);
      wireTabs();
      selectTab(location.hash.slice(1) || "week", false);
      wirePlan();
      wireSession();
      wireSkills();
      wireDemos();
    }
    initStudy();
    document.addEventListener("astro:page-load", initStudy);
  </script>
</Layout>

