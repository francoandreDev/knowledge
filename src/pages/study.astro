  }
  :global(.dark) .chip[aria-pressed="true"] {
    border-color: #38bdf8;
    background: #082f49;
    color: #e0f2fe;
  }
  .chip:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }
  .seg {
    display: inline-flex;
    overflow: hidden;
    align-self: flex-end;
    border-radius: 0.75rem;
    border: 2px solid #0f172a;
  }
  :global(.dark) .seg {
    border-color: #f1f5f9;
  }
  .seg button {
    border: 0;
    background: #fff;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
    font-weight: 800;
    color: #334155;
    cursor: pointer;
  }
  :global(.dark) .seg button {
    background: #0f172a;
    color: #cbd5e1;
  }
  .seg button + button {
    border-left: 2px solid #0f172a;
  }
  :global(.dark) .seg button + button {
    border-left-color: #f1f5f9;
  }
  .seg button[aria-pressed="true"] {
    background: #0369a1;
    color: #fff;
  }
  .seg button:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: -3px;
  }

  /* week */
  .week-sum,
  .session-sum {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.9375rem;
    font-weight: 800;
  }
  .bar {
    display: block;
    height: 0.625rem;
    min-width: 8rem;
    flex: 1 1 10rem;
    overflow: hidden;
    border-radius: 999px;
    background: #e2e8f0;
  }
  :global(.dark) .bar {
    background: #334155;
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #0ea5e9, #10b981);
    transition: width 0.5s ease-out;
  }
  /* day picker */
  .days-field {
    align-self: flex-end;
  }
  .day-pick {
    display: inline-flex;
    gap: 0.25rem;
  }
  .day-pick button {
    min-width: 2.75rem;
    border-radius: 0.75rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding: 0.4375rem 0.375rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: none;
    color: #64748b;
    cursor: pointer;
    transition:
      transform 0.08s,
      border-color 0.08s;
  }
  :global(.dark) .day-pick button {
    border-color: #334155;
    background: #0f172a;
    color: #94a3b8;
  }
  .day-pick button[aria-pressed="true"] {
    border-color: #082f49;
    background: #0369a1;
    color: #fff;
    box-shadow: 0 3px 0 #082f49;
  }
  .day-pick button:hover {
    transform: translateY(-1px);
  }
  .day-pick button:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* week board */
  .week {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    align-items: start;
  }
  @media (min-width: 1180px) {
    .week {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
  .week :global(.day) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.625rem;
    overflow: hidden;
    border-radius: 1.125rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding: 0 0 0.625rem;
    box-shadow: 0 4px 0 #cbd5e1;
  }
  :global(.dark) .week :global(.day) {
    border-color: #334155;
    background: #0f172a;
    box-shadow: 0 4px 0 #334155;
  }
  .week :global(.day.is-today) {
    border-color: #0369a1;
    box-shadow: 0 5px 0 #0369a1;
  }
  .week :global(.day.is-past:not(.is-today)) {
    opacity: 0.7;
  }
  .week :global(.day.is-rest) {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }
  .week :global(.day-head) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    background: #f1f5f9;
    padding: 0.625rem 0.75rem;
    border-bottom: 2px solid #e2e8f0;
  }
  :global(.dark) .week :global(.day-head) {
    background: #1e293b;
    border-bottom-color: #334155;
  }
  .week :global(.day.is-today .day-head) {
    background: #e0f2fe;
    border-bottom-color: #bae6fd;
  }
  :global(.dark) .week :global(.day.is-today .day-head) {
    background: #082f49;
    border-bottom-color: #0c4a6e;
  }
  .week :global(.day-name) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .week :global(.day-name b) {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .week :global(.day-name i) {
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
  }
  .week :global(.day-today) {
    align-self: flex-start;
    border-radius: 999px;
    background: #0369a1;
    padding: 0 0.5rem;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .week :global(.day-meter) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .week :global(.day-meter-bar) {
    display: block;
    height: 0.4375rem;
    overflow: hidden;
    border-radius: 999px;
    background: #cbd5e1;
  }
  :global(.dark) .week :global(.day-meter-bar) {
    background: #475569;
  }
  .week :global(.day-meter-bar i) {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: #10b981;
    transition: width 0.4s ease-out;
  }
  .week :global(.day-meter-text) {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #64748b;
  }
  .week :global(.rest) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 1rem 0.75rem 0.5rem;
    color: #94a3b8;
  }
  .week :global(.rest-text) {
    font-size: 0.875rem;
    font-weight: 800;
  }
  .week :global(.rest-add) {
    border-radius: 999px;
    border: 2px solid #cbd5e1;
    background: transparent;
    padding: 0.125rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #475569;
    cursor: pointer;
  }
  :global(.dark) .week :global(.rest-add) {
    border-color: #475569;
    color: #cbd5e1;
  }
  .week :global(.rest-add:hover) {
    border-color: #0369a1;
    color: #0369a1;
  }
  .week :global(.blocks) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0.625rem;
    list-style: none;
  }
  .week :global(.block-rest) {
    padding: 0.5rem 0.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #94a3b8;
  }
  .week :global(.block) {
    --uc: hsl(var(--uh, 210) 65% 42%);
    --uc-soft: hsl(var(--uh, 210) 85% 94%);
    display: flex;
    gap: 0.5rem;
    border-radius: 0.875rem;
    border: 2px solid var(--uc);
    background: var(--uc-soft);
    padding: 0.5rem;
  }
  :global(.dark) .week :global(.block) {
    --uc: hsl(var(--uh, 210) 70% 68%);
    --uc-soft: hsl(var(--uh, 210) 40% 14%);
  }
  .week :global(.block.kind-review) {
    --uc: #c2410c;
    --uc-soft: #fff7ed;
  }
  :global(.dark) .week :global(.block.kind-review) {
    --uc: #fdba74;
    --uc-soft: #431407;
  }
  .week :global(.block.kind-practice) {
    --uc: #6d28d9;
    --uc-soft: #f5f3ff;
  }
  :global(.dark) .week :global(.block.kind-practice) {
    --uc: #c4b5fd;
    --uc-soft: #1e1b4b;
  }
  .week :global(.block.is-done) {
    border-style: dashed;
    opacity: 0.65;
  }
  .week :global(.block.is-done .block-title) {
    text-decoration: line-through;
  }
  .week :global(.block-ic) {
    display: flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    background: var(--uc);
    color: #fff;
  }
  :global(.dark) .week :global(.block-ic) {
    color: #0f172a;
  }
  .week :global(.block-link) {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
    color: inherit;
  }
  .week :global(.block-kind) {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--uc);
  }
  .week :global(.block-title) {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .week :global(.block-foot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }
  .week :global(.block-min) {
    border-radius: 999px;
    background: #fff;
    border: 1.5px solid var(--uc);
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--uc);
  }
  :global(.dark) .week :global(.block-min) {
    background: #0f172a;
  }
  .week :global(.check) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: 999px;
    border: 2px solid var(--uc);
    background: #fff;
    padding: 0.0625rem 0.5rem 0.0625rem 0.3125rem;
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--uc);
    cursor: pointer;
  }
  :global(.dark) .week :global(.check) {
    background: #0f172a;
  }
  .week :global(.check svg) {
    opacity: 0.35;
  }
  .week :global(.check[aria-pressed="true"]) {
    background: var(--uc);
    color: #fff;
  }
  :global(.dark) .week :global(.check[aria-pressed="true"]) {
    color: #0f172a;
  }
  .week :global(.check[aria-pressed="true"] svg) {
    opacity: 1;
  }
  .week :global(.check:focus-visible),
  .week :global(.block-link:focus-visible) {
    outline: 3px solid var(--uc);
    outline-offset: 2px;
  }

  /* session */
  .session-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .session-list :global(.si) {
    --uc: hsl(var(--uh, 210) 65% 42%);
    --uc-soft: hsl(var(--uh, 210) 85% 94%);
  }
  :global(.dark) .session-list :global(.si) {
    --uc: hsl(var(--uh, 210) 70% 68%);
    --uc-soft: hsl(var(--uh, 210) 40% 14%);
  }
  .session-list :global(.si-link) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 1rem;
    border: 2px solid #cbd5e1;
    border-left: 6px solid var(--uc);
    background: var(--uc-soft);
    padding: 0.625rem 0.875rem;
    color: inherit;
    box-shadow: 0 3px 0 #cbd5e1;
  }
  :global(.dark) .session-list :global(.si-link) {
    border-color: #334155;
    border-left-color: var(--uc);
    box-shadow: 0 3px 0 #334155;
  }
  .session-list :global(.si-link:hover) {
    border-color: var(--uc);
  }
  .session-list :global(.si-n) {
    display: flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--uc);
    font-weight: 800;
    color: #fff;
  }
  :global(.dark) .session-list :global(.si-n) {
    color: #0f172a;
  }
  .session-list :global(.si-body) {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }
  .session-list :global(.si-body b) {
    font-size: 0.9375rem;
    font-weight: 800;
  }
  .session-list :global(.si-body i) {
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: capitalize;
    color: #64748b;
  }
  .session-list :global(.si-min) {
    border-radius: 999px;
    background: #fff;
    border: 1.5px solid var(--uc);
    padding: 0 0.625rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--uc);
  }
  :global(.dark) .session-list :global(.si-min) {
    background: #0f172a;
  }
  .session-list :global(.empty-state) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-radius: 1rem;
    border: 2px dashed #cbd5e1;
    padding: 1rem;
    font-weight: 700;
    color: #64748b;
  }
  .session-list :global(.sq) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: 1rem;
    border: 2px solid #c4b5fd;
    background: #f5f3ff;
    padding: 0.75rem 0.875rem;
  }
  :global(.dark) .session-list :global(.sq) {
    border-color: #4c1d95;
    background: #1e1b4b;
  }
  .session-list :global(.sq-prompt) {
    font-size: 0.9375rem;
    font-weight: 800;
  }
  .session-list :global(.sq-choices) {
    display: grid;
    gap: 0.375rem;
  }
  .session-list :global(.sq-choice) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    border-radius: 0.75rem;
    border: 2px solid #c4b5fd;
    background: #fff;
    padding: 0.375rem 0.625rem;
    text-align: left;
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
  }
  :global(.dark) .session-list :global(.sq-choice) {
    border-color: #4c1d95;
    background: #0f172a;
    color: #f1f5f9;
  }
  .session-list :global(.sq-choice i) {
    display: flex;
    height: 1.5rem;
    width: 1.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #ede9fe;
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #5b21b6;
  }
  .session-list :global(.sq-choice:disabled) {
    cursor: default;
  }
  .session-list :global(.sq-choice.is-right) {
    border-color: #059669;
    background: #d1fae5;
    color: #064e3b;
  }
  .session-list :global(.sq-choice.is-wrong) {
    border-color: #dc2626;
    background: #fee2e2;
    color: #7f1d1d;
  }
  .session-list :global(.sq-after) {
    font-size: 0.8125rem;
    font-weight: 800;
  }
  .session-list :global(.sq-after a) {
    color: #5b21b6;
    text-decoration: underline;
  }
  :global(.dark) .session-list :global(.sq-after a) {
    color: #c4b5fd;
  }

  /* skills */
  .skills-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #64748b;
  }
  .legend i {
    display: block;
    height: 0.75rem;
    width: 8rem;
    border-radius: 999px;
    border: 1.5px solid #cbd5e1;
    background: linear-gradient(90deg, #fef3c7, #059669);
  }
  .gaps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .gaps :global(.gaps-label) {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b45309;
  }
  .gaps :global(.gap-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    border: 2px solid #fcd34d;
    background: #fffbeb;
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: capitalize;
    color: #92400e;
    cursor: pointer;
  }
  .gaps :global(.gap-chip b) {
    border-radius: 999px;
    background: #fde68a;
    padding: 0 0.375rem;
    font-size: 0.6875rem;
  }
  :global(.dark) .gaps :global(.gap-chip) {
    border-color: #92400e;
    background: #451a03;
    color: #fcd34d;
  }
  :global(.dark) .gaps :global(.gap-chip b) {
    background: #78350f;
  }
  .matrix-wrap {
    max-height: 34rem;
    overflow: auto;
    border-radius: 1rem;
    border: 2px solid #cbd5e1;
    background: #fff;
  }
  :global(.dark) .matrix-wrap {
    border-color: #334155;
    background: #0f172a;
  }
  .matrix {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.8125rem;
  }
  .matrix thead th {
    position: sticky;
    top: 0;
    z-index: 3;
    background: inherit;
    padding: 0.5rem 0.125rem 0.375rem;
    text-align: center;
    font-weight: 800;
    color: #475569;
    background-color: #fff;
  }
  :global(.dark) .matrix thead th {
    background-color: #0f172a;
    color: #cbd5e1;
  }
  .matrix .corner {
    left: 0;
    z-index: 4;
    min-width: 9.5rem;
    text-align: left;
    padding-left: 0.75rem;
  }
  .col-ic {
    display: flex;
    justify-content: center;
  }
  .col-name {
    display: block;
    max-height: 5.5rem;
    overflow: hidden;
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    text-transform: capitalize;
    writing-mode: vertical-rl;
    white-space: nowrap;
    margin-inline: auto;
  }
  .matrix tbody th {
    position: sticky;
    left: 0;
    z-index: 2;
    background-color: #fff;
    padding: 0.125rem 0.5rem 0.125rem 0.5rem;
    text-align: left;
  }
  :global(.dark) .matrix tbody th {
    background-color: #0f172a;
  }
  .matrix td {
    padding: 0.125rem;
    text-align: center;
  }
  .row-btn {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    border: 2px solid transparent;
    background: transparent;
    padding: 0.125rem 0.375rem;
    text-align: left;
    font-weight: 700;
    text-transform: capitalize;
    color: #334155;
    cursor: pointer;
  }
  :global(.dark) .row-btn {
    color: #cbd5e1;
  }
  .row-btn:hover,
  .row-btn[aria-pressed="true"] {
    border-color: #0369a1;
    background: #e0f2fe;
    color: #0c4a6e;
  }
  :global(.dark) .row-btn:hover,
  :global(.dark) .row-btn[aria-pressed="true"] {
    border-color: #38bdf8;
    background: #082f49;
    color: #e0f2fe;
  }
  .row-btn:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 1px;
  }
  .gap-flag {
    margin-left: auto;
    border-radius: 999px;
    background: #fde68a;
    padding: 0 0.375rem;
    font-style: normal;
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #92400e;
  }
  .gap-flag[hidden] {
    display: none;
  }
  .cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    height: 1.75rem;
    width: 1.75rem;
    border-radius: 0.5rem;
    border: 2px solid #fcd34d;
    background: color-mix(in srgb, #059669 calc(var(--f) * 100%), #fef3c7);
    font-size: 0.6875rem;
    font-weight: 800;
    color: #78350f;
    cursor: pointer;
  }
  .cell.is-full {
    border-color: #047857;
    color: #fff;
  }
  :global(.dark) .cell {
    border-color: #92400e;
    background: color-mix(in srgb, #10b981 calc(var(--f) * 100%), #3b1d06);
    color: #fde68a;
  }
  :global(.dark) .cell.is-full {
    border-color: #34d399;
    color: #052e16;
  }
  .cell:hover {
    transform: scale(1.12);
  }
  .cell:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 1px;
  }
  .tag-units {
    border-radius: 1rem;
    border: 2px solid #0369a1;
    background: #f0f9ff;
    padding: 0.875rem 1rem;
    box-shadow: 0 4px 0 #0369a1;
  }
  .tag-units[hidden] {
    display: none;
  }
  :global(.dark) .tag-units {
    border-color: #38bdf8;
    background: #082f49;
    box-shadow: 0 4px 0 #38bdf8;
  }
  .tag-units h3 {
    margin-bottom: 0.625rem;
