  .session-list :global(.step.wrong) {
    background: #ef4444;
  }
  .session-list :global(.arena-stage) {
    position: relative;
  }
  .session-list :global(.qcard),
  .session-list :global(.qresults) {
    --wc: hsl(var(--world-h, 260) 72% 38%);
    --wc-deep: hsl(var(--world-h, 260) 72% 18%);
    --wc-soft: hsl(var(--world-h, 260) 80% 95%);
    --wc-text: hsl(var(--world-h, 260) 70% 22%);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 2px solid var(--wc);
    background: #fff;
    padding: 0 0 1rem;
    box-shadow: 0 5px 0 var(--wc);
  }
  :global(.dark) .session-list :global(.qcard),
  :global(.dark) .session-list :global(.qresults) {
    --wc: hsl(var(--world-h, 260) 80% 62%);
    --wc-deep: hsl(var(--world-h, 260) 68% 16%);
    --wc-soft: hsl(var(--world-h, 260) 45% 14%);
