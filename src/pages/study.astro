  .demo-title {
    padding: 0.25rem 0.875rem 0;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .demo-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 0 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #64748b;
  }
  .demo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: auto;
    padding: 0.25rem 0.875rem 0;
  }
  .dm {
    border-radius: 999px;
    background: #e2e8f0;
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
