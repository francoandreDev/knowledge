  /* demos */
  .demo-grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .demo-grid li[hidden] {
    display: none;
  }
  .demo {
    --wc: hsl(var(--world-h) 72% 38%);
    --wc-soft: hsl(var(--world-h) 80% 95%);
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.375rem;
    overflow: hidden;
    border-radius: 1.125rem;
    border: 2px solid #cbd5e1;
    background: #fff;
    padding: 0 0 0.75rem;
    color: #0f172a;
