---
import Layout from "../layouts/Layout.astro";
import HubHeader from "../components/HubHeader.astro";
import { BookOpen, Flame } from "lucide-astro";
import { roadmap } from "../data/roadmap";
import { loadHomeData } from "../lib/home-data";

const { writtenUnits, totalUnits, tracksStarted } = await loadHomeData();
const totalWritten = writtenUnits.length;
---

<Layout title="Stats & streak">
  <HubHeader
    title="Stats & streak"
    subtitle="Day-over-day continuity beats a weekly quota. One finished unit a day keeps the chain alive."
  />

  <div class="mt-8 flex max-w-md flex-col gap-3">
    <div
      class="flex items-center gap-2 rounded-lg border border-dashed border-slate-300 px-3 py-2 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-500"
    >
      <BookOpen class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
      <span>
        Full curriculum live — <span class="tabular-nums"
          >{totalWritten}/{totalUnits}</span
        > units ·
        <span class="tabular-nums">{tracksStarted}/{roadmap.tracks.length}</span
        > tracks ·
        <span class="tabular-nums"
          >{Math.round((totalWritten / totalUnits) * 100)}%</span
        > of the roadmap
      </span>
    </div>

    <div
      data-streak-gauge
      class="rounded-lg border border-slate-200 bg-white p-3 sm:max-w-xs dark:border-slate-800 dark:bg-slate-900/50"
    >
      <div data-streak-active>
        <div
          data-streak-icon-row
          class="flex items-center gap-1.5 text-slate-400 dark:text-slate-600"
        >
          <Flame class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
          <span class="text-[10px] font-semibold tracking-wide uppercase"
            >Streak</span
          >
        </div>
        <p data-streak-label class="mt-1 text-xl font-bold tabular-nums">
          0 days
        </p>
        <div
          data-streak-strip
          class="mt-1.5 flex items-center gap-1"
          aria-hidden="true"
        >
          {
            Array.from({ length: 7 }).map(() => (
              <span
                data-day-dot
                class="h-1.5 w-1.5 rounded-full bg-slate-200 dark:bg-slate-700"
              />
            ))
          }
        </div>
      </div>
      <div data-streak-invite class="hidden items-center gap-3">
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
          style="background: color-mix(in srgb, var(--gauge-warn) 15%, transparent)"
        >
          <Flame
            class="h-4 w-4"
            style="color: var(--gauge-warn)"
            aria-hidden="true"
          />
        </span>
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
            Start your streak today
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-500">
            Finish one unit to light it up.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { computeStreak, isDayActive } from "../lib/progress-gauges";

    function renderStreak() {
      const streakActive = document.querySelector<HTMLElement>(
        "[data-streak-active]",
      );
      const streakInvite = document.querySelector<HTMLElement>(
        "[data-streak-invite]",
      );
      const streakLabel = document.querySelector<HTMLElement>(
        "[data-streak-label]",
      );
      const streakIconRow = document.querySelector<HTMLElement>(
        "[data-streak-icon-row]",
      );
      const dayDots = document.querySelectorAll<HTMLElement>(
        "[data-streak-strip] [data-day-dot]",
      );
      const { current, longest, activeToday } = computeStreak();

      // A "0 days" streak with seven empty dots reads as a failure state on
      // a reader's very first visit — swap it for an invitation instead of
      // showing an empty chart. Only once a real streak exists does the
      // dots view (which can show it slipping) earn its place.
      streakActive?.classList.toggle("hidden", current === 0);
      streakInvite?.classList.toggle("hidden", current > 0);
      streakInvite?.classList.toggle("flex", current === 0);
      if (current === 0) return;

      if (streakLabel) {
        streakLabel.textContent = current === 1 ? "1 day" : `${current} days`;
        streakLabel.title = activeToday
          ? `${current}-day streak — you're in today. Best: ${longest}.`
          : current > 0
            ? `${current}-day streak — do one unit today to keep it alive. Best: ${longest}.`
            : `No active streak yet. Best so far: ${longest}.`;
      }
      if (streakIconRow) {
        const lit = current > 0;
        streakIconRow.classList.toggle("text-orange-500", lit);
        streakIconRow.classList.toggle("dark:text-orange-400", lit);
        streakIconRow.classList.toggle("text-slate-400", !lit);
        streakIconRow.classList.toggle("dark:text-slate-600", !lit);
      }

      const DAY_MS = 24 * 60 * 60 * 1000;
      const today = Date.now();
      dayDots.forEach((dot, i) => {
        // Dots run oldest (6 days ago) to newest (today), left to right.
        const offsetFromToday = dayDots.length - 1 - i;
        const active = isDayActive(today - offsetFromToday * DAY_MS);
        dot.classList.toggle("bg-orange-400", active);
        dot.classList.toggle("dark:bg-orange-500", active);
        dot.classList.toggle("bg-slate-200", !active);
        dot.classList.toggle("dark:bg-slate-700", !active);
      });
    }
    renderStreak();
    document.addEventListener("astro:page-load", renderStreak);
  </script>
</Layout>
