---
import { HelpCircle } from "lucide-astro";

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<div class="checkpoint-box not-prose my-6 rounded-lg border border-dashed p-4">
  <div class="flex items-start gap-2">
    <HelpCircle
      class="mt-0.5 h-4 w-4 shrink-0"
      style="color: var(--accent-text)"
      aria-hidden="true"
    />
    <p class="text-sm font-medium text-slate-800 dark:text-slate-200">
      {question}
    </p>
  </div>
  <button
    type="button"
    data-checkpoint-toggle
    class="mt-3 inline-flex items-center gap-1 text-xs font-semibold tracking-wide uppercase"
    style="color: var(--accent-text)"
  >
    Show answer
  </button>
  <div
    data-checkpoint-answer
    class="prose prose-sm dark:prose-invert mt-3 hidden max-w-none border-t border-slate-200 pt-3 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 dark:border-slate-700"
  >
    <slot />
  </div>
</div>

<script>
  function wireCheckpoints() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-checkpoint-toggle]")
      .forEach((button) => {
        if (button.dataset.wired === "true") return;
        button.dataset.wired = "true";

        const answer = button.nextElementSibling as HTMLElement | null;
        if (!answer) return;

        button.addEventListener("click", () => {
          const isHidden = answer.classList.contains("hidden");
          if (isHidden) {
            answer.classList.remove("hidden");
            // Re-trigger a fresh reveal even on a repeated show/hide cycle —
            // see LevelTabs.astro's activateTab for why a class already
            // present won't replay its animation without this.
            answer.classList.remove("animate-fade-slide-in");
            void answer.offsetWidth;
            answer.classList.add("animate-fade-slide-in");
            button.textContent = "Hide answer";
          } else {
            answer.classList.add("hidden");
            button.textContent = "Show answer";
          }
        });
      });
  }

  wireCheckpoints();
  document.addEventListener("astro:page-load", wireCheckpoints);
</script>
