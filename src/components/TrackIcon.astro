---
import {
  Globe,
  Server,
  GitBranch,
  MessageCircle,
  Puzzle,
  Shield,
  Rocket,
  TrendingUp,
  Briefcase,
  Swords,
  BookOpen,
  Calculator,
  Bug,
  Blocks,
  HeartPulse,
  Users,
} from "lucide-astro";

interface Props {
  track: string;
  class?: string;
}

const { track, class: className = "" } = Astro.props;

const ICONS: Record<string, typeof Globe> = {
  web: Globe,
  systems: Server,
  "git-teamwork": GitBranch,
  "business-communication": MessageCircle,
  logic: Puzzle,
  security: Shield,
  "infra-delivery": Rocket,
  "career-craft": TrendingUp,
  "product-domain": Briefcase,
  "corporate-politics": Swords,
  "learning-craft": BookOpen,
  "applied-math": Calculator,
  "testing-quality": Bug,
  "software-design": Blocks,
  "sustainable-performance": HeartPulse,
  "people-management": Users,
};

const Icon = ICONS[track] ?? Globe;
---

<Icon class={className} aria-hidden="true" />
