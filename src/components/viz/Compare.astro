---
// Two options side by side (before/after, approach A vs B). Each side has a
// title and up to ~6 short lines (~34 chars each: SVG text doesn't wrap).
// Left uses --viz-4 (warm), right uses --viz-3 (green) by default; pass
// `neutral` to use two cool tones when neither side is "the fix".
//
//   <Compare left={{ title: "Polling", items: ["Client asks", "Wasted calls"] }}
//            right={{ title: "Push", items: ["Server tells", "Instant"] }} />
interface Side {
  title: string;
  items: string[];
}
interface Props {
  left: Side;
  right: Side;
  neutral?: boolean;
  caption?: string;
}

const { left, right, neutral = false, caption } = Astro.props;

const rows = Math.max(left.items.length, right.items.length);
const width = 700;
const colW = 330;
const height = 64 + rows * 28 + 16;
const colors = neutral
  ? ["var(--viz-1)", "var(--viz-2)"]
  : ["var(--viz-4)", "var(--viz-3)"];
const sides = [left, right];
---

<figure class="not-prose my-6">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="mx-auto h-auto w-full max-w-3xl"
    role="img"
    aria-label={caption ?? `${left.title} versus ${right.title}`}
  >
    {
      sides.map((side, s) => {
        const x = 4 + s * (colW + 32);
        const c = colors[s];
        return (
          <g>
            <rect
              x={x}
              y="4"
              width={colW}
              height={height - 8}
              rx="12"
              fill={`color-mix(in srgb, ${c} 12%, transparent)`}
              stroke={c}
              stroke-width="2"
            />
            <rect
              x={x}
              y="4"
              width={colW}
              height="40"
              rx="12"
              fill={c}
              opacity="0.9"
            />
            <text
              x={x + 18}
              y="30"
              font-size="16"
              font-weight="700"
              fill="#0f172a"
            >
              {side.title}
            </text>
            {side.items.map((item, i) => (
              <g>
                <circle cx={x + 24} cy={69 + i * 28} r="4" fill={c} />
                <text
                  x={x + 38}
                  y={74 + i * 28}
                  font-size="14"
                  fill="currentColor"
                >
                  {item}
                </text>
              </g>
            ))}
          </g>
        );
      })
    }
  </svg>
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {caption}
      </figcaption>
    )
  }
</figure>
