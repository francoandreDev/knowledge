---
// Horizontal sequence of dated/ordered events: a rollout, an incident, an
// escalation path. Alternates labels above/below the line so neighbours don't
// collide. Keep `label` short (~22 chars) and `note` optional and shorter.
//
//   <Timeline events={[{ when: "Day 1", label: "Announce", note: "all hands" }, ...]} />
interface Event {
  when: string;
  label: string;
  note?: string;
}
interface Props {
  events: Event[];
  caption?: string;
}

const { events, caption } = Astro.props;

const width = 720;
const height = 190;
const pad = 70;
const lineY = height / 2;
const step = events.length > 1 ? (width - pad * 2) / (events.length - 1) : 0;
---

<figure class="not-prose my-6">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="mx-auto h-auto w-full max-w-3xl"
    role="img"
    aria-label={caption ??
      events.map((e) => `${e.when}: ${e.label}`).join("; ")}
  >
    <line
      x1={pad - 30}
      y1={lineY}
      x2={width - pad + 30}
      y2={lineY}
      stroke="currentColor"
      stroke-width="2"
      opacity="0.35"
      stroke-linecap="round"></line>
    {
      events.map((e, i) => {
        const x = events.length > 1 ? pad + i * step : width / 2;
        const up = i % 2 === 0;
        const c = `var(--viz-${(i % 6) + 1})`;
        const base = up ? lineY - 34 : lineY + 44;
        return (
          <g text-anchor="middle">
            <circle cx={x} cy={lineY} r="9" fill={c} />
            <line
              x1={x}
              x2={x}
              y1={lineY + (up ? -10 : 10)}
              y2={lineY + (up ? -24 : 24)}
              stroke={c}
              stroke-width="2"
            />
            <text
              x={x}
              y={up ? base - 28 : base - 14}
              font-size="12"
              fill={c}
              font-weight="700"
            >
              {e.when}
            </text>
            <text
              x={x}
              y={up ? base - 12 : base + 2}
              font-size="14"
              font-weight="600"
              fill="currentColor"
            >
              {e.label}
            </text>
            {e.note && (
              <text
                x={x}
                y={up ? base + 4 : base + 18}
                font-size="12"
                fill="currentColor"
                opacity="0.7"
              >
                {e.note}
              </text>
            )}
          </g>
        );
      })
    }
  </svg>
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {caption}
      </figcaption>
    )
  }
</figure>
