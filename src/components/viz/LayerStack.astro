---
// A stack of labelled layers (OSI-style, request path, architecture tiers).
// Plain data in, inline SVG out; colors come from the shared --viz-N palette
// so it follows light/dark. Keep labels short (~40 chars): SVG text doesn't wrap.
//
//   <LayerStack layers={[{ label: "Browser", note: "renders HTML" }, ...]} />
interface Layer {
  label: string;
  note?: string;
}
interface Props {
  layers: Layer[];
  /** Draw a down arrow between layers (a request passing through). */
  arrows?: boolean;
  caption?: string;
}

const { layers, arrows = false, caption } = Astro.props;

const rowH = 52;
const gap = arrows ? 22 : 8;
const width = 640;
const height = layers.length * rowH + (layers.length - 1) * gap + 8;
---

<figure class="not-prose my-6">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="mx-auto h-auto w-full max-w-2xl"
    role="img"
    aria-label={caption ?? layers.map((l) => l.label).join(", ")}
  >
    {
      layers.map((layer, i) => {
        const y = 4 + i * (rowH + gap);
        const c = `var(--viz-${(i % 6) + 1})`;
        return (
          <g>
            <rect
              x="4"
              y={y}
              width={width - 8}
              height={rowH}
              rx="10"
              fill={`color-mix(in srgb, ${c} 16%, transparent)`}
              stroke={c}
              stroke-width="2"
            />
            <text
              x="24"
              y={y + (layer.note ? 22 : 31)}
              font-size="16"
              font-weight="600"
              fill="currentColor"
            >
              {layer.label}
            </text>
            {layer.note && (
              <text
                x="24"
                y={y + 41}
                font-size="13"
                fill="currentColor"
                opacity="0.7"
              >
                {layer.note}
              </text>
            )}
            {arrows && i < layers.length - 1 && (
              <path
                d={`M ${width / 2} ${y + rowH + 3} v ${gap - 9} m -5 -5 l 5 5 l 5 -5`}
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.6"
              />
            )}
          </g>
        );
      })
    }
  </svg>
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {caption}
      </figcaption>
    )
  }
</figure>
