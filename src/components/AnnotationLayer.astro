---
// Mounted once per unit content page. Makes three kinds of text clickable
// inside `.prose-panel` content:
//   1. Author `<Term>` components (Term.astro) — shows the author's
//      `define` text, plus the reader's own note if they've added one.
//   2. Existing **bold**/`code` text that predates this feature — clicking
//      it opens the composer directly (there's no author definition for
//      old content to show, so the click invites the reader's own note).
//   3. Any freely selected span of prose — a small toolbar offers "Add
//      note" for the current selection.
// All reader-authored data is IndexedDB-backed (annotations-db.ts), scoped
// to the active profile, never sent anywhere.
import { X, Trash2, Pencil, Link2, BookOpen } from "lucide-astro";
---

<dialog
  data-annotation-modal
  class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-0 text-slate-900 backdrop:bg-slate-950/60 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100"
>
  <div class="p-5">
    <div class="flex items-start justify-between gap-4">
      <p
        data-annotation-quote
        class="text-sm font-semibold text-slate-900 dark:text-slate-100"
      >
      </p>
      <button
        type="button"
        data-annotation-close
        aria-label="Close"
        class="shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <X class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div
      data-annotation-official
      class="mt-3 hidden rounded-lg border p-3 scenario-box"
    >
      <p
        class="scenario-box-label text-xs font-semibold tracking-wide uppercase"
      >
        Definition
      </p>
      <p
        data-annotation-official-text
        class="mt-1 text-sm text-slate-800 dark:text-slate-200"
      >
      </p>
    </div>

    <div data-annotation-view class="mt-3 hidden">
      <p
        class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        Your note
      </p>
      <p
        data-annotation-view-definition
        class="mt-1 hidden text-sm text-slate-700 dark:text-slate-300"
      >
      </p>
      <a
        data-annotation-view-link
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 hidden items-center gap-1 text-sm font-medium underline decoration-2 underline-offset-2"
        style="color: var(--accent-text)"
      >
        <Link2 class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        <span data-annotation-view-link-text></span>
      </a>
      <div class="mt-2 flex items-center gap-3">
        <button
          type="button"
          data-annotation-edit
          class="inline-flex items-center gap-1 text-xs font-medium hover:underline"
          style="color: var(--accent-text)"
        >
          <Pencil class="h-3 w-3" aria-hidden="true" />
          Edit
        </button>
        <button
          type="button"
          data-annotation-delete
          class="inline-flex items-center gap-1 text-xs font-medium text-red-600 hover:underline dark:text-red-400"
        >
          <Trash2 class="h-3 w-3" aria-hidden="true" />
          Delete
        </button>
      </div>
    </div>

    <button
      type="button"
      data-annotation-add-note-button
      class="mt-3 inline-flex items-center gap-1 text-xs font-medium hover:underline"
      style="color: var(--accent-text)"
    >
      <BookOpen class="h-3.5 w-3.5" aria-hidden="true" />
      Add your own note
    </button>

    <div data-annotation-form class="mt-3 hidden">
      <div
        class="flex gap-1 rounded-lg border border-slate-200 p-1 dark:border-slate-800"
        role="tablist"
      >
        <button
          type="button"
          data-annotation-type="definition"
          aria-pressed="true"
          class="flex-1 rounded-md px-2 py-1.5 text-xs font-semibold text-slate-500 transition aria-pressed:bg-slate-900 aria-pressed:text-white dark:text-slate-400 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900"
        >
          Definition
        </button>
        <button
          type="button"
          data-annotation-type="link"
          aria-pressed="false"
          class="flex-1 rounded-md px-2 py-1.5 text-xs font-semibold text-slate-500 transition aria-pressed:bg-slate-900 aria-pressed:text-white dark:text-slate-400 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900"
        >
          Link
        </button>
      </div>
      <textarea
        data-annotation-input-definition
        rows="3"
        placeholder="Your own definition or note..."
        class="mt-2 w-full resize-none rounded-lg border border-slate-300 bg-white p-2.5 text-sm outline-none focus:border-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:focus:border-slate-500"
      ></textarea>
      <input
        type="url"
        data-annotation-input-link
        placeholder="https://..."
        class="mt-2 hidden w-full rounded-lg border border-slate-300 bg-white p-2.5 text-sm outline-none focus:border-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:focus:border-slate-500"
      />
      <p
        data-annotation-error
        class="mt-1.5 hidden text-xs text-red-600 dark:text-red-400"
      >
      </p>
      <div class="mt-3 flex items-center gap-2">
        <button
          type="button"
          data-annotation-save
          class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
        >
          Save
        </button>
        <button
          type="button"
          data-annotation-cancel
          class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</dialog>

<div
  data-selection-toolbar
  class="fixed z-50 hidden -translate-x-1/2 -translate-y-full"
>
  <button
    type="button"
    data-selection-add-note
    class="flex items-center gap-1.5 rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold whitespace-nowrap text-white shadow-lg transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
  >
    <BookOpen class="h-3.5 w-3.5" aria-hidden="true" />
    Add note
  </button>
</div>

<script>
  import { getActiveProfile } from "../lib/profile";
  import {
    getAnnotationsForPage,
    saveAnnotation,
    deleteAnnotation,
    annotationId,
    type AnnotationRecord,
    type AnnotationType,
  } from "../lib/annotations-db";
  import {
    anchorFromRange,
    anchorFromElement,
    resolveAnchor,
    wrapRange,
    type Anchor,
  } from "../lib/annotation-anchor";

  const RETROACTIVE_SELECTOR = ".prose-panel :is(strong, :not(pre) > code)";

  function initAnnotationLayer() {
    const modal = document.querySelector<HTMLDialogElement>(
      "[data-annotation-modal]",
    );
    const toolbar = document.querySelector<HTMLElement>(
      "[data-selection-toolbar]",
    );
    if (!modal || !toolbar) return;
    if (modal.dataset.wired === "true") return;
    modal.dataset.wired = "true";

    const profile = getActiveProfile();
    const pagePath = location.pathname;
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>(".prose-panel"),
    );
    if (!profile || panels.length === 0) return;
    const profileId = profile.id;

    const els = {
      quote: modal.querySelector<HTMLElement>("[data-annotation-quote]")!,
      official: modal.querySelector<HTMLElement>("[data-annotation-official]")!,
      officialText: modal.querySelector<HTMLElement>(
        "[data-annotation-official-text]",
      )!,
      view: modal.querySelector<HTMLElement>("[data-annotation-view]")!,
      viewDefinition: modal.querySelector<HTMLElement>(
        "[data-annotation-view-definition]",
      )!,
      viewLink: modal.querySelector<HTMLAnchorElement>(
        "[data-annotation-view-link]",
      )!,
      viewLinkText: modal.querySelector<HTMLElement>(
        "[data-annotation-view-link-text]",
      )!,
      editBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-edit]",
      )!,
      deleteBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-delete]",
      )!,
      addNoteBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-add-note-button]",
      )!,
      form: modal.querySelector<HTMLElement>("[data-annotation-form]")!,
      typeButtons: Array.from(
        modal.querySelectorAll<HTMLButtonElement>("[data-annotation-type]"),
      ),
      inputDefinition: modal.querySelector<HTMLTextAreaElement>(
        "[data-annotation-input-definition]",
      )!,
      inputLink: modal.querySelector<HTMLInputElement>(
        "[data-annotation-input-link]",
      )!,
      error: modal.querySelector<HTMLElement>("[data-annotation-error]")!,
      saveBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-save]",
      )!,
      cancelBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-cancel]",
      )!,
      closeBtn: modal.querySelector<HTMLButtonElement>(
        "[data-annotation-close]",
      )!,
    };
    const toolbarBtn = toolbar.querySelector<HTMLButtonElement>(
      "[data-selection-add-note]",
    )!;

    // ---- state for whatever the modal currently has open ----
    let currentAnchor: Anchor | null = null;
    let currentRecordId: string | null = null;
    let currentPanel: HTMLElement | null = null;
    let currentTermDefine: string | null = null;
    let currentFormType: AnnotationType = "definition";
    const byId = new Map<string, AnnotationRecord>();

    function setFormType(type: AnnotationType) {
      currentFormType = type;
      els.typeButtons.forEach((b) =>
        b.setAttribute(
          "aria-pressed",
          String(b.dataset.annotationType === type),
        ),
      );
      els.inputDefinition.classList.toggle("hidden", type !== "definition");
      els.inputLink.classList.toggle("hidden", type !== "link");
      els.error.classList.add("hidden");
    }

    function resetModal() {
      els.official.classList.add("hidden");
      els.view.classList.add("hidden");
      els.form.classList.add("hidden");
      els.addNoteBtn.classList.remove("hidden");
      els.viewDefinition.classList.add("hidden");
      els.viewLink.classList.add("hidden");
      els.inputDefinition.value = "";
      els.inputLink.value = "";
      setFormType("definition");
    }

    function showComposer() {
      els.form.classList.remove("hidden");
      els.view.classList.add("hidden");
      els.addNoteBtn.classList.add("hidden");
      const existing = currentRecordId ? byId.get(currentRecordId) : null;
      if (existing) {
        setFormType(existing.type);
        if (existing.type === "definition")
          els.inputDefinition.value = existing.content;
        else els.inputLink.value = existing.content;
      }
      (currentFormType === "definition"
        ? els.inputDefinition
        : els.inputLink
      ).focus();
    }

    function showView(record: AnnotationRecord) {
      els.view.classList.remove("hidden");
      els.form.classList.add("hidden");
      els.addNoteBtn.classList.add("hidden");
      if (record.type === "definition") {
        els.viewDefinition.textContent = record.content;
        els.viewDefinition.classList.remove("hidden");
        els.viewLink.classList.add("hidden");
      } else {
        els.viewLinkText.textContent = record.content;
        els.viewLink.href = record.content;
        els.viewLink.classList.remove("hidden");
        els.viewDefinition.classList.add("hidden");
      }
    }

    /** Opens the modal for a given anchor. `recordId` may already exist (a saved user note) or not (nothing saved yet for this anchor). */
    function openModal(
      anchor: Anchor,
      panel: HTMLElement,
      opts: { termDefine?: string | null } = {},
    ) {
      currentAnchor = anchor;
      currentPanel = panel;
      currentTermDefine = opts.termDefine ?? null;
      currentRecordId = annotationId(
        profileId,
        pagePath,
        anchor.quote,
        anchor.prefix,
        anchor.suffix,
      );
      resetModal();
      els.quote.textContent = anchor.quote;

      if (currentTermDefine) {
        els.official.classList.remove("hidden");
        els.officialText.textContent = currentTermDefine;
      }

      const existing = byId.get(currentRecordId);
      if (existing) {
        showView(existing);
      } else if (currentTermDefine) {
        // An author definition exists — default to just showing it, with
        // "add your own note" available rather than forcing the composer.
      } else {
        // No official definition and no saved note yet (the retroactive
        // bold/code path, or a fresh free-text selection) — go straight to
        // composing since there's nothing else useful to show.
        showComposer();
      }

      modal!.showModal();
    }

    async function persistCurrent() {
      if (!currentAnchor || !currentRecordId) return;
      const content =
        currentFormType === "definition"
          ? els.inputDefinition.value.trim()
          : els.inputLink.value.trim();
      if (!content) {
        els.error.textContent =
          currentFormType === "definition"
            ? "Write something first."
            : "Enter a URL first.";
        els.error.classList.remove("hidden");
        return;
      }
      if (currentFormType === "link") {
        try {
          new URL(content);
        } catch {
          els.error.textContent = "That doesn't look like a valid URL.";
          els.error.classList.remove("hidden");
          return;
        }
      }
      const now = Date.now();
      const existing = byId.get(currentRecordId);
      const record: AnnotationRecord = {
        id: currentRecordId,
        profileId,
        pagePath,
        quote: currentAnchor.quote,
        prefix: currentAnchor.prefix,
        suffix: currentAnchor.suffix,
        type: currentFormType,
        content,
        createdAt: existing?.createdAt ?? now,
        updatedAt: now,
      };
      await saveAnnotation(record);
      byId.set(record.id, record);
      renderMarkForRecord(record, currentPanel);
      showView(record);
    }

    async function deleteCurrent() {
      if (!currentRecordId) return;
      await deleteAnnotation(currentRecordId);
      byId.delete(currentRecordId);
      const mark = document.querySelector<HTMLElement>(
        `[data-annotation-id="${CSS.escape(currentRecordId)}"]`,
      );
      if (mark) {
        // Unwrap: replace the mark with its own contents.
        const parent = mark.parentNode;
        if (parent) {
          while (mark.firstChild) parent.insertBefore(mark.firstChild, mark);
          parent.removeChild(mark);
          parent.normalize();
        }
      }
      modal!.close();
    }

    function renderMarkForRecord(
      record: AnnotationRecord,
      panel: HTMLElement | null,
    ) {
      if (!panel) return;
      // Already rendered (editing an existing mark) — nothing to wrap.
      if (
        document.querySelector(
          `[data-annotation-id="${CSS.escape(record.id)}"]`,
        )
      ) {
        return;
      }
      const range = resolveAnchor(panel, {
        quote: record.quote,
        prefix: record.prefix,
        suffix: record.suffix,
      });
      if (!range) return;
      const mark = document.createElement("mark");
      mark.className = "annotation-mark";
      mark.dataset.annotationId = record.id;
      mark.dataset.annotationType = record.type;
      mark.title =
        record.type === "link"
          ? "Click to open · Shift+click to edit"
          : "Click for your note";
      wrapRange(range, mark);
    }

    async function loadAndRenderExisting() {
      const records = await getAnnotationsForPage(profileId, pagePath);
      for (const record of records) {
        byId.set(record.id, record);
        for (const panel of panels) {
          if (
            (panel.textContent ?? "").includes(record.prefix + record.quote)
          ) {
            renderMarkForRecord(record, panel);
            break;
          }
        }
      }
    }

    // ---- click delegation across every prose panel ----
    function findPanel(el: Element): HTMLElement | null {
      return el.closest<HTMLElement>(".prose-panel");
    }

    panels.forEach((panel) => {
      panel.addEventListener("click", (e) => {
        const target = e.target as Element;

        const existingMark = target.closest<HTMLElement>(
          "[data-annotation-id]",
        );
        if (existingMark) {
          const id = existingMark.dataset.annotationId!;
          const record = byId.get(id);
          if (!record) return;
          // A link-type note behaves like a real link by default — it
          // navigates, it doesn't detour through a modal. Shift+click (or
          // a plain click on a definition-type note) opens the modal.
          if (record.type === "link" && !(e as MouseEvent).shiftKey) {
            window.open(record.content, "_blank", "noopener,noreferrer");
            return;
          }
          openModal(
            {
              quote: record.quote,
              prefix: record.prefix,
              suffix: record.suffix,
            },
            panel,
          );
          return;
        }

        const term = target.closest<HTMLElement>("[data-term]");
        if (term) {
          const root = findPanel(term);
          if (!root) return;
          const anchor = anchorFromElement(term, root);
          openModal(anchor, root, {
            termDefine: term.dataset.termDefine ?? null,
          });
          return;
        }

        const retro = target.closest<HTMLElement>(RETROACTIVE_SELECTOR);
        if (retro && !retro.closest("[data-term]")) {
          const root = findPanel(retro);
          if (!root) return;
          const anchor = anchorFromElement(retro, root);
          openModal(anchor, root);
        }
      });
    });

    // ---- free-text selection toolbar ----
    function hideToolbar() {
      toolbar!.classList.add("hidden");
    }

    document.addEventListener("selectionchange", () => {
      const selection = document.getSelection();
      if (!selection || selection.isCollapsed || selection.rangeCount === 0) {
        hideToolbar();
        return;
      }
      const range = selection.getRangeAt(0);
      const panel = findPanel(
        range.startContainer.parentElement ?? document.body,
      );
      if (
        !panel ||
        !panels.includes(panel) ||
        !panel.contains(range.endContainer)
      ) {
        hideToolbar();
        return;
      }
      const text = selection.toString().trim();
      if (!text) {
        hideToolbar();
        return;
      }
      const rect = range.getBoundingClientRect();
      toolbar!.style.left = `${rect.left + rect.width / 2}px`;
      toolbar!.style.top = `${rect.top - 8}px`;
      toolbar!.classList.remove("hidden");
      toolbar!.dataset.pendingPanel = "";
      (toolbar as HTMLElement & { _panel?: HTMLElement })._panel = panel;
    });

    // Clicking the toolbar itself would otherwise collapse the live text
    // selection before the click handler below runs (the browser's default
    // "click elsewhere clears selection" behavior) — preventDefault on
    // mousedown keeps the selection intact through the click.
    toolbarBtn.addEventListener("mousedown", (e) => e.preventDefault());
    toolbarBtn.addEventListener("click", () => {
      const selection = document.getSelection();
      const panel = (toolbar as HTMLElement & { _panel?: HTMLElement })._panel;
      if (!selection || selection.rangeCount === 0 || !panel) return;
      const range = selection.getRangeAt(0);
      const anchor = anchorFromRange(range, panel);
      hideToolbar();
      selection.removeAllRanges();
      if (!anchor.quote.trim()) return;
      openModal(anchor, panel);
    });

    document.addEventListener("mousedown", (e) => {
      if (!toolbar!.contains(e.target as Node)) hideToolbar();
    });

    // ---- modal wiring ----
    els.typeButtons.forEach((btn) => {
      btn.addEventListener("click", () =>
        setFormType(btn.dataset.annotationType as AnnotationType),
      );
    });
    els.addNoteBtn.addEventListener("click", showComposer);
    els.editBtn.addEventListener("click", showComposer);
    els.deleteBtn.addEventListener("click", () => void deleteCurrent());
    els.saveBtn.addEventListener("click", () => void persistCurrent());
    els.cancelBtn.addEventListener("click", () => {
      const existing = currentRecordId ? byId.get(currentRecordId) : null;
      if (existing) showView(existing);
      else modal!.close();
    });
    els.closeBtn.addEventListener("click", () => modal!.close());
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    loadAndRenderExisting();
  }

  initAnnotationLayer();
  document.addEventListener("astro:page-load", initAnnotationLayer);
</script>
