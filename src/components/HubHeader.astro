---
import { ArrowLeft } from "lucide-astro";

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div>
  <a
    href="/"
    class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
  >
    <ArrowLeft class="h-4 w-4" aria-hidden="true" />
    Home
  </a>
  <h1
    class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl"
    style="letter-spacing: -0.02em"
  >
    {title}
  </h1>
  {
    subtitle && (
      <p class="mt-3 max-w-xl text-lg text-slate-500 dark:text-slate-400">
        {subtitle}
      </p>
    )
  }
</div>
