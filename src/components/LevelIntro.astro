---
import { ListChecks } from "lucide-astro";

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div
  class="level-intro not-prose mb-6 rounded-lg border p-3"
  style="background-color: var(--accent-soft-bg); border-color: var(--accent-soft-border);"
>
  <div
    class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase"
    style="color: var(--accent-text)"
  >
    <ListChecks class="h-3.5 w-3.5" aria-hidden="true" />
    In this level
  </div>
  <ul class="flex flex-wrap gap-x-5 gap-y-1.5">
    {
      items.map((item) => (
        <li class="flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-300">
          <span
            class="h-1 w-1 shrink-0 rounded-full"
            style="background-color: var(--accent)"
          />
          {item}
        </li>
      ))
    }
  </ul>
</div>
