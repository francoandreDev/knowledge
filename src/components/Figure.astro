---
// Raster images go through astro:assets so they're resized, converted to
// WebP and lazy-loaded at build time. Import the file (don't use a string
// path) so Astro can read its dimensions:
//
//   import img from "./images/devtools-network.png";
//   <Figure src={img} alt="Network tab showing a 304" caption="..." credit="..." />
//
// Prefer SVG components / Mermaid for diagrams; use this for real captures
// and licensed illustrations. `credit` records provenance/license for any
// third-party image.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  width?: number;
}

const { src, alt, caption, credit, width = 800 } = Astro.props;
---

<figure class="not-prose my-6">
  <Image
    src={src}
    alt={alt}
    width={Math.min(width, src.width)}
    widths={[400, 800, 1200]}
    sizes="(min-width: 768px) 768px, 100vw"
    format="webp"
    loading="lazy"
    class="mx-auto h-auto w-full max-w-3xl rounded-lg border border-slate-200 dark:border-slate-800"
  />
  {
    (caption || credit) && (
      <figcaption class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {caption}
        {credit && <span class="block text-xs opacity-70">{credit}</span>}
      </figcaption>
    )
  }
</figure>
