---
// Covers a unit page whose previous unit hasn't been completed yet. The
// roadmap's level map already shows these units as locked; this is what makes
// the lock real when someone arrives by URL, search, or a random pick.
import { Lock, ArrowRight, Map } from "lucide-astro";

interface Props {
  track: string;
  prevSlug: string | null;
  prevProblem: string | null;
}
const { track, prevSlug, prevProblem } = Astro.props;
---

{
  prevSlug && (
    <div
      data-lock-guard
      data-track={track}
      data-prev-slug={prevSlug}
      class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm"
    >
      <div
        role="alertdialog"
        aria-labelledby="lock-guard-title"
        class="w-full max-w-md rounded-2xl border-2 border-slate-900 bg-white p-6 text-slate-900 shadow-[0_6px_0_#0f172a] dark:border-slate-100 dark:bg-slate-900 dark:text-slate-100 dark:shadow-[0_6px_0_#f1f5f9]"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-100">
          <Lock class="h-6 w-6" aria-hidden="true" />
        </span>
        <h2 id="lock-guard-title" class="mt-4 text-2xl font-extrabold">
          This level is locked
        </h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">
          Finish the previous unit in{" "}
          <span class="font-semibold">{track}/</span> to open it:
        </p>
        <p class="mt-2 font-semibold">{prevProblem}</p>
        <a
          href={`/${track}/${prevSlug}/`}
          class="mt-5 flex items-center justify-between gap-3 rounded-xl border-2 border-[#082f49] bg-[#0369a1] px-4 py-3 font-extrabold text-white shadow-[0_4px_0_#082f49] transition hover:brightness-110"
        >
          Go to the previous unit
          <ArrowRight class="h-5 w-5" aria-hidden="true" />
        </a>
        <a
          href={`/roadmap#${track}`}
          class="mt-3 flex items-center justify-center gap-2 rounded-xl border-2 border-slate-300 px-4 py-2.5 font-bold transition hover:border-slate-900 dark:border-slate-700 dark:hover:border-slate-100"
        >
          <Map class="h-4 w-4" aria-hidden="true" />
          Back to the map
        </a>
      </div>
    </div>
  )
}

<script>
  import { hasCompleted } from "../lib/unlock";

  function initLockGuard() {
    const guard = document.querySelector<HTMLElement>("[data-lock-guard]");
    if (!guard) return;
    const track = guard.dataset.track ?? "";
    const prev = guard.dataset.prevSlug ?? "";
    const locked = !!track && !!prev && !hasCompleted(track, prev);
    guard.classList.toggle("hidden", !locked);
    guard.classList.toggle("flex", locked);
    document.body.style.overflow = locked ? "hidden" : "";
  }
  initLockGuard();
  document.addEventListener("astro:page-load", initLockGuard);
</script>
