---
// Inline MDX component for marking a specific word/phrase as a glossary
// term going forward — either `define` (opens the shared annotation modal
// with this text) or `href` (a real outbound link, underlined, no modal).
// Existing **bold**/`code` text elsewhere in prose is handled separately,
// retroactively, by AnnotationLayer.astro's client script — this component
// is only for content an author deliberately marks from here on.
interface Props {
  define?: string;
  href?: string;
  id?: string;
}

const { define, href, id } = Astro.props;

if (!define && !href) {
  throw new Error("<Term> needs either a `define` or an `href` prop.");
}
if (define && href) {
  throw new Error("<Term> takes either `define` or `href`, not both.");
}

const slotHtml = await Astro.slots.render("default");
const slotText = slotHtml
  .replace(/<[^>]+>/g, "")
  .trim()
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-+|-+$/g, "");
const termId = id ?? slotText;
---

{
  href ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold underline decoration-2 underline-offset-2"
      style="color: var(--accent-text)"
    >
      <slot />
    </a>
  ) : (
    <button
      type="button"
      data-term
      data-term-id={termId}
      data-term-define={define}
      class="cursor-help rounded-sm font-semibold underline decoration-dotted decoration-2 underline-offset-2"
      style="color: var(--accent-text)"
    >
      <slot />
    </button>
  )
}
