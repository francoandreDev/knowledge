---
// One lucide icon per roadmap tag, so a unit's main tag is recognisable at a
// glance on the roadmap (same pattern as TrackIcon.astro: outline, 24x24
// source, sized by the caller). Unknown tags fall back to a plain tag glyph.
import {
  Accessibility,
  BadgeDollarSign,
  Binary,
  BookOpen,
  Blocks,
  Brain,
  Bug,
  Cloud,
  Coins,
  Compass,
  Crown,
  Database,
  Eye,
  Flag,
  FlaskConical,
  Flame,
  Gauge,
  GitBranch,
  GraduationCap,
  Globe,
  KeyRound,
  Lightbulb,
  Lock,
  Megaphone,
  MessageSquare,
  Network,
  PenLine,
  Palette,
  Plug,
  Puzzle,
  Repeat,
  Rocket,
  Ruler,
  Scale,
  Server,
  Share2,
  Shield,
  ShieldAlert,
  ShieldCheck,
  Siren,
  Sigma,
  Sparkles,
  Tag,
  Target,
  TrendingUp,
  UserPlus,
  Users,
  Workflow,
  Wrench,
  Zap,
} from "lucide-astro";

interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className = "" } = Astro.props;

const ICONS: Record<string, typeof Tag> = {
  accessibility: Accessibility,
  algorithms: Binary,
  "api-design": Plug,
  architecture: Blocks,
  authentication: KeyRound,
  backend: Server,
  burnout: Flame,
  caching: Zap,
  "career-growth": TrendingUp,
  "code-quality": Wrench,
  collaboration: Share2,
  communication: MessageSquare,
  concurrency: Workflow,
  "conflict-resolution": Scale,
  "cost-management": Coins,
  databases: Database,
  debugging: Bug,
  "decision-making": Compass,
  "deep-work": Brain,
  delegation: Share2,
  deployment: Rocket,
  design: Palette,
  "design-patterns": Puzzle,
  encryption: Lock,
  estimation: Ruler,
  feedback: Repeat,
  frontend: Globe,
  hiring: UserPlus,
  "incident-response": Siren,
  "influence-politics": Crown,
  infra: Cloud,
  leadership: Flag,
  learning: GraduationCap,
  math: Sigma,
  "mental-models": Lightbulb,
  mentoring: BookOpen,
  negotiation: BadgeDollarSign,
  networking: Network,
  observability: Eye,
  onboarding: Sparkles,
  performance: Gauge,
  "product-thinking": Target,
  reliability: ShieldCheck,
  "risk-management": ShieldAlert,
  sales: Megaphone,
  security: Shield,
  "team-management": Users,
  testing: FlaskConical,
  "version-control": GitBranch,
  writing: PenLine,
};

const Icon = ICONS[tag] ?? Tag;
---

<Icon class={className} aria-hidden="true" />
