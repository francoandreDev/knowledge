---
import { FileText, Lightbulb, Code2 } from "lucide-astro";

interface Props {
  hasL1: boolean;
  hasL2: boolean;
  hasL3: boolean;
}

const { hasL1, hasL2, hasL3 } = Astro.props;
const levels = [
  { id: "l1", label: "L1 · Summary", icon: FileText, available: hasL1 },
  { id: "l2", label: "L2 · Concept", icon: Lightbulb, available: hasL2 },
  { id: "l3", label: "L3 · Deep dive", icon: Code2, available: hasL3 },
] as const;
const firstAvailable = levels.find((l) => l.available)?.id ?? "l1";
---

<div data-level-tabs>
  <div
    class="flex gap-1 border-b border-slate-200 dark:border-slate-800"
    role="tablist"
  >
    {
      levels.map((level) => (
        <button
          type="button"
          role="tab"
          data-tab-button={level.id}
          disabled={!level.available}
          aria-selected={level.id === firstAvailable ? "true" : "false"}
          class="flex items-center gap-1.5 rounded-t-md px-4 py-2 text-sm font-medium text-slate-500 transition disabled:cursor-not-allowed disabled:opacity-40 hover:text-slate-900 aria-selected:border-b-2 aria-selected:border-slate-900 aria-selected:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 dark:aria-selected:border-slate-100 dark:aria-selected:text-slate-100"
        >
          <level.icon class="h-4 w-4" aria-hidden="true" />
          {level.label}
        </button>
      ))
    }
  </div>

  <div class="pt-6">
    <div
      data-tab-panel="l1"
      class:list={["prose-panel", firstAvailable !== "l1" && "hidden"]}
    >
      <slot name="l1" />
    </div>
    <div
      data-tab-panel="l2"
      class:list={["prose-panel", firstAvailable !== "l2" && "hidden"]}
    >
      <slot name="l2" />
    </div>
    <div
      data-tab-panel="l3"
      class:list={["prose-panel", firstAvailable !== "l3" && "hidden"]}
    >
      <slot name="l3" />
    </div>
  </div>
</div>

<script>
  function initLevelTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-level-tabs]")
      .forEach((root) => {
        const buttons =
          root.querySelectorAll<HTMLButtonElement>("[data-tab-button]");
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            if (button.disabled) return;
            const target = button.dataset.tabButton!;
            buttons.forEach((b) =>
              b.setAttribute(
                "aria-selected",
                String(b.dataset.tabButton === target),
              ),
            );
            root
              .querySelectorAll<HTMLElement>("[data-tab-panel]")
              .forEach((panel) => {
                const isTarget = panel.dataset.tabPanel === target;
                panel.classList.toggle("hidden", !isTarget);
                // A one-shot keyframe animation (see global.css) rather than
                // a transition-based fade — a transition needs a "before"
                // frame to actually paint before its target changes, which a
                // JS-scheduled rAF class-swap can miss entirely if the tab
                // isn't foregrounded at that instant. An `animation` applied
                // directly has no such timing dependency.
                if (isTarget) {
                  panel.classList.remove("animate-fade-slide-in");
                  void panel.offsetWidth;
                  panel.classList.add("animate-fade-slide-in");
                }
              });
            // A panel just un-hid — any Mermaid diagram inside it that was
            // skipped at page load (because it was hidden then) needs to
            // render for real now that it's actually visible. See
            // Layout.astro's mermaid script for why this matters.
            document.dispatchEvent(new CustomEvent("mermaid:rerun"));
          });
        });
      });
  }

  initLevelTabs();
  document.addEventListener("astro:page-load", initLevelTabs);
</script>
