---
interface Props {
  hasL1: boolean;
  hasL2: boolean;
  hasL3: boolean;
}

const { hasL1, hasL2, hasL3 } = Astro.props;
const levels = [
  { id: "l1", label: "L1 · Summary", available: hasL1 },
  { id: "l2", label: "L2 · Concept", available: hasL2 },
  { id: "l3", label: "L3 · Deep dive", available: hasL3 },
] as const;
const firstAvailable = levels.find((l) => l.available)?.id ?? "l1";
---

<div data-level-tabs>
  <div
    class="flex gap-1 border-b border-slate-200 dark:border-slate-800"
    role="tablist"
  >
    {
      levels.map((level) => (
        <button
          type="button"
          role="tab"
          data-tab-button={level.id}
          disabled={!level.available}
          aria-selected={level.id === firstAvailable ? "true" : "false"}
          class="rounded-t-md px-4 py-2 text-sm font-medium text-slate-500 transition disabled:cursor-not-allowed disabled:opacity-40 hover:text-slate-900 aria-selected:border-b-2 aria-selected:border-slate-900 aria-selected:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 dark:aria-selected:border-slate-100 dark:aria-selected:text-slate-100"
        >
          {level.label}
        </button>
      ))
    }
  </div>

  <div class="pt-6">
    <div
      data-tab-panel="l1"
      class:list={["prose-panel", firstAvailable !== "l1" && "hidden"]}
    >
      <slot name="l1" />
    </div>
    <div
      data-tab-panel="l2"
      class:list={["prose-panel", firstAvailable !== "l2" && "hidden"]}
    >
      <slot name="l2" />
    </div>
    <div
      data-tab-panel="l3"
      class:list={["prose-panel", firstAvailable !== "l3" && "hidden"]}
    >
      <slot name="l3" />
    </div>
  </div>
</div>

<script>
  function initLevelTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-level-tabs]")
      .forEach((root) => {
        const buttons = root.querySelectorAll<HTMLButtonElement>(
          "[data-tab-button]",
        );
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            if (button.disabled) return;
            const target = button.dataset.tabButton!;
            buttons.forEach((b) =>
              b.setAttribute(
                "aria-selected",
                String(b.dataset.tabButton === target),
              ),
            );
            root
              .querySelectorAll<HTMLElement>("[data-tab-panel]")
              .forEach((panel) => {
                panel.classList.toggle(
                  "hidden",
                  panel.dataset.tabPanel !== target,
                );
              });
          });
        });
      });
  }

  initLevelTabs();
  document.addEventListener("astro:page-load", initLevelTabs);
</script>
