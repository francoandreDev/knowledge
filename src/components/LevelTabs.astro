---
// The unit page's navigation: a dock for the four stages (L1, L2, L3, Exam), a
// side index of the open stage's sections with "seen" dots, and Back / Next
// buttons at the end of each stage. Inside L1-L3 the content is split at each
// `##` heading into steps shown one at a time (a step bar plus Back / Next). The stage panels keep the same data
// attributes the rest of the site styles against ([data-tab-panel],
// [data-tab-button], [data-level-end], [data-read-check]).
import {
  FileText,
  Lightbulb,
  Code2,
  ShieldCheck,
  Check,
  ArrowLeft,
  ArrowRight,
} from "lucide-astro";

interface Props {
  hasL1: boolean;
  hasL2: boolean;
  hasL3: boolean;
  hasExam: boolean;
  track: string;
  unitSlug: string;
}

const { hasL1, hasL2, hasL3, hasExam, track, unitSlug } = Astro.props;
const stages = [
  { id: "l1", name: "L1", label: "L1 · Summary", icon: FileText },
  { id: "l2", name: "L2", label: "L2 · Concept", icon: Lightbulb },
  { id: "l3", name: "L3", label: "L3 · Deep dive", icon: Code2 },
  { id: "exam", name: "Exam", label: "Exam · Domain check", icon: ShieldCheck },
].filter(
  (s) =>
    ({ l1: hasL1, l2: hasL2, l3: hasL3, exam: hasExam })[
      s.id as "l1" | "l2" | "l3" | "exam"
    ],
);
const first = stages[0]?.id ?? "l1";
---

<div
  data-level-tabs
  data-track={track}
  data-unit={unitSlug}
  class="scroll-mt-16"
>
  <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:self-start" aria-label="In this stage">
      <div class="flex items-center gap-3">
        <span
          data-rail-ring
          class="grid h-11 w-11 shrink-0 place-items-center rounded-full"
          style="--p: 0; background: conic-gradient(var(--accent) calc(var(--p) * 1%), rgb(148 163 184 / 0.3) 0)"
        >
          <span
            data-rail-pct
            class="grid h-8 w-8 place-items-center rounded-full bg-white text-[11px] font-bold text-slate-700 dark:bg-slate-950 dark:text-slate-200"
            >0%</span
          >
        </span>
        <div class="min-w-0">
          <p
            data-rail-title
            class="text-sm font-semibold text-slate-800 dark:text-slate-100"
          >
          </p>
          <p data-rail-sub class="text-xs text-slate-500 dark:text-slate-400">
          </p>
        </div>
      </div>
      <ul
        data-toc
        class="mt-3 flex flex-wrap gap-1.5 lg:flex-col lg:flex-nowrap lg:gap-0.5 lg:border-l-2 lg:border-slate-200 lg:pl-2 dark:lg:border-slate-800"
      >
      </ul>
    </aside>

    <div class="min-w-0">
      {
        stages.map((stage, i) => {
          const prev = stages[i - 1];
          const next = stages[i + 1];
          return (
            <div
              data-tab-panel={stage.id}
              data-stage-label={stage.label}
              class:list={["prose-panel", first !== stage.id && "hidden"]}
            >
              <slot name={stage.id} />
              <div data-level-end={stage.id} />
              <div
                data-stage-nav
                class="not-prose mt-10 border-t border-slate-200 pt-5 dark:border-slate-800"
              >
                <div class="mb-4 flex gap-1.5" aria-hidden="true">
                  {stages.map((s) => (
                    <span
                      data-stage-dot={s.id}
                      class:list={[
                        "h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-slate-700",
                        s.id === stage.id && "ring-2 ring-slate-400",
                      ]}
                    />
                  ))}
                </div>
                <div class="flex items-center justify-between gap-3">
                  {prev ? (
                    <button
                      type="button"
                      data-goto={prev.id}
                      class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500"
                    >
                      <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
                      Back: {prev.name}
                    </button>
                  ) : (
                    <button
                      type="button"
                      disabled
                      class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 opacity-40 dark:border-slate-700 dark:text-slate-300"
                    >
                      <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
                      Back
                    </button>
                  )}
                  {next && (
                    <button
                      type="button"
                      data-goto={next.id}
                      class="inline-flex items-center gap-1.5 rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-[0_3px_0_rgb(0_0_0/0.25)] transition hover:bg-rose-500 active:translate-y-0.5 active:shadow-none"
                    >
                      Next: {next.name}
                      <ArrowRight class="h-3.5 w-3.5" aria-hidden="true" />
                    </button>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <nav
    class="sticky bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-30 mx-auto md:bottom-3 mt-8 grid w-full max-w-md gap-1 rounded-2xl border-2 border-slate-200 bg-white/95 p-1 shadow-lg backdrop-blur dark:border-slate-700 dark:bg-slate-900/95"
    style={`grid-template-columns: repeat(${stages.length}, minmax(0, 1fr))`}
    role="tablist"
    aria-label="Stages"
  >
    {
      stages.map((stage) => (
        <button
          type="button"
          role="tab"
          data-tab-button={stage.id}
          aria-selected={stage.id === first ? "true" : "false"}
          class="relative flex flex-col items-center gap-0.5 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-500 transition hover:text-slate-900 aria-selected:bg-[var(--accent-soft-bg)] dark:text-slate-400 dark:hover:text-slate-100"
        >
          <stage.icon class="h-5 w-5" aria-hidden="true" />
          {stage.name}
          <span class="h-1 w-3/4 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
            <i
              data-dock-bar={stage.id}
              class="block h-full w-0 rounded-full"
              style="background: var(--accent)"
            />
          </span>
          <Check
            data-read-check={stage.id}
            class="absolute top-1 right-1 hidden h-3 w-3 text-emerald-500 dark:text-emerald-400"
            aria-hidden="true"
          />
        </button>
      ))
    }
  </nav>
</div>

<script>
  import { pStorage } from "../lib/profile";
  import { getExerciseState } from "../lib/spaced-repetition";

  interface TocItem {
    id: string;
    el: HTMLElement;
    label: string;
    kind: "section" | "demo" | "topic";
    // Index of the step (section) this entry lives in; unset for the exam.
    step?: number;
  }

  const lastLevelKey = (t: string, u: string) => `level-last:${t}/${u}`;
  const readLevelsKey = (t: string, u: string) => `level-read:${t}/${u}`;
  const seenKey = (t: string, u: string) => `toc-seen:${t}/${u}`;

  function readSet(key: string, profile: boolean): Set<string> {
    try {
      const raw = profile ? pStorage.getItem(key) : localStorage.getItem(key);
      return new Set(raw ? (JSON.parse(raw) as string[]) : []);
    } catch {
      return new Set();
    }
  }

  function markLevelRead(root: HTMLElement, level: string) {
    const track = root.dataset.track!;
    const unit = root.dataset.unit!;
    const read = readSet(readLevelsKey(track, unit), false);
    if (read.has(level)) return;
    read.add(level);
    localStorage.setItem(readLevelsKey(track, unit), JSON.stringify([...read]));
    root
      .querySelector<HTMLElement>(`[data-read-check="${level}"]`)
      ?.classList.remove("hidden");
  }

  const prettify = (id: string) => {
    const spaced = id.replace(/-/g, " ");
    return spaced.charAt(0).toUpperCase() + spaced.slice(1);
  };

  // The sections of one stage that the side index lists, in page order.
  function collectItems(panel: HTMLElement, level: string): TocItem[] {
    const items: TocItem[] = [];
    let n = 0;
    const push = (el: HTMLElement, label: string, kind: TocItem["kind"]) => {
      if (!el.id) el.id = `toc-${level}-${n}`;
      el.classList.add("scroll-mt-24");
      items.push({ id: el.id, el, label, kind });
      n += 1;
    };
    if (level === "exam") {
      panel
        .querySelectorAll<HTMLElement>("[data-exercise-pool][data-pool-id]")
        .forEach((el) => {
          if (!el.id) el.id = `toc-exam-${el.dataset.poolId}`;
          items.push({
            id: el.id,
            el,
            label: prettify(el.dataset.poolId ?? "Topic"),
            kind: "topic",
          });
        });
      return items;
    }
    // Only sections and demos are listed. Checkpoints and quick checks sit
    // inside their section (a level can have one per topic), so listing them
    // would bury the sections in near-identical entries.
    const steps = Array.from(
      panel.querySelectorAll<HTMLElement>(":scope > [data-step]"),
    );
    const stepOf = (el: HTMLElement) =>
      Math.max(0, steps.indexOf(el.closest<HTMLElement>("[data-step]")!));
    if (steps[0]?.dataset.intro === "true")
      items.push({
        id: steps[0].id,
        el: steps[0],
        label: "Start here",
        kind: "section",
        step: 0,
      });
    panel
      .querySelectorAll<HTMLElement>("h2, [data-interactive-demo]")
      .forEach((el) => {
        if (el.matches("h2")) {
          push(el, el.textContent?.trim() || "Section", "section");
        } else {
          const title = el.querySelector("p")?.textContent?.trim();
          push(el, title ? `Try it: ${title}` : "Try it", "demo");
        }
        items[items.length - 1]!.step = stepOf(el);
      });
    return items;
  }

  // Wraps a stage's content in one <section data-step> per `##` heading (plus
  // an intro step for whatever precedes the first one). Returns the sections.
  function splitIntoSteps(panel: HTMLElement, level: string): HTMLElement[] {
    const end = panel.querySelector<HTMLElement>("[data-level-end]");
    if (!end || level === "exam") return [];
    const nodes: HTMLElement[] = [];
    for (
      let n = panel.firstElementChild as HTMLElement | null;
      n && n !== end;
      n = n.nextElementSibling as HTMLElement | null
    )
      nodes.push(n);
    const groups: HTMLElement[][] = [[]];
    for (const n of nodes) {
      if (n.matches("h2")) groups.push([]);
      groups[groups.length - 1]!.push(n);
    }
    // The intro only counts when it holds visible content (not just scripts).
    const hasIntro = groups[0]!.some((n) => n.tagName !== "SCRIPT");
    if (!hasIntro) groups.shift();
    const sections = groups.map((g, i) => {
      const sec = document.createElement("section");
      sec.dataset.step = String(i);
      sec.className = "scroll-mt-24";
      if (hasIntro && i === 0) {
        sec.dataset.intro = "true";
        sec.id = `toc-${level}-start`;
      }
      panel.insertBefore(sec, end);
      g.forEach((n) => sec.append(n));
      return sec;
    });
    return sections;
  }

  // The step bar above the sections and the Previous / Next row below them.
  // Their state (current, done, hint) is filled in by stepUi() in the init.
  function buildStepUi(panel: HTMLElement, secs: HTMLElement[]) {
    const end = panel.querySelector("[data-level-end]");
    const bar = document.createElement("div");
    bar.dataset.stepbar = "";
    bar.className = "not-prose mb-6 scroll-mt-24";
    bar.innerHTML = `<div class="flex items-baseline justify-between gap-3 text-xs">
        <span data-step-count class="font-semibold tracking-wide whitespace-nowrap uppercase" style="color: var(--accent-text)"></span>
        <span data-step-title class="min-w-0 truncate text-slate-500 dark:text-slate-400"></span>
      </div>
      <div data-step-segments class="mt-1 flex gap-1.5" role="group" aria-label="Sections"></div>`;
    const row = bar.querySelector("[data-step-segments]")!;
    secs.forEach((sec, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.dataset.stepGo = String(i);
      b.className = "group flex-1 py-1.5";
      const label = `${i + 1}. ${stepTitle(sec)}`;
      b.title = label;
      b.setAttribute("aria-label", label);
      b.innerHTML =
        '<i class="block h-1.5 rounded-full bg-slate-200 transition-colors group-hover:bg-slate-300 dark:bg-slate-700 dark:group-hover:bg-slate-600"></i>';
      row.append(b);
    });
    panel.insertBefore(bar, secs[0]!);

    const nav = document.createElement("div");
    nav.dataset.stepNav = "";
    nav.className =
      "not-prose mt-8 flex items-center justify-between gap-3 border-t border-slate-200 pt-4 dark:border-slate-800";
    nav.innerHTML = `<button type="button" data-step-back class="rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 disabled:opacity-40 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">Previous</button>
      <span data-step-hint class="min-w-0 text-center text-xs text-slate-500 dark:text-slate-400"></span>
      <button type="button" data-step-next class="rounded-full px-4 py-2 text-sm font-semibold text-white shadow-[0_3px_0_rgb(0_0_0/0.25)] transition active:translate-y-0.5 active:shadow-none" style="background: var(--accent)">Next section</button>`;
    panel.insertBefore(nav, end);
  }

  const stepTitle = (sec: HTMLElement) =>
    sec.dataset.intro === "true"
      ? "Start here"
      : (sec.querySelector("h2")?.textContent?.trim() ?? "Section");

  function initLevelTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-level-tabs]")
      .forEach((root) => {
        const track = root.dataset.track!;
        const unit = root.dataset.unit!;
        const panels = Array.from(
          root.querySelectorAll<HTMLElement>("[data-tab-panel]"),
        );
        const model: Record<string, TocItem[]> = {};
        const stepsOf: Record<string, HTMLElement[]> = {};
        const stepIdx: Record<string, number> = {};
        const stepsKey = (level: string) =>
          `step-last:${track}/${unit}/${level}`;
        for (const p of panels) {
          const level = p.dataset.tabPanel!;
          if (p.dataset.stepped !== "true") {
            p.dataset.stepped = "true";
            const secs = splitIntoSteps(p, level);
            if (secs.length < 2) {
              // One section is not worth a step bar: undo the wrap.
              const end = p.querySelector("[data-level-end]");
              secs.forEach((sec) => {
                while (sec.firstChild) p.insertBefore(sec.firstChild, end);
                sec.remove();
              });
            } else {
              buildStepUi(p, secs);
            }
          }
          stepsOf[level] = Array.from(
            p.querySelectorAll<HTMLElement>(":scope > [data-step]"),
          );
        }
        for (const p of panels)
          model[p.dataset.tabPanel!] = collectItems(p, p.dataset.tabPanel!);

        const seen = readSet(seenKey(track, unit), true);
        let active = "";

        const examPassed = (items: TocItem[]) =>
          items.filter(
            (i) =>
              getExerciseState(track, unit, i.el.dataset.poolId ?? "") ===
              "passed",
          ).length;
        const isDone = (level: string, item: TocItem) =>
          level === "exam"
            ? getExerciseState(track, unit, item.el.dataset.poolId ?? "") ===
              "passed"
            : seen.has(item.id);
        const doneCount = (level: string) => {
          const items = model[level] ?? [];
          return level === "exam"
            ? examPassed(items)
            : items.filter((i) => seen.has(i.id)).length;
        };
        const pct = (level: string) => {
          const total = model[level]?.length ?? 0;
          return total === 0 ? 0 : Math.round((doneCount(level) / total) * 100);
        };

        function refreshProgress() {
          for (const level of Object.keys(model)) {
            const p = pct(level);
            const bar = root.querySelector<HTMLElement>(
              `[data-dock-bar="${level}"]`,
            );
            if (bar) bar.style.width = `${p}%`;
            root
              .querySelectorAll<HTMLElement>(`[data-stage-dot="${level}"]`)
              .forEach((d) => {
                d.style.background = p === 100 ? "var(--accent)" : "";
              });
          }
          if (active) {
            const ring = root.querySelector<HTMLElement>("[data-rail-ring]")!;
            ring.style.setProperty("--p", String(pct(active)));
            root.querySelector("[data-rail-pct]")!.textContent =
              `${pct(active)}%`;
            const total = model[active]?.length ?? 0;
            root.querySelector("[data-rail-sub]")!.textContent =
              active === "exam"
                ? `${doneCount(active)}/${total} topics passed`
                : `${doneCount(active)}/${total} sections seen`;
            root
              .querySelectorAll<HTMLElement>("[data-toc-dot]")
              .forEach((dot) => {
                const item = model[active]!.find(
                  (i) => i.id === dot.dataset.tocDot,
                );
                const done = !!item && isDone(active, item);
                dot.classList.toggle("bg-emerald-500", done);
                dot.classList.toggle("border-emerald-500", done);
              });
          }
        }

        function renderToc(level: string) {
          const list = root.querySelector<HTMLElement>("[data-toc]")!;
          list.replaceChildren();
          for (const item of model[level] ?? []) {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = `#${item.id}`;
            a.dataset.tocLink = item.id;
            a.className =
              "flex items-center gap-1.5 rounded-md border-l-2 border-transparent px-2 py-1 text-xs font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 lg:-ml-[10px]";
            const dot = document.createElement("span");
            dot.dataset.tocDot = item.id;
            dot.className =
              "h-2.5 w-2.5 shrink-0 rounded-full border-2 border-slate-300 dark:border-slate-600";
            const text = document.createElement("span");
            text.textContent = item.label;
            text.className = "line-clamp-2";
            a.append(dot, text);
            li.append(a);
            list.append(li);
          }
        }

        function setActiveLink(id: string) {
          root.querySelectorAll<HTMLElement>("[data-toc-link]").forEach((a) => {
            const on = a.dataset.tocLink === id;
            a.classList.toggle("text-[var(--accent-text)]", on);
            a.classList.toggle("border-[var(--accent)]", on);
            a.classList.toggle("border-transparent", !on);
          });
        }

        function stepUi(level: string) {
          const panel = panels.find((p) => p.dataset.tabPanel === level)!;
          const secs = stepsOf[level] ?? [];
          const idx = stepIdx[level] ?? 0;
          if (secs.length < 2) return;
          const checksLeft = (sec: HTMLElement) =>
            Array.from(
              sec.querySelectorAll<HTMLElement>("[data-practice-check]"),
            ).filter((b) => b.dataset.complete !== "true").length;
          panel.querySelectorAll<HTMLElement>("[data-step-go]").forEach((b) => {
            const i = Number(b.dataset.stepGo);
            const sec = secs[i]!;
            const full =
              sec.querySelector("[data-practice-check]") !== null &&
              checksLeft(sec) === 0;
            b.setAttribute("aria-current", i === idx ? "step" : "false");
            const bar = b.querySelector<HTMLElement>("i")!;
            bar.style.background =
              i === idx
                ? "var(--accent)"
                : full
                  ? "rgb(16 185 129)"
                  : visitedStep(level, i)
                    ? "var(--accent-soft-border)"
                    : "";
          });
          panel.querySelector("[data-step-count]")!.textContent =
            `Section ${idx + 1} of ${secs.length}`;
          panel.querySelector("[data-step-title]")!.textContent = stepTitle(
            secs[idx]!,
          );
          const last = idx === secs.length - 1;
          panel
            .querySelector<HTMLButtonElement>("[data-step-back]")!
            .toggleAttribute("disabled", idx === 0);
          panel
            .querySelector("[data-step-next]")!
            .classList.toggle("hidden", last);
          const left = checksLeft(secs[idx]!);
          panel.querySelector("[data-step-hint]")!.textContent =
            last || left === 0
              ? ""
              : `${left} ${left === 1 ? "check" : "checks"} left, or just continue`;
        }

        const visitedStep = (level: string, i: number) =>
          (model[level] ?? []).some((it) => it.step === i && seen.has(it.id));

        function showStep(level: string, idx: number, userTriggered: boolean) {
          const panel = panels.find((p) => p.dataset.tabPanel === level)!;
          const secs = stepsOf[level] ?? [];
          if (secs.length < 2) return;
          idx = Math.max(0, Math.min(secs.length - 1, idx));
          stepIdx[level] = idx;
          secs.forEach((sec, i) => sec.classList.toggle("hidden", i !== idx));
          const last = idx === secs.length - 1;
          panel
            .querySelectorAll("[data-stage-nav], [data-level-end]")
            .forEach((el) => el.classList.toggle("hidden", !last));
          const item = (model[level] ?? []).find((i) => i.step === idx);
          if (item) setActiveLink(item.id);
          let changed = false;
          for (const it of model[level] ?? []) {
            if (it.step === idx && !seen.has(it.id)) {
              seen.add(it.id);
              changed = true;
            }
          }
          if (changed)
            pStorage.setItem(seenKey(track, unit), JSON.stringify([...seen]));
          try {
            localStorage.setItem(stepsKey(level), String(idx));
          } catch {
            /* storage unavailable: resume point just isn't remembered */
          }
          const sec = secs[idx]!;
          sec.classList.remove("animate-fade-slide-in");
          void sec.offsetWidth;
          sec.classList.add("animate-fade-slide-in");
          // Diagrams and charts in a section that was hidden need a layout pass.
          document.dispatchEvent(new CustomEvent("mermaid:rerun"));
          window.dispatchEvent(new Event("resize"));
          stepUi(level);
          refreshProgress();
          if (userTriggered)
            panel
              .querySelector("[data-stepbar]")
              ?.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        function activateTab(target: string, userTriggered: boolean) {
          const targetButton = root.querySelector<HTMLButtonElement>(
            `[data-tab-button="${target}"]`,
          );
          if (!targetButton) return;
          active = target;
          root
            .querySelectorAll<HTMLButtonElement>("[data-tab-button]")
            .forEach((b) =>
              b.setAttribute(
                "aria-selected",
                String(b.dataset.tabButton === target),
              ),
            );
          panels.forEach((panel) => {
            const isTarget = panel.dataset.tabPanel === target;
            panel.classList.toggle("hidden", !isTarget);
            // One-shot keyframe animation (see global.css); remove, reflow and
            // re-add so re-selecting a stage replays it.
            if (isTarget) {
              panel.classList.remove("animate-fade-slide-in");
              void panel.offsetWidth;
              panel.classList.add("animate-fade-slide-in");
            }
          });
          // A panel just un-hid: any Mermaid diagram skipped at load because
          // it was hidden has to render now (see Layout.astro).
          document.dispatchEvent(new CustomEvent("mermaid:rerun"));
          root.querySelector("[data-rail-title]")!.textContent =
            panels.find((p) => p.dataset.tabPanel === target)?.dataset
              .stageLabel ?? "";
          // Rail accent follows the stage, same as the panel does.
          root
            .querySelector<HTMLElement>("aside")
            ?.setAttribute("data-tab-panel-accent", target);
          renderToc(target);
          if ((stepsOf[target]?.length ?? 0) > 1) {
            if (stepIdx[target] === undefined) {
              const saved = Number(localStorage.getItem(stepsKey(target)));
              stepIdx[target] = Number.isFinite(saved) ? saved : 0;
            }
            showStep(target, stepIdx[target]!, false);
          }
          refreshProgress();
          localStorage.setItem(lastLevelKey(track, unit), target);
          if (userTriggered)
            root.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        readSet(readLevelsKey(track, unit), false).forEach((level) => {
          root
            .querySelector<HTMLElement>(`[data-read-check="${level}"]`)
            ?.classList.remove("hidden");
        });

        if (root.dataset.wired !== "true") {
          root.dataset.wired = "true";
          root.addEventListener("click", (e) => {
            const t = e.target as Element;
            const tab = t.closest<HTMLElement>("[data-tab-button]");
            const go = t.closest<HTMLElement>("[data-goto]");
            const link = t.closest<HTMLAnchorElement>("[data-toc-link]");
            const stepBtn = t.closest<HTMLElement>(
              "[data-step-go], [data-step-back], [data-step-next]",
            );
            if (tab) return activateTab(tab.dataset.tabButton!, true);
            if (go) return activateTab(go.dataset.goto!, true);
            if (stepBtn) {
              const level =
                stepBtn.closest<HTMLElement>("[data-tab-panel]")!.dataset
                  .tabPanel!;
              const cur = stepIdx[level] ?? 0;
              const to =
                stepBtn.dataset.stepGo !== undefined
                  ? Number(stepBtn.dataset.stepGo)
                  : "stepBack" in stepBtn.dataset
                    ? cur - 1
                    : cur + 1;
              return showStep(level, to, true);
            }
            if (link) {
              e.preventDefault();
              const item = (model[active] ?? []).find(
                (i) => i.id === link.dataset.tocLink,
              );
              if (item?.step !== undefined) showStep(active, item.step, false);
              item?.el.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          });
          // Exam progress changes when a topic is graded or reset.
          for (const ev of ["exercise:graded", "exercises:reset"])
            document.addEventListener(ev, () => refreshProgress());
          // A quick-practice card changed: refresh the step bar and hint.
          root.addEventListener("practice:update", () => {
            if (active) stepUi(active);
          });

          // A sentinel after each panel's content marks the stage as read once
          // it scrolls into view. offsetParent guards against a hidden panel's
          // collapsed sentinel reporting as intersecting.
          const sentinels = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const target = entry.target as HTMLElement;
                if (!entry.isIntersecting || target.offsetParent === null)
                  return;
                markLevelRead(root, target.dataset.levelEnd!);
                sentinels.unobserve(target);
              });
            },
            { rootMargin: "0px 0px -10% 0px" },
          );
          root
            .querySelectorAll<HTMLElement>("[data-level-end]")
            .forEach((el) => sentinels.observe(el));
        }

        const last = localStorage.getItem(lastLevelKey(track, unit));
        const initial =
          last && root.querySelector(`[data-tab-button="${last}"]`)
            ? last
            : panels.find((p) => !p.classList.contains("hidden"))?.dataset
                .tabPanel;
        if (initial) activateTab(initial, false);
      });
  }

  initLevelTabs();
  document.addEventListener("astro:page-load", initLevelTabs);
</script>
