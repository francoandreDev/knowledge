---
import { AlertCircle } from "lucide-astro";

interface Props {
  label?: string;
}

const { label = "The problem" } = Astro.props;
// The whiteboard's reference panel shows a distilled, structured recap of
// the scenario — not the flowing narrative shown in the callout itself.
// Falls back to the narrative if a unit hasn't authored a `facts` slot yet.
const hasFacts = Astro.slots.has("facts");
const referenceHTML = hasFacts
  ? await Astro.slots.render("facts")
  : await Astro.slots.render("default");
---

<div
  class="my-6 rounded-lg border border-sky-200 bg-sky-50 p-4 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 dark:border-sky-900 dark:bg-sky-950/40"
>
  <div class="not-prose mb-2 flex items-center justify-between gap-1.5">
    <div
      class="flex items-center gap-1.5 text-xs font-semibold tracking-wide text-sky-700 uppercase dark:text-sky-400"
    >
      <AlertCircle class="h-3.5 w-3.5" aria-hidden="true" />
      {label}
    </div>
    <span data-whiteboard-trigger data-whiteboard-title={label}></span>
  </div>
  <slot />
  <template data-whiteboard-reference set:html={referenceHTML} />
</div>

<script>
  import { mountWhiteboardTrigger } from "../lib/whiteboard";

  function slugify(text: string): string {
    return text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  }

  function wireScenarioWhiteboards() {
    document
      .querySelectorAll<HTMLElement>("[data-whiteboard-trigger]")
      .forEach((trigger) => {
        if (trigger.dataset.wired === "true") return;
        trigger.dataset.wired = "true";

        const title = trigger.dataset.whiteboardTitle || "Scenario";
        const card = trigger.closest("div")?.parentElement;
        const template = card?.querySelector<HTMLTemplateElement>(
          "[data-whiteboard-reference]",
        );
        if (!template) return;

        mountWhiteboardTrigger(trigger, {
          storageKey: `whiteboard:${location.pathname}:${slugify(title)}`,
          referenceHTML: template.innerHTML,
          title,
        });
      });
  }

  wireScenarioWhiteboards();
  document.addEventListener("astro:page-load", wireScenarioWhiteboards);
</script>
