---
// A radial "instrument panel" gauge, used two ways:
//  - static:  `fraction` is known at build time (e.g. roadmap's overall
//             content-coverage tiles) — renders once, no JS involved.
//  - dynamic: `trackName` + `total` are set instead — renders empty and
//             carries `data-gauge-track`/`data-gauge-total` for
//             progress-gauges.ts to fill in from the reader's own progress
//             after mount (see applyTrackGauges). `total` is the count of
//             *written* units for that track, since those are the only ones
//             a reader could have marked done.
// Callers own the label via the default slot — a dynamic label should carry
// `data-gauge-frac` so applyTrackGauges can find and update it.
interface Props {
  size?: number;
  class?: string;
  fraction?: number;
  trackName?: string;
  total?: number;
  color?: "accent" | "warn";
}

const {
  size = 40,
  class: className = "",
  fraction,
  trackName,
  total,
  color = "accent",
} = Astro.props;

const RADIUS = 16;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const strokeVar =
  color === "warn" ? "var(--gauge-warn)" : "var(--gauge-accent)";
const initialOffset =
  fraction !== undefined
    ? CIRCUMFERENCE * (1 - Math.min(1, Math.max(0, fraction)))
    : CIRCUMFERENCE;
---

<span
  class={`inline-flex items-center ${className}`}
  data-gauge-track={trackName}
  data-gauge-total={trackName !== undefined ? (total ?? 0) : undefined}
>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <circle
      cx="20"
      cy="20"
      r={RADIUS}
      fill="none"
      stroke-width="4"
      class="stroke-slate-200 dark:stroke-slate-800"></circle>
    <circle
      data-gauge-arc
      cx="20"
      cy="20"
      r={RADIUS}
      fill="none"
      stroke-width="4"
      stroke-linecap="round"
      stroke-dasharray={CIRCUMFERENCE}
      stroke-dashoffset={initialOffset}
      transform="rotate(-90 20 20)"
      class="transition-[stroke-dashoffset] duration-500"
      style={`stroke: ${strokeVar}`}></circle>
  </svg>
  <slot />
</span>
