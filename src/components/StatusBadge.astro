---
import { Check, Loader, Circle } from "lucide-astro";
import type { UnitStatus } from "../data/roadmap";

interface Props {
  status: UnitStatus | "written";
}

const { status } = Astro.props;

const STYLES: Record<string, { icon: typeof Check; classes: string }> = {
  done: {
    icon: Check,
    classes:
      "text-emerald-700 bg-emerald-50 dark:text-emerald-400 dark:bg-emerald-950",
  },
  written: {
    icon: Check,
    classes:
      "text-emerald-700 bg-emerald-50 dark:text-emerald-400 dark:bg-emerald-950",
  },
  "in-progress": {
    icon: Loader,
    classes: "text-amber-700 bg-amber-50 dark:text-amber-400 dark:bg-amber-950",
  },
  planned: {
    icon: Circle,
    classes:
      "text-slate-500 bg-slate-100 dark:text-slate-500 dark:bg-slate-800",
  },
};

const { icon: Icon, classes } = STYLES[status] ?? STYLES.planned;
---

<span
  class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${classes}`}
>
  <Icon class="h-3 w-3" aria-hidden="true" />
  {status}
</span>
