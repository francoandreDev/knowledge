---
import { UserRound, Plus, Trash2 } from "lucide-astro";
import { roadmap } from "../data/roadmap";

const ALL_TAGS = Array.from(
  new Set(roadmap.tracks.flatMap((t) => t.units.flatMap((u) => u.tags))),
).sort();
---

<div
  data-profile-gate
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm"
>
  <div
    data-profile-gate-card
    class="animate-fade-slide-in max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900"
  >
    <div data-profile-gate-intro>
      <h2 class="text-lg font-semibold tracking-tight">
        Welcome to systems-mastery
      </h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        A self-study curriculum that takes you from junior to a solid
        staff-level engineer, one real problem at a time. Progress, exercise
        results, and whiteboard notes are saved locally in this browser under
        whichever profile you pick below — nothing leaves your device.
      </p>
      <dl
        class="mt-4 grid grid-cols-1 gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs dark:border-slate-800 dark:bg-slate-950/40"
      >
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 font-semibold">Junior</dt>
          <dd class="text-slate-600 dark:text-slate-400">
            Solves well-scoped problems with guidance; still building judgment
            about trade-offs.
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 font-semibold">Mid</dt>
          <dd class="text-slate-600 dark:text-slate-400">
            Owns features end-to-end; makes sound calls within a familiar area
            with less oversight.
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 font-semibold">Senior</dt>
          <dd class="text-slate-600 dark:text-slate-400">
            Handles ambiguity; trusted to design solutions, not just implement
            someone else's.
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 font-semibold">Staff</dt>
          <dd class="text-slate-600 dark:text-slate-400">
            Sets technical direction across teams; multiplies other engineers,
            not just their own output.
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-16 shrink-0 font-semibold">Principal</dt>
          <dd class="text-slate-600 dark:text-slate-400">
            Shapes strategy at an org level; which problems get worked on
            matters as much as how they're solved.
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-5">
      <p
        data-profile-list-label
        class="hidden text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        Continue as
      </p>
      <div data-profile-list class="mt-2 space-y-1.5"></div>

      <div data-profile-create-row class="mt-3 flex items-center gap-2">
        <input
          type="text"
          data-profile-name-input
          placeholder="Your name"
          maxlength="40"
          class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:focus:border-slate-500"
        />
        <button
          type="button"
          data-profile-create-btn
          class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
        >
          <Plus class="h-4 w-4" aria-hidden="true" />
          New profile
        </button>
      </div>
      <p
        data-profile-error
        class="mt-2 hidden text-xs text-red-600 dark:text-red-400"
      >
      </p>
    </div>

    <div data-profile-interests-section class="mt-5 hidden">
      <p
        class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-500"
      >
        Interests
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">
        Optional — pick a few tags to personalize the homepage and pre-select
        matching roadmap filters. Skip if you'd rather see everything.
      </p>
      <div data-interest-chip-list class="mt-2 flex flex-wrap gap-1.5"></div>
    </div>

    <button
      type="button"
      data-profile-interests-continue
      class="mt-4 hidden w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
    >
      Continue
    </button>

    <button
      type="button"
      data-profile-gate-cancel
      class="mt-4 hidden w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500"
    >
      Cancel
    </button>
  </div>
</div>

<template data-profile-row-template>
  <div
    data-profile-row
    class="flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-800"
  >
    <button
      type="button"
      data-profile-select-btn
      class="flex flex-1 items-center gap-2 px-3 py-2 text-left text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800/60"
    >
      <UserRound
        class="h-4 w-4 shrink-0 text-slate-400 dark:text-slate-500"
        aria-hidden="true"
      />
      <span data-profile-row-name class="truncate"></span>
    </button>
    <button
      type="button"
      data-profile-delete-btn
      aria-label="Delete profile"
      class="mr-1.5 shrink-0 rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:text-slate-500 dark:hover:bg-red-950 dark:hover:text-red-400"
    >
      <Trash2 class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>
</template>

<script
  type="application/json"
  id="profile-gate-tags"
  set:html={JSON.stringify(ALL_TAGS)}
/>

<script>
  import {
    getProfiles,
    getActiveProfile,
    createProfile,
    switchProfile,
    deleteProfile,
    updateProfileInterests,
    type Profile,
  } from "../lib/profile";

  function readAllTags(): string[] {
    const el = document.getElementById("profile-gate-tags");
    try {
      const parsed = JSON.parse(el?.textContent || "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  const ALL_TAGS = readAllTags();

  function els() {
    const gate = document.querySelector<HTMLElement>("[data-profile-gate]");
    const list = document.querySelector<HTMLElement>("[data-profile-list]");
    const listLabel = document.querySelector<HTMLElement>(
      "[data-profile-list-label]",
    );
    const input = document.querySelector<HTMLInputElement>(
      "[data-profile-name-input]",
    );
    const createRow = document.querySelector<HTMLElement>(
      "[data-profile-create-row]",
    );
    const createBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-create-btn]",
    );
    const cancelBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-gate-cancel]",
    );
    const error = document.querySelector<HTMLElement>("[data-profile-error]");
    const rowTemplate = document.querySelector<HTMLTemplateElement>(
      "[data-profile-row-template]",
    );
    const interestsSection = document.querySelector<HTMLElement>(
      "[data-profile-interests-section]",
    );
    const interestsList = document.querySelector<HTMLElement>(
      "[data-interest-chip-list]",
    );
    const continueBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-interests-continue]",
    );
    if (
      !gate ||
      !list ||
      !listLabel ||
      !input ||
      !createRow ||
      !createBtn ||
      !cancelBtn ||
      !error ||
      !rowTemplate ||
      !interestsSection ||
      !interestsList ||
      !continueBtn
    ) {
      return null;
    }
    return {
      gate,
      list,
      listLabel,
      input,
      createRow,
      createBtn,
      cancelBtn,
      error,
      rowTemplate,
      interestsSection,
      interestsList,
      continueBtn,
    };
  }

  function renderInterestChips(container: HTMLElement, profileId: string) {
    container.innerHTML = "";
    const profile = getProfiles().find((p) => p.id === profileId);
    const selected = new Set(profile?.interests ?? []);
    for (const tag of ALL_TAGS) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.textContent = tag;
      chip.setAttribute("aria-pressed", String(selected.has(tag)));
      chip.className =
        "inline-flex items-center gap-1 rounded-full border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:border-slate-400 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:aria-pressed:border-slate-100 dark:aria-pressed:bg-slate-100 dark:aria-pressed:text-slate-900";
      chip.addEventListener("click", () => {
        const nowActive = chip.getAttribute("aria-pressed") !== "true";
        chip.setAttribute("aria-pressed", String(nowActive));
        if (nowActive) selected.add(tag);
        else selected.delete(tag);
        updateProfileInterests(profileId, Array.from(selected));
      });
      container.append(chip);
    }
  }

  function showError(error: HTMLElement, message: string) {
    error.textContent = message;
    error.classList.remove("hidden");
  }

  function clearError(error: HTMLElement) {
    error.textContent = "";
    error.classList.add("hidden");
  }

  function renderProfileRow(
    profile: Profile,
    rowTemplate: HTMLTemplateElement,
  ): HTMLElement {
    const fragment = rowTemplate.content.cloneNode(true) as DocumentFragment;
    const row = fragment.querySelector<HTMLElement>("[data-profile-row]")!;
    const nameEl = row.querySelector<HTMLElement>("[data-profile-row-name]")!;
    const selectBtn = row.querySelector<HTMLButtonElement>(
      "[data-profile-select-btn]",
    )!;
    const deleteBtn = row.querySelector<HTMLButtonElement>(
      "[data-profile-delete-btn]",
    )!;
    nameEl.textContent = profile.name;

    selectBtn.addEventListener("click", () => {
      switchProfile(profile.id);
      location.reload();
    });

    let confirming = false;
    deleteBtn.addEventListener("click", () => {
      if (!confirming) {
        confirming = true;
        deleteBtn.setAttribute("aria-label", `Confirm delete ${profile.name}`);
        deleteBtn.classList.add("bg-red-50", "text-red-600");
        deleteBtn.classList.add("dark:bg-red-950", "dark:text-red-400");
        window.setTimeout(() => {
          confirming = false;
        }, 3000);
        return;
      }
      deleteProfile(profile.id);
      row.remove();
      renderList();
    });

    return row;
  }

  function renderList() {
    const e = els();
    if (!e) return;
    const profiles = getProfiles();
    e.list.innerHTML = "";
    e.listLabel.classList.toggle("hidden", profiles.length === 0);
    for (const profile of profiles) {
      e.list.append(renderProfileRow(profile, e.rowTemplate));
    }
    e.cancelBtn.classList.toggle("hidden", getActiveProfile() === null);
  }

  function openGate() {
    const e = els();
    if (!e) return;
    renderList();
    clearError(e.error);
    e.input.value = "";
    e.list.classList.remove("hidden");
    e.listLabel.classList.remove("hidden");
    e.createRow.classList.remove("hidden");
    e.continueBtn.classList.add("hidden");

    const active = getActiveProfile();
    if (active) {
      e.interestsSection.classList.remove("hidden");
      renderInterestChips(e.interestsList, active.id);
    } else {
      e.interestsSection.classList.add("hidden");
    }

    e.gate.classList.remove("hidden");
    e.gate.classList.add("flex");
  }

  function closeGate() {
    const e = els();
    if (!e) return;
    e.gate.classList.add("hidden");
    e.gate.classList.remove("flex");
  }

  function submitNewProfile() {
    const e = els();
    if (!e) return;
    const name = e.input.value.trim();
    if (!name) {
      showError(e.error, "Enter a name to create a profile.");
      return;
    }
    const profile = createProfile(name);
    clearError(e.error);

    // Step into an interest-picking stage before reloading, rather than
    // reloading immediately — this is the "right after creating a new
    // profile" moment the interest picker is meant to catch. Picking is
    // optional; "Continue" moves on regardless of what (if anything) was
    // selected.
    e.list.classList.add("hidden");
    e.listLabel.classList.add("hidden");
    e.createRow.classList.add("hidden");
    e.cancelBtn.classList.add("hidden");
    e.interestsSection.classList.remove("hidden");
    renderInterestChips(e.interestsList, profile.id);
    e.continueBtn.classList.remove("hidden");
  }

  function wire() {
    const e = els();
    if (!e || e.gate.dataset.wired === "true") return;
    e.gate.dataset.wired = "true";

    e.createBtn.addEventListener("click", submitNewProfile);
    e.input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") submitNewProfile();
    });
    e.cancelBtn.addEventListener("click", closeGate);
    e.continueBtn.addEventListener("click", () => location.reload());

    document.addEventListener("profile-gate:open", openGate);
  }

  function init() {
    wire();
    if (!getActiveProfile()) openGate();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
