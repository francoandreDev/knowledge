---
import { Plus, X, HelpCircle, Gamepad2, Pencil, Trash2 } from "lucide-astro";
import LevelsModal from "./LevelsModal.astro";
---

<div
  data-profile-gate
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm"
>
  <div
    data-profile-gate-card
    class="animate-fade-slide-in relative max-h-[92vh] w-full max-w-2xl overflow-y-auto rounded-3xl border-2 border-slate-900 bg-white shadow-[0_6px_0_#0f172a] dark:border-slate-100 dark:bg-slate-900 dark:shadow-[0_6px_0_#f1f5f9]"
  >
    <header class="gate-hero relative overflow-hidden px-6 pt-6 pb-9">
      <svg
        class="gate-cloud gate-cloud-1"
        viewBox="0 0 120 50"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20 44a16 16 0 0 1 2-31 22 22 0 0 1 42-4 18 18 0 0 1 34 10 14 14 0 0 1 2 25z"
        ></path>
      </svg>
      <svg
        class="gate-cloud gate-cloud-2"
        viewBox="0 0 120 50"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20 44a16 16 0 0 1 2-31 22 22 0 0 1 42-4 18 18 0 0 1 34 10 14 14 0 0 1 2 25z"
        ></path>
      </svg>
      <svg
        class="gate-waves"
        viewBox="0 0 400 24"
        preserveAspectRatio="none"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M0 12q25-12 50 0t50 0 50 0 50 0 50 0 50 0 50 0 50 0v12H0z"
        ></path>
      </svg>
      <button
        type="button"
        data-profile-gate-close
        aria-label="Close"
        title="Close"
        class="absolute top-3 right-3 z-10 hidden shrink-0 rounded-full border-2 border-slate-900 bg-white p-1.5 text-slate-700 transition hover:bg-slate-100 dark:border-slate-100 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        <X class="h-4 w-4" aria-hidden="true" />
      </button>
      <p
        class="relative text-xs font-extrabold tracking-widest text-sky-700 uppercase dark:text-sky-300"
      >
        Profiles
      </p>
      <h2 class="relative mt-1 text-3xl font-extrabold tracking-tight">
        Who's playing?
      </h2>
      <p
        class="relative mt-2 max-w-md text-sm font-semibold text-slate-600 dark:text-slate-300"
      >
        Each profile keeps its own progress, exercise results, notes and game
        hero. Everything is saved in this browser; nothing leaves your device.
      </p>
    </header>

    <div class="p-5">
      <div
        data-profile-delete-confirm
        class="mb-4 hidden items-center gap-2 rounded-xl border-2 border-red-300 bg-red-50 p-3 text-sm dark:border-red-900 dark:bg-red-950/40"
      >
        <span class="flex-1 font-semibold">
          Delete <strong data-profile-delete-name></strong>? Its progress and
          its game hero go with it.
        </span>
        <button
          type="button"
          data-profile-delete-keep
          class="shrink-0 rounded-lg border-2 border-slate-300 bg-white px-3 py-1 font-bold whitespace-nowrap text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        >
          Keep it
        </button>
        <button
          type="button"
          data-profile-delete-confirm-btn
          class="shrink-0 rounded-lg bg-red-600 px-3 py-1 font-bold whitespace-nowrap text-white hover:bg-red-700"
        >
          Delete
        </button>
      </div>

      <div data-profile-grid class="grid gap-4 sm:grid-cols-2"></div>

      <div
        data-profile-editor
        class="mt-5 hidden rounded-2xl border-2 border-slate-900 bg-slate-50 p-4 dark:border-slate-100 dark:bg-slate-950"
      >
        <div class="flex flex-col gap-4 sm:flex-row">
          <div
            data-profile-stage
            class="editor-stage mx-auto flex h-32 w-32 shrink-0 items-center justify-center rounded-3xl border-2 border-slate-900 dark:border-slate-100"
          >
            <canvas
              data-profile-preview
              data-size="112"
              class="h-28 w-28"
              aria-label="Preview of your hero"></canvas>
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-3">
            <h3
              data-profile-editor-title
              class="text-lg font-extrabold tracking-tight"
            >
              New profile
            </h3>
            <label data-profile-name-field class="flex flex-col gap-1">
              <span
                class="text-[11px] font-extrabold tracking-wider text-slate-500 uppercase"
                >Name</span
              >
              <input
                type="text"
                data-profile-name-input
                placeholder="Your name"
                maxlength="40"
                class="min-w-0 rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-semibold outline-none focus:border-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:focus:border-slate-100"
              />
            </label>
            <div class="flex flex-col gap-1">
              <span
                class="text-[11px] font-extrabold tracking-wider text-slate-500 uppercase"
                >Hero colour</span
              >
              <div
                data-profile-swatches
                role="radiogroup"
                aria-label="Hero colour"
                class="flex flex-wrap gap-2"
              >
              </div>
              <p class="text-xs font-semibold text-slate-500">
                This is the hero you play with in the game.
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-profile-create-btn
                class="inline-flex items-center gap-1.5 rounded-xl border-2 border-slate-900 bg-sky-500 px-4 py-2 text-sm font-extrabold text-white shadow-[0_3px_0_#0f172a] transition active:translate-y-[3px] active:shadow-none dark:border-slate-100"
              >
                <Plus class="h-4 w-4" aria-hidden="true" />
                <span data-profile-create-label>Create profile</span>
              </button>
              <button
                type="button"
                data-profile-editor-cancel
                class="rounded-xl border-2 border-slate-300 px-4 py-2 text-sm font-bold text-slate-600 dark:border-slate-700 dark:text-slate-300"
              >
                Cancel
              </button>
            </div>
            <p
              data-profile-error
              class="hidden text-xs font-semibold text-red-600 dark:text-red-400"
            >
            </p>
          </div>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-2">
        <button
          type="button"
          data-profile-add
          class="inline-flex items-center gap-1.5 rounded-xl border-2 border-dashed border-slate-400 px-3 py-1.5 text-sm font-extrabold text-slate-600 transition hover:border-slate-900 hover:text-slate-900 dark:border-slate-600 dark:text-slate-300 dark:hover:border-slate-100 dark:hover:text-slate-100"
        >
          <Plus class="h-4 w-4" aria-hidden="true" />
          New profile
        </button>
        <span class="flex items-center gap-4">
          <button
            type="button"
            data-levels-trigger
            class="inline-flex items-center gap-1 text-xs font-bold hover:underline"
            style="color: var(--accent-text)"
          >
            <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
            What do the levels mean?
          </button>
          <a
            href="/game"
            class="inline-flex items-center gap-1 text-xs font-bold text-slate-600 hover:underline dark:text-slate-300"
          >
            <Gamepad2 class="h-3.5 w-3.5" aria-hidden="true" />
            Open the game
          </a>
        </span>
      </div>

      <button
        type="button"
        data-profile-gate-cancel
        class="mt-4 hidden w-full rounded-xl border-2 border-slate-300 px-3 py-2 text-sm font-bold text-slate-600 transition hover:border-slate-500 dark:border-slate-700 dark:text-slate-400"
      >
        Close
      </button>
    </div>
  </div>
</div>

<template data-profile-tile-template>
  <div
    data-profile-tile
    class="group relative flex gap-3 rounded-2xl border-2 border-slate-200 bg-white p-3 transition hover:-translate-y-0.5 hover:border-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-100"
  >
    <span
      data-profile-tile-badge
      class="absolute -top-2.5 left-4 hidden rounded-full bg-sky-600 px-2 py-0.5 text-[10px] font-extrabold tracking-wide text-white uppercase"
    >
      Last used
    </span>
    <span
      data-profile-tile-active
      class="absolute -top-2.5 right-4 hidden rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-extrabold tracking-wide text-white uppercase"
    >
      Active
    </span>
    <span class="relative block h-[4.75rem] w-[4.75rem] shrink-0">
      <svg
        viewBox="0 0 40 40"
        class="absolute inset-0 h-full w-full -rotate-90"
        aria-hidden="true"
      >
        <circle
          cx="20"
          cy="20"
          r="18"
          fill="none"
          stroke-width="2.6"
          class="stroke-slate-200 dark:stroke-slate-800"></circle>
        <circle
          data-profile-tile-arc
          cx="20"
          cy="20"
          r="18"
          fill="none"
          stroke-width="2.6"
          stroke-linecap="round"
          style="stroke: var(--gauge-accent)"></circle>
      </svg>
      <span
        data-profile-tile-stage
        class="absolute inset-[5px] overflow-hidden rounded-full"
      >
        <canvas data-profile-tile-avatar data-size="64" class="h-full w-full"
        ></canvas>
      </span>
    </span>
    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <div class="flex items-baseline gap-2">
        <span
          data-profile-tile-name
          class="min-w-0 truncate text-base font-extrabold"></span>
        <span
          data-profile-tile-pct
          class="shrink-0 text-xs font-extrabold"
          style="color: var(--gauge-accent)"></span>
      </div>
      <p
        data-profile-tile-sub
        class="text-xs font-semibold text-slate-500 dark:text-slate-400"
      >
      </p>
      <ul data-profile-tile-stats class="flex flex-wrap gap-1"></ul>
      <div class="mt-auto flex items-center gap-1.5 pt-1.5">
        <button
          type="button"
          data-profile-tile-select
          class="rounded-lg border-2 border-slate-900 bg-slate-900 px-3 py-1 text-xs font-extrabold text-white shadow-[0_2px_0_#475569] transition active:translate-y-[2px] active:shadow-none dark:border-slate-100 dark:bg-slate-100 dark:text-slate-900"
        >
          Play as
        </button>
        <button
          type="button"
          data-profile-tile-edit
          aria-label="Change hero colour"
          title="Change hero colour"
          class="flex h-7 w-7 items-center justify-center rounded-lg border-2 border-slate-200 text-slate-500 transition hover:border-slate-900 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-100 dark:hover:text-slate-100"
        >
          <Pencil class="h-3.5 w-3.5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-profile-tile-delete
          aria-label="Delete profile"
          title="Delete profile"
          class="flex h-7 w-7 items-center justify-center rounded-lg border-2 border-slate-200 text-slate-500 transition hover:border-red-600 hover:text-red-600 dark:border-slate-700 dark:text-slate-400"
        >
          <Trash2 class="h-3.5 w-3.5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</template>

<LevelsModal />

<script>
  import {
    AVATAR_COLORS,
    DEFAULT_AVATAR_COLOR,
    getProfiles,
    getActiveProfile,
    createProfile,
    switchProfile,
    deleteProfile,
    countProfileDone,
    readProfileGameStats,
    setProfileAvatar,
    type Profile,
  } from "../lib/profile";
  import { mountAvatar } from "../lib/avatar";

  function getTrackUnits(): Record<string, string[]> {
    const el = document.getElementById("header-track-unit-slugs");
    if (!el?.textContent) return {};
    try {
      const parsed = JSON.parse(el.textContent);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  const q = <T extends Element = HTMLElement>(
    sel: string,
    root: ParentNode = document,
  ) => root.querySelector<T>(sel);

  function els() {
    const gate = q("[data-profile-gate]");
    const grid = q("[data-profile-grid]");
    const input = q<HTMLInputElement>("[data-profile-name-input]");
    const nameField = q("[data-profile-name-field]");
    const editor = q("[data-profile-editor]");
    const editorTitle = q("[data-profile-editor-title]");
    const stage = q("[data-profile-stage]");
    const preview = q<HTMLCanvasElement>("[data-profile-preview]");
    const swatches = q("[data-profile-swatches]");
    const createBtn = q<HTMLButtonElement>("[data-profile-create-btn]");
    const createLabel = q("[data-profile-create-label]");
    const editorCancel = q<HTMLButtonElement>("[data-profile-editor-cancel]");
    const addBtn = q<HTMLButtonElement>("[data-profile-add]");
    const cancelBtn = q<HTMLButtonElement>("[data-profile-gate-cancel]");
    const closeBtn = q<HTMLButtonElement>("[data-profile-gate-close]");
    const error = q("[data-profile-error]");
    const tileTemplate = q<HTMLTemplateElement>("[data-profile-tile-template]");
    const deleteConfirm = q("[data-profile-delete-confirm]");
    const deleteConfirmName = q("[data-profile-delete-name]");
    const deleteKeepBtn = q<HTMLButtonElement>("[data-profile-delete-keep]");
    const deleteConfirmBtn = q<HTMLButtonElement>(
      "[data-profile-delete-confirm-btn]",
    );
    if (
      !gate ||
      !grid ||
      !input ||
      !nameField ||
      !editor ||
      !editorTitle ||
      !stage ||
      !preview ||
      !swatches ||
      !createBtn ||
      !createLabel ||
      !editorCancel ||
      !addBtn ||
      !cancelBtn ||
      !closeBtn ||
      !error ||
      !tileTemplate ||
      !deleteConfirm ||
      !deleteConfirmName ||
      !deleteKeepBtn ||
      !deleteConfirmBtn
    ) {
      return null;
    }
    return {
      gate,
      grid,
      input,
      nameField,
      editor,
      editorTitle,
      stage,
      preview,
      swatches,
      createBtn,
      createLabel,
      editorCancel,
      addBtn,
      cancelBtn,
      closeBtn,
      error,
      tileTemplate,
      deleteConfirm,
      deleteConfirmName,
      deleteKeepBtn,
      deleteConfirmBtn,
    };
  }

  let pendingDeleteId: string | null = null;
  // "create" makes a new profile; an id edits that profile's hero colour.
  let editing: "create" | string = "create";
  let pickedColor = DEFAULT_AVATAR_COLOR;

  function showError(error: HTMLElement, message: string) {
    error.textContent = message;
    error.classList.remove("hidden");
  }
  function clearError(error: HTMLElement) {
    error.textContent = "";
    error.classList.add("hidden");
  }

  function openDeleteConfirm(profile: Profile) {
    const e = els();
    if (!e) return;
    pendingDeleteId = profile.id;
    e.deleteConfirmName.textContent = profile.name;
    e.deleteConfirm.classList.remove("hidden");
    e.deleteConfirm.classList.add("flex");
  }
  function closeDeleteConfirm() {
    const e = els();
    if (!e) return;
    pendingDeleteId = null;
    e.deleteConfirm.classList.add("hidden");
    e.deleteConfirm.classList.remove("flex");
  }

  const GAUGE_RADIUS = 18;
  const GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;

  const ICONS = {
    coin: '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h4a1.8 1.8 0 0 1 0 3.6h-3a1.8 1.8 0 0 0 0 3.6h4"/></svg>',
    token:
      '<svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>',
    up: '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg>',
    chest:
      '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="11" rx="2"/><path d="M3 13h18M5 9a7 7 0 0 1 14 0"/></svg>',
  };

  function statChip(icon: string, value: number, label: string, tone: string) {
    const li = document.createElement("li");
    li.className = `inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-extrabold ${tone}`;
    li.title = label;
    li.setAttribute("aria-label", `${value} ${label}`);
    li.innerHTML = `${icon}<span>${value}</span>`;
    return li;
  }

  function renderProfileTile(
    profile: Profile,
    tileTemplate: HTMLTemplateElement,
    trackUnits: Record<string, string[]>,
    totalUnits: number,
    activeId: string | null,
  ): HTMLElement {
    const fragment = tileTemplate.content.cloneNode(true) as DocumentFragment;
    const tile = q("[data-profile-tile]", fragment)!;
    const done = countProfileDone(profile.id, trackUnits);
    const fraction = totalUnits > 0 ? done / totalUnits : 0;
    const color = profile.avatarColor ?? DEFAULT_AVATAR_COLOR;
    const isActive = profile.id === activeId;

    q("[data-profile-tile-name]", tile)!.textContent = profile.name;
    q("[data-profile-tile-pct]", tile)!.textContent =
      totalUnits > 0 ? `${Math.round(fraction * 100)}%` : "";
    q("[data-profile-tile-sub]", tile)!.textContent =
      done === 0
        ? "No units finished yet"
        : `${done} of ${totalUnits} units done`;
    const arc = q<SVGCircleElement>("[data-profile-tile-arc]", tile)!;
    arc.setAttribute("stroke-dasharray", String(GAUGE_CIRCUMFERENCE));
    arc.setAttribute(
      "stroke-dashoffset",
      String(GAUGE_CIRCUMFERENCE * (1 - fraction)),
    );
    q("[data-profile-tile-stage]", tile)!.style.background = `${color}33`;
    const canvas = q<HTMLCanvasElement>("[data-profile-tile-avatar]", tile)!;
    tile.dataset.avatarColor = color;
    tile.dataset.profileId = profile.id;
    canvas.dataset.pending = "true";

    const stats = readProfileGameStats(profile.id);
    const list = q("[data-profile-tile-stats]", tile)!;
    list.append(
      statChip(
        ICONS.coin,
        stats.coins,
        "coins",
        "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300",
      ),
      statChip(
        ICONS.token,
        stats.tokens,
        "game tokens",
        "bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300",
      ),
      statChip(
        ICONS.up,
        stats.upgrades,
        "upgrade levels",
        "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300",
      ),
    );
    if (stats.chests > 0)
      list.append(
        statChip(
          ICONS.chest,
          stats.chests,
          "unopened chests",
          "bg-violet-100 text-violet-800 dark:bg-violet-950 dark:text-violet-300",
        ),
      );

    const select = q<HTMLButtonElement>("[data-profile-tile-select]", tile)!;
    if (isActive) {
      select.textContent = "Continue";
      q("[data-profile-tile-active]", tile)?.classList.remove("hidden");
    }
    select.addEventListener("click", () => {
      if (isActive) {
        closeGate();
        return;
      }
      switchProfile(profile.id);
      location.reload();
    });
    q("[data-profile-tile-edit]", tile)!.addEventListener("click", () =>
      openEditor(profile.id),
    );
    q("[data-profile-tile-delete]", tile)!.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();
        openDeleteConfirm(profile);
      },
    );
    return tile;
  }

  function renderGrid() {
    const e = els();
    if (!e) return;
    closeDeleteConfirm();
    const profiles = getProfiles();
    const active = getActiveProfile();
    const trackUnits = getTrackUnits();
    const totalUnits = Object.values(trackUnits).reduce(
      (sum, slugs) => sum + slugs.length,
      0,
    );
    let lastId: string | null = null;
    let lastTime = -1;
    for (const profile of profiles) {
      const t = profile.lastActiveAt ?? profile.createdAt;
      if (t > lastTime) {
        lastTime = t;
        lastId = profile.id;
      }
    }
    e.grid.innerHTML = "";
    const tiles: HTMLElement[] = [];
    for (const profile of profiles) {
      const tile = renderProfileTile(
        profile,
        e.tileTemplate,
        trackUnits,
        totalUnits,
        active?.id ?? null,
      );
      if (
        profiles.length > 1 &&
        profile.id === lastId &&
        profile.id !== active?.id
      ) {
        q("[data-profile-tile-badge]", tile)?.classList.remove("hidden");
      }
      e.grid.append(tile);
      tiles.push(tile);
    }
    // Avatars are drawn once the tiles are in the document, so they can size
    // themselves from the laid-out canvas.
    for (const tile of tiles) {
      const canvas = q<HTMLCanvasElement>("[data-profile-tile-avatar]", tile);
      if (canvas) mountAvatar(canvas, tile.dataset.avatarColor!);
    }
    if (profiles.length === 0) {
      const hint = document.createElement("p");
      hint.className =
        "rounded-2xl border-2 border-dashed border-slate-300 p-6 text-center text-sm font-semibold text-slate-500 sm:col-span-2 dark:border-slate-700";
      hint.textContent = "No profiles yet. Make your first one below.";
      e.grid.append(hint);
    }
  }

  function renderSwatches() {
    const e = els();
    if (!e) return;
    e.swatches.innerHTML = "";
    for (const c of AVATAR_COLORS) {
      const b = document.createElement("button");
      b.type = "button";
      b.setAttribute("role", "radio");
      b.setAttribute("aria-label", c.name);
      b.setAttribute("aria-checked", String(c.hex === pickedColor));
      b.title = c.name;
      b.dataset.hex = c.hex;
      b.className =
        "h-8 w-8 rounded-full border-2 border-slate-900 transition hover:scale-110 aria-checked:scale-110 aria-checked:ring-4 aria-checked:ring-slate-900/30 dark:border-slate-100 dark:aria-checked:ring-slate-100/30";
      b.style.background = c.hex;
      b.addEventListener("click", () => {
        pickedColor = c.hex;
        for (const o of e.swatches.querySelectorAll<HTMLElement>(
          "[role=radio]",
        ))
          o.setAttribute("aria-checked", String(o.dataset.hex === pickedColor));
        paintPreview();
      });
      e.swatches.append(b);
    }
  }

  function paintPreview() {
    const e = els();
    if (!e) return;
    e.stage.style.background = `${pickedColor}33`;
    mountAvatar(e.preview, pickedColor);
  }

  function openEditor(mode: "create" | string) {
    const e = els();
    if (!e) return;
    editing = mode;
    clearError(e.error);
    const profile =
      mode === "create" ? null : getProfiles().find((p) => p.id === mode);
    if (profile) {
      pickedColor = profile.avatarColor ?? DEFAULT_AVATAR_COLOR;
      e.editorTitle.textContent = `${profile.name}'s hero`;
      e.nameField.classList.add("hidden");
      e.createLabel.textContent = "Save colour";
    } else {
      editing = "create";
      // Start new profiles on a colour nobody here is wearing yet.
      const used = new Set(
        getProfiles().map((p) => p.avatarColor ?? DEFAULT_AVATAR_COLOR),
      );
      pickedColor =
        AVATAR_COLORS.find((c) => !used.has(c.hex))?.hex ??
        DEFAULT_AVATAR_COLOR;
      e.editorTitle.textContent = "New profile";
      e.nameField.classList.remove("hidden");
      e.createLabel.textContent = "Create profile";
      e.input.value = "";
    }
    renderSwatches();
    e.editor.classList.remove("hidden");
    paintPreview();
    if (editing === "create") e.input.focus();
    e.editor.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  function closeEditor() {
    const e = els();
    if (!e) return;
    e.editor.classList.add("hidden");
    clearError(e.error);
  }

  function openGate() {
    const e = els();
    if (!e) return;
    renderGrid();
    closeEditor();
    e.gate.classList.remove("hidden");
    e.gate.classList.add("flex");
    // With no profile yet the picker opens straight on the creation form.
    if (getProfiles().length === 0) openEditor("create");
  }

  function closeGate() {
    const e = els();
    if (!e) return;
    e.gate.classList.add("hidden");
    e.gate.classList.remove("flex");
  }

  function submitEditor() {
    const e = els();
    if (!e) return;
    if (editing === "create") {
      const name = e.input.value.trim();
      if (!name) {
        showError(e.error, "Enter a name to create a profile.");
        return;
      }
      createProfile(name, pickedColor);
      location.reload();
      return;
    }
    setProfileAvatar(editing, pickedColor);
    if (getActiveProfile()?.id === editing) {
      location.reload();
      return;
    }
    closeEditor();
    renderGrid();
  }

  function wire() {
    const e = els();
    if (!e || e.gate.dataset.wired === "true") return;
    e.gate.dataset.wired = "true";

    e.createBtn.addEventListener("click", submitEditor);
    e.input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") submitEditor();
    });
    e.addBtn.addEventListener("click", () => openEditor("create"));
    e.editorCancel.addEventListener("click", () => {
      if (getProfiles().length > 0) closeEditor();
    });
    e.cancelBtn.addEventListener("click", closeGate);
    e.closeBtn.addEventListener("click", closeGate);
    e.deleteKeepBtn.addEventListener("click", closeDeleteConfirm);
    e.deleteConfirmBtn.addEventListener("click", () => {
      if (!pendingDeleteId) return;
      deleteProfile(pendingDeleteId);
      renderGrid();
      if (getProfiles().length === 0) openEditor("create");
    });
    e.gate.addEventListener("click", (event) => {
      if (event.target === e.gate && getActiveProfile()) closeGate();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !e.gate.classList.contains("hidden") &&
        getActiveProfile()
      ) {
        closeGate();
      }
    });
    document.addEventListener("profile-gate:open", openGate);
  }

  function init() {
    wire();
    const active = getActiveProfile();
    const e = els();
    if (e) {
      e.cancelBtn.classList.toggle("hidden", !active);
      e.closeBtn.classList.toggle("hidden", !active);
    }
    if (!active) openGate();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

