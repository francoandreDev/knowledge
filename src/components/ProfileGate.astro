---
import { Plus, X, HelpCircle } from "lucide-astro";
import LevelsModal from "./LevelsModal.astro";
---

<div
  data-profile-gate
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm"
>
  <div
    data-profile-gate-card
    class="animate-fade-slide-in relative max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl border border-slate-200 bg-white p-5 shadow-xl dark:border-slate-800 dark:bg-slate-900"
  >
    <button
      type="button"
      data-profile-gate-close
      aria-label="Close"
      title="Close"
      class="absolute top-3 right-3 hidden shrink-0 rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-200"
    >
      <X class="h-4 w-4" aria-hidden="true" />
    </button>

    <h2 class="pr-6 text-lg font-semibold tracking-tight">Who's this?</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      Pick a profile to continue. Progress, exercise results, and whiteboard
      notes are saved locally in this browser, under whichever one you pick —
      nothing leaves your device.
    </p>

    <div
      data-profile-delete-confirm
      class="mt-3 hidden items-center gap-2 rounded-lg border p-2 text-xs"
      style="border-color: var(--accent-soft-border); background: var(--accent-soft-bg)"
    >
      <span class="flex-1">
        Delete <strong data-profile-delete-name></strong>? All of its progress
        goes with it.
      </span>
      <button
        type="button"
        data-profile-delete-keep
        class="shrink-0 rounded-md border border-slate-300 bg-white px-2 py-1 font-semibold whitespace-nowrap text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
      >
        Keep it
      </button>
      <button
        type="button"
        data-profile-delete-confirm-btn
        class="shrink-0 rounded-md bg-red-600 px-2 py-1 font-semibold whitespace-nowrap text-white hover:bg-red-700"
      >
        Delete
      </button>
    </div>

    <div data-profile-grid class="mt-4 grid grid-cols-3 gap-2"></div>

    <div data-profile-create-row class="mt-3 hidden items-center gap-2">
      <input
        type="text"
        data-profile-name-input
        placeholder="Your name"
        maxlength="40"
        class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:focus:border-slate-500"
      />
      <button
        type="button"
        data-profile-create-btn
        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
      >
        <Plus class="h-4 w-4" aria-hidden="true" />
        Create
      </button>
    </div>
    <p
      data-profile-error
      class="mt-2 hidden text-xs text-red-600 dark:text-red-400"
    >
    </p>

    <div class="mt-4 flex items-center justify-between">
      <button
        type="button"
        data-levels-trigger
        class="inline-flex items-center gap-1 text-xs font-medium hover:underline"
        style="color: var(--accent-text)"
      >
        <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
        What do the levels mean?
      </button>
      <a
        href="/roadmap"
        class="text-xs font-medium text-slate-500 hover:underline dark:text-slate-400"
      >
        Personalize later →
      </a>
    </div>

    <button
      type="button"
      data-profile-gate-cancel
      class="mt-4 hidden w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 transition hover:border-slate-400 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-500"
    >
      Cancel
    </button>
  </div>
</div>

<template data-profile-tile-template>
  <div
    data-profile-tile
    class="group relative flex flex-col items-center gap-1.5 rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"
  >
    <span
      data-profile-tile-badge
      class="absolute -top-1.5 left-1/2 hidden -translate-x-1/2 rounded-full px-1.5 py-0.5 text-[8.5px] font-bold tracking-wide text-white uppercase"
      style="background: var(--accent-text)"
    >
      Last used
    </span>
    <button
      type="button"
      data-profile-tile-delete
      aria-label="Delete profile"
      class="absolute top-1 right-1 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-white text-slate-400 opacity-0 transition group-hover:opacity-100 hover:!text-red-600 focus:opacity-100 dark:bg-slate-900"
    >
      <X class="h-3 w-3" aria-hidden="true" />
    </button>
    <button
      type="button"
      data-profile-tile-select
      class="flex w-full flex-col items-center gap-1.5"
    >
      <span class="relative block h-10 w-10 shrink-0">
        <svg
          viewBox="0 0 40 40"
          width="40"
          height="40"
          class="absolute inset-0 -rotate-90"
        >
          <circle
            cx="20"
            cy="20"
            r="17"
            fill="none"
            stroke-width="3"
            class="stroke-slate-200 dark:stroke-slate-800"></circle>
          <circle
            data-profile-tile-arc
            cx="20"
            cy="20"
            r="17"
            fill="none"
            stroke-width="3"
            stroke-linecap="round"
            style="stroke: var(--gauge-accent)"></circle>
        </svg>
        <span
          data-profile-tile-initial
          class="absolute inset-[4px] flex items-center justify-center rounded-full text-sm font-semibold text-white"
        ></span>
      </span>
      <span
        data-profile-tile-name
        class="max-w-full truncate text-xs font-semibold"></span>
      <span
        data-profile-tile-pct
        class="text-[10px] font-semibold"
        style="color: var(--gauge-accent)"></span>
    </button>
  </div>
</template>

<LevelsModal />

<script>
  import {
    getProfiles,
    getActiveProfile,
    createProfile,
    switchProfile,
    deleteProfile,
    countProfileDone,
    type Profile,
  } from "../lib/profile";

  const PALETTE = [
    "#0ea5e9",
    "#0f9c8c",
    "#b45309",
    "#7c3aed",
    "#be185d",
    "#0369a1",
    "#15803d",
    "#c2410c",
  ];

  function colorForProfile(id: string): string {
    let hash = 0;
    for (let i = 0; i < id.length; i++) {
      hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
    }
    return PALETTE[hash % PALETTE.length];
  }

  function getTrackUnits(): Record<string, string[]> {
    const el = document.getElementById("header-track-unit-slugs");
    if (!el?.textContent) return {};
    try {
      const parsed = JSON.parse(el.textContent);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function els() {
    const gate = document.querySelector<HTMLElement>("[data-profile-gate]");
    const grid = document.querySelector<HTMLElement>("[data-profile-grid]");
    const input = document.querySelector<HTMLInputElement>(
      "[data-profile-name-input]",
    );
    const createRow = document.querySelector<HTMLElement>(
      "[data-profile-create-row]",
    );
    const createBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-create-btn]",
    );
    const cancelBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-gate-cancel]",
    );
    const closeBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-gate-close]",
    );
    const error = document.querySelector<HTMLElement>("[data-profile-error]");
    const tileTemplate = document.querySelector<HTMLTemplateElement>(
      "[data-profile-tile-template]",
    );
    const deleteConfirm = document.querySelector<HTMLElement>(
      "[data-profile-delete-confirm]",
    );
    const deleteConfirmName = document.querySelector<HTMLElement>(
      "[data-profile-delete-name]",
    );
    const deleteKeepBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-delete-keep]",
    );
    const deleteConfirmBtn = document.querySelector<HTMLButtonElement>(
      "[data-profile-delete-confirm-btn]",
    );
    if (
      !gate ||
      !grid ||
      !input ||
      !createRow ||
      !createBtn ||
      !cancelBtn ||
      !closeBtn ||
      !error ||
      !tileTemplate ||
      !deleteConfirm ||
      !deleteConfirmName ||
      !deleteKeepBtn ||
      !deleteConfirmBtn
    ) {
      return null;
    }
    return {
      gate,
      grid,
      input,
      createRow,
      createBtn,
      cancelBtn,
      closeBtn,
      error,
      tileTemplate,
      deleteConfirm,
      deleteConfirmName,
      deleteKeepBtn,
      deleteConfirmBtn,
    };
  }

  let pendingDeleteId: string | null = null;

  function showError(error: HTMLElement, message: string) {
    error.textContent = message;
    error.classList.remove("hidden");
  }

  function clearError(error: HTMLElement) {
    error.textContent = "";
    error.classList.add("hidden");
  }

  function openDeleteConfirm(profile: Profile) {
    const e = els();
    if (!e) return;
    pendingDeleteId = profile.id;
    e.deleteConfirmName.textContent = profile.name;
    e.deleteConfirm.classList.remove("hidden");
    e.deleteConfirm.classList.add("flex");
  }

  function closeDeleteConfirm() {
    const e = els();
    if (!e) return;
    pendingDeleteId = null;
    e.deleteConfirm.classList.add("hidden");
    e.deleteConfirm.classList.remove("flex");
  }

  const GAUGE_RADIUS = 17;
  const GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;

  function renderProfileTile(
    profile: Profile,
    tileTemplate: HTMLTemplateElement,
    trackUnits: Record<string, string[]>,
    totalUnits: number,
  ): HTMLElement {
    const fragment = tileTemplate.content.cloneNode(true) as DocumentFragment;
    const tile = fragment.querySelector<HTMLElement>("[data-profile-tile]")!;
    const initial = tile.querySelector<HTMLElement>(
      "[data-profile-tile-initial]",
    )!;
    const nameEl = tile.querySelector<HTMLElement>("[data-profile-tile-name]")!;
    const pctEl = tile.querySelector<HTMLElement>("[data-profile-tile-pct]")!;
    const arc = tile.querySelector<SVGCircleElement>(
      "[data-profile-tile-arc]",
    )!;
    const selectBtn = tile.querySelector<HTMLButtonElement>(
      "[data-profile-tile-select]",
    )!;
    const deleteBtn = tile.querySelector<HTMLButtonElement>(
      "[data-profile-tile-delete]",
    )!;

    const done = countProfileDone(profile.id, trackUnits);
    const fraction = totalUnits > 0 ? done / totalUnits : 0;
    const pct = Math.round(fraction * 100);

    initial.textContent = (profile.name.trim().charAt(0) || "?").toUpperCase();
    initial.style.background = colorForProfile(profile.id);
    nameEl.textContent = profile.name;
    pctEl.textContent = totalUnits > 0 ? `${pct}%` : "New";
    arc.setAttribute("stroke-dasharray", String(GAUGE_CIRCUMFERENCE));
    arc.setAttribute(
      "stroke-dashoffset",
      String(GAUGE_CIRCUMFERENCE * (1 - fraction)),
    );

    selectBtn.addEventListener("click", () => {
      switchProfile(profile.id);
      location.reload();
    });

    deleteBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      openDeleteConfirm(profile);
    });

    return tile;
  }

  function renderGrid() {
    const e = els();
    if (!e) return;
    closeDeleteConfirm();

    const profiles = getProfiles();
    const trackUnits = getTrackUnits();
    const totalUnits = Object.values(trackUnits).reduce(
      (sum, slugs) => sum + slugs.length,
      0,
    );

    let lastId: string | null = null;
    let lastTime = -1;
    for (const profile of profiles) {
      const t = profile.lastActiveAt ?? profile.createdAt;
      if (t > lastTime) {
        lastTime = t;
        lastId = profile.id;
      }
    }

    e.grid.innerHTML = "";
    for (const profile of profiles) {
      const tile = renderProfileTile(
        profile,
        e.tileTemplate,
        trackUnits,
        totalUnits,
      );
      if (profiles.length > 1 && profile.id === lastId) {
        tile.style.borderColor = "var(--accent-soft-border)";
        tile.style.background = "var(--accent-soft-bg)";
        tile
          .querySelector<HTMLElement>("[data-profile-tile-badge]")
          ?.classList.remove("hidden");
      }
      e.grid.append(tile);
    }

    const addTile = document.createElement("button");
    addTile.type = "button";
    addTile.dataset.profileAddTile = "true";
    addTile.className =
      "flex min-h-[78px] flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-slate-300 p-2.5 text-slate-500 transition hover:border-slate-400 hover:text-slate-700 dark:border-slate-700 dark:text-slate-500 dark:hover:border-slate-600 dark:hover:text-slate-300";
    addTile.innerHTML =
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="text-[10.5px] font-semibold">New</span>';
    addTile.addEventListener("click", () => {
      e.createRow.classList.remove("hidden");
      e.createRow.classList.add("flex");
      e.input.focus();
    });
    e.grid.append(addTile);
  }

  function openGate() {
    const e = els();
    if (!e) return;
    renderGrid();
    clearError(e.error);
    e.input.value = "";
    e.createRow.classList.add("hidden");
    e.createRow.classList.remove("flex");

    e.gate.classList.remove("hidden");
    e.gate.classList.add("flex");
  }

  function closeGate() {
    const e = els();
    if (!e) return;
    e.gate.classList.add("hidden");
    e.gate.classList.remove("flex");
  }

  function submitNewProfile() {
    const e = els();
    if (!e) return;
    const name = e.input.value.trim();
    if (!name) {
      showError(e.error, "Enter a name to create a profile.");
      return;
    }
    createProfile(name);
    location.reload();
  }

  function wire() {
    const e = els();
    if (!e || e.gate.dataset.wired === "true") return;
    e.gate.dataset.wired = "true";

    e.createBtn.addEventListener("click", submitNewProfile);
    e.input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") submitNewProfile();
    });
    e.cancelBtn.addEventListener("click", closeGate);
    e.closeBtn.addEventListener("click", closeGate);
    e.deleteKeepBtn.addEventListener("click", closeDeleteConfirm);
    e.deleteConfirmBtn.addEventListener("click", () => {
      if (!pendingDeleteId) return;
      deleteProfile(pendingDeleteId);
      renderGrid();
    });

    e.gate.addEventListener("click", (event) => {
      if (event.target === e.gate && getActiveProfile()) closeGate();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !e.gate.classList.contains("hidden") &&
        getActiveProfile()
      ) {
        closeGate();
      }
    });

    document.addEventListener("profile-gate:open", openGate);
  }

  function init() {
    wire();
    const active = getActiveProfile();
    const e = els();
    if (e) {
      e.cancelBtn.classList.toggle("hidden", !active);
      e.closeBtn.classList.toggle("hidden", !active);
    }
    if (!active) openGate();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
