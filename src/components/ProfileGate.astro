  }
  .gate-cloud {
    position: absolute;
    color: #fff;
    opacity: 0.85;
    pointer-events: none;
    animation: gate-drift 14s ease-in-out infinite alternate;
  }
  :global(.dark) .gate-cloud {
    color: #1e293b;
  }
  .gate-cloud-1 {
    top: 1rem;
    right: 22%;
    width: 6rem;
  }
  .gate-cloud-2 {
    top: 3.5rem;
    right: 6%;
    width: 4.5rem;
    opacity: 0.6;
    animation-duration: 19s;
  }
  .gate-waves {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.5rem;
    width: 100%;
    color: #bae6fd;
    pointer-events: none;
  }
  :global(.dark) .gate-waves {
    color: #0c4a6e;
  }
  .editor-stage {
    background:
      radial-gradient(circle, rgb(15 23 42 / 0.12) 1px, transparent 1.6px) 0 0 /
        10px 10px,
      #e0f2fe;
  }
  @keyframes gate-drift {
    to {
      transform: translateX(1.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
