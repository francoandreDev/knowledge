---
// A separate top-layer <dialog> for "what do the levels mean?" — pulled out
// of ProfileGate.astro so opening it doesn't grow that modal (it stacks on
// top instead, same pattern as TopicMythModal.astro) and has room to explain
// itself properly instead of being squeezed into a collapsed <details>.
import { X } from "lucide-astro";

const LEVELS = [
  {
    name: "Junior",
    trait: "Executes with guidance",
    impact: "a task",
    comp: "$70–100k",
    compMin: 70,
    compMax: 100,
  },
  {
    name: "Mid",
    trait: "Owns features solo",
    impact: "a feature",
    comp: "$100–150k",
    compMin: 100,
    compMax: 150,
  },
  {
    name: "Senior",
    trait: "Designs under ambiguity",
    impact: "a system",
    comp: "$150–220k",
    compMin: 150,
    compMax: 220,
  },
  {
    name: "Staff",
    trait: "Multiplies other engineers",
    impact: "a team of teams",
    comp: "$220–350k",
    compMin: 220,
    compMax: 350,
  },
  {
    name: "Principal",
    trait: "Sets org-wide strategy",
    impact: "the org",
    comp: "$300–500k+",
    compMin: 300,
    compMax: 500,
  },
];

// Normalizes each level's comp band onto a shared $70k–$500k scale so the
// range bars are comparable at a glance — not just "this level's number" but
// "where this band sits relative to every other one."
const COMP_SCALE_MIN = 70;
const COMP_SCALE_MAX = 500;
function compBarStyle(min: number, max: number): string {
  const span = COMP_SCALE_MAX - COMP_SCALE_MIN;
  const left = ((min - COMP_SCALE_MIN) / span) * 100;
  const width = ((max - min) / span) * 100;
  return `left:${left}%; width:${width}%`;
}
---

<dialog
  data-levels-modal
  class="m-auto w-full max-w-lg rounded-xl border border-slate-200 bg-white p-0 text-slate-900 backdrop:bg-slate-950/60 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100"
>
  <div class="animate-fade-slide-in p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-lg font-semibold tracking-tight">
        What do the levels mean?
      </h2>
      <button
        type="button"
        data-levels-close
        aria-label="Close"
        class="shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <X class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>
    <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-500">
      Bar length is scope of impact — what breaks (or improves) if this person
      is wrong.
    </p>

    <div class="mt-4">
      <div
        class="relative mx-1 h-2 rounded-full bg-slate-200 dark:bg-slate-800"
      >
        <div
          data-you-pin-tick
          class="absolute top-0 hidden h-full w-0.5 -translate-x-1/2"
          style="left: 0%; background: var(--accent-text)"
        >
        </div>
        <div
          data-you-pin
          class="absolute -top-[19px] hidden -translate-x-1/2 rounded-full px-1.5 py-0.5 text-[9.5px] font-bold whitespace-nowrap text-white"
          style="left: 0%; background: var(--accent-text)"
        >
          <span data-you-pin-label>You · 0%</span>
        </div>
      </div>
      <div
        class="mt-1.5 flex justify-between text-[9.5px] text-slate-400 dark:text-slate-500"
      >
        {LEVELS.map((level) => <span>{level.name}</span>)}
      </div>
    </div>

    <ul class="mt-4 space-y-4">
      {
        LEVELS.map((level, i) => (
          <li class="flex items-center gap-3.5">
            <div
              class="h-1.5 w-9 shrink-0 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"
              aria-hidden="true"
            >
              <div
                class="h-full rounded-full"
                style={`width:${((i + 1) / LEVELS.length) * 100}%; background: var(--gauge-accent)`}
              />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-sm font-semibold">{level.name}</span>
                <span class="text-sm text-slate-600 dark:text-slate-400">
                  {level.trait}
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-500">
                Impact reaches{" "}
                <span class="font-medium text-slate-600 dark:text-slate-400">
                  {level.impact}
                </span>
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <span class="font-mono text-xs tabular-nums text-slate-400 dark:text-slate-600">
                {level.comp}
              </span>
              <div class="relative h-1.5 w-14 rounded-full bg-slate-200 dark:bg-slate-800">
                <div
                  class="absolute h-full rounded-full"
                  style={`${compBarStyle(level.compMin, level.compMax)}; background: var(--gauge-accent)`}
                />
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-5 text-[11px] text-slate-400 dark:text-slate-500">
      These are a framework for thinking about scope, not literal titles — the
      level itself is only earned and consolidated through real experience on
      the job. No amount of theory, or mastery of it, grants it: this isn't a
      course made of checkable topics.
    </p>

    <p class="mt-2 text-[11px] text-slate-400 dark:text-slate-500">
      Rough total-comp bands, US tech market — varies widely by company, region,
      and market conditions.
    </p>
  </div>
</dialog>

<script>
  import { countTotalDone } from "../lib/progress-gauges";

  function getTrackUnits(): Record<string, string[]> {
    const el = document.getElementById("header-track-unit-slugs");
    if (!el?.textContent) return {};
    try {
      const parsed = JSON.parse(el.textContent);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  // Rough, just-for-fun placement: positions a pin at the reader's exact
  // share of the written curriculum completed along a single Junior→
  // Principal track, rather than snapping it into one of the 5 rows below.
  // Only shown once they've actually completed something — at 0% the pin
  // would sit right at the start of "Junior" for every brand-new profile,
  // which reads as a judgment rather than a sense of progress.
  function highlightYourLevel() {
    const trackUnits = getTrackUnits();
    const total = Object.values(trackUnits).reduce(
      (sum, slugs) => sum + slugs.length,
      0,
    );
    const done = total > 0 ? countTotalDone(trackUnits) : 0;
    if (done <= 0 || total <= 0) return;

    const pct = Math.round(Math.min(1, done / total) * 100);
    const left = `${pct}%`;

    const tick = document.querySelector<HTMLElement>("[data-you-pin-tick]");
    const pin = document.querySelector<HTMLElement>("[data-you-pin]");
    const label = document.querySelector<HTMLElement>("[data-you-pin-label]");
    if (!tick || !pin || !label) return;

    tick.style.left = left;
    pin.style.left = left;
    label.textContent = `You · ${pct}%`;
    tick.classList.remove("hidden");
    pin.classList.remove("hidden");
  }

  function initLevelsModal() {
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-levels-modal]",
    );
    if (!dialog) return;
    if (dialog.dataset.wired === "true") return;
    dialog.dataset.wired = "true";

    document
      .querySelectorAll<HTMLElement>("[data-levels-trigger]")
      .forEach((trigger) => {
        if (trigger.dataset.levelsWired === "true") return;
        trigger.dataset.levelsWired = "true";
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          highlightYourLevel();
          dialog!.showModal();
        });
      });

    dialog
      .querySelector("[data-levels-close]")
      ?.addEventListener("click", () => dialog!.close());
    // Native <dialog> only closes on a backdrop click if we detect the
    // click landed on the dialog element itself (its padding box is the
    // backdrop area once ::backdrop is excluded from hit-testing).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });
  }

  initLevelsModal();
  document.addEventListener("astro:page-load", initLevelsModal);
</script>
