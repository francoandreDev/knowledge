---
// A separate top-layer <dialog> for "what do the levels mean?" — pulled out
// of ProfileGate.astro so opening it doesn't grow that modal (it stacks on
// top instead, same pattern as TopicMythModal.astro) and has room to explain
// itself properly instead of being squeezed into a collapsed <details>.
import { X } from "lucide-astro";

const LEVELS = [
  {
    name: "Junior",
    trait: "Executes with guidance",
    impact: "a task",
    comp: "$70–100k",
  },
  {
    name: "Mid",
    trait: "Owns features solo",
    impact: "a feature",
    comp: "$100–150k",
  },
  {
    name: "Senior",
    trait: "Designs under ambiguity",
    impact: "a system",
    comp: "$150–220k",
  },
  {
    name: "Staff",
    trait: "Multiplies other engineers",
    impact: "a team of teams",
    comp: "$220–350k",
  },
  {
    name: "Principal",
    trait: "Sets org-wide strategy",
    impact: "the org",
    comp: "$300–500k+",
  },
];
---

<dialog
  data-levels-modal
  class="m-auto w-full max-w-lg rounded-xl border border-slate-200 bg-white p-0 text-slate-900 backdrop:bg-slate-950/60 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100"
>
  <div class="animate-fade-slide-in p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-lg font-semibold tracking-tight">
        What do the levels mean?
      </h2>
      <button
        type="button"
        data-levels-close
        aria-label="Close"
        class="shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
      >
        <X class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>
    <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-500">
      Circle size is scope of impact — what breaks (or improves) if this person
      is wrong.
    </p>

    <ul class="mt-5 space-y-4">
      {
        LEVELS.map((level, i) => (
          <li
            data-level-row
            data-level-index={i}
            class="flex items-center gap-3.5 rounded-lg transition-colors"
          >
            <span
              class="flex shrink-0 items-center justify-center rounded-full"
              style={`width:${20 + i * 9}px; height:${20 + i * 9}px; background: color-mix(in srgb, var(--gauge-accent) ${28 + i * 16}%, transparent)`}
              aria-hidden="true"
            />
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-sm font-semibold">{level.name}</span>
                <span class="text-sm text-slate-600 dark:text-slate-400">
                  {level.trait}
                </span>
                <span
                  data-level-you-badge
                  class="hidden rounded-full px-1.5 py-0.5 text-[9.5px] font-bold tracking-wide text-white uppercase"
                  style="background: var(--accent-text)"
                >
                  You are ~here
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-500">
                Impact reaches{" "}
                <span class="font-medium text-slate-600 dark:text-slate-400">
                  {level.impact}
                </span>
              </p>
            </div>
            <span class="shrink-0 self-start font-mono text-xs tabular-nums text-slate-400 dark:text-slate-600">
              {level.comp}
            </span>
          </li>
        ))
      }
    </ul>

    <p
      data-level-you-caption
      class="mt-4 hidden text-[11px]"
      style="color: var(--accent-text)"
    >
      Rough placement based on the share of the curriculum you've completed here
      — not a literal title, just a sense of where you're tracking.
    </p>

    <p class="mt-2 text-[11px] text-slate-400 dark:text-slate-500">
      Rough total-comp bands, US tech market — varies widely by company, region,
      and market conditions.
    </p>
  </div>
</dialog>

<script>
  import { countTotalDone } from "../lib/progress-gauges";

  function getTrackUnits(): Record<string, string[]> {
    const el = document.getElementById("header-track-unit-slugs");
    if (!el?.textContent) return {};
    try {
      const parsed = JSON.parse(el.textContent);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  const LEVEL_COUNT = 5;

  // Rough, just-for-fun placement: bucket the reader's share of the written
  // curriculum completed into one of the 5 level rows. Only shown once
  // they've actually completed something — at 0% every bucket would point
  // at the same "Junior" row for every brand-new profile, which reads as a
  // judgment rather than a sense of progress.
  function highlightYourLevel() {
    const trackUnits = getTrackUnits();
    const total = Object.values(trackUnits).reduce(
      (sum, slugs) => sum + slugs.length,
      0,
    );
    const done = total > 0 ? countTotalDone(trackUnits) : 0;
    if (done <= 0 || total <= 0) return;

    const fraction = Math.min(1, done / total);
    const bucket = Math.min(
      LEVEL_COUNT - 1,
      Math.floor(fraction * LEVEL_COUNT),
    );

    const row = document.querySelector<HTMLElement>(
      `[data-level-row][data-level-index="${bucket}"]`,
    );
    row?.querySelector("[data-level-you-badge]")?.classList.remove("hidden");
    row?.style.setProperty("background", "var(--accent-soft-bg)");
    document
      .querySelector("[data-level-you-caption]")
      ?.classList.remove("hidden");
  }

  function initLevelsModal() {
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-levels-modal]",
    );
    if (!dialog) return;
    if (dialog.dataset.wired === "true") return;
    dialog.dataset.wired = "true";

    document
      .querySelectorAll<HTMLElement>("[data-levels-trigger]")
      .forEach((trigger) => {
        if (trigger.dataset.levelsWired === "true") return;
        trigger.dataset.levelsWired = "true";
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          highlightYourLevel();
          dialog!.showModal();
        });
      });

    dialog
      .querySelector("[data-levels-close]")
      ?.addEventListener("click", () => dialog!.close());
    // Native <dialog> only closes on a backdrop click if we detect the
    // click landed on the dialog element itself (its padding box is the
    // backdrop area once ::backdrop is excluded from hit-testing).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });
  }

  initLevelsModal();
  document.addEventListener("astro:page-load", initLevelsModal);
</script>
