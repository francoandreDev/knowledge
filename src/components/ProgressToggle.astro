---
import { Check, Lock, Circle } from "lucide-astro";

interface Props {
  track: string;
  unitSlug: string;
  hasExercises: boolean;
}

const { track, unitSlug, hasExercises } = Astro.props;
---

<button
  data-progress-toggle
  data-track={track}
  data-unit={unitSlug}
  data-has-exercises={String(hasExercises)}
  class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-300 data-[done=true]:border-emerald-500 data-[done=true]:bg-emerald-50 data-[done=true]:text-emerald-700 data-[due=true]:border-amber-500 data-[due=true]:bg-amber-50 data-[due=true]:text-amber-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:disabled:hover:border-slate-700 dark:data-[done=true]:border-emerald-500 dark:data-[done=true]:bg-emerald-950 dark:data-[done=true]:text-emerald-400 dark:data-[due=true]:border-amber-500 dark:data-[due=true]:bg-amber-950 dark:data-[due=true]:text-amber-400"
>
  <Check data-icon="done" class="hidden h-4 w-4" aria-hidden="true" />
  <Lock data-icon="gated" class="hidden h-4 w-4" aria-hidden="true" />
  <Circle data-icon="default" class="hidden h-4 w-4" aria-hidden="true" />
  <span data-progress-label>Mark as done</span>
</button>

<script>
  import {
    getProgress,
    markDone,
    unmarkDone,
    allExercisesPassed,
    checkAndApplyReviewDue,
    daysUntil,
  } from "../lib/spaced-repetition";

  // Exercise panels are scoped to one level each and pick their own random
  // 2-of-N pools on init (see ExercisePanel.astro), writing the result onto
  // their own dataset rather than a static prop — this reads that state
  // directly from the DOM (pull-based) so gating is correct regardless of
  // whether ProgressToggle's or ExercisePanel's script executes first.
  function getShownExerciseIds(): { ready: boolean; ids: string[] } {
    const panels = document.querySelectorAll<HTMLElement>(
      "[data-exercise-panel]",
    );
    if (panels.length === 0) return { ready: true, ids: [] };

    const ids: string[] = [];
    for (const panel of panels) {
      if (panel.dataset.ready !== "true") return { ready: false, ids: [] };
      ids.push(...JSON.parse(panel.dataset.shownIds || "[]"));
    }
    return { ready: true, ids };
  }

  function renderToggle(button: HTMLButtonElement) {
    const track = button.dataset.track!;
    const unitSlug = button.dataset.unit!;
    const hasExercises = button.dataset.hasExercises === "true";
    const label = button.querySelector<HTMLElement>("[data-progress-label]")!;
    const icons = {
      done: button.querySelector<HTMLElement>('[data-icon="done"]')!,
      gated: button.querySelector<HTMLElement>('[data-icon="gated"]')!,
      default: button.querySelector<HTMLElement>('[data-icon="default"]')!,
    };

    const state = getProgress(track, unitSlug);
    const shown = getShownExerciseIds();
    const gated =
      hasExercises &&
      (!shown.ready || !allExercisesPassed(track, unitSlug, shown.ids));

    button.dataset.done = String(state.done);
    button.disabled = false;

    const activeIcon = state.done ? "done" : gated ? "gated" : "default";
    for (const [name, el] of Object.entries(icons)) {
      el.classList.toggle("hidden", name !== activeIcon);
    }

    if (state.done) {
      const days = state.nextReviewAt ? daysUntil(state.nextReviewAt) : null;
      label.textContent = days !== null ? `Done (review in ${days}d)` : "Done";
    } else if (gated) {
      label.textContent = "Complete all exercises to mark as done";
      button.disabled = true;
    } else {
      label.textContent = "Mark as done";
    }
  }

  function renderAllToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-progress-toggle]")
      .forEach(renderToggle);
  }

  function wireToggle(button: HTMLButtonElement) {
    if (button.dataset.wired === "true") return;
    button.dataset.wired = "true";

    const track = button.dataset.track!;
    const unitSlug = button.dataset.unit!;

    const wasReset = checkAndApplyReviewDue(track, unitSlug);
    if (wasReset) {
      document.dispatchEvent(new CustomEvent("exercises:reset"));
    }

    button.addEventListener("click", () => {
      const state = getProgress(track, unitSlug);
      if (state.done) {
        unmarkDone(track, unitSlug);
      } else {
        const hasExercises = button.dataset.hasExercises === "true";
        const shown = getShownExerciseIds();
        if (
          hasExercises &&
          (!shown.ready || !allExercisesPassed(track, unitSlug, shown.ids))
        ) {
          return; // shouldn't happen (button is disabled), but be safe
        }
        markDone(track, unitSlug);
        button.classList.remove("animate-pop");
        // Re-trigger even if the class never finished removing (rapid
        // clicks) — reflow forces the browser to notice the class was gone
        // for a moment before it's added back.
        void button.offsetWidth;
        button.classList.add("animate-pop");
      }
      renderToggle(button);
    });
  }

  function initProgressToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-progress-toggle]")
      .forEach(wireToggle);
    renderAllToggles();
  }

  // Re-render (not re-wire) whenever an exercise is graded, so gating
  // unlocks live without needing a reload.
  document.addEventListener("exercise:graded", renderAllToggles);
  document.addEventListener("exercises:reset", renderAllToggles);
  document.addEventListener("exercises:shown", renderAllToggles);

  initProgressToggles();
  document.addEventListener("astro:page-load", initProgressToggles);
</script>
