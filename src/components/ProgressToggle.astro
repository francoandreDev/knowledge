---
interface Props {
  track: string;
  unitSlug: string;
}

const { track, unitSlug } = Astro.props;
const key = `progress:${track}/${unitSlug}`;
---

<button
  data-progress-key={key}
  class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-slate-400 data-[done=true]:border-emerald-500 data-[done=true]:bg-emerald-50 data-[done=true]:text-emerald-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:data-[done=true]:border-emerald-500 dark:data-[done=true]:bg-emerald-950 dark:data-[done=true]:text-emerald-400"
>
  <span data-progress-label>Mark as done</span>
</button>

<script>
  function initProgressToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("button[data-progress-key]")
      .forEach((button) => {
        const key = button.dataset.progressKey!;
        const label = button.querySelector<HTMLElement>(
          "[data-progress-label]",
        )!;

        function render() {
          const done = localStorage.getItem(key) === "true";
          button.dataset.done = String(done);
          label.textContent = done ? "Done" : "Mark as done";
        }

        button.addEventListener("click", () => {
          const done = localStorage.getItem(key) === "true";
          localStorage.setItem(key, String(!done));
          render();
        });

        render();
      });
  }

  initProgressToggles();
  document.addEventListener("astro:page-load", initProgressToggles);
</script>
