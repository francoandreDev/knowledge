    <rect x="120" y="30" width="60" height="40" rx="4" class="accent" />
    <text x="150" y="54" text-anchor="middle" class="label mono accent-text">bundle.js</text>
  `,
  "client-side-caching": `
    <rect x="10" y="30" width="44" height="40" rx="4" />
    <text x="32" y="24" text-anchor="middle" class="label">browser</text>
    <rect x="150" y="14" width="44" height="26" rx="4" opacity="0.6" />
