  cors: `
    <rect x="10" y="24" width="56" height="52" rx="6" />
    <text x="38" y="20" text-anchor="middle" class="label">app.example.com</text>
    <rect x="134" y="24" width="56" height="52" rx="6" class="accent" />
    <text x="162" y="20" text-anchor="middle" class="label accent-text">api.other.com</text>
    <path d="M70 42h60" marker-end="url(#arrow-dim)" />
    <text x="100" y="38" text-anchor="middle" class="label" opacity="0.7">fetch()</text>
    <circle cx="100" cy="58" r="9" class="accent" />
