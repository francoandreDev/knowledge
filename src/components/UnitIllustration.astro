---
// Hand-authored hero illustrations, one per pilot unit. Outline style
// matches lucide-astro (stroke-based, currentColor, rounded caps/joins) so
// these read as part of the same visual system as the chrome icons, just
// scaled up into a wider banner instead of a small glyph. The `.accent`/
// `.accent-stroke`/`.accent-text` classes read the `--accent`/`--accent-text`
// CSS vars (global.css) instead of a fixed color — the shared header
// illustration gets the site's default blue, while `::l2`/`::l3` variants
// inherit whichever level color their [data-tab-panel] ancestor sets.
//
// Pilot scope: only units listed in ILLUSTRATIONS have one. Falls through to
// nothing for every other unit — this is intentionally not yet wired to all
// 125 units (see CLAUDE.md Phase 2 pilot).
//
// `variant` distinguishes the shared header illustration (unitSlug, no
// variant) from per-level ones (unitSlug + "::l2" / "::l3") — each level
// gets its own distinct visual instead of reusing the header image.
interface Props {
  unitSlug: string;
  variant?: "l2" | "l3";
}

const { unitSlug, variant } = Astro.props;
const key = variant ? `${unitSlug}::${variant}` : unitSlug;

