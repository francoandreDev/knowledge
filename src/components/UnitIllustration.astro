---
// Hand-authored hero illustrations, one per pilot unit. Outline style
// matches lucide-astro (stroke-based, currentColor, rounded caps/joins) so
// these read as part of the same visual system as the chrome icons, just
// scaled up into a wider banner instead of a small glyph. Sky accent matches
// the mermaid chart palette already used elsewhere on the page (see
// Layout.astro's chartThemeVariables) rather than introducing a new color.
//
// Pilot scope: only units listed in ILLUSTRATIONS have one. Falls through to
// nothing for every other unit — this is intentionally not yet wired to all
// 125 units (see CLAUDE.md Phase 2 pilot).
interface Props {
  unitSlug: string;
}

const { unitSlug } = Astro.props;

const ILLUSTRATIONS: Record<string, string> = {
  "http-request-response-basics": `
    <rect x="8" y="30" width="52" height="40" rx="4" />
    <path d="M24 42h20M24 50h20M24 58h12" />
    <rect x="140" y="30" width="52" height="40" rx="4" />
    <path d="M156 42h20M156 50h20M156 58h12" stroke-opacity="0.5" />
    <path d="M64 42h72" class="accent" marker-end="url(#arrow-accent)" />
    <path d="M136 58H64" stroke-opacity="0.5" marker-end="url(#arrow-dim)" />
    <text x="100" y="36" text-anchor="middle" class="label">request</text>
    <text x="100" y="72" text-anchor="middle" class="label" opacity="0.6">response</text>
