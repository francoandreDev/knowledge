    <path d="M10 68L100 10" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="55" y="94" text-anchor="middle" class="label accent-text" font-size="5">price crosses zero</text>
    <text x="150" y="14" text-anchor="middle" class="label" opacity="0.7">clamped</text>
    <path d="M110 70h80" opacity="0.4" />
    <path d="M110 68L150 40L190 40" opacity="0.6" marker-end="url(#arrow-dim)" />
    <text x="150" y="94" text-anchor="middle" class="label" opacity="0.6" font-size="5">floors at zero</text>
  `,
  "shared-history": `
    <path d="M10 50h80" opacity="0.4" />
    <circle cx="60" cy="50" r="4" opacity="0.4" />
    <circle cx="80" cy="50" r="4" class="accent" />
    <text x="80" y="34" text-anchor="middle" class="label accent-text" font-size="5">teammate's commit</text>
    <path d="M10 70h140" stroke-dasharray="3 3" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="80" y="90" text-anchor="middle" class="label accent-text">force-push rewrites remote</text>
    <circle cx="80" cy="50" r="7" opacity="0.3" />
    <path d="M76 46l8 8M84 46l-8 8" class="accent-stroke" />
  `,
  "shared-history::l2": `
    <text x="45" y="10" text-anchor="middle" class="label" opacity="0.7">normal push</text>
    <path d="M15 50h60" opacity="0.5" />
    <circle cx="70" cy="50" r="6" opacity="0.4" />
    <path d="M64 44l12 12M76 44l-12 12" opacity="0.6" />
    <text x="45" y="76" text-anchor="middle" class="label" opacity="0.6" font-size="5">rejected — not fast-forward</text>
    <text x="155" y="10" text-anchor="middle" class="label accent-text">--force</text>
    <path d="M120 50h60" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="155" y="76" text-anchor="middle" class="label accent-text" font-size="5">overwrites remote ref anyway</text>
  `,
  "shared-history::l3": `
    <path d="M10 90h180" />
    <path d="M10 90V10" />
    <path d="M10 88L70 70L130 40L190 15" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="140" y="28" text-anchor="middle" class="label accent-text">commits lost (naive force)</text>
    <path d="M10 88L190 88" opacity="0.5" marker-end="url(#arrow-dim)" />
    <text x="100" y="98" text-anchor="middle" class="label" opacity="0.5">--force-with-lease: 0 lost →</text>
  `,
  "snapshots-manual-copies": `
    <text x="45" y="10" text-anchor="middle" class="label" opacity="0.7" font-size="5">project-v2-FINAL.zip</text>
    <rect x="15" y="16" width="24" height="20" rx="2" opacity="0.4" /><rect x="42" y="16" width="24" height="20" rx="2" opacity="0.4" /><rect x="69" y="16" width="24" height="20" rx="2" opacity="0.4" />
    <text x="45" y="50" text-anchor="middle" class="label" opacity="0.5" font-size="5">which one is current?</text>
    <text x="150" y="10" text-anchor="middle" class="label accent-text">git commits</text>
    <circle cx="120" cy="70" r="4" class="accent" /><circle cx="145" cy="70" r="4" class="accent" /><circle cx="170" cy="70" r="4" class="accent" />
    <path d="M124 70h17M149 70h17" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="150" y="90" text-anchor="middle" class="label accent-text" font-size="5">one traceable history</text>
  `,
  "snapshots-manual-copies::l2": `
    <rect x="10" y="20" width="40" height="24" rx="3" opacity="0.5" />
    <text x="30" y="14" text-anchor="middle" class="label" opacity="0.6" font-size="5">file A</text>
    <rect x="10" y="56" width="40" height="24" rx="3" opacity="0.5" />
    <text x="30" y="92" text-anchor="middle" class="label" opacity="0.6" font-size="5">file B (identical bytes)</text>
    <path d="M50 32h50M50 68h50" opacity="0.5" marker-end="url(#arrow-dim)" />
    <rect x="105" y="38" width="55" height="24" rx="4" class="accent" />
    <text x="132" y="54" text-anchor="middle" class="label accent-text mono" font-size="5">blob hash</text>
    <text x="132" y="76" text-anchor="middle" class="label accent-text" font-size="5">stored once</text>
  `,
  "snapshots-manual-copies::l3": `
    <path d="M10 90h180" />
    <path d="M10 90V10" />
    <path d="M10 88L70 60L130 30L190 10" opacity="0.5" marker-end="url(#arrow-dim)" />
    <text x="150" y="24" text-anchor="middle" class="label" opacity="0.6">manual copies</text>
    <path d="M10 88L70 82L130 76L190 70" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <text x="150" y="86" text-anchor="middle" class="label accent-text">git (content-addressed)</text>
    <text x="100" y="98" text-anchor="middle" class="label" opacity="0.5">project size →</text>
  `,
  "working-tree": `
    <rect x="10" y="30" width="50" height="50" rx="4" class="accent" />
    <text x="35" y="58" text-anchor="middle" class="label accent-text" font-size="5">working tree</text>
    <rect x="75" y="30" width="50" height="50" rx="4" opacity="0.5" />
    <text x="100" y="58" text-anchor="middle" class="label" opacity="0.6" font-size="5">index</text>
    <rect x="140" y="30" width="50" height="50" rx="4" opacity="0.5" />
    <text x="165" y="58" text-anchor="middle" class="label" opacity="0.6" font-size="5">HEAD</text>
    <path d="M35 30Q35 10 165 10Q165 10 165 30" class="accent-stroke" stroke-dasharray="3 3" marker-end="url(#arrow-accent)" />
    <text x="100" y="20" text-anchor="middle" class="label accent-text" font-size="5">uncommitted edit follows checkout</text>
    <text x="100" y="94" text-anchor="middle" class="label" opacity="0.5" font-size="5">only committed work is anchored to a branch</text>
  `,
  "working-tree::l2": `
    <rect x="10" y="18" width="180" height="16" rx="3" opacity="0.4" />
    <text x="100" y="29" text-anchor="middle" class="label" opacity="0.6" font-size="5">tracked, unchanged → clean switch</text>
    <rect x="10" y="40" width="180" height="16" rx="3" class="accent" />
    <text x="100" y="51" text-anchor="middle" class="label accent-text" font-size="5">tracked, edited → comes along with you</text>
    <rect x="10" y="62" width="180" height="16" rx="3" opacity="0.5" />
    <text x="100" y="73" text-anchor="middle" class="label" opacity="0.6" font-size="5">conflicting edit → checkout blocked</text>
  `,
  "working-tree::l3": `
    <text x="100" y="12" text-anchor="middle" class="label" opacity="0.6" font-size="5">uncommitted edits, by branch switch</text>
    <rect x="20" y="30" width="35" height="40" rx="4" opacity="0.5" />
    <text x="37" y="78" text-anchor="middle" class="label" opacity="0.6" font-size="5">safe: committed</text>
    <rect x="82" y="20" width="35" height="50" rx="4" class="accent" />
    <text x="99" y="78" text-anchor="middle" class="label accent-text" font-size="5">at risk: uncommitted</text>
    <rect x="144" y="45" width="35" height="25" rx="4" opacity="0.35" />
    <text x="161" y="78" text-anchor="middle" class="label" opacity="0.5" font-size="5">gitignored</text>
  `,
};

const raw = ILLUSTRATIONS[key];
---

{
  raw && (
    <div class="unit-illustration mb-6 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/50">
      <svg
        viewBox="0 0 200 100"
        class="h-auto w-full text-slate-400 dark:text-slate-600"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <defs>
          <marker
            id="arrow-accent"
            markerWidth="8"
            markerHeight="8"
            refX="6"
            refY="4"
            orient="auto"
          >
            <path d="M0 0l6 4-6 4" class="accent-stroke" fill="none" />
          </marker>
          <marker
            id="arrow-dim"
            markerWidth="8"
            markerHeight="8"
            refX="6"
            refY="4"
            orient="auto"
          >
            <path
              d="M0 0l6 4-6 4"
              stroke="currentColor"
              stroke-opacity="0.5"
              fill="none"
            />
          </marker>
        </defs>
        <Fragment set:html={raw} />
      </svg>
    </div>
  )
}

<style>
  /* set:html injects raw markup at runtime, which Astro can't attach its
     scope-hash class to — every rule touching that markup must be :global()
     or it silently never matches. */
  :global(.unit-illustration svg .label) {
    font-size: 6px;
    fill: currentColor;
    stroke: none;
    font-family: inherit;
  }
  :global(.unit-illustration svg .label.mono) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  :global(.unit-illustration svg .accent) {
    stroke: var(--accent);
  }
  :global(.unit-illustration svg .accent-stroke) {
    stroke: var(--accent);
  }
  :global(.unit-illustration svg .accent-text) {
    fill: var(--accent-text);
  }
</style>
