    <circle cx="28" cy="22" r="2.5" opacity="0.5" />
    <circle cx="36" cy="22" r="2.5" opacity="0.5" />
    <text x="24" y="48" class="label mono">&lt;input&gt;</text>
    <text x="24" y="62" class="label mono accent-text">&lt;script&gt;steal()&lt;/script&gt;</text>
    <path d="M24 68h88" stroke-dasharray="3 3" class="accent-stroke" />
    <path d="M150 50l24-18M150 50l24 18M150 50h34" class="accent-stroke" marker-end="url(#arrow-accent)" />
    <path d="M158 20a26 26 0 0 1 26 0M158 20l-4 6M158 20l6 3" class="accent-stroke" />
    <text x="172" y="14" text-anchor="middle" class="label accent-text">attacker</text>
  `,
  bundling: `
    <rect x="10" y="12" width="34" height="20" rx="3" />
    <text x="27" y="26" text-anchor="middle" class="label mono">a.js</text>
    <rect x="10" y="40" width="34" height="20" rx="3" />
    <text x="27" y="54" text-anchor="middle" class="label mono">b.js</text>
    <rect x="10" y="68" width="34" height="20" rx="3" />
    <text x="27" y="82" text-anchor="middle" class="label mono">c.js</text>
    <path d="M44 22h30M74 22Q100 22 100 50" marker-end="url(#arrow-dim)" />
