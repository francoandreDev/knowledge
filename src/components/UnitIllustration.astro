    <text x="16" y="51" class="label mono" opacity="0.8">.btn { color: blue }</text>
    <rect x="10" y="62" width="120" height="18" rx="3" class="accent" />
    <text x="16" y="75" class="label mono accent-text">#submit .btn { color: red }</text>
