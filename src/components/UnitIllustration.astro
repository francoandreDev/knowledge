    <text x="42" y="30" text-anchor="middle" class="label mono" opacity="0.6">div</text>
    <rect x="12" y="38" width="60" height="14" rx="2" opacity="0.4" />
    <text x="42" y="48" text-anchor="middle" class="label mono" opacity="0.6">div</text>
    <rect x="12" y="56" width="60" height="14" rx="2" opacity="0.4" />
    <text x="42" y="66" text-anchor="middle" class="label mono" opacity="0.6">div</text>
    <rect x="12" y="74" width="60" height="14" rx="2" opacity="0.4" />
    <text x="42" y="84" text-anchor="middle" class="label mono" opacity="0.6">div</text>
    <text x="158" y="14" text-anchor="middle" class="label accent-text">semantic HTML</text>
    <rect x="128" y="20" width="60" height="14" rx="2" class="accent" />
    <text x="158" y="30" text-anchor="middle" class="label mono accent-text">header</text>
    <rect x="128" y="38" width="60" height="14" rx="2" class="accent" />
    <text x="158" y="48" text-anchor="middle" class="label mono accent-text">nav</text>
    <rect x="128" y="56" width="60" height="14" rx="2" class="accent" />
    <text x="158" y="66" text-anchor="middle" class="label mono accent-text">main</text>
    <rect x="128" y="74" width="60" height="14" rx="2" class="accent" />
    <text x="158" y="84" text-anchor="middle" class="label mono accent-text">footer</text>
  `,
  "render-performance": `
    <path d="M10 70h180" />
    <path d="M10 70V26M120 70V16" stroke-dasharray="2 3" opacity="0.6" />
    <text x="120" y="12" text-anchor="middle" class="label accent-text">16ms budget</text>
    <rect x="10" y="52" width="110" height="18" rx="2" opacity="0.5" />
    <rect x="120" y="52" width="55" height="18" rx="2" class="accent" />
    <text x="92" y="90" text-anchor="middle" class="label" opacity="0.7">long task</text>
