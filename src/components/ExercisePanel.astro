---
import { HelpCircle, Code2 } from "lucide-astro";
import { groupExercisesIntoPools, type ExerciseItem } from "../lib/curriculum";

interface Props {
  track: string;
  unitSlug: string;
  exercises: ExerciseItem[];
}

const { track, unitSlug, exercises } = Astro.props;
const pools = groupExercisesIntoPools(exercises);
---

{
  pools.length > 0 && (
    <div
      data-exercise-panel
      data-track={track}
      data-unit={unitSlug}
      class="mt-10 space-y-6 border-t border-slate-200 pt-8 dark:border-slate-800"
    >
      <h3 class="flex items-center gap-1.5 text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
        <HelpCircle class="h-4 w-4" aria-hidden="true" />
        Exercises
      </h3>
      {pools.length > 2 && (
        <p class="text-xs text-slate-400 dark:text-slate-500">
          Showing 2 of {pools.length} — reload for a different pair.
        </p>
      )}
      {pools.map((pool) => {
        const isCode = pool.variants[0]?.type === "code";
        return (
          <div
            data-exercise-pool
            data-pool-id={pool.poolId}
            data-track={track}
            data-unit={unitSlug}
            class="hidden rounded-lg border border-slate-200 p-4 dark:border-slate-800"
          >
            <div class="mb-2 flex items-center gap-1.5 text-xs font-medium text-slate-400 dark:text-slate-500">
              {isCode ? (
                <Code2 class="h-3.5 w-3.5" aria-hidden="true" />
              ) : (
                <HelpCircle class="h-3.5 w-3.5" aria-hidden="true" />
              )}
              {isCode ? "Code exercise" : "Quiz"}
            </div>
            <script
              type="application/json"
              data-pool-variants
              set:html={JSON.stringify(pool.variants)}
            />
            <div data-pool-content />
          </div>
        );
      })}
    </div>
  )
}

<script>
  import { setExerciseState } from "../lib/spaced-repetition";
  import { mountWhiteboardTrigger } from "../lib/whiteboard";
  import { mountLearnMoreTrigger } from "../lib/learn-more";

  type QuizVariant = {
    type: "quiz";
    id: string;
    prompt: string;
    choices: string[];
    correctIndex: number;
    explanation: string;
    reference?: string;
    learnMore?: string;
  };
  type CodeVariant = {
    type: "code";
    id: string;
    prompt: string;
    starterCode: string;
    tests: { description: string; expr: string }[];
    solution: string;
    explanation: string;
    reference?: string;
    learnMore?: string;
  };
  type Variant = QuizVariant | CodeVariant;

  const WORKER_SOURCE = `
    self.onmessage = (e) => {
      const { code, tests } = e.data;

      function expect(actual) {
        return {
          toBe(expected) {
            if (!Object.is(actual, expected)) {
              throw new Error("Expected " + JSON.stringify(actual) + " to be " + JSON.stringify(expected));
            }
          },
          toEqual(expected) {
            const a = JSON.stringify(actual);
            const b = JSON.stringify(expected);
            if (a !== b) throw new Error("Expected " + a + " to equal " + b);
          },
          toBeTruthy() {
            if (!actual) throw new Error("Expected " + JSON.stringify(actual) + " to be truthy");
          },
          toThrow() {
            if (typeof actual !== "function") {
              throw new Error("expect(...).toThrow() needs a function");
            }
            let threw = false;
            try { actual(); } catch { threw = true; }
            if (!threw) throw new Error("Expected function to throw, but it didn't");
          },
        };
      }

      const results = [];
      for (const t of tests) {
        try {
          eval(code + "\\n" + t.expr);
          results.push({ description: t.description, passed: true });
        } catch (err) {
          results.push({ description: t.description, passed: false, error: String((err && err.message) || err) });
        }
      }
      self.postMessage({ results });
    };
  `;

  function runInWorker(
    code: string,
    tests: { description: string; expr: string }[],
  ): Promise<{ description: string; passed: boolean; error?: string }[]> {
    return new Promise((resolve) => {
      const blob = new Blob([WORKER_SOURCE], {
        type: "application/javascript",
      });
      const worker = new Worker(URL.createObjectURL(blob));

      const timeout = setTimeout(() => {
        worker.terminate();
        resolve(
          tests.map((t) => ({
            description: t.description,
            passed: false,
            error: "Timed out after 3s — possible infinite loop.",
          })),
        );
      }, 3000);

      worker.onmessage = (e) => {
        clearTimeout(timeout);
        worker.terminate();
        resolve(e.data.results);
      };
      worker.onerror = (e) => {
        clearTimeout(timeout);
        worker.terminate();
        resolve(
          tests.map((t) => ({
            description: t.description,
            passed: false,
            error: e.message,
          })),
        );
      };

      worker.postMessage({ code, tests });
    });
  }

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // The whiteboard's reference panel is the question itself — the
  // choices/starter code are already visible on the page right next to the
  // drawer, so repeating them here would be the exact duplication this is
  // meant to avoid — plus, when set, the pool's own `reference`: a compact
  // visual and one-line theory statement connecting a wrong answer back to
  // the concept it's testing. The question is built via textContent (safely
  // HTML-escaped); `reference` is trusted, author-written HTML from
  // exercises.json, same as `Scenario`'s `facts` slot.
  function buildReferenceHTML(promptText: string, reference?: string): string {
    const wrap = document.createElement("div");
    const label = el(
      "p",
      "text-xs font-semibold uppercase tracking-wide text-slate-400",
      "Question",
    );
    const p = document.createElement("p");
    p.textContent = promptText;
    wrap.append(label, p);
    if (reference) {
      const referenceWrap = document.createElement("div");
      referenceWrap.className =
        "mt-3 border-t border-slate-200 pt-3 dark:border-slate-700";
      referenceWrap.innerHTML = reference;
      wrap.append(referenceWrap);
    }
    return wrap.innerHTML;
  }

  function exerciseToolsRow(
    poolId: string,
    referenceHTML: string,
    learnMore: string | undefined,
  ): HTMLElement {
    const row = el("div", "mt-2 flex justify-end gap-2");
    mountWhiteboardTrigger(row, {
      storageKey: `whiteboard:${location.pathname}:${poolId}`,
      referenceHTML,
      title: "Exercise reference",
    });
    if (learnMore) {
      mountLearnMoreTrigger(row, {
        title: "Learn more",
        contentHTML: learnMore,
      });
    }
    return row;
  }

  function renderQuiz(
    container: HTMLElement,
    variant: QuizVariant,
    track: string,
    unitSlug: string,
    poolId: string,
    reference: string | undefined,
    learnMore: string | undefined,
  ) {
    const prompt = el(
      "p",
      "text-sm text-slate-800 dark:text-slate-200",
      variant.prompt,
    );
    const toolRow = exerciseToolsRow(
      poolId,
      buildReferenceHTML(variant.prompt, reference),
      learnMore,
    );
    const wrap = el("div", "mt-3 space-y-2");

    const UNSELECTED_LABEL_CLASS =
      "flex items-center gap-2 rounded-md border border-transparent px-2 py-1 text-sm text-slate-700 dark:text-slate-300";
    // Native radio dots are easy to miss at a glance, especially scanning
    // several choices quickly — the label itself now carries a visible
    // border + background + bold text while its radio is checked, on top
    // of (not instead of) the native dot.
    const SELECTED_LABEL_CLASS =
      "flex items-center gap-2 rounded-md border border-slate-400 bg-slate-100 px-2 py-1 text-sm font-medium text-slate-900 dark:border-slate-500 dark:bg-slate-800 dark:text-slate-100";

    const radios: HTMLInputElement[] = [];
    variant.choices.forEach((choice, i) => {
      const label = el("label", UNSELECTED_LABEL_CLASS);
      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = `quiz-${variant.id}`;
      radio.value = String(i);
      radio.className =
        "h-4 w-4 shrink-0 accent-slate-900 dark:accent-slate-100";
      radio.addEventListener("change", () => {
        radios.forEach((r) => {
          r.closest("label")!.className = r.checked
            ? SELECTED_LABEL_CLASS
            : UNSELECTED_LABEL_CLASS;
        });
      });
      radios.push(radio);
      label.append(radio, document.createTextNode(choice));
      wrap.append(label);
    });

    const feedback = el("p", "hidden text-sm font-medium");
    const explanation = el(
      "p",
      "hidden mt-1 text-sm text-slate-500 dark:text-slate-400",
      variant.explanation,
    );
    const checkButton = el(
      "button",
      "rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-300 dark:border-slate-700 dark:text-slate-300 dark:disabled:hover:border-slate-700",
      "Check answer",
    );
    checkButton.type = "button";

    // One attempt per view — once graded, the radios and button lock. Without
    // this, nothing stops clicking through choices one at a time until one
    // happens to pass, or re-selecting the now-visible correct answer after
    // reading the explanation — either way "passed" would no longer mean the
    // learner actually knew it going in.
    checkButton.addEventListener("click", () => {
      const selected = radios.find((r) => r.checked);
      if (!selected) {
        feedback.textContent = "Pick an answer first.";
        feedback.className = "text-sm font-medium text-amber-600";
        feedback.classList.remove("hidden");
        return;
      }
      const passed = Number(selected.value) === variant.correctIndex;
      setExerciseState(track, unitSlug, poolId, passed ? "passed" : "failed");
      feedback.textContent = passed ? "Correct" : "Not quite";
      feedback.className = passed
        ? "text-sm font-medium text-emerald-600 animate-pop"
        : "text-sm font-medium text-red-600 animate-shake";
      feedback.classList.remove("hidden");
      explanation.classList.remove("hidden");
      explanation.classList.add("animate-fade-slide-in");

      radios.forEach((radio, i) => {
        radio.disabled = true;
        const label = radio.closest("label")!;
        if (i === variant.correctIndex) {
          label.className =
            "flex items-center gap-2 text-sm font-medium text-emerald-700 dark:text-emerald-400";
        } else if (radio === selected) {
          label.className =
            "flex items-center gap-2 text-sm font-medium text-red-700 line-through dark:text-red-400";
        } else {
          label.className =
            "flex items-center gap-2 text-sm text-slate-400 dark:text-slate-600";
        }
      });
      checkButton.disabled = true;

      document.dispatchEvent(new CustomEvent("exercise:graded"));
    });

    wrap.append(checkButton, feedback, explanation);
    container.append(prompt, toolRow, wrap);
  }

  function renderCode(
    container: HTMLElement,
    variant: CodeVariant,
    track: string,
    unitSlug: string,
    poolId: string,
    reference: string | undefined,
    learnMore: string | undefined,
  ) {
    const prompt = el(
      "p",
      "text-sm text-slate-800 dark:text-slate-200",
      variant.prompt,
    );
    const toolRow = exerciseToolsRow(
      poolId,
      buildReferenceHTML(variant.prompt, reference),
      learnMore,
    );
    const wrap = el("div", "mt-3 space-y-2");

    const textarea = document.createElement("textarea");
    textarea.spellcheck = false;
    textarea.rows = 6;
    textarea.value = variant.starterCode;
    textarea.className =
      "w-full rounded-md border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100";

    const runButton = el(
      "button",
      "rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 dark:border-slate-700 dark:text-slate-300",
      "Run tests",
    );
    runButton.type = "button";

    const resultsList = el("ul", "space-y-1 text-sm");
    const solutionWrap = el("div", "hidden mt-3 space-y-1");
    const solutionLabel = el(
      "p",
      "text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400",
      "Solution",
    );
    const solutionCode = el(
      "pre",
      "overflow-x-auto rounded-md bg-slate-900 p-3 text-sm text-slate-100",
    );
    const solutionCodeInner = document.createElement("code");
    solutionCodeInner.textContent = variant.solution;
    solutionCode.append(solutionCodeInner);
    const solutionExplanation = el(
      "p",
      "text-sm text-slate-500 dark:text-slate-400",
      variant.explanation,
    );
    solutionWrap.append(solutionLabel, solutionCode, solutionExplanation);

    runButton.addEventListener("click", async () => {
      runButton.disabled = true;
      runButton.textContent = "Running…";
      const results = await runInWorker(textarea.value, variant.tests);
      runButton.disabled = false;
      runButton.textContent = "Run tests";

      resultsList.innerHTML = "";
      resultsList.classList.add("animate-fade-slide-in");
      let allPassed = true;
      for (const r of results) {
        if (!r.passed) allPassed = false;
        const li = el(
          "li",
          r.passed ? "text-emerald-600" : "text-red-600",
          r.passed
            ? `✓ ${r.description}`
            : `✗ ${r.description}${r.error ? ` — ${r.error}` : ""}`,
        );
        resultsList.append(li);
      }
      setExerciseState(
        track,
        unitSlug,
        poolId,
        allPassed ? "passed" : "failed",
      );
      resultsList.classList.add(allPassed ? "animate-pop" : "animate-shake");
      solutionWrap.classList.remove("hidden");
      solutionWrap.classList.add("animate-fade-slide-in");
      document.dispatchEvent(new CustomEvent("exercise:graded"));
    });

    wrap.append(textarea, runButton, resultsList, solutionWrap);
    container.append(prompt, toolRow, wrap);
  }

  function renderPool(poolEl: HTMLElement) {
    const track = poolEl.dataset.track!;
    const unitSlug = poolEl.dataset.unit!;
    const poolId = poolEl.dataset.poolId!;
    const content = poolEl.querySelector<HTMLElement>("[data-pool-content]")!;
    const variantsJson = poolEl.querySelector<HTMLScriptElement>(
      "[data-pool-variants]",
    )?.textContent;
    const variants: Variant[] = variantsJson ? JSON.parse(variantsJson) : [];
    if (variants.length === 0) return;

    const variant = variants[Math.floor(Math.random() * variants.length)];
    content.innerHTML = "";

    // Any variant in the pool may carry reference/learnMore (validate:content
    // enforces they're identical where set) — fall back to a sibling's so
    // it doesn't matter which random variant got shown.
    const reference =
      variant.reference ?? variants.find((v) => v.reference)?.reference;
    const learnMore =
      variant.learnMore ?? variants.find((v) => v.learnMore)?.learnMore;

    if (variant.type === "quiz") {
      renderQuiz(
        content,
        variant,
        track,
        unitSlug,
        poolId,
        reference,
        learnMore,
      );
    } else {
      renderCode(
        content,
        variant,
        track,
        unitSlug,
        poolId,
        reference,
        learnMore,
      );
    }
  }

  // Shows only 2 randomly-picked pools per panel (a panel is scoped to one
  // level) — the rest stay in the bank. Reshuffled on every init call,
  // including the exercises:reset spaced-repetition reset below, so a
  // re-exam shows a genuinely different pair, not the same 2 re-answered.
  function initExercises() {
    document
      .querySelectorAll<HTMLElement>("[data-exercise-panel]")
      .forEach((panel) => {
        const pools = Array.from(
          panel.querySelectorAll<HTMLElement>("[data-exercise-pool]"),
        );
        const shuffled = [...pools].sort(() => Math.random() - 0.5);
        const shown = shuffled.slice(0, 2);
        const shownIds = shown.map((el) => el.dataset.poolId!);

        for (const poolEl of pools) {
          poolEl.classList.add("hidden");
          poolEl.classList.remove("animate-fade-slide-in");
          poolEl.style.animationDelay = "";
        }
        shown.forEach((poolEl, i) => {
          poolEl.style.animationDelay = `${i * 80}ms`;
          renderPool(poolEl);
          poolEl.classList.remove("hidden");
          poolEl.classList.add("animate-fade-slide-in");
        });

        panel.dataset.shownIds = JSON.stringify(shownIds);
        panel.dataset.ready = "true";
      });
    document.dispatchEvent(new CustomEvent("exercises:shown"));
  }

  // A fresh random variant every time the pool is (re-)rendered — including
  // after a spaced-repetition reset, so a re-exam isn't the same question.
  document.addEventListener("exercises:reset", initExercises);

  initExercises();
  document.addEventListener("astro:page-load", initExercises);
</script>
