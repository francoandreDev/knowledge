---
// A unit's own emblem: the first keyword rule that matches its title or slug
// picks a specific icon (undo, merge, cache, lock...), so two units that share
// a tag still look different on the roadmap. Falls back to the tag icon.
import {
  Anchor,
  Archive,
  Bell,
  Binary,
  Brain,
  Bug,
  Calculator,
  Calendar,
  Clock,
  Cloud,
  Container,
  Copy,
  Cpu,
  Database,
  Dices,
  Eye,
  FileText,
  Filter,
  FolderTree,
  Gauge,
  Gem,
  GitBranch,
  GitCommit,
  GitMerge,
  GitPullRequest,
  Globe,
  Handshake,
  Hash,
  HardDrive,
  Hourglass,
  KeyRound,
  Layers,
  Lightbulb,
  Link,
  ListChecks,
  Lock,
  Mail,
  Map,
  MessageSquare,
  Microscope,
  Package,
  Puzzle,
  Repeat,
  Rocket,
  Router,
  Scale,
  Scissors,
  Search,
  Server,
  Shield,
  Shuffle,
  Siren,
  Telescope,
  Terminal,
  TestTube,
  Timer,
  Undo2,
  Users,
  Wallet,
  Webhook,
  Workflow,
  Zap,
} from "lucide-astro";
import TagIcon from "./TagIcon.astro";

interface Props {
  text: string;
  tag?: string;
  class?: string;
}

const { text, tag = "", class: className = "" } = Astro.props;

const RULES: Array<[RegExp, typeof Lock]> = [
  [/undo|revert|reset|rollback|mistake/, Undo2],
  [/rebase|merge|conflict/, GitMerge],
  [/pull request|code review|review/, GitPullRequest],
  [/commit|snapshot|history/, GitCommit],
  [/branch/, GitBranch],
  [/cach/, Zap],
  [/password|hash|token|secret|credential/, KeyRound],
  [/encrypt|tls|https|certificate/, Lock],
  [/inject|xss|csrf|attack|vulnerab|threat/, Bug],
  [/auth|permission|identity|access/, Shield],
  [/sql|database|index|transaction|schema|query/, Database],
  [/dns|network|tcp|packet|latency|routing/, Router],
  [/http|request|response|url|browser|web/, Globe],
  [/api|rest|webhook|integration/, Webhook],
  [/queue|event|message|async|stream/, Workflow],
  [/thread|concurren|race|lock|deadlock|parallel/, Cpu],
  [/memory|disk|storage|file/, HardDrive],
  [/container|docker|image/, Container],
  [/deploy|release|ship|rollout|pipeline|ci\b/, Rocket],
  [/cloud|serverless|scal/, Cloud],
  [/monitor|observab|log|metric|trace/, Eye],
  [/incident|outage|on-call|alert|postmortem/, Siren],
  [/slo|sla|reliab|availab/, Gauge],
  [/perform|fast|slow|speed|profil|big-o|complexity|algorithm/, Timer],
  [/sort|search|tree|graph|array|data struct/, Binary],
  [/test|assert|mock|tdd/, TestTube],
  [/debug|bug|trace/, Bug],
  [/estimat|forecast|deadline|schedule|plan/, Calendar],
  [/time|hour|focus|deep work/, Hourglass],
  [/budget|cost|price|money|salary|roi/, Wallet],
  [/negotiat|deal|agree|contract/, Handshake],
  [/feedback|1:1|one-on-one|mentor|coach/, MessageSquare],
  [/email|write|writing|document|memo|doc/, FileText],
  [/meeting|present|stakeholder|audience|team|people|hire|hiring/, Users],
  [/decision|trade-?off|choose|choice|bias/, Scale],
  [/probab|statist|math|calcul|expected|average|percent/, Calculator],
  [/random|luck|risk|odds|chance/, Dices],
  [/learn|memor|practice|study|spaced/, Brain],
  [/idea|model|principle|why/, Lightbulb],
  [/refactor|smell|clean|solid|pattern|design/, Puzzle],
  [/layer|architecture|module|boundar|hexagonal/, Layers],
  [/service|server|backend|monolith|micro/, Server],
  [/copy|duplicate|replica/, Copy],
  [/split|cut|scope|slice/, Scissors],
  [/retry|loop|repeat|idempot/, Repeat],
  [/shuffle|reorder|sequence/, Shuffle],
  [/link|reference|dependen/, Link],
  [/package|library|bundle|module/, Package],
  [/folder|structure|organi/, FolderTree],
  [/cli|shell|terminal|command|script/, Terminal],
  [/roadmap|path|career|promotion|growth/, Map],
  [/strategy|vision|long-term|future/, Telescope],
  [/research|experiment|hypothes/, Microscope],
  [/checklist|process|step/, ListChecks],
  [/filter|noise|signal/, Filter],
  [/notif|remind/, Bell],
  [/archive|backup|retention/, Archive],
  [/value|worth|premium|quality/, Gem],
  [/hold|stable|anchor|baseline/, Anchor],
  [/mail|inbox|communicat/, Mail],
  [/clock|latency|timeout/, Clock],
  [/search|find|lookup/, Search],
  [/hash/, Hash],
];

const haystack = text.toLowerCase();
const Match = RULES.find(([re]) => re.test(haystack))?.[1];
---

{
  Match ? (
    <Match class={className} aria-hidden="true" />
  ) : (
    <TagIcon tag={tag} class={className} />
  )
}
