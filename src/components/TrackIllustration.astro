---
// Small hero illustrations, one per track — used on the homepage and
// roadmap track headers to make each category visually recognizable at a
// glance, the same outline/accent visual language as UnitIllustration.astro
// (stroke-based, currentColor, `.accent`/`.label` classes reading the
// `--accent`/`--accent-text` tokens from global.css). These always render
// outside any level tab panel, so they pick up the site's default (L1/blue)
// accent — no per-level variants needed here, unlike unit illustrations.
interface Props {
  track: string;
  class?: string;
}

const { track, class: className = "" } = Astro.props;

const ILLUSTRATIONS: Record<string, string> = {
  web: `
    <rect x="10" y="20" width="70" height="60" rx="5" />
    <path d="M10 34h70" />
    <circle cx="20" cy="27" r="1.6" fill="currentColor" />
    <circle cx="26" cy="27" r="1.6" fill="currentColor" />
    <rect x="120" y="20" width="70" height="60" rx="5" opacity="0.6" />
    <path d="M120 34h70" opacity="0.6" />
    <path d="M82 42h36" class="accent" marker-end="url(#arrow-accent)" />
    <path d="M118 60h-36" opacity="0.5" marker-end="url(#arrow-dim)" />
    <text x="45" y="94" text-anchor="middle" class="label mono">client</text>
