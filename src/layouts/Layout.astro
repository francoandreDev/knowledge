---
import "../styles/global.css";
import {
  GraduationCap,
  ListChecks,
  Gamepad2,
  Sun,
  Moon,
  UserRound,
  Search,
  ChevronRight,
} from "lucide-astro";
import ProfileGate from "../components/ProfileGate.astro";
import { getWrittenUnits } from "../lib/curriculum";
import { groupSlugsByTrack } from "../lib/progress-gauges";
import { getUnit, roadmap } from "../data/roadmap";
import { TRACK_ICON_PATHS } from "../lib/track-icon-paths";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Card grids and lists (home, roadmap, track listings) have real use for
   * the extra room on a wide screen — more columns, less wasted margin.
   * Long-form prose doesn't: `.prose-panel` below sets `max-w-none` so
   * Typography's own 65ch cap never fights this container's width, which
   * means a unit page must keep the *narrower* default or its L1/L2/L3
   * text would stretch to an uncomfortable line length. Default false.
   *
   * A first pass capped this at max-w-6xl (1152px) — on an ordinary
   * 1280-1440px laptop window that cap alone *is* almost the full width,
   * so the "breathing room" fix looked like no margin at all. The actual
   * ask was simpler: keep a fixed, modest side gutter (the 32-48px desktop
   * range) and let content use whatever's left, rather than capping the
   * column at a fixed pixel width and calling the rest "margin." So: a
   * much more generous outer cap (only relevant on genuinely huge/ultrawide
   * monitors) plus padding that scales with the breakpoint instead of a
   * tight fixed max-width doing the work.
   */
  wide?: boolean;
  /**
   * Shown in the header in place of the plain "systems-mastery" wordmark —
   * a reader two levels deep in a unit page otherwise sees a header
   * indistinguishable from the homepage's. Only unit pages pass this; every
   * other page leaves it unset and keeps the wordmark exactly as before.
   */
  breadcrumb?: { track: string; unit: string };
}

const {
  title,
  description = "A self-study curriculum from junior to a solid staff-level engineer.",
  ogImage,
  wide = false,
  breadcrumb,
} = Astro.props;
const shellClass = wide
  ? "max-w-[1600px] px-4 sm:px-6 lg:px-8 xl:px-12"
  : "max-w-4xl px-4";

// No production domain is configured yet (astro.config.mjs has no `site`) —
// once this deploys, set `site` there so this resolves to a real absolute
// URL instead of falling back to Astro's build-time placeholder origin.
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url).toString()
  : undefined;

const pathname = Astro.url.pathname;
const isRoadmapActive =
  pathname === "/roadmap" || pathname.startsWith("/roadmap/");
const isGameActive = pathname === "/game" || pathname.startsWith("/game/");

// Header-wide search (reachable from every page, not just home/roadmap) and
// the profile button's progress ring both need the same written-units pool
// — built once here, in the layout every page already goes through, rather
// than duplicating this per page.
const headerWrittenUnits = await getWrittenUnits();
const headerUnitLookup = headerWrittenUnits.map((u) => {
  const unit = getUnit(u.track, u.unitSlug);
  return {
    track: u.track,
    slug: u.unitSlug,
    problem: unit?.problem ?? u.unitSlug,
  };
});
const headerTrackNames = roadmap.tracks.map((t) => t.name);
const headerTrackUnitSlugs = groupSlugsByTrack(headerWrittenUnits);
---

<html lang="en" class="scroll-smooth">
  <head>
    <script is:inline>
      // Resolves the effective theme (explicit user choice from a previous
      // toggle, falling back to OS preference) into a `.dark` class on
      // <html> BEFORE first paint — must run this early and un-deferred to
      // avoid a flash of the wrong theme. Every `dark:` utility site-wide
      // (via the `@custom-variant dark` in global.css) and every custom
      // accent-token rule keys off this one class from here on, not off
      // prefers-color-scheme directly.
      (function () {
        const stored = localStorage.getItem("theme");
        const isDark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · systems-mastery</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · systems-mastery`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · systems-mastery`} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
  </head>
  <body
    class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <header
      class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80"
    >
      <nav
        class={`relative mx-auto flex ${shellClass} items-center gap-3 py-3`}
      >
        <a
          href="/"
          aria-label="systems-mastery home"
          class="flex shrink-0 items-center gap-1.5 font-semibold tracking-tight"
        >
          <GraduationCap class="h-5 w-5" aria-hidden="true" />
          {!breadcrumb && <span>systems-mastery</span>}
        </a>

        {
          breadcrumb && (
            <div class="flex min-w-0 flex-1 items-center gap-1.5 text-sm">
              <a
                href={`/${breadcrumb.track}/`}
                class="shrink-0 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
              >
                {breadcrumb.track}
              </a>
              <ChevronRight
                class="h-3.5 w-3.5 shrink-0 text-slate-300 dark:text-slate-700"
                aria-hidden="true"
              />
              <span class="truncate font-medium text-slate-900 dark:text-slate-100">
                {breadcrumb.unit}
              </span>
            </div>
          )
        }
        {!breadcrumb && <div class="min-w-0 flex-1" />}

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-4">
          <a
            href="/roadmap"
            title="Roadmap"
            aria-label="Roadmap"
            aria-current={isRoadmapActive ? "page" : undefined}
            class={`flex h-7 w-7 items-center justify-center gap-1.5 rounded-full border border-slate-200 text-slate-600 transition hover:border-slate-400 hover:text-slate-900 sm:h-auto sm:w-auto sm:rounded-none sm:border-0 sm:p-0 sm:hover:border-0 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100 dark:sm:hover:border-0 ${
              isRoadmapActive
                ? "text-slate-900 sm:font-semibold dark:text-slate-100"
                : ""
            }`}
          >
            <span
              aria-hidden="true"
              class="hidden h-1.5 w-1.5 shrink-0 rounded-full sm:inline-block"
              style={isRoadmapActive
                ? "background: var(--gauge-accent)"
                : "background: transparent"}></span>
            <ListChecks class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
            <span class="hidden sm:inline">roadmap</span>
          </a>
          <a
            href="/game/"
            title="Play the game — the badge shows how many runs you've earned"
            aria-current={isGameActive ? "page" : undefined}
            class={`relative flex h-7 w-7 items-center justify-center gap-1.5 rounded-full border border-slate-200 text-slate-600 transition hover:border-slate-400 hover:text-slate-900 sm:h-auto sm:w-auto sm:rounded-none sm:border-0 sm:p-0 sm:hover:border-0 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100 dark:sm:hover:border-0 ${
              isGameActive
                ? "text-slate-900 sm:font-semibold dark:text-slate-100"
                : ""
            }`}
          >
            <span
              aria-hidden="true"
              class="hidden h-1.5 w-1.5 shrink-0 rounded-full sm:inline-block"
              style={isGameActive
                ? "background: var(--gauge-accent)"
                : "background: transparent"}></span>
            <Gamepad2 class="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
            <span class="hidden sm:inline">game</span>
            <span
              data-nav-game-badge
              title="Runs earned — mark a curriculum unit done to earn more"
              class="hidden absolute -top-1.5 -right-2 h-4 min-w-4 rounded-full bg-emerald-500 px-1 text-center text-[10px] leading-4 font-semibold text-white"
            ></span>
          </a>
          <div class="relative">
            <button
              type="button"
              data-header-search-trigger
              aria-label="Search"
              aria-expanded="false"
              title="Search units and tracks"
              class="flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
            >
              <Search class="h-3.5 w-3.5" aria-hidden="true" />
            </button>
            <div
              data-header-search-panel
              class="hidden absolute top-full right-0 z-20 mt-2 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-slate-200 bg-white text-left shadow-lg dark:border-slate-700 dark:bg-slate-900"
            >
              <div
                class="flex items-center gap-2 border-b border-slate-200 px-3 py-2 dark:border-slate-800"
              >
                <Search
                  class="h-4 w-4 shrink-0 text-slate-400"
                  aria-hidden="true"
                />
                <input
                  type="text"
                  data-header-search-input
                  autocomplete="off"
                  placeholder="Search units or tracks…"
                  class="w-full bg-transparent text-sm text-slate-900 outline-none placeholder:text-slate-400 dark:text-slate-100 dark:placeholder:text-slate-500"
                />
              </div>
              <div data-header-search-results role="listbox"></div>
              <p
                data-header-search-empty
                class="hidden px-3 py-3 text-xs text-slate-400 dark:text-slate-600"
              >
                Nothing matches yet — try a track or a topic.
              </p>
            </div>
          </div>
          <button
            type="button"
            data-theme-toggle
            aria-label="Toggle dark mode"
            class="flex h-7 w-7 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
          >
            <Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
            <Moon class="block h-4 w-4 dark:hidden" aria-hidden="true" />
          </button>
          <button
            type="button"
            data-profile-trigger
            title="Switch or delete profile"
            class="flex h-7 items-center gap-1.5 rounded-full border border-slate-200 px-1 text-xs font-medium text-slate-600 transition hover:border-slate-400 hover:text-slate-900 sm:h-auto sm:py-1 sm:pr-2.5 sm:pl-1.5 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
          >
            <span
              data-profile-ring
              class="relative flex h-4 w-4 shrink-0 items-center justify-center"
            >
              <svg
                viewBox="0 0 20 20"
                class="absolute inset-0 h-full w-full -rotate-90"
                aria-hidden="true"
              >
                <circle
                  cx="10"
                  cy="10"
                  r="8"
                  fill="none"
                  stroke-width="2.5"
                  class="stroke-slate-200 dark:stroke-slate-700"></circle>
                <circle
                  data-profile-ring-arc
                  cx="10"
                  cy="10"
                  r="8"
                  fill="none"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="50.27"
                  stroke-dashoffset="50.27"
                  class="transition-[stroke-dashoffset] duration-500"
                  style="stroke: var(--gauge-accent)"></circle>
              </svg>
              <UserRound class="h-2.5 w-2.5" aria-hidden="true" />
            </span>
            <span data-profile-trigger-name class="hidden sm:inline"
              >Profile</span
            >
          </button>
        </div>
      </nav>
    </header>
    <main class={`mx-auto ${shellClass} py-8`}>
      <slot />
    </main>
    <ProfileGate />

    <script
      type="application/json"
      id="header-unit-lookup"
      set:html={JSON.stringify(headerUnitLookup)}
    />
    <script
      type="application/json"
      id="header-track-list"
      set:html={JSON.stringify(headerTrackNames)}
    />
    <script
      type="application/json"
      id="header-track-icon-paths"
      set:html={JSON.stringify(TRACK_ICON_PATHS)}
    />
    <script
      type="application/json"
      id="header-track-unit-slugs"
      set:html={JSON.stringify(headerTrackUnitSlugs)}
    />

    <script>
      import mermaid from "mermaid";
      import { getActiveProfile } from "../lib/profile";
      import { getTokenCount } from "../lib/game/tokens";
      import { countTotalDone } from "../lib/progress-gauges";

      function renderGameBadge() {
        const badge = document.querySelector<HTMLElement>(
          "[data-nav-game-badge]",
        );
        if (!badge) return;
        const count = getTokenCount();
        badge.textContent = String(count);
        badge.classList.toggle("hidden", count < 1);
      }
      renderGameBadge();
      document.addEventListener("astro:page-load", renderGameBadge);
      document.addEventListener("game:tokens-changed", renderGameBadge);

      function initProfileTrigger() {
        const button = document.querySelector<HTMLButtonElement>(
          "[data-profile-trigger]",
        );
        const nameEl = document.querySelector<HTMLElement>(
          "[data-profile-trigger-name]",
        );
        if (!button || !nameEl) return;

        const active = getActiveProfile();
        nameEl.textContent = active ? active.name : "Profile";

        if (button.dataset.wired === "true") return;
        button.dataset.wired = "true";
        button.addEventListener("click", () => {
          document.dispatchEvent(new CustomEvent("profile-gate:open"));
        });
      }
      initProfileTrigger();
      document.addEventListener("astro:page-load", initProfileTrigger);

      // Overall completion ring around the profile button's user icon —
      // same ring math as the home/roadmap track gauges (applyTrackGauges),
      // just a single aggregate fraction instead of one per track. Re-read
      // on every page-load like the gauges, not live-updated mid-page: a
      // profile switch already triggers a full reload (ProfileGate.astro),
      // and marking a unit done happens on a page with no ring to refresh.
      function applyProfileRing() {
        const arc = document.querySelector<SVGCircleElement>(
          "[data-profile-ring-arc]",
        );
        const el = document.getElementById("header-track-unit-slugs");
        if (!arc || !el) return;
        let map: Record<string, string[]>;
        try {
          map = JSON.parse(el.textContent || "{}");
        } catch {
          return;
        }
        const total = Object.values(map).reduce((n, s) => n + s.length, 0);
        const done = countTotalDone(map);
        const fraction = total > 0 ? done / total : 0;
        const circumference = 2 * Math.PI * 8;
        arc.style.strokeDashoffset = String(circumference * (1 - fraction));
      }
      applyProfileRing();
      document.addEventListener("astro:page-load", applyProfileRing);

      function initThemeToggle() {
        const button = document.querySelector<HTMLButtonElement>(
          "[data-theme-toggle]",
        );
        if (!button || button.dataset.wired === "true") return;
        button.dataset.wired = "true";
        button.addEventListener("click", () => {
          const goingDark =
            !document.documentElement.classList.contains("dark");
          localStorage.setItem("theme", goingDark ? "dark" : "light");
          // Reload rather than toggle the class live — mermaid diagrams
          // already on the page bake their theme colors in at render time
          // (see below), so a live class-only flip would leave every
          // rendered diagram in the old theme's colors until the next
          // navigation. A reload is simple and correct; this is a content
          // site, not an app, so the reload cost is negligible.
          location.reload();
        });
      }
      initThemeToggle();
      document.addEventListener("astro:page-load", initThemeToggle);

      // Header search — reachable from every page (home/roadmap additionally
      // have their own larger hero search; this is the compact header
      // equivalent so a reader deep in a unit page isn't three clicks away
      // from finding another topic). Deliberately separate data/markup from
      // index.astro's dropdown rather than sharing it: that one lives inside
      // a page-specific <form>, this one inside the global header, and
      // merging them would couple two otherwise-independent UIs for little
      // benefit.
      interface HeaderSearchUnit {
        track: string;
        slug: string;
        problem: string;
      }
      interface HeaderSearchResult {
        label: string;
        track: string;
        href: string;
      }
      interface HeaderIconNode {
        type: string;
        props: Record<string, string | number>;
      }

      function buildHeaderResultIcon(
        iconPaths: Record<string, HeaderIconNode[]>,
        track: string,
      ): SVGSVGElement {
        const svgNS = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("width", "13");
        svg.setAttribute("height", "13");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("fill", "none");
        svg.setAttribute("stroke", "currentColor");
        svg.setAttribute("stroke-width", "2");
        svg.setAttribute("stroke-linecap", "round");
        svg.setAttribute("stroke-linejoin", "round");
        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute(
          "class",
          "shrink-0 text-slate-400 dark:text-slate-600",
        );
        for (const node of iconPaths[track] ?? []) {
          const el = document.createElementNS(svgNS, node.type);
          for (const [key, value] of Object.entries(node.props)) {
            el.setAttribute(key, String(value));
          }
          svg.appendChild(el);
        }
        return svg;
      }

      function initHeaderSearch() {
        const trigger = document.querySelector<HTMLButtonElement>(
          "[data-header-search-trigger]",
        );
        const panel = document.querySelector<HTMLElement>(
          "[data-header-search-panel]",
        );
        const input = document.querySelector<HTMLInputElement>(
          "[data-header-search-input]",
        );
        const resultsHost = document.querySelector<HTMLElement>(
          "[data-header-search-results]",
        );
        const emptyEl = document.querySelector<HTMLElement>(
          "[data-header-search-empty]",
        );
        const unitsEl = document.getElementById("header-unit-lookup");
        const tracksEl = document.getElementById("header-track-list");
        const iconsEl = document.getElementById("header-track-icon-paths");
        if (
          !trigger ||
          !panel ||
          !input ||
          !resultsHost ||
          !emptyEl ||
          !unitsEl ||
          !tracksEl ||
          !iconsEl
        )
          return;
        if (trigger.dataset.wired === "true") return;
        trigger.dataset.wired = "true";

        let units: HeaderSearchUnit[] = [];
        let tracks: string[] = [];
        let iconPaths: Record<string, HeaderIconNode[]> = {};
        try {
          units = JSON.parse(unitsEl.textContent || "[]");
        } catch {
          // Malformed embed — search just finds nothing.
        }
        try {
          tracks = JSON.parse(tracksEl.textContent || "[]");
        } catch {
          // Malformed embed — track matches just don't appear.
        }
        try {
          iconPaths = JSON.parse(iconsEl.textContent || "{}");
        } catch {
          // Malformed embed — rows render with no icon.
        }

        const MAX_RESULTS = 4;

        function computeResults(query: string): HeaderSearchResult[] {
          const q = query.trim().toLowerCase();
          if (!q) return [];
          const unitMatches: HeaderSearchResult[] = units
            .filter((u) => u.problem.toLowerCase().includes(q))
            .map((u) => ({
              label: u.problem,
              track: u.track,
              href: `/${u.track}/${u.slug}/`,
            }));
          const trackMatches: HeaderSearchResult[] = tracks
            .filter((t) => t.toLowerCase().includes(q))
            .map((t) => ({ label: t, track: t, href: `/${t}/` }));
          return [...unitMatches, ...trackMatches].slice(0, MAX_RESULTS);
        }

        function renderResults(results: HeaderSearchResult[]) {
          resultsHost!.innerHTML = "";
          emptyEl!.classList.toggle(
            "hidden",
            results.length > 0 || input!.value.trim() === "",
          );
          results.forEach((r) => {
            const row = document.createElement("a");
            row.href = r.href;
            row.setAttribute("role", "option");
            row.className =
              "flex items-center gap-2 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-800";
            row.appendChild(buildHeaderResultIcon(iconPaths, r.track));
            const text = document.createElement("span");
            text.className = "flex-1 truncate";
            text.textContent = r.label;
            const tag = document.createElement("span");
            tag.className =
              "shrink-0 text-[10px] text-slate-400 dark:text-slate-600";
            tag.textContent = r.track;
            row.append(text, tag);
            resultsHost!.appendChild(row);
          });
        }

        function openPanel() {
          panel!.classList.remove("hidden");
          trigger!.setAttribute("aria-expanded", "true");
        }
        function closePanel() {
          panel!.classList.add("hidden");
          trigger!.setAttribute("aria-expanded", "false");
        }

        trigger.addEventListener("click", () => {
          if (panel!.classList.contains("hidden")) {
            openPanel();
            input!.focus();
            renderResults(computeResults(input!.value));
          } else {
            closePanel();
          }
        });
        input.addEventListener("input", () => {
          renderResults(computeResults(input.value));
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closePanel();
            trigger!.focus();
          } else if (e.key === "Enter") {
            const first = resultsHost!.querySelector<HTMLAnchorElement>("a");
            if (first) {
              e.preventDefault();
              window.location.href = first.href;
            }
          }
        });
        document.addEventListener("click", (e) => {
          const target = e.target as Node;
          if (
            !panel!.classList.contains("hidden") &&
            !panel!.contains(target) &&
            !trigger!.contains(target)
          ) {
            closePanel();
          }
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !panel!.classList.contains("hidden")) {
            closePanel();
          }
        });
      }
      initHeaderSearch();
      document.addEventListener("astro:page-load", initHeaderSearch);

      const prefersDark = document.documentElement.classList.contains("dark");
      // Mermaid measures label text (to size boxes/notes) using this font,
      // via canvas — if it doesn't match the font actually applied to
      // .mermaid (inherited from Tailwind Typography's `.prose`), the box
      // Mermaid draws and the text the browser renders disagree on width,
      // and the rect ends up visibly offset from its own label. Keep this
      // in sync with Tailwind's --font-sans (see tailwindcss/theme.css).
      const pageFontFamily =
        "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, " +
        "'Helvetica Neue', 'Noto Sans', Arial, sans-serif";

      // xyChart's plot area falls back to themeVariables.background when it
      // has no explicit backgroundColor — the built-in dark/default themes
      // pick a background a shade lighter than our actual page background
      // (bg-slate-950), so bar/line charts rendered with a visibly
      // mismatched gray box behind them otherwise. Pie's default slice
      // palette (pie1..pie6) also includes near-black entries that are
      // effectively invisible against bg-slate-950 — overridden with a
      // brighter, higher-contrast palette below. These override only the
      // specific variables that broke against our background; everything
      // else keeps the base dark/default theme's look (sequence diagrams
      // included).
      // Note: plotColorPalette/backgroundColor for xyChart are *theme*
      // variables (nested under themeVariables.xyChart), not fields of the
      // top-level `xyChart` diagram-config object passed to initialize() —
      // that one only holds layout options like width/titleFontSize. Mixing
      // these up produces a TS error (XYChartConfig has no such fields) and,
      // at runtime, silently falls back to the built-in palette instead.
      // xyChart's title/axis text falls back to themeVariables.primaryTextColor,
      // which mermaid resolves from an internal `darkMode` boolean — NOT from
      // the `theme: "dark"` string we pass to initialize() below. We never set
      // that boolean, so it defaults false and primaryTextColor resolves to a
      // near-black gray regardless of our theme name, rendering title/axis
      // text near-invisible against our dark background. Set xyChart's text
      // colors explicitly instead of relying on that fallback chain.
      const chartThemeVariables = prefersDark
        ? {
            background: "transparent",
            pie1: "#38bdf8",
            pie2: "#a78bfa",
            pie3: "#34d399",
            pie4: "#fb923c",
            pie5: "#f472b6",
            pie6: "#facc15",
            pieSectionTextColor: "#020617",
            pieStrokeColor: "#020617",
            pieOuterStrokeColor: "#475569",
            xyChart: {
              backgroundColor: "transparent",
              plotColorPalette:
                "#38bdf8,#a78bfa,#34d399,#fb923c,#f472b6,#facc15",
              titleColor: "#e2e8f0",
              xAxisTitleColor: "#cbd5e1",
              xAxisLabelColor: "#cbd5e1",
              xAxisTickColor: "#64748b",
              xAxisLineColor: "#64748b",
              yAxisTitleColor: "#cbd5e1",
              yAxisLabelColor: "#cbd5e1",
              yAxisTickColor: "#64748b",
              yAxisLineColor: "#64748b",
            },
          }
        : {
            background: "transparent",
            pie1: "#0ea5e9",
            pie2: "#8b5cf6",
            pie3: "#10b981",
            pie4: "#f97316",
            pie5: "#ec4899",
            pie6: "#eab308",
            pieSectionTextColor: "#f8fafc",
            pieStrokeColor: "#ffffff",
            pieOuterStrokeColor: "#cbd5e1",
            xyChart: {
              backgroundColor: "transparent",
              plotColorPalette:
                "#0ea5e9,#8b5cf6,#10b981,#f97316,#ec4899,#eab308",
              titleColor: "#1e293b",
              xAxisTitleColor: "#334155",
              xAxisLabelColor: "#334155",
              xAxisTickColor: "#94a3b8",
              xAxisLineColor: "#94a3b8",
              yAxisTitleColor: "#334155",
              yAxisLabelColor: "#334155",
              yAxisTickColor: "#94a3b8",
              yAxisLineColor: "#94a3b8",
            },
          };

      mermaid.initialize({
        startOnLoad: false,
        theme: prefersDark ? "dark" : "default",
        themeVariables: chartThemeVariables,
        fontFamily: pageFontFamily,
        // Default sequence diagrams repeat actor boxes at the bottom
        // ("mirrored" actors) — in our narrow content column that repeat
        // reliably overlaps the last message/note instead of leaving room
        // for it, so it's off rather than fought with more container width.
        sequence: { mirrorActors: false },
        // xychart-beta's x-axis labels default to horizontal (labelRotation:
        // 0) with no wrapping — a handful of realistic category names (e.g.
        // "SHA-256 (GPU cluster)") don't fit their allotted slot at that
        // angle and get visually cut off / overlap their neighbor. Angling
        // labels gives each one much more effective width for the same
        // horizontal footprint, the standard fix for this class of chart;
        // -30° reads comfortably left-to-right without needing the labels
        // to run fully vertical.
        //
        // Rotating the labels adds real vertical footprint (the further a
        // rotated label's own width, the more it hangs below the axis).
        // Verified by transforming each <text>'s bbox through its actual
        // getCTM() into the chart's own viewBox coordinates: rotated labels
        // consistently landed ~12-18px past the bottom edge regardless of
        // total chart height — silently clipped by the SVG's own overflow.
        // Growing `height` alone doesn't fix it: mermaid reserves the axis's
        // label space from its OWN estimated footprint
        // (sin(rotation)*textWidth + cos(rotation)*textHeight +
        // labelPadding*2), not as a share of total chart height, and that
        // estimate under-shoots the real rendered bbox by a small, roughly
        // constant amount (a measurement/render mismatch inside mermaid
        // itself, not something this project's math). `labelPadding`, unlike
        // `height`, feeds directly into that reserved-space calculation, so
        // padding it out is what actually buys back the missing margin.
        xyChart: {
          xAxis: {
            labelRotation: -30,
            labelFontSize: 11,
            labelPadding: 28,
          },
        },
      });

      // Convert every fenced mermaid block to a `.mermaid` div up front —
      // cheap, no layout involved — but only RENDER (mermaid.run) the ones
      // that are currently visible. flowchart/xychart diagrams measure text
      // via real DOM layout (getBBox), which returns 0 for anything inside
      // a `display:none` ancestor — rendering one while its LevelTabs panel
      // is hidden collapses it to an empty ~16x16 box permanently (sequence
      // diagrams use canvas-based text measurement instead, so they don't
      // have this problem, which is why this went unnoticed on L2 tabs that
      // happened to use sequenceDiagram). LevelTabs dispatches
      // "mermaid:rerun" after un-hiding a panel so any diagram that was
      // skipped gets rendered for real the first time it's actually shown.
      function isInHiddenPanel(el: Element): boolean {
        return el.closest("[data-tab-panel].hidden") !== null;
      }

      function convertFencedBlocks(scope: ParentNode) {
        const blocks = scope.querySelectorAll<HTMLElement>(
          'pre[data-language="mermaid"]',
        );
        blocks.forEach((pre) => {
          const container = document.createElement("div");
          container.className = "mermaid";
          container.textContent = pre.textContent ?? "";
          pre.replaceWith(container);
        });
      }

      function renderVisibleMermaid() {
        const nodes = Array.from(
          document.querySelectorAll<HTMLElement>(
            ".mermaid:not([data-processed])",
          ),
        ).filter((el) => !isInHiddenPanel(el));
        if (nodes.length > 0) void mermaid.run({ nodes });
      }

      convertFencedBlocks(document);
      renderVisibleMermaid();
      document.addEventListener("mermaid:rerun", renderVisibleMermaid);
    </script>
  </body>
</html>
