---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · systems-mastery</title>
  </head>
  <body
    class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <header
      class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80"
    >
      <nav
        class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3"
      >
        <a href="/" class="font-semibold tracking-tight">systems-mastery</a>
        <a
          href="/roadmap"
          class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
          >roadmap</a
        >
      </nav>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <script>
      import mermaid from "mermaid";

      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      // Mermaid measures label text (to size boxes/notes) using this font,
      // via canvas — if it doesn't match the font actually applied to
      // .mermaid (inherited from Tailwind Typography's `.prose`), the box
      // Mermaid draws and the text the browser renders disagree on width,
      // and the rect ends up visibly offset from its own label. Keep this
      // in sync with Tailwind's --font-sans (see tailwindcss/theme.css).
      const pageFontFamily =
        "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, " +
        "'Helvetica Neue', 'Noto Sans', Arial, sans-serif";

      // xyChart's plot area falls back to themeVariables.background when it
      // has no explicit backgroundColor — the built-in dark/default themes
      // pick a background a shade lighter than our actual page background
      // (bg-slate-950), so bar/line charts rendered with a visibly
      // mismatched gray box behind them otherwise. Pie's default slice
      // palette (pie1..pie6) also includes near-black entries that are
      // effectively invisible against bg-slate-950 — overridden with a
      // brighter, higher-contrast palette below. These override only the
      // specific variables that broke against our background; everything
      // else keeps the base dark/default theme's look (sequence diagrams
      // included).
      // Note: plotColorPalette/backgroundColor for xyChart are *theme*
      // variables (nested under themeVariables.xyChart), not fields of the
      // top-level `xyChart` diagram-config object passed to initialize() —
      // that one only holds layout options like width/titleFontSize. Mixing
      // these up produces a TS error (XYChartConfig has no such fields) and,
      // at runtime, silently falls back to the built-in palette instead.
      const chartThemeVariables = prefersDark
        ? {
            background: "transparent",
            pie1: "#38bdf8",
            pie2: "#a78bfa",
            pie3: "#34d399",
            pie4: "#fb923c",
            pie5: "#f472b6",
            pie6: "#facc15",
            pieSectionTextColor: "#020617",
            pieStrokeColor: "#020617",
            pieOuterStrokeColor: "#475569",
            xyChart: {
              backgroundColor: "transparent",
              plotColorPalette:
                "#38bdf8,#a78bfa,#34d399,#fb923c,#f472b6,#facc15",
            },
          }
        : {
            background: "transparent",
            pie1: "#0ea5e9",
            pie2: "#8b5cf6",
            pie3: "#10b981",
            pie4: "#f97316",
            pie5: "#ec4899",
            pie6: "#eab308",
            pieSectionTextColor: "#f8fafc",
            pieStrokeColor: "#ffffff",
            pieOuterStrokeColor: "#cbd5e1",
            xyChart: {
              backgroundColor: "transparent",
              plotColorPalette:
                "#0ea5e9,#8b5cf6,#10b981,#f97316,#ec4899,#eab308",
            },
          };

      mermaid.initialize({
        startOnLoad: false,
        theme: prefersDark ? "dark" : "default",
        themeVariables: chartThemeVariables,
        fontFamily: pageFontFamily,
        // Default sequence diagrams repeat actor boxes at the bottom
        // ("mirrored" actors) — in our narrow content column that repeat
        // reliably overlaps the last message/note instead of leaving room
        // for it, so it's off rather than fought with more container width.
        sequence: { mirrorActors: false },
      });

      const blocks = document.querySelectorAll<HTMLElement>(
        'pre[data-language="mermaid"]',
      );
      blocks.forEach((pre) => {
        const container = document.createElement("div");
        container.className = "mermaid";
        container.textContent = pre.textContent ?? "";
        pre.replaceWith(container);
      });
      if (blocks.length > 0) {
        void mermaid.run();
      }
    </script>
  </body>
</html>
