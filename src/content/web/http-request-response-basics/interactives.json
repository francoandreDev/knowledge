{
  "items": [
    {
      "id": "transfer-time",
      "level": 3,
      "title": "How payload size and bandwidth determine transfer time",
      "description": "The response body from the request/response cycle above still has to travel over the network. Drag the sliders to see how a bigger payload or a slower connection changes how long that takes.",
      "params": [
        {
          "name": "payloadKB",
          "label": "Response payload size",
          "min": 1,
          "max": 5000,
          "step": 1,
          "default": 200,
          "unit": " KB"
        },
        {
          "name": "bandwidthMbps",
          "label": "Connection bandwidth",
          "min": 1,
          "max": 1000,
          "step": 1,
          "default": 50,
          "unit": " Mbps"
        }
      ],
      "compute": "return { transferMs: Math.round((params.payloadKB * 8) / params.bandwidthMbps) };",
      "outputs": [
        {
          "key": "transferMs",
          "label": "Transfer time",
          "unit": "ms",
          "color": "#38bdf8"
        }
      ],
      "chartParam": "payloadKB"
    }
  ]
}
