{
  "items": [
    {
      "id": "tree-shaking-savings",
      "level": 3,
      "title": "How much unused code tree-shaking actually removes",
      "description": "The bundler above only ships exports something actually imports. Drag the sliders to see how a bundle's total size and the fraction of dead code in it change what actually ships.",
      "params": [
        {
          "name": "totalKB",
          "label": "Total bundle before tree-shaking",
          "min": 50,
          "max": 3000,
          "step": 10,
          "default": 800,
          "unit": " KB"
        },
        {
          "name": "unusedPercent",
          "label": "Unused exports",
          "min": 0,
          "max": 90,
          "step": 1,
          "default": 30,
          "unit": "%"
        }
      ],
      "compute": "return { finalKB: Math.round(params.totalKB * (1 - params.unusedPercent / 100)) };",
      "outputs": [
        {
          "key": "finalKB",
          "label": "Final bundle size",
          "unit": "KB",
          "color": "#38bdf8"
        }
      ],
      "chartParam": "unusedPercent"
    }
  ]
}
