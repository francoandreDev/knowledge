{
  "items": [
    {
      "id": "specificity-score",
      "level": 3,
      "title": "How ID and class counts combine into a specificity score",
      "description": "The selector comparison above used one fixed combination. Drag the sliders to compute the specificity score for any combination of IDs and classes in a single selector (one element type assumed).",
      "params": [
        {
          "name": "idCount",
          "label": "Number of ID selectors (#foo)",
          "min": 0,
          "max": 3,
          "step": 1,
          "default": 0
        },
        {
          "name": "classCount",
          "label": "Number of class selectors (.foo)",
          "min": 0,
          "max": 6,
          "step": 1,
          "default": 2
        }
      ],
      "compute": "return { score: params.idCount * 100 + params.classCount * 10 + 1 };",
      "outputs": [
        {
          "key": "score",
          "label": "Specificity score",
          "color": "#38bdf8"
        }
      ],
      "chartParam": "classCount"
    }
  ]
}
