{
  "items": [
    {
      "id": "scope-exposure-calculator",
      "level": 3,
      "title": "How does scope scale with a bug's actual reach?",
      "description": "Reproduces Sam's exposure calculation from L3: customers affected × charge per customer. Defaults (3,100 customers, $60 each) reproduce the unit's exact $186,000 figure. Drag either slider to see how quickly a small-looking bug's exposure grows as its blast radius widens.",
      "params": [
        {
          "name": "customersAffected",
          "label": "Customers affected",
          "min": 100,
          "max": 10000,
          "step": 100,
          "default": 3100,
          "unit": ""
        },
        {
          "name": "chargePerCustomer",
          "label": "Charge per customer",
          "min": 10,
          "max": 200,
          "step": 5,
          "default": 60,
          "unit": "$"
        }
      ],
      "compute": "return { totalExposure: params.customersAffected * params.chargePerCustomer };",
      "outputs": [
        {
          "key": "totalExposure",
          "label": "Total exposure",
          "unit": "$",
          "color": "#f87171"
        }
      ],
      "chartParam": "customersAffected"
    }
  ]
}
